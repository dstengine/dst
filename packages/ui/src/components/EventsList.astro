---
// Body of /events/ across the network — the same cards as NewsList, split into
// Upcoming / Past by `start` against build time. Astro builds are static, so
// "now" is fixed at build time; that's an acceptable drift for a network that
// rebuilds regularly, not a live app.
import type { EventItem } from "@dst/content/types";
import FeedCards from "./FeedCards.astro";
import Icon from "./Icon.astro";
import { withLabels, type ArticleLabels } from "../labels.ts";
import CountdownScript from "./CountdownScript.astro";

interface Props {
  items: EventItem[];
  /** Where this site keeps its feed. Defaults to the English paths every
      DST host uses; a site publishing in another language passes its own
      ("/noticias/", "/eventos/") so its URLs are in the language of the
      words on the page. */
  eventsBase?: string;
  /** Locale for dates on this page. Defaults to the network's English;
      a site writing in another language passes its own. */
  locale?: string;
  /** The two group headings, for a site not writing in English. */
  labels?: Partial<ArticleLabels>;
  /** Absolute https URL of this site's whole-calendar .ics. Absent on a
      site that doesn't publish one, and the block then isn't drawn. */
  calendarHref?: string;
}
const { items, eventsBase = "/events/", locale, labels: labelOverrides, calendarHref } = Astro.props;
const L = withLabels(labelOverrides);
const todayIso = new Date().toISOString().slice(0, 10);

// webcal: is what hands the URL straight to a calendar app as a
// subscription. The same address over https downloads the file instead,
// which is the one-off import the per-event button already does — so the
// scheme is the whole difference between the two things.
const subscribeHref = calendarHref?.replace(/^https?:/, "webcal:");

// Upcoming events run in date order. Nothing else.
//
// They used to run ranked-first: a handful of events carried a `featured`
// number and jumped the queue, on the argument that a city agenda is not a
// flat list and a reader should meet the big ones first. That argument is
// wrong for a calendar, and a calendar is what this is. A listing that put
// 15 November above 14 September above 1 November read as broken — because
// the one thing a reader asks a date-ordered list is "what is next", and
// answering it with "the biggest" answers a question nobody asked. The
// promotion belongs on the front page and in the size of the card, not in
// the order of the dates.
//
// `featured` survives on EventItem and still ranks news; it no longer moves
// an event.
const byDate = (a: EventItem, b: EventItem) =>
  a.start < b.start ? -1 : a.start > b.start ? 1 : 0;

const toCard = (item: EventItem, past: boolean) => {
  const hasPage = Array.isArray(item.body) && item.body.length > 0;
  return {
    href: hasPage ? `${eventsBase}${item.slug}/` : undefined,
    eyebrow: item.category,
    date: item.start,
    title: item.title,
    short: item.cardTitle,
    text: [item.venue, item.city].filter(Boolean).join(" · ") || item.summary,
    // An event with a picture of its own shows it; the rest keep the date
    // cover, which for an event is the thing being decided about anyway.
    image: item.image,
    imageAlt: item.imageAlt,
    imageFit: "cover" as const,
    event: true,
    past,
  };
};

const upcoming = items
  .filter((e) => e.start >= todayIso)
  .sort(byDate)
  .map((e) => toCard(e, false));
const past = items
  .filter((e) => e.start < todayIso)
  .sort((a, b) => (a.start < b.start ? 1 : a.start > b.start ? -1 : 0))
  .map((e) => toCard(e, true));
---
{items.length > 0 && (
  <div class="events-lists">
    {upcoming.length > 0 && (
      <div class="events-group">
        <h3 class="events-group-heading">{L.upcoming}</h3>
        <FeedCards items={upcoming} columns={upcoming.length <= 2 ? upcoming.length : undefined} locale={locale} labels={L} />
        <CountdownScript />
      </div>
    )}
    {past.length > 0 && (
      <div class="events-group events-group-past">
        <h3 class="events-group-heading">{L.pastGroup}</h3>
        <FeedCards items={past} columns={past.length <= 2 ? past.length : undefined} locale={locale} labels={L} />
      </div>
    )}
    {subscribeHref && (
      <a class="events-subscribe" href={subscribeHref} title={L.subscribeCalendarTitle}>
        <Icon name="events" />
        <span class="events-subscribe-text">
          <span class="events-subscribe-label">{L.subscribeCalendar}</span>
          <span class="events-subscribe-note">{L.subscribeCalendarNote}</span>
        </span>
      </a>
    )}
  </div>
)}

<style>
  .events-lists { display: flex; flex-direction: column; gap: var(--space-5); margin-top: var(--space-3); }
  .events-group-heading { margin: 0; font-size: var(--step-1); }
  /* A past event is still worth having on the page — it's evidence the site
     covers this beat — but it shouldn't compete with what's still to come. */
  .events-group-past { opacity: 0.85; }

  /* Sits under the dates, because it is the thing to do after reading them.
     The whole block is the target, not the label inside it: a two-line offer
     whose top line alone is clickable makes the reader aim, and on a phone
     the note is the larger half of what they are aiming at. */
  .events-subscribe {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    padding: var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-size: var(--step--1);
    color: inherit;
    text-decoration: none;
  }
  .events-subscribe:hover,
  .events-subscribe:focus-visible { border-color: var(--accent); }
  /* :global on the svg because Icon.astro renders it, not this file, and
     Astro scopes every part of a selector — including the descendant. The
     unsized mark came out 95px square. Glance.astro gets away with a plain
     `dt svg` only because it writes its own svg inline. */
  .events-subscribe :global(svg) {
    flex: none;
    width: 1.4em;
    height: 1.4em;
    color: var(--accent);
    /* Optical alignment with the label's cap height rather than its box. */
    margin-top: 0.1em;
  }
  .events-subscribe-text { display: flex; flex-direction: column; gap: 0.15em; }
  .events-subscribe-label { font-weight: 600; color: var(--accent); }
  .events-subscribe:hover .events-subscribe-label { text-decoration: underline; }
  .events-subscribe-note { color: var(--muted); }
</style>
