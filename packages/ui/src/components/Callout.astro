---
interface Props { kind?: "note" | "warn" }
const { kind = "note" } = Astro.props;
---
<div class:list={["callout", kind]}>
  <slot />
</div>

<style>
  .callout {
    /* Every other element on the page lives inside .container; Callout is
       always used directly in <main> without that wrapper, so it needs
       its own matching max-width/centering or it renders full-bleed
       edge-to-edge while everything around it stays margined. */
    box-sizing: border-box;
    max-width: var(--page-width);
    margin: var(--space-3) auto;
    padding: var(--space-2) var(--space-3);
    padding-left: calc(var(--space-3) - 3px);
    border-left: 3px solid var(--accent, #1F5C4E);
    background: var(--accent-tint, var(--surface-sunk));
    border-radius: 0 var(--radius) var(--radius) 0;
    font-size: var(--step--1);
  }
  .callout.warn {
    border-left-color: var(--warn);
    background: var(--warn-bg);
  }
</style>
