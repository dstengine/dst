---
// A Google Maps frame for a place we hold coordinates for — the same embed
// as the event and news pages, see ../maps.ts for why Google and why keyless —
// and a link out for anyone who wants directions.
//
// Lazy on purpose: a map below the fold should not cost the first paint.
//
// The way out is a button, not a line of caption text. Someone reading a
// venue page on a phone outside the theatre wants the one thing the embed
// cannot give them — the route — and a 13px grey link under a map is not
// where a thumb goes looking for it.
import Icon from "./Icon.astro";
import { mapEmbedUrl, directionsUrl } from "../maps";
interface Props {
  lat: number;
  lon: number;
  /** Named in the iframe title, so a screen reader hears which place. */
  name: string;
  /** 16 is the block the venue stands in. */
  zoom?: number;
  /** Language of the map's own labels; the page's locale. */
  locale?: string;
}
// English by default, like the button under it.
const { lat, lon, name, zoom = 16, locale = "en" } = Astro.props;
const src = mapEmbedUrl(lat, lon, { zoom, locale });
const full = directionsUrl(lat, lon);
---
<figure class="locate-map">
  <iframe src={src} title={`Map showing ${name}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
  <figcaption>
    <a class="button button-secondary" href={full} target="_blank" rel="nofollow noopener" title={`The way to ${name}, in Google Maps`}>
      <Icon name="navigate" />
      Directions
    </a>
  </figcaption>
</figure>

<style>
  .locate-map { margin: var(--space-4) 0 0; }
  .locate-map iframe {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    min-height: 240px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-sunk);
  }
  .locate-map figcaption {
    margin-top: var(--space-2);
  }
</style>
