---
// Detail page body for a single event — same block-only-when-present rule
// as NewsArticle.astro, plus the two things an event has that a news item
// doesn't: dates/venue/organizer in the header, and a ticket button right
// under it while intent is still fresh.
import type { EventItem } from "@dst/content/types";
import LeadForm from "./LeadForm.astro";
import VentureGrid from "./VentureGrid.astro";
import SourceLine from "./SourceLine.astro";
import ImageNote from "./ImageNote.astro";
import CountdownScript from "./CountdownScript.astro";
import { ICONS } from "../icons.ts";
import { formatDate } from "../date.ts";

interface Props {
  item: EventItem;
  backHref: string;
  ticketHref?: string; // resolved by the route to /go/<slug>/, not item.ticket.url directly
}
const { item, backHref, ticketHref } = Astro.props;

// Schema.org takes a full timestamp when the clock time is known — a
// date-only startDate tells Google the day but not the hour, and event
// rich results lean on the hour.
const offset = item.utcOffset ?? "+04:00";
const stamp = (day: string, time?: string) => (time ? `${day}T${time}:00${offset}` : day);
const startStamp = stamp(item.start, item.startTime);
const endStamp = item.end || item.endTime ? stamp(item.end ?? item.start, item.endTime) : undefined;

const jsonLd =
  item.jsonLd ??
  {
    "@context": "https://schema.org",
    "@type": "Event",
    name: item.title,
    description: item.summary,
    startDate: startStamp,
    ...(endStamp ? { endDate: endStamp } : {}),
    eventStatus: "https://schema.org/EventScheduled",
    eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
    ...(item.venue || item.city
      ? {
          location: {
            "@type": "Place",
            name: item.venue ?? item.city,
            ...(item.geo
              ? { geo: { "@type": "GeoCoordinates", latitude: item.geo.lat, longitude: item.geo.lng } }
              : {}),
            ...(item.city ? { address: { "@type": "PostalAddress", addressLocality: item.city } } : {}),
          },
        }
      : {}),
    ...(item.organizer ? { organizer: { "@type": "Organization", name: item.organizer } } : {}),
    ...(item.ticket && ticketHref ? { offers: { "@type": "Offer", url: ticketHref } } : {}),
  };

const relatedItems = (item.related ?? []).map((card) => ({
  href: card.href,
  title: card.title, // VentureGrid's anchor title attribute
  eyebrow: card.eyebrow ?? "Related",
  status: "Read more",
  name: card.title,
  text: card.text,
  image: card.image,
  imageAlt: card.imageAlt,
  icon: card.image ? undefined : ICONS.link,
}));
---
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
<article class="container event-article">
  <header class="event-article-header">
    <p class="event-article-meta">
      {item.category && <span class="event-article-category">{item.category}</span>}
      <time datetime={startStamp}>{formatDate(item.start)}</time>
      {item.end && <span>&ndash; <time datetime={endStamp}>{formatDate(item.end)}</time></span>}
      {item.startTime && (
        <span class="event-article-time">
          {item.startTime}{item.endTime && <>&ndash;{item.endTime}</>}
        </span>
      )}
      {/* Revealed client-side once the last day has passed — a static build
          can't know, and a page still presenting a finished event as
          upcoming is the usual way these listings rot. */}
      <span class="event-article-ended" data-event-ended datetime={item.end ?? item.start} hidden>
        Ended
      </span>
    </p>
    <h1>{item.title}</h1>
    {(item.venue || item.city || item.organizer) && (
      <p class="event-article-details">
        {[item.venue, item.city].filter(Boolean).join(", ")}
        {item.organizer && <span class="event-article-organizer"> &middot; Organized by {item.organizer}</span>}
      </p>
    )}
  </header>

  <p class="event-article-actions">
    {item.ticket && ticketHref && (
      <a class="button" href={ticketHref} title={item.ticket.label ?? "Register"}>{item.ticket.label ?? "Register"}</a>
    )}
    {/* Secondary to the ticket link, but present on every event: a plain
        .ics file, no account and no calendar service in between. */}
    <a class="button button-secondary" href={`${backHref}${item.slug}.ics`} download title={`Add ${item.title} to your calendar`}>
      Add to calendar
    </a>
  </p>

  {item.image && (
    <figure class:list={["event-article-figure", { "figure-diagram": item.imageKind && item.imageKind !== "photo" }]}>
      <img src={item.image} alt={item.imageAlt ?? ""} loading="eager" width={item.imageWidth} height={item.imageHeight} />
      <ImageNote kind={item.imageKind} credit={item.imageCredit} />
    </figure>
  )}

  {/* Above the original description on purpose: once something has
      happened, what came of it is the news, and the announcement is
      background. */}
  {item.outcome && item.outcome.length > 0 && (
    <section class="event-article-outcome">
      <h2>What happened</h2>
      <div class="prose">
        {item.outcome.map((p) => <p set:html={p} />)}
      </div>
    </section>
  )}

  {item.body && item.body.length > 0 && (
    <div class="prose">
      {/* set:html so a paragraph can carry <strong> on the fact it turns
          on — a figure, a resolution number, a date. Content is authored in
          this repo, never user input, same as the district ContentPage. */}
      {item.body.map((p) => <p set:html={p} />)}
    </div>
  )}

  {item.expertise && (
    <div class="prose event-article-expertise">
      <p set:html={item.expertise} />
    </div>
  )}

  {item.geo && (
    <section class="locate">
      <h2>Locate</h2>
      <div class="locate-map">
        <iframe
          src={`https://www.openstreetmap.org/export/embed.html?bbox=${item.geo.lng - 0.02}%2C${item.geo.lat - 0.01}%2C${item.geo.lng + 0.02}%2C${item.geo.lat + 0.01}&layer=mapnik&marker=${item.geo.lat}%2C${item.geo.lng}`}
          loading="lazy"
          title={`Map — ${item.geo.name}`}
        />
      </div>
    </section>
  )}

  {item.form && (
    <section class="event-article-form">
      {item.form.title && <h2>{item.form.title}</h2>}
      {item.form.description && <p>{item.form.description}</p>}
      <LeadForm formName={item.form.title} formDescription={item.form.description} submitLabel={item.form.submitLabel}>
        {Object.entries(item.form.meta ?? {}).map(([key, value]) => (
          <input type="hidden" name={`meta.${key}`} value={value} />
        ))}
      </LeadForm>
    </section>
  )}

  {relatedItems.length > 0 && (
    <section class="event-article-related">
      <h2>Related</h2>
      <VentureGrid items={relatedItems} />
    </section>
  )}

  {item.source && <SourceLine source={item.source} />}

  <nav class="event-article-back">
    <a href={backHref} title="All events">&larr; All events</a>
  </nav>
  <CountdownScript />
</article>

<style>
  /* One column for the whole article, centred — every block inside runs
     edge to edge of it. Previously each block set its own width (measure
     on the text, full container on images, fit-content on diagrams) and
     the page came out as a ragged stack of three different alignments.
     Wider than the bare reading measure so a diagram still has room. */
  .event-article {
    max-width: 46rem;
    padding-top: var(--space-5);
    padding-bottom: var(--space-5);
  }
  .event-article-header { max-width: none; }
  .event-article-meta { display: flex; align-items: center; gap: var(--space-2); margin: 0 0 var(--space-1); font-size: var(--step--1); color: var(--ink-faint); }
  .event-article-category { font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--accent, #1F5C4E); }
  .event-article-header h1 { margin: 0; }
  /* Clock time is data, like the date beside it. */
  .event-article-time {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }
  .event-article-details { margin: var(--space-1) 0 0; color: var(--ink-muted); }
  .event-article-organizer { color: var(--ink-faint); }

  .event-article-actions { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-3); }

  .event-article-ended {
    font-family: var(--font-mono);
    font-size: 0.92em;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--warn);
    background: var(--warn-bg);
    padding: 0.1em 0.5em;
    border-radius: 999px;
  }
  .event-article-outcome { margin-top: var(--space-4); }
  .event-article-outcome h2 { margin-bottom: 0; }

  .event-article-figure { margin: var(--space-4) 0 0; }
  .event-article-figure img { display: block; width: 100%; max-height: 60vh; object-fit: cover; background: var(--surface-sunk); border-radius: var(--radius); }
  /* See NewsArticle: a diagram is fitted whole, since cropping it loses
     data rather than scenery, and the figure shrinks to the picture so the
     caption sits under it rather than off to the left. */
  .figure-diagram img { object-fit: contain; background: transparent; height: auto; max-height: none; }

  .prose { margin-top: var(--space-4); max-width: none; }
  /* Justified, with hyphenation on. Justification without hyphens opens
     rivers of white space in a column this narrow — the two go together or
     not at all. */
  .prose p {
    /* The global `p, li` measure is 38rem; the article column is 46rem. Left
       in place it held every paragraph ~80px short of the figure above it,
       so the text looked inset from its own column. The column is the
       measure here. */
    max-width: none;
    text-align: justify;
    hyphens: auto;
    -webkit-hyphens: auto;
  }
  /* Justification needs room to distribute: on a phone the column is short
     enough that it opens rivers between words and hyphenates every other
     line. Ragged right is the better reading experience there. */
  @media (max-width: 640px) {
    .prose p { text-align: left; hyphens: manual; -webkit-hyphens: manual; }
  }
  /* Roughly one line of leading. At --space-2 the gap was half the
     line-height and paragraphs ran together. */
  .prose p + p { margin-top: var(--space-3); }
  .event-article-expertise p { color: var(--ink-muted); font-style: italic; }

  .locate { margin-top: var(--space-4); }
  .locate-map { margin-top: var(--space-2); border: 1px solid var(--border); }
  .locate-map iframe { display: block; width: 100%; height: clamp(300px, 34vw, 440px); border: 0; }

  .event-article-form { margin-top: var(--space-4); }

  .event-article-related { margin-top: var(--space-4); }


  .event-article-back { margin-top: var(--space-4); font-family: var(--font-mono); font-size: var(--step--1); }
  .event-article-back a { color: var(--ink-muted); text-decoration: none; }
  .event-article-back a:hover { color: var(--accent); }
</style>
