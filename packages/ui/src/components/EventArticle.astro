---
import ArticleBody from "./ArticleBody.astro";
import Photo from "./Photo.astro";
import { itemContext } from '../schema';
import type { Publisher } from '../schema';
// Detail page body for a single event — same block-only-when-present rule
// as NewsArticle.astro, plus the two things an event has that a news item
// doesn't: dates/venue/organizer in the header, and a ticket button right
// under it while intent is still fresh.
import type { EventItem, NewsItem } from "@dst/content/types";
import LeadForm from "./LeadForm.astro";
import VentureGrid from "./VentureGrid.astro";
import FeedCards from "./FeedCards.astro";
import SourceLine from "./SourceLine.astro";
import ImageNote from "./ImageNote.astro";
import CountdownScript from "./CountdownScript.astro";
import Glance from "./Glance.astro";
import { ICONS } from "../icons.ts";
import { formatDate } from "../date.ts";
import { withLabels, type ArticleLabels } from "../labels.ts";

interface Props {
  item: EventItem;
  backHref: string;
  ticketHref?: string; // resolved by the route to /go/<slug>/, not item.ticket.url directly
  /** Where to send a reader when there is no seller on file: the /go/ hop
      to the event's own source. Every event page should end its header with
      something to press — a page that answers "should I go?" and then
      offers no way to act on the answer has stopped halfway. */
  sourceHref?: string;
  /** The rest of the site's events, so an event page isn't a dead end: the
      only way on used to be the back link, since `related` is filled in by
      hand and most items don't have any. */
  more?: EventItem[];
  /** Fallback for a site with only one event, same reason as on the news
      side: an article has to end with somewhere to go. */
  moreNews?: NewsItem[];
  /** Where this site keeps its feed. Defaults to the English paths every
      DST host uses; a site publishing in another language passes its own
      ("/noticias/", "/eventos/") so its URLs are in the language of the
      words on the page. */
  newsBase?: string;
  eventsBase?: string;
  /** Who the article's own Article/Event block names as publisher. Defaults
      to DST like the rest of the graph; a site that publishes itself passes
      its own, or the block contradicts the page around it. */
  publisher?: Publisher;
  /** Locale for dates on this page. Defaults to the network's English;
      a site writing in another language passes its own. */
  locale?: string;
  /** The words this component puts on the page that don't come from the
      item — headings, glance labels, button text. English by default, so
      the eleven English sites pass nothing; a Spanish site passes its own
      set and its chrome stops contradicting its copy. */
  labels?: Partial<ArticleLabels>;
}
const { item, backHref, ticketHref, sourceHref, more = [], moreNews = [], newsBase = "/news/", eventsBase = "/events/", publisher, locale = "en-US", labels: labelOverrides } = Astro.props;
const L = withLabels(labelOverrides);

const todayIso = new Date().toISOString().slice(0, 10);
const moreCards = more
  .filter((other) => other.slug !== item.slug && Array.isArray(other.body) && other.body.length > 0)
  // What's still to come first, then past events most recent first.
  .sort((a, b) => {
    const aUp = a.start >= todayIso;
    const bUp = b.start >= todayIso;
    if (aUp !== bUp) return aUp ? -1 : 1;
    return aUp ? (a.start < b.start ? -1 : 1) : (a.start < b.start ? 1 : -1);
  })
  .slice(0, 3)
  .map((other) => ({
    href: `${eventsBase}${other.slug}/`,
    eyebrow: other.category,
    date: other.start,
    title: other.title,
    short: other.cardTitle,
    text: [other.venue, other.city].filter(Boolean).join(" · ") || other.summary,
    image: other.image,
    imageAlt: other.imageAlt,
    imageFit: "cover" as const,
    event: true,
    past: other.start < todayIso,
  }));

const newsCards = moreNews
  .filter((n) => Array.isArray(n.body) && n.body.length > 0)
  .sort((a, b) => (a.date < b.date ? 1 : -1))
  .slice(0, 3)
  .map((n) => ({
    href: `${newsBase}${n.slug}/`,
    eyebrow: n.category,
    date: n.date,
    title: n.title,
    short: n.cardTitle,
    text: n.summary,
    image: n.image,
    imageAlt: n.imageAlt,
  }));
const tail = moreCards.length > 0
  ? { heading: L.moreEvents, cards: moreCards }
  : newsCards.length > 0
    ? { heading: L.latestNews, cards: newsCards }
    : null;

// Schema.org takes a full timestamp when the clock time is known — a
// date-only startDate tells Google the day but not the hour, and event
// rich results lean on the hour.
const offset = item.utcOffset ?? "+04:00";
const stamp = (day: string, time?: string) => (time ? `${day}T${time}:00${offset}` : day);
const startStamp = stamp(item.start, item.startTime);
const endStamp = item.end || item.endTime ? stamp(item.end ?? item.start, item.endTime) : undefined;

// Absolute, because a crawler resolves a relative URL in JSON-LD against
// nothing in particular; and tied to the page's own graph, so the event
// has a named publisher instead of standing on its own.
const absolute = (url: string) => (Astro.site ? new URL(url, Astro.site).href : url);
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;

// How long the day runs, from the clock times rather than repeated by hand.
const duration = (() => {
  if (!item.startTime || !item.endTime || item.end) return undefined;
  const [sh, sm] = item.startTime.split(":").map(Number);
  const [eh, em] = item.endTime.split(":").map(Number);
  const minutes = eh * 60 + em - (sh * 60 + sm);
  if (!Number.isFinite(minutes) || minutes <= 0) return undefined;
  return L.durationValue(Math.floor(minutes / 60), minutes % 60);
})();

const currency = item.tickets?.currency ?? "AED";
const money = (amount: number) =>
  new Intl.NumberFormat(locale, { style: "currency", currency, maximumFractionDigits: 0 }).format(amount);
const price = (() => {
  const t = item.tickets;
  if (!t || t.priceFrom === undefined) return undefined;
  if (t.priceTo === undefined || t.priceTo === t.priceFrom) return money(t.priceFrom);
  return `${money(t.priceFrom)} – ${money(t.priceTo)}`;
})();

// The facts someone weighs before deciding, in the order they weigh them.
// Anything the organiser hasn't published is left out rather than filled
// with a placeholder — an empty row is worse than a shorter list.
const glance: { label: string; value: string; icon: string }[] = [
  item.startTime && {
    label: L.time,
    value: item.endTime ? `${item.startTime} – ${item.endTime}` : L.timeFrom(item.startTime),
    icon: ICONS.clock,
  },
  duration && { label: L.duration, value: duration, icon: ICONS.hourglass },
  { label: L.format, value: L.inPerson, icon: ICONS.users },
  (item.venue || item.city) && {
    label: L.where,
    value: [item.venue, item.city].filter(Boolean).join(", "),
    icon: ICONS.pin,
  },
  price && { label: L.ticketsRow, value: price, icon: ICONS.ticket },
  item.tickets?.salesEnd && {
    label: L.salesClose,
    value: formatDate(item.tickets.salesEnd, locale),
    icon: ICONS.events,
  },
  item.tickets?.refundPolicy && {
    label: L.refunds,
    value: item.tickets.refundPolicy,
    icon: ICONS.money,
  },
  item.organizer && { label: L.organizer, value: item.organizer, icon: ICONS.briefcase },
].filter(Boolean) as { label: string; value: string; icon: string }[];

// AggregateOffer when there's a range, plain Offer when there's one price —
// the two are not interchangeable in the spec, and a range submitted as an
// Offer is what makes a price disappear from the rich result.
const offers = (() => {
  if (!item.ticket || !ticketHref) return undefined;
  const url = absolute(ticketHref);
  const t = item.tickets;
  const validThrough = t?.salesEnd ? `${t.salesEnd}T23:59:59${offset}` : undefined;
  const common = {
    url,
    availability: "https://schema.org/InStock",
    ...(validThrough ? { validThrough } : {}),
  };
  if (t?.priceFrom === undefined) return { "@type": "Offer", ...common };
  if (t.priceTo === undefined || t.priceTo === t.priceFrom) {
    return { "@type": "Offer", price: t.priceFrom, priceCurrency: currency, ...common };
  }
  return {
    "@type": "AggregateOffer",
    lowPrice: t.priceFrom,
    highPrice: t.priceTo,
    priceCurrency: currency,
    ...common,
  };
})();

const jsonLd =
  item.jsonLd ??
  {
    "@context": "https://schema.org",
    "@type": "Event",
    name: item.title,
    description: item.summary,
    ...(canonicalUrl ? itemContext(canonicalUrl, publisher) : {}),
    ...(item.image ? { image: absolute(item.image) } : {}),
    startDate: startStamp,
    ...(endStamp ? { endDate: endStamp } : {}),
    eventStatus: "https://schema.org/EventScheduled",
    eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
    ...(item.venue || item.city
      ? {
          location: {
            "@type": "Place",
            name: item.venue ?? item.city,
            ...(item.geo
              ? { geo: { "@type": "GeoCoordinates", latitude: item.geo.lat, longitude: item.geo.lng } }
              : {}),
            ...(item.city ? { address: { "@type": "PostalAddress", addressLocality: item.city } } : {}),
          },
        }
      : {}),
    ...(item.organizer ? { organizer: { "@type": "Organization", name: item.organizer } } : {}),
    ...(offers ? { offers } : {}),
  };

// The primary button. A seller if we have one; failing that, the page the
// event was written from, which for most of these is the organiser's own
// site and is where a ticket would be sold if there is one to sell.
const action = (() => {
  if (item.ticket && ticketHref) return { href: ticketHref, label: item.ticket.label ?? L.register };
  if (sourceHref) return { href: sourceHref, label: L.tickets };
  return undefined;
})();

const relatedItems = (item.related ?? []).map((card) => ({
  href: card.href,
  title: card.title, // VentureGrid's anchor title attribute
  eyebrow: card.eyebrow ?? L.related,
  status: L.readMore,
  name: card.title,
  text: card.text,
  image: card.image,
  imageAlt: card.imageAlt,
  icon: card.image ? undefined : ICONS.link,
}));
---
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
<article class="container event-article">
  <header class="event-article-header">
    <p class="event-article-meta">
      {item.category && <span class="event-article-category">{item.category}</span>}
      <time datetime={startStamp}>{formatDate(item.start, locale)}</time>
      {item.end && <span>&ndash; <time datetime={endStamp}>{formatDate(item.end, locale)}</time></span>}
      {item.startTime && (
        <span class="event-article-time">
          {item.startTime}{item.endTime && <>&ndash;{item.endTime}</>}
        </span>
      )}
      {/* Revealed client-side once the last day has passed — a static build
          can't know, and a page still presenting a finished event as
          upcoming is the usual way these listings rot. */}
      <span class="event-article-ended" data-event-ended datetime={item.end ?? item.start} hidden>
        {L.ended}
      </span>
    </p>
    <h1>{item.title}</h1>
    {(item.venue || item.city || item.organizer) && (
      <p class="event-article-details">
        {[item.venue, item.city].filter(Boolean).join(", ")}
        {item.organizer && <span class="event-article-organizer"> &middot; {L.organizedBy} {item.organizer}</span>}
      </p>
    )}
  </header>

  <p class="event-article-actions">
    {action && (
      <a class="button" href={action.href} title={`${action.label} — ${item.title}`}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ICONS.ticket} /></svg>
        {action.label}
      </a>
    )}
    {/* Secondary to the ticket link, but present on every event: a plain
        .ics file, no account and no calendar service in between. */}
    <a class="button button-secondary" href={`${backHref}${item.slug}.ics`} download title={L.addToCalendarTitle(item.title)}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ICONS.events} /></svg>
      {L.addToCalendar}
    </a>
  </p>

  {item.image && (
    <figure class:list={["event-article-figure", { "figure-diagram": item.imageKind && item.imageKind !== "photo" }]}>
      <Photo
        src={item.image}
        alt={item.imageAlt ?? ""}
        narrow={item.imageNarrow}
        loading="eager"
        fetchpriority="high"
        sizes="(max-width: 46rem) 100vw, 46rem"
        width={item.imageWidth}
        height={item.imageHeight}
      />
      <ImageNote kind={item.imageKind} credit={item.imageCredit} labels={L.imageKinds} />
    </figure>
  )}

  <Glance facts={glance} />

  {/* Above the original description on purpose: once something has
      happened, what came of it is the news, and the announcement is
      background. */}
  {item.outcome && item.outcome.length > 0 && (
    <section class="event-article-outcome">
      <h2>{L.whatHappened}</h2>
      <div class="prose">
        {item.outcome.map((p) => <p set:html={p} />)}
      </div>
    </section>
  )}

  {/* A story that kept moving after we published it. Placed above the
      original piece because the new fact is the reason to be on the page,
      and the piece underneath is now the background to it. */}
  {item.updates && item.updates.length > 0 && (
    <section class="article-updates">
      <h2>{L.updates}</h2>
      <dl>
        {item.updates.map((u) => (
          <div class="article-update">
            <dt><time datetime={u.on}>{formatDate(u.on, locale)}</time></dt>
            <dd set:html={u.text} />
          </div>
        ))}
      </dl>
    </section>
  )}

  {item.body && item.body.length > 0 && (
    <ArticleBody blocks={item.body} />
  )}

  {item.programme && item.programme.length > 0 && (
    <section class="event-programme">
      <h2>{L.programme}</h2>
      <dl>
        {item.programme.map((track) => (
          <div class="event-programme-track">
            <dt>{track.heading}</dt>
            <dd set:html={track.text} />
          </div>
        ))}
      </dl>
    </section>
  )}

  {item.audience && item.audience.length > 0 && (
    <section class="event-audience">
      <h2>{L.whoItsFor}</h2>
      <ul>
        {item.audience.map((who) => <li>{who}</li>)}
      </ul>
    </section>
  )}

  {item.expertise && (
    <div class="prose event-article-expertise">
      <p set:html={item.expertise} />
    </div>
  )}

  {item.geo && (
    <section class="locate">
      <h2>{L.locate}</h2>
      <div class="locate-map">
        <iframe
          src={`https://www.openstreetmap.org/export/embed.html?bbox=${item.geo.lng - 0.02}%2C${item.geo.lat - 0.01}%2C${item.geo.lng + 0.02}%2C${item.geo.lat + 0.01}&layer=mapnik&marker=${item.geo.lat}%2C${item.geo.lng}`}
          loading="lazy"
          title={L.mapTitle(item.geo.name)}
        />
      </div>
    </section>
  )}

  {item.form && (
    <section class="event-article-form">
      {item.form.title && <h2>{item.form.title}</h2>}
      {item.form.description && <p>{item.form.description}</p>}
      <LeadForm formName={item.form.title} formDescription={item.form.description} submitLabel={item.form.submitLabel}>
        {Object.entries(item.form.meta ?? {}).map(([key, value]) => (
          <input type="hidden" name={`meta.${key}`} value={value} />
        ))}
      </LeadForm>
    </section>
  )}

  {relatedItems.length > 0 && (
    <section class="event-article-related">
      <h2>{L.related}</h2>
      <VentureGrid items={relatedItems} />
    </section>
  )}

  {item.source && <SourceLine source={item.source} locale={locale} labels={L} />}

  {tail && (
    <section class="event-article-more">
      <h2>{tail.heading}</h2>
      <FeedCards items={tail.cards} columns={tail.cards.length} locale={locale} labels={L} />
    </section>
  )}

  <nav class="event-article-back">
    <a href={backHref} title={L.allEvents}>&larr; {L.allEvents}</a>
  </nav>
  <CountdownScript />
</article>

<style>
  /* One column for the whole article, centred — every block inside runs
     edge to edge of it. Previously each block set its own width (measure
     on the text, full container on images, fit-content on diagrams) and
     the page came out as a ragged stack of three different alignments.
     Wider than the bare reading measure so a diagram still has room. */
  .event-article {
    max-width: 46rem;
    padding-top: var(--space-5);
    padding-bottom: var(--space-5);
  }
  .event-article-header { max-width: none; }
  /* Wraps as whole items. Without this the row squeezes each child instead,
     and on a phone "Nov 16, 2026" broke across three lines beside a clock
     time doing the same. */
  .event-article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem var(--space-2);
    margin: 0 0 var(--space-1);
    font-size: var(--step--1);
    color: var(--ink-faint);
  }
  .event-article-meta > * { white-space: nowrap; }
  .event-article-category { font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--accent, #1F5C4E); }
  .event-article-header h1 { margin: 0; }
  /* Clock time is data, like the date beside it. */
  .event-article-time {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }
  .event-article-details { margin: var(--space-1) 0 0; color: var(--ink-muted); }
  .event-article-organizer { color: var(--ink-faint); }

  .event-article-actions { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-3); }
  /* The buttons are laid out by the shared .button rule; this only puts the
     mark beside the label without disturbing its padding or height. */
  .event-article-actions .button {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
  }

  .event-article-ended {
    font-family: var(--font-mono);
    font-size: 0.92em;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--warn);
    background: var(--warn-bg);
    padding: 0.1em 0.5em;
    border-radius: 999px;
  }
  .event-article-outcome { margin-top: var(--space-4); }
  .event-article-outcome h2 { margin-bottom: 0; }

  .event-article-figure { margin: var(--space-4) 0 0; }
  .event-article-figure img { display: block; width: 100%; max-height: 60vh; object-fit: cover; background: var(--surface-sunk); border-radius: var(--radius); }
  /* See NewsArticle: a diagram is fitted whole, since cropping it loses
     data rather than scenery, and the figure shrinks to the picture so the
     caption sits under it rather than off to the left. */
  .figure-diagram img { object-fit: contain; background: transparent; height: auto; max-height: none; }

  .prose { margin-top: var(--space-4); max-width: none; }
  /* Justified, with hyphenation on. Justification without hyphens opens
     rivers of white space in a column this narrow — the two go together or
     not at all. */
  .prose p {
    /* The global `p, li` measure is 38rem; the article column is 46rem. Left
       in place it held every paragraph ~80px short of the figure above it,
       so the text looked inset from its own column. The column is the
       measure here. */
    max-width: none;
    text-align: justify;
    hyphens: auto;
    -webkit-hyphens: auto;
  }
  /* Justification needs room to distribute: on a phone the column is short
     enough that it opens rivers between words and hyphenates every other
     line. Ragged right is the better reading experience there. */
  @media (max-width: 640px) {
    .prose p { text-align: left; hyphens: manual; -webkit-hyphens: manual; }
  }
  /* Roughly one line of leading. At --space-2 the gap was half the
     line-height and paragraphs ran together. */
  .prose p + p { margin-top: var(--space-3); }
  .event-article-expertise p { color: var(--ink-muted); font-style: italic; }

  /* The decision panel: two columns on anything wider than a phone, label
     over value below that. Rows rather than a bare <dl> grid so a value
     that wraps stays aligned with its own label. */
  .event-programme { margin-top: var(--space-4); }
  .event-programme dl { margin: var(--space-2) 0 0; display: grid; gap: var(--space-3); }
  .event-programme dt { font-weight: 600; color: var(--ink); }
  .event-programme dd { margin: 0.35rem 0 0; color: var(--ink-muted); max-width: none; }

  .event-audience { margin-top: var(--space-4); }
  /* Tags, not a bulleted list: these are parallel labels, and a column of
     bullets makes eight short phrases look like eight paragraphs. */
  .event-audience ul {
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }
  .event-audience li {
    max-width: none;
    padding: 0.25em 0.7em;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .locate { margin-top: var(--space-4); }
  .locate-map { margin-top: var(--space-2); border: 1px solid var(--border); }
  .locate-map iframe { display: block; width: 100%; height: clamp(300px, 34vw, 440px); border: 0; }

  .event-article-form { margin-top: var(--space-4); }

  .event-article-related { margin-top: var(--space-4); }
  .event-article-more { margin-top: var(--space-5); }


  .event-article-back { margin-top: var(--space-4); font-family: var(--font-mono); font-size: var(--step--1); }
  /* A tap target, not just a line of text: 44px is the smallest a finger
     reliably hits, and this is the main way back to the feed. */
  .event-article-back a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-right: var(--space-2);
    color: var(--ink-muted);
    text-decoration: none;
  }
  .event-article-back a:hover { color: var(--accent); }

  .article-updates { margin-top: var(--space-4); }
  .article-updates dl { margin: var(--space-2) 0 0; display: grid; gap: var(--space-3); }
  /* The date is the point of the row, so it leads the line rather than
     sitting under it: a reader scanning for what is new reads down the
     dates, not down the sentences. */
  .article-update dt { font-family: var(--font-mono); font-size: var(--step--1); color: var(--ink-muted); }
  .article-update dd { margin: 0.25rem 0 0; max-width: 46rem; }
</style>
