---
// Compact ~3-item embed for homepages (TODO 41/42). Renders nothing at all
// when the feed is empty — that's the actual mechanism behind "show a news
// block when there's news" (TODO 40): no empty section, no placeholder.
//
// Cards, and a section heading at the same size as every other section's.
// It used to be a date-and-headline list under a utility-sized heading, on
// the theory that a summary strip shouldn't announce itself as a chapter.
// In place that read as a thin shelf between two heavy sections, and the
// heading looked like a label rather than a peer of "Hubs".
import type { NewsItem } from "@dst/content/types";
import FeedCards from "./FeedCards.astro";

interface Props {
  items: NewsItem[];
  limit?: number;
  heading?: string;
}
const { items, limit = 3, heading = "News" } = Astro.props;
// A photograph fills its cover; a diagram is fitted whole. Unmarked images
// are fitted too — that is the safe way round, since a cropped chart loses
// the numbers while a fitted photo only sits in a slightly smaller box.
const fitFor = (kind?: string) => (kind === "photo" || kind === "render" || kind === "generated" ? "cover" : "contain") as "cover" | "contain";
const latest = [...items].sort((a, b) => (a.date < b.date ? 1 : a.date > b.date ? -1 : 0)).slice(0, limit);

const cards = latest.map((item) => {
  const hasPage = Array.isArray(item.body) && item.body.length > 0;
  return {
    href: hasPage ? `/news/${item.slug}/` : undefined,
    eyebrow: item.category,
    date: item.date,
    title: item.title,
    text: item.summary,
    image: item.image,
    imageAlt: item.imageAlt,
    imageFit: fitFor(item.imageKind),
  };
});
---
{cards.length > 0 && (
  <section class="container news-block">
    <div class="news-block-head">
      <h2>{heading}</h2>
      <a class="news-block-all" href="/news/" title="All news">All news &rarr;</a>
    </div>
    <FeedCards items={cards} columns={cards.length} />
  </section>
)}

<style>
  /* The h2 in the head row drops the margin-top that separates one section
     from the next, so that it sits on the link's baseline. Put that spacing
     back on the section itself. */
  .news-block { margin-top: var(--space-5); }
  /* wrap, and a heading that may grow but not be squeezed: with the link
     held at its full width beside it, a multi-word heading on a phone was
     compressed into a 6rem column and broke onto five lines. Short of room,
     the link drops to its own line instead. */
  .news-block-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
  }
  .news-block-head h2 { margin: 0; flex: 1 1 22rem; }
  /* inline-flex + min-height: on a phone this was a 24px-tall target sitting
     beside a heading, well under the 44px below which taps start landing on
     whatever is next to them. The box grows, the text stays put. */
  .news-block-all {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    flex-shrink: 0;
    font-size: var(--step--1);
    font-weight: 600;
    text-decoration: none;
  }
</style>
