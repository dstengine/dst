---
// A bare outbound hop for /go/<slug>/ routes. Deliberately renders no site
// chrome: this is a redirect, not a page. It carries noindex/nofollow, and
// /go/ is disallowed in robots.txt, so third-party destinations collect no
// link equity from our pages and the hops themselves never get indexed.
//
// Static hosting can't issue a 3xx from a generated page, so this uses the
// standard belt-and-braces pair — a meta refresh for clients with no JS,
// and location.replace() so the hop doesn't land in browser history.
//
// The words are the page's own: a hop on a site that is not in English says
// so in the site's language. The defaults are the English page every hop
// printed before, so a site that passes nothing is unchanged. The default
// slot is the paragraph a reader sees if neither the refresh nor the script
// moves them, by default "Redirecting to <link>."; a slot keeps the link as
// it is, since rel="nofollow noopener external" is what
// tests/outbound-links.test.js holds every hop to. The slot hugs its
// paragraph: whitespace around it would print into every hop's bytes.
//
// A hop to a box office leaves with UTM tags (../utm.ts), so the seller
// sees which site and event sent the buyer. Which hops those are is read
// off the slug unless the page says: `ticket` overrides it, and a page that
// writes its own slot tags its own link with tagTicketUrl and passes the
// tagged `to` (fest's hops, which know their kind).
import { isTicketHop, tagTicketUrl } from "../utm";

interface Props {
  to: string;
  /** `<html lang>`. Defaults to "en". */
  lang?: string;
  /** The tab's title while the hop runs. Defaults to "Redirecting". */
  title?: string;
  /** Whether the hop leads to a box office. Defaults to its slug's shape. */
  ticket?: boolean;
}

const { to: target, lang = "en", title = "Redirecting", ticket } = Astro.props;
const slug = Astro.params.slug;
const to = (ticket ?? isTicketHop(slug)) ? tagTicketUrl(target, { campaign: slug, host: Astro.site?.hostname }) : target;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <title>{title}</title>
    <link rel="icon" href="data:," />
  </head>
  <body>
    <slot><p>
      Redirecting to <a href={to} rel="nofollow noopener external">{to}</a>.
    </p></slot>
    <script is:inline define:vars={{ to }}>
      location.replace(to);
    </script>
  </body>
</html>
