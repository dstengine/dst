---
// The body of a section page. A section is a slice of the site's whole
// feed, and a site's feed is two feeds — what is on, and what happened —
// so a slice of it can hold either or both. "Theatre" on nyc42 is nine
// shows and two articles about them, and splitting that across two thin
// pages would be splitting one subject to suit our own filing.
//
// The two headings only appear when both halves do. With one list on the
// page the h1 has already named it, and a subheading repeating the h1 is a
// line of furniture.
import type { EventItem, NewsItem } from "@dst/content/types";
import type { FeedItem, Headings } from "@dst/content/sections";
import EventsList from "./EventsList.astro";
import NewsList from "./NewsList.astro";
import { withLabels, type ArticleLabels } from "../labels.ts";

interface Props {
  items: FeedItem[];
  eventsBase?: string;
  newsBase?: string;
  locale?: string;
  labels?: Partial<ArticleLabels>;
  /**
   * The words over the two halves of the feed, and over the two groups of
   * dates inside the events half.
   *
   * They default from `labels`, because a site that publishes in Spanish has
   * already said so once and should not have to say it again per page:
   * /dia-de-muertos/ was the first mxo section to hold events and news at
   * once, and it published "Events" and "Upcoming" over Spanish cards until
   * this defaulted.
   *
   * A section may then override any of them from its own `copy` in
   * sections.ts — see `Headings` in @dst/content/sections. That is worth
   * doing where the subject is searched for by name: "Eventos" is our filing
   * label, and the reader arrived asking something more specific. A heading
   * given here is drawn even when only one half of the feed is on the page,
   * since a page that named its own heading meant it.
   */
  headings?: Headings;
}
const {
  items,
  eventsBase,
  newsBase,
  locale,
  labels,
  headings = {},
} = Astro.props;

const L = withLabels(labels);
// The overrides reach the events list the same way every other word does —
// as labels — so EventsList needs to know nothing about sections.
const eventLabels = {
  ...labels,
  ...(headings.upcoming ? { upcoming: headings.upcoming } : {}),
  ...(headings.past ? { pastGroup: headings.past } : {}),
};

// An event carries a start date and a news item does not; that is the whole
// of the difference the page needs to know about.
const events = items.filter((i): i is EventItem => "start" in i);
const news = items.filter((i): i is NewsItem => !("start" in i));
const both = events.length > 0 && news.length > 0;
---
{events.length > 0 && (
  <>
    {(both || headings.events) && (
      <h2 class="section-feed-heading">{headings.events ?? L.eventsHeading}</h2>
    )}
    <EventsList items={events} eventsBase={eventsBase} locale={locale} labels={eventLabels} />
  </>
)}
{news.length > 0 && (
  <>
    {(both || headings.news) && (
      <h2 class="section-feed-heading">{headings.news ?? L.newsHeading}</h2>
    )}
    <NewsList items={news} newsBase={newsBase} locale={locale} />
  </>
)}

<style>
  /* Space above, not below: the heading belongs to the list under it, and
     the gap that separates the two halves of the page is the one over the
     second heading. */
  .section-feed-heading {
    margin: 2.5rem 0 1rem;
  }
  .section-feed-heading:first-child {
    margin-top: 0;
  }
</style>
