---
// Compact ~3-item embed for homepages (TODO 41/42) — the events counterpart
// of NewsBlock.astro. Shows only upcoming events; renders nothing when
// there are none, same "show it only when there's something to show" rule.
//
// Same cards as the news block, with one difference that matters: a news
// item's date is a filing stamp, an event's date is the whole point, so the
// card leads with the date as its cover and carries a countdown.
import type { EventItem } from "@dst/content/types";
import FeedCards from "./FeedCards.astro";
import CountdownScript from "./CountdownScript.astro";

interface Props {
  items: EventItem[];
  limit?: number;
  heading?: string;
  /** Where this site keeps its feed. Defaults to the English paths every
      DST host uses; a site publishing in another language passes its own
      ("/noticias/", "/eventos/") so its URLs are in the language of the
      words on the page. */
  eventsBase?: string;
  /** Wording for the see-all link, for a site not writing in English. */
  allLabel?: string;
  /** Locale for dates on this page. Defaults to the network's English;
      a site writing in another language passes its own. */
  locale?: string;
}
const { items, limit = 3, heading = "Events", eventsBase = "/events/", allLabel = "All events", locale } = Astro.props;
// A `nav` slot sits between the head row and the cards: a site whose
// calendar is cut into sections puts that row of links here, so the front
// page offers the same way in as the calendar does. Empty on every site
// that has no such row, which is why it is a slot and not a prop — the
// block should not know what a section is.
const todayIso = new Date().toISOString().slice(0, 10);
// Same order as the full listing at /events/ — date, ascending, and nothing
// else. A front page that led with the biggest while the listing it links to
// led with the next thing would be two answers to one question; both now
// answer the only question a calendar is asked, which is what is next. See
// EventsList for why the `featured` rank stopped moving events.
const upcoming = items
  .filter((e) => e.start >= todayIso)
  .sort((a, b) => (a.start < b.start ? -1 : a.start > b.start ? 1 : 0))
  .slice(0, limit);

const cards = upcoming.map((item) => {
  const hasPage = Array.isArray(item.body) && item.body.length > 0;
  return {
    href: hasPage ? `${eventsBase}${item.slug}/` : undefined,
    eyebrow: item.category,
    date: item.start,
    title: item.title,
    short: item.cardTitle,
    text: [item.venue, item.city].filter(Boolean).join(" · ") || item.summary,
    // An event with a picture of its own shows it; the rest keep the date
    // cover, which for an event is the thing being decided about anyway.
    image: item.image,
    imageAlt: item.imageAlt,
    imageFit: "cover" as const,
    event: true,
  };
});
---
{cards.length > 0 && (
  <section class="container events-block">
    <div class="events-block-head">
      <h2>{heading}</h2>
      <a class="events-block-all" href={eventsBase} title={allLabel}>{allLabel}<span class="events-block-arrow" aria-hidden="true"> &rarr;</span></a>
    </div>
    <slot name="nav" />
    <FeedCards items={cards} columns={cards.length} locale={locale} />
    <CountdownScript />
  </section>
)}

<style>
  /* See NewsBlock: the head row zeroes the h2's margin for baseline
     alignment, so the section carries the inter-section spacing instead. */
  .events-block { margin-top: var(--space-5); }
  /* wrap, and a heading that may grow but not be squeezed: with the link
     held at its full width beside it, a multi-word heading on a phone was
     compressed into a 6rem column and broke onto five lines. Short of room,
     the link drops to its own line instead. */
  .events-block-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
  }
  .events-block-head h2 { margin: 0; flex: 1 1 22rem; }
  .events-block-all {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    flex-shrink: 0;
    font-size: var(--step--1);
    font-weight: 600;
    text-decoration: none;
  }

  /* Below this width the head row wraps and the link lands on a line of its
     own, where a short phrase in accent colour reads as a stray caption
     rather than the way on to the rest of the feed. The basis is set here
     rather than left to the wrap, so the breakpoint and the wrap are the
     same number and the link is never a button on a line it shares with the
     heading. Outlined, not filled: this is navigation, and a solid accent
     button here would outrank the page's actual calls to action. */
  @media (max-width: 34rem) {
    .events-block-all {
      flex: 1 0 100%;
      justify-content: center;
      padding: 0.7em 1.3em;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: transparent;
    }
    .events-block-all:where(:hover, :focus-visible) {
      background: var(--surface-sunk);
      text-decoration: none;
    }
    /* The arrow was doing the work of saying "this leads somewhere". The
       button shape says it already, and an arrow inside a button reads as a
       second, different control. */
    .events-block-arrow { display: none; }
  }
</style>
