---
// Body of /news/ across the network. The same cards as the blocks on a front
// page and the feed under an article: one format for a feed item everywhere it
// appears, so the listing isn't a weaker version of the block that linked to
// it. An item only links to its own page when it has a `body` — a thin item
// with no detail page renders as a self-contained card instead (rule 7 in the
// news/events spec).
import type { NewsItem } from "@dst/content/types";
import FeedCards from "./FeedCards.astro";

interface Props {
  items: NewsItem[];
  /** Where this site keeps its feed. Defaults to the English paths every
      DST host uses; a site publishing in another language passes its own
      ("/noticias/", "/eventos/") so its URLs are in the language of the
      words on the page. */
  newsBase?: string;
  /** Locale for dates on this page. Defaults to the network's English;
      a site writing in another language passes its own. */
  locale?: string;
}
const { items, newsBase = "/news/", locale } = Astro.props;
// A photograph fills its cover; a diagram is fitted whole. Unmarked images
// are fitted too — that is the safe way round, since a cropped chart loses
// the numbers while a fitted photo only sits in a slightly smaller box.
const fitFor = (kind?: string) => (kind === "photo" || kind === "render" || kind === "generated" ? "cover" : "contain") as "cover" | "contain";
// Ranked items lead, then the rest newest-first. `featured` is a rank, not
// a flag: 1 is the story to lead with, and only a handful on a site carry a
// number — a feed where everything is promoted promotes nothing. Same
// comparator as EventsList, so the front page and the listing agree.
const byRankThenDate = (a: NewsItem, b: NewsItem) => {
  if (a.featured !== b.featured) {
    if (a.featured === undefined) return 1;
    if (b.featured === undefined) return -1;
    return a.featured - b.featured;
  }
  return a.date < b.date ? 1 : a.date > b.date ? -1 : 0;
};
const sorted = [...items].sort(byRankThenDate);
const cards = sorted.map((item) => {
  const hasPage = Array.isArray(item.body) && item.body.length > 0;
  return {
    href: hasPage ? `${newsBase}${item.slug}/` : undefined,
    eyebrow: item.category,
    date: item.date,
    title: item.title,
    text: item.summary,
    image: item.image,
    imageAlt: item.imageAlt,
    imageFit: fitFor(item.imageKind),
  };
});
---
{/* Two or fewer cards get their column count pinned, the way the front-page
    blocks already do: left to auto-fill they sit in the first two tracks of a
    four-track row and leave half the page empty. Three or more fill the row on
    their own. */}
{cards.length > 0 && <FeedCards items={cards} columns={cards.length <= 2 ? cards.length : undefined} locale={locale} />}
