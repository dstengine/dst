---
// Body of /news/ across the network. The same cards as the blocks on a front
// page and the feed under an article: one format for a feed item everywhere it
// appears, so the listing isn't a weaker version of the block that linked to
// it. An item only links to its own page when it has a `body` — a thin item
// with no detail page renders as a self-contained card instead (rule 7 in the
// news/events spec).
import type { NewsItem } from "@dst/content/types";
import FeedCards from "./FeedCards.astro";

interface Props {
  items: NewsItem[];
}
const { items } = Astro.props;
// A photograph fills its cover; a diagram is fitted whole. Unmarked images
// are fitted too — that is the safe way round, since a cropped chart loses
// the numbers while a fitted photo only sits in a slightly smaller box.
const fitFor = (kind?: string) => (kind === "photo" || kind === "render" || kind === "generated" ? "cover" : "contain") as "cover" | "contain";
const sorted = [...items].sort((a, b) => (a.date < b.date ? 1 : a.date > b.date ? -1 : 0));
const cards = sorted.map((item) => {
  const hasPage = Array.isArray(item.body) && item.body.length > 0;
  return {
    href: hasPage ? `/news/${item.slug}/` : undefined,
    eyebrow: item.category,
    date: item.date,
    title: item.title,
    text: item.summary,
    image: item.image,
    imageAlt: item.imageAlt,
    imageFit: fitFor(item.imageKind),
  };
});
---
{cards.length > 0 && <FeedCards items={cards} />}
