---
import Photo from "./Photo.astro";
import { ICONS } from "../icons";
// Extracted 1:1 from the dst.llc hub grid — same markup, same class names,
// same CSS. It stayed frozen so no other site could drag the hub's own grid
// around by accident. The column cap below is the first deliberate change to
// it: the markup is still identical, and the hub's five cards no longer come
// out as four and a stray.
export interface VentureCardItem {
  href?: string;
  title?: string;
  eyebrow: string;
  /** Optional: a card that has nothing to badge renders no pill at all.
   * An empty one still painted its background and read as a clipped stub. */
  status?: string;
  inProgress?: boolean;
  name: string;
  text: string;
  image?: string;
  imageAlt?: string;
  icon?: string;
  /** A fact line under the text, set off by a rule: dates, a place, a price.
      Cards that don't pass one look exactly as they did. */
  meta?: string;
}
interface Props {
  items: VentureCardItem[];
  /** Pin the column count at desktop widths, when the caller knows its own
      card count and auto-fill would leave one card alone on the last row. */
  columns?: number;
  /** Put the card's name on the photograph instead of under it.

      For grids that sit at the fold, where a card cropped in half shows a
      picture and nothing that says what the picture is of. The heading
      moves — it is not repeated — so there is still one h3 per card. Only
      for grids whose images are photographs with room at the bottom; on the
      mark cover the name falls back to the body, where it has contrast. */
  labelOnMedia?: boolean;
}
const { items, columns, labelOnMedia = false } = Astro.props;
const metaIcon = ICONS.events;
---
<div class:list={["venture-grid", columns && "venture-grid-pinned"]} style={columns ? `--venture-columns: ${columns}` : undefined}>
  {items.map((item) => {
    const Tag = item.href ? "a" : "article";
    return (
      <Tag class="venture" href={item.href} title={item.title}>
        <div class:list={["venture-media", !item.image && "mark-cover"]}>
          {item.image ? (
            <>
              <Photo src={item.image} alt={item.imageAlt ?? ""} sizes="(max-width: 700px) 100vw, 420px" />
              {labelOnMedia && <h3 class="venture-media-name">{item.name}</h3>}
            </>
          ) : (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={item.icon} />
            </svg>
          )}
        </div>
        <div class="venture-body">
          <div class="venture-meta">
            <p class="eyebrow">{item.eyebrow}</p>
            {item.status && (
              <span class:list={["venture-status", { "venture-status-progress": item.inProgress }]}>{item.status}</span>
            )}
          </div>
          {!(labelOnMedia && item.image) && <h3>{item.name}</h3>}
          <p>{item.text}</p>
          {item.meta && (
            <p class="venture-fact">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={metaIcon} /></svg>
              <span>{item.meta}</span>
            </p>
          )}
        </div>
      </Tag>
    );
  })}
  <slot />
</div>

<style>
  .venture-grid {
    display: grid;
    /* auto-fill, not auto-fit: auto-fit collapses columns nothing is ever
       placed in and hands their space to the remaining 1fr tracks — fine
       with dst.llc's five cards (every column gets used somewhere), but a
       sparse grid (a lone eco portfolio entry) would have its one or two
       used columns balloon to fill the row. auto-fill keeps the full
       column count computed from the 260px minimum either way, so a
       card's width doesn't depend on how many other cards exist. */
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  /* An orphan is a card sitting alone on the last row. At desktop widths the
     260px minimum gave four columns, so the hub's five cards came out 4 + 1
     and the fifth read as an afterthought rather than a peer. A caller that
     pins its column count gets a deterministic layout at every width instead:
     three across on desktop, two on a tablet with a lone last card widened to
     span both, one on a phone. Callers that don't pin keep auto-fill, which is
     the right answer when the card count isn't known up front. */
  @media (min-width: 560px) and (max-width: 759px) {
    .venture-grid-pinned { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .venture-grid-pinned > :last-child:nth-child(odd) { grid-column: span 2; }
  }
  @media (min-width: 760px) {
    .venture-grid {
      /* The pinned minimum is 0: the caller has taken responsibility for the
         count, and a 260px floor would push three columns past a 768px screen. */
      grid-template-columns: repeat(var(--venture-columns, auto-fill), minmax(var(--venture-min, 260px), 1fr));
    }
    .venture-grid-pinned { --venture-min: 0; }
  }
  .venture {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
    transition: border-color 200ms ease, transform 200ms ease;
  }
  a.venture:hover { border-color: var(--accent, #1F5C4E); transform: translateY(-2px); }

  .venture-media {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }
  /* The photograph's own backdrop. Excluded on .mark-cover, which brings the
     shared no-photo cover from tokens.css — scoped styles load after that
     file, so without the exclusion this would quietly win and grey it out. */
  .venture-media:not(.mark-cover) {
    background: linear-gradient(140deg, var(--surface-sunk), var(--surface));
  }
  .venture-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease;
  }
  a.venture:hover .venture-media img { transform: scale(1.03); }
  /* The no-photograph cover is .mark-cover in tokens.css — every card grid
     in the network shares it, so a site without licensed photography looks
     the same wherever its cards appear. */

  .venture-body { padding: var(--space-3); }
  .venture-meta { display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); }
  .venture-meta .eyebrow { margin: 0; }
  .venture-status {
    flex-shrink: 0;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ok);
    background: var(--ok-bg);
    padding: 0.15em 0.6em;
    border-radius: 999px;
  }
  .venture-status-progress { color: var(--warn); background: var(--warn-bg); }
  .venture h3 { margin-top: var(--space-2); margin-bottom: var(--space-1); font-size: var(--step-1); font-weight: 600; }
  .venture-body p { margin: 0; font-size: var(--step--1); color: var(--ink-muted); }
  .venture-body .venture-fact {
    display: flex;
    align-items: center;
    gap: 0.45em;
    margin-top: var(--space-2);
    padding-top: var(--space-2);
    border-top: 1px solid var(--border);
    color: var(--ink-faint);
  }
  .venture-fact svg { width: 15px; height: 15px; flex-shrink: 0; color: var(--accent); }

  /* The name on the photograph. The scrim is sized for the worst case these
     grids actually contain — a white sky or a floodlit facade filling the
     bottom of the frame — not for an average picture, which is how text over
     an image gets shipped unreadable. Solid at the base, gone by 60%, so the
     top of the photograph is untouched. */
  .venture-media-name {
    position: absolute;
    inset: auto 0 0;
    margin: 0;
    padding: 2.5em var(--space-3) var(--space-3);
    color: #FFFFFF;
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1.15;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6);
    background: linear-gradient(to top, rgba(8, 10, 13, 0.92), rgba(8, 10, 13, 0.72) 45%, rgba(8, 10, 13, 0) 100%);
    pointer-events: none;
  }
</style>
