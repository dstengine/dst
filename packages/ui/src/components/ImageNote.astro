---
// Says whether a picture is evidence or an impression, in the visible
// caption rather than only in the alt text.
//
// This market runs the other way: developer renders are presented as
// photographs of buildings that do not exist yet, and the reader is left
// to guess. Naming it costs one line. The alt text already carried this
// on some images — but only a screen reader ever saw it.
import type { ImageKind } from "@dst/content/types";

interface Props {
  kind?: ImageKind;
  credit?: string;
  /** Caption text, when the picture also needs describing. */
  caption?: string;
}
const { kind, credit, caption } = Astro.props;

// The word alone carries it: "Render" already means "not a photograph",
// and spelling that out reads as an apology for the picture. `generated`
// gets no label at all — how the image was produced is our business, not a
// caption on the page.
const LABELS: Partial<Record<ImageKind, string>> = {
  photo: "Photograph",
  diagram: "Diagram",
  illustration: "Illustration",
  render: "Render",
};
const label = kind ? LABELS[kind] : undefined;
const show = Boolean(caption || label || credit);
---
{show && (
  <figcaption class="image-note">
    {caption && <span class="image-note-caption">{caption}</span>}
    {label && (
      <span class:list={["image-note-kind", { "image-note-kind-warn": kind !== "photo" }]}>{label}</span>
    )}
    {label && credit && <span class="image-note-sep" aria-hidden="true">·</span>}
    {credit && <span class="image-note-credit">{credit}</span>}
  </figcaption>
)}

<style>
  .image-note {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5em var(--space-2);
    margin-top: var(--space-2);
    font-size: var(--step--1);
    line-height: 1.5;
    color: var(--ink-faint);
  }
  .image-note-caption { color: var(--ink-muted); }
  /* Without a mark between them, "Illustration" and the credit read as one
     phrase with a stray double space. */
  .image-note-sep { color: var(--border); }
  .image-note-kind {
    font-family: var(--font-mono);
    font-size: 0.92em;
    letter-spacing: 0.02em;
  }
  /* A picture that isn't a photograph is the case worth noticing, so it
     gets the flag colour rather than blending into the caption. */
  .image-note-kind-warn { color: var(--warn); }
</style>
