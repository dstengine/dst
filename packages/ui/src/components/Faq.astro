---
// Renders an FAQ block as plain accordion markup (zero JS — native <details>)
// and emits matching FAQPage JSON-LD at build time, at zero runtime cost.
// `a` may contain a small set of inline tags (<strong>, <em>) — Google's
// FAQPage guidelines explicitly allow that subset in the answer text, so it
// goes into the JSON-LD as-is rather than being stripped to plain text.
//
// `text`, when a site gives it, is what the JSON-LD carries instead: the
// same answer as words alone. For answers whose markup belongs to the page
// and means nothing off it: a link relative to the page (fest.one points a
// reader to the guide's other pages from inside an answer) or a span the
// stylesheet keeps on one line. The accordion still prints `a`. Without
// `text`, `a` goes in as before.
//
// `generic` marks an answer that is the same wherever it appears: a site-wide
// policy, a disclaimer, anything already said in the footer. Those still show
// on the page — a reader asking the question deserves the answer where they
// are — but they are kept out of the markup. Structured data is a claim about
// *this* page, and the identical claim repeated across sixty pages is what a
// search engine reads as a template rather than as an answer. A block whose
// answers are all generic emits no FAQPage at all.
interface QA { q: string; a: string; text?: string; generic?: boolean }
interface Props { items: QA[] }

const { items } = Astro.props;

const specific = items.filter((item) => !item.generic);
const jsonLd = specific.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: specific.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.text ?? item.a },
  })),
} : null;
---
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
<div class="faq">
  {items.map((item) => (
    <details class="faq-item">
      <summary>{item.q}</summary>
      <p set:html={item.a} />
    </details>
  ))}
</div>

<style>
  .faq { display: flex; flex-direction: column; gap: var(--space-1); margin: var(--space-3) 0; }
  /* The box draws the row and the summary inside it is what toggles, so the
     padding lives on the summary and the answer rather than here. Padding on
     the box was a band around the question that looked tappable and opened
     nothing: on a one-line question only the middle 29px worked. */
  .faq-item {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .faq-item summary {
    font-weight: 600;
    cursor: pointer;
    font-size: var(--step-0);
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    /* The box's old padding, so the whole visible row is the target: 57px
       for one line. 44px is the floor the network tests for, written down
       in case a token ever shrinks the line. The inner radius keeps the
       focus ring and the tap highlight, which now cover the row, inside
       the box's rounded corners. */
    padding: var(--space-2) var(--space-3);
    min-height: 44px;
    border-radius: calc(var(--radius) - 1px);
  }
  /* Native <details> markers differ by browser (a filled triangle in some,
     nothing styleable in others) and don't take an open/closed transition.
     A hand-drawn chevron reads the same everywhere and animates on toggle. */
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::marker { content: ""; }
  .faq-item summary::after {
    content: "";
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    border-right: 2px solid var(--ink-muted);
    border-bottom: 2px solid var(--ink-muted);
    transform: rotate(45deg);
    transition: transform 150ms ease;
  }
  .faq-item[open] summary::after { transform: rotate(-135deg); }
  /* Open, the summary keeps 8px under the question for the answer's gap, so
     the question and its chevron stay put when the row opens. */
  .faq-item[open] summary { padding-bottom: var(--space-1); }
  /* Margin, not padding: the global cap on paragraphs, `max-width:
     var(--measure)`, measures the border box, so side padding would narrow
     every answer from 38rem to 35rem on a wide screen and re-wrap it. The
     box's 1px border keeps the bottom margin inside the box. */
  .faq-item p { margin: 0 var(--space-3) var(--space-2); color: var(--ink-muted); }
</style>
