---
// Renders an FAQ block as plain accordion markup (zero JS — native <details>)
// and emits matching FAQPage JSON-LD at build time, at zero runtime cost.
interface QA { q: string; a: string }
interface Props { items: QA[] }

const { items } = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
<div class="faq">
  {items.map((item) => (
    <details class="faq-item">
      <summary>{item.q}</summary>
      <p>{item.a}</p>
    </details>
  ))}
</div>

<style>
  .faq { display: flex; flex-direction: column; gap: var(--space-1); margin: var(--space-3) 0; }
  .faq-item {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-2) var(--space-3);
    background: var(--surface);
  }
  .faq-item summary {
    font-weight: 600;
    cursor: pointer;
    font-size: var(--step-0);
  }
  .faq-item p { margin: var(--space-1) 0 0; color: var(--ink-muted); }
</style>
