---
/* Light and dark. Two states in the control, three in the data: until the
   reader touches it there is no stored choice and no `data-theme`, so the
   page follows their own system setting — including if the system flips
   while the page is open. The first click ends that and stores a choice.

   No "system" position in the cycle on purpose: it is a state the reader
   already has by default and does not have to be told about, and a third
   icon on a control this small asks a question nobody was asking.

   The script that stamps the stored choice is inline in the head, not here:
   it has to run before the first paint or the page flashes the wrong theme.
   See BaseLayout. This component only draws the control and the click. */
---
<button id="theme-toggle" class="theme-toggle" type="button" hidden>
  <svg class="theme-icon theme-icon-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4.2" /><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M19.1 4.9l-1.8 1.8M6.7 17.3l-1.8 1.8" />
  </svg>
  <svg class="theme-icon theme-icon-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" />
  </svg>
</button>

<script is:inline>
  (() => {
    const btn = document.getElementById("theme-toggle");
    if (!btn) return;
    // Only offer the control once we know the script runs: with JS off the
    // page still renders in the reader's own theme, and a dead button would
    // be worse than no button.
    btn.hidden = false;

    const system = window.matchMedia("(prefers-color-scheme: dark)");

    const stored = () => {
      try {
        const v = localStorage.getItem("theme");
        return v === "light" || v === "dark" ? v : null;
      } catch { return null; }
    };

    // What the reader is actually looking at, whoever decided it.
    const current = () => stored() ?? (system.matches ? "dark" : "light");

    const draw = () => {
      const mode = current();
      btn.dataset.mode = mode;
      const next = mode === "dark" ? "light" : "dark";
      btn.setAttribute("aria-label", `Switch to ${next} theme`);
      btn.title = `Switch to ${next} theme`;
    };

    draw();
    // While nothing is stored the page is following the system, so the icon
    // has to follow it too — otherwise a reader whose machine switches at
    // sunset is looking at a sun on a dark page.
    system.addEventListener("change", () => { if (!stored()) draw(); });

    btn.addEventListener("click", () => {
      const next = current() === "dark" ? "light" : "dark";
      document.documentElement.setAttribute("data-theme", next);
      try { localStorage.setItem("theme", next); }
      catch { /* private mode: the choice just does not outlive the page */ }
      draw();
    });
  })();
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* 44px: the tap target the network tests for. */
    width: 44px;
    height: 44px;
    padding: 0;
    background: none;
    border: 1px solid transparent;
    border-radius: var(--radius);
    color: var(--ink-muted);
    cursor: pointer;
  }
  .theme-toggle:hover { color: var(--ink); border-color: var(--border); }
  .theme-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .theme-icon { width: 20px; height: 20px; display: none; }
  .theme-toggle[data-mode="light"] .theme-icon-light,
  .theme-toggle[data-mode="dark"] .theme-icon-dark { display: block; }
</style>
