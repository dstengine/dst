---
/* Light and dark, with the reader's own setting as the default.
   Three states, not two: "system" is a real choice and it is the one the
   site starts in, so a two-way switch would have no way back to it once
   the reader touched it. The cycle is system -> light -> dark -> system.

   No stored choice means no `data-theme` attribute, and tokens.css falls
   through to `prefers-color-scheme`. A stored choice stamps the attribute,
   which the `:root[data-theme]` blocks answer.

   The script that stamps it is inline in the head, not here: it has to run
   before the first paint or the page flashes the wrong theme. See
   BaseLayout. This component only draws the control and handles the click. */
---
<button id="theme-toggle" class="theme-toggle" type="button" hidden>
  <svg class="theme-icon theme-icon-system" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="2.5" y="4" width="19" height="13" rx="1.5" /><path d="M8 21h8M12 17v4" />
  </svg>
  <svg class="theme-icon theme-icon-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4.2" /><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M19.1 4.9l-1.8 1.8M6.7 17.3l-1.8 1.8" />
  </svg>
  <svg class="theme-icon theme-icon-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" />
  </svg>
</button>

<script is:inline>
  (() => {
    const btn = document.getElementById("theme-toggle");
    if (!btn) return;
    // Only offer the control once we know the script runs: with JS off the
    // page still renders in the reader's own theme, which is the default
    // anyway, and a dead button would be worse than no button.
    btn.hidden = false;

    const ORDER = ["system", "light", "dark"];
    const WORD = { system: "Follow system", light: "Light", dark: "Dark" };

    const read = () => {
      try {
        const v = localStorage.getItem("theme");
        return ORDER.includes(v) ? v : "system";
      } catch { return "system"; }
    };

    const apply = (mode) => {
      const root = document.documentElement;
      if (mode === "system") root.removeAttribute("data-theme");
      else root.setAttribute("data-theme", mode);
      btn.dataset.mode = mode;
      btn.setAttribute("aria-label", `Theme: ${WORD[mode]}. Change.`);
      btn.title = `Theme: ${WORD[mode]}`;
    };

    apply(read());

    btn.addEventListener("click", () => {
      const next = ORDER[(ORDER.indexOf(read()) + 1) % ORDER.length];
      try {
        if (next === "system") localStorage.removeItem("theme");
        else localStorage.setItem("theme", next);
      } catch { /* private mode: the choice just does not outlive the page */ }
      apply(next);
    });
  })();
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* 44px: the tap target the network tests for. */
    width: 44px;
    height: 44px;
    padding: 0;
    background: none;
    border: 1px solid transparent;
    border-radius: var(--radius);
    color: var(--ink-muted);
    cursor: pointer;
  }
  .theme-toggle:hover { color: var(--ink); border-color: var(--border); }
  .theme-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .theme-icon { width: 20px; height: 20px; display: none; }
  .theme-toggle[data-mode="system"] .theme-icon-system,
  .theme-toggle[data-mode="light"] .theme-icon-light,
  .theme-toggle[data-mode="dark"] .theme-icon-dark { display: block; }
</style>
