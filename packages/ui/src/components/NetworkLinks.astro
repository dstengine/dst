---
// Links across the network, in two shapes.
//
// `links` — a short curated row, shown in the footer of every vertical, so
// a reader (and a crawler) arriving on any page can reach the sites next
// door rather than only the hub.
//
// `sites` — the hub's full listing, where each site is named with the
// pages worth going straight to. Deep links, because a hub that only ever
// points at six home pages leaves every inner page of every vertical
// reachable from nowhere but its own nav.
import type { NetworkLink, NetworkSite } from "@dst/content/network";

interface Props {
  heading: string;
  intro?: string;
  links?: NetworkLink[];
  sites?: NetworkSite[];
}

const { heading, intro, links = [], sites = [] } = Astro.props;
const empty = links.length === 0 && sites.length === 0;
---
{!empty && (
  <section class:list={["network-links", sites.length > 0 && "network-links-wide"]}>
    {sites.length > 0 ? (
      /* Sixteen links is a reasonable footer on a desktop and half a screen
         of scrolling on a phone, so there it collapses — but only there,
         and only once the script below has run. Open in the markup, so
         without JavaScript every link is visible on every width rather
         than shut behind a control that can't be operated. */
      <details class="network-fold" open>
        <summary class="network-summary"><h2>{heading}</h2></summary>
        {intro && <p class="network-intro">{intro}</p>}
        <ul class="network-sites">
          {sites.map((site) => (
            <li>
              {/* The site is the label on its column, not the offer — its
                  own card, with its own description, is on the hub's home
                  page. Repeating the description here made a visitor read
                  the same six sites twice. */}
              <a class="network-site-name" href={`https://${site.host}`} title={`${site.name} — ${site.blurb}`}>
                {site.name}
              </a>
              <ul class="network-deep">
                {site.links.map((link) => (
                  <li>
                    <a href={link.href} title={link.title}>{link.label}</a>
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
      </details>
    ) : (
      <>
        <h2>{heading}</h2>
        {intro && <p class="network-intro">{intro}</p>}
        <p class="network-row">
          {links.map((link, i) => (
            <>
              {i > 0 && <span aria-hidden="true"> · </span>}
              <a href={link.href} title={link.title}>{link.label}</a>
            </>
          ))}
        </p>
      </>
    )}
  </section>
)}

<script>
  // <details> can't be driven by a media query: a closed panel isn't
  // rendered at all, so CSS can't force it open on a wide screen. The
  // markup ships open and this closes it on a phone, which means the
  // no-JavaScript case is the harmless one — everything visible.
  const NARROW = window.matchMedia("(max-width: 640px)");
  const folds = document.querySelectorAll<HTMLDetailsElement>(".network-fold");
  const sync = () => {
    for (const fold of folds) {
      // Leave it alone once someone has touched it — reopening a panel a
      // visitor just closed is worse than a long footer.
      if (fold.dataset.touched) continue;
      fold.open = !NARROW.matches;
    }
  };
  for (const fold of folds) {
    fold.addEventListener("toggle", () => {
      if (fold.matches(":hover, :focus-within")) fold.dataset.touched = "yes";
    });
  }
  sync();
  NARROW.addEventListener("change", sync);
</script>

<style>
  .network-links { display: flex; flex-direction: column; gap: var(--space-2); }
  /* Both variants live in a footer now, where the heading is a label over
     a set of links, not a section title. It was briefly set as a page
     heading, for the stretch when the wide listing sat in the middle of
     the hub's home page. */
  .network-links h2 {
    font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--ink-muted); font-weight: 600; margin: 0;
  }
  .network-row { margin: 0; line-height: 1.8; }
  .network-intro { margin: 0; color: var(--ink-muted); max-width: 46ch; }

  .network-links-wide { gap: var(--space-3); }
  /* Fixed steps rather than auto-fit. Six sites into an auto-fit track came
     out as four columns and a stray two, with half the second row empty —
     1, 2 and 3 all divide six, so every row is full at every width. */
  .network-sites {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: var(--space-3) var(--space-4);
    grid-template-columns: 1fr;
  }
  @media (min-width: 40rem) { .network-sites { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64rem) { .network-sites { grid-template-columns: repeat(3, 1fr); } }

  .network-sites > li { display: flex; flex-direction: column; gap: 0.4rem; min-width: 0; }
  /* The column's label: quiet, so the destinations under it are what the
     eye lands on. They are the only thing in this block that isn't
     reachable from anywhere else on the page. */
  .network-site-name {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
    text-decoration: none;
  }
  .network-site-name:hover { color: var(--accent); }

  .network-deep { list-style: none; margin: 0; padding: 0; display: grid; }
  /* One destination per line, each its own target. Run together as a
     sentence with middots they read as one item and hit like one too. */
  .network-deep a {
    display: flex;
    align-items: center;
    min-height: 2.5rem;
    border-bottom: 1px solid var(--border);
    /* The rule under each row already separates them; an underline as well
       made a six-item column look hatched. This is a menu, not links in a
       sentence — the row itself is the affordance. */
    text-decoration: none;
  }
  .network-deep a:hover { color: var(--accent); text-decoration: underline; }
  .network-deep li:last-child a { border-bottom: 0; }

  /* Above the breakpoint the fold isn't a control at all: the summary is
     gone and the panel shows whether or not <details> is open. Marker
     removed on both, since the summary carries its own caret below and a
     disclosure triangle beside a heading is not the look. */
  .network-fold { display: flex; flex-direction: column; gap: var(--space-3); }
  .network-summary { list-style: none; cursor: default; }
  .network-summary::-webkit-details-marker { display: none; }
  .network-summary h2 { display: inline-block; }

  /* Both the label and the rows below it are links, and on a phone every
     one of them has to be thumb-sized — 44px is the smallest a finger
     reliably hits. On a pointer the rows can be tighter, so the block stays
     scannable rather than spread over a screen and a half. */
  @media (max-width: 640px) {
    .network-site-name { display: flex; align-items: center; min-height: 44px; }
    .network-deep a { min-height: 44px; }
    /* Collapsed by default here — sixteen links made the footer longer
       than the page above it. */
    .network-summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-2);
      min-height: 44px;
      cursor: pointer;
    }
    .network-summary::after {
      content: "";
      width: 0.5rem; height: 0.5rem;
      border-right: 1.5px solid var(--ink-faint);
      border-bottom: 1.5px solid var(--ink-faint);
      transform: rotate(45deg) translate(-25%, -25%);
      transition: transform 150ms ease;
    }
    .network-fold[open] .network-summary::after { transform: rotate(-135deg); }
  }
  @media (min-width: 40.0625rem) {
    .network-summary { display: none; }
  }
</style>
