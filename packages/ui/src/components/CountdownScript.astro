---
// Fills in "in 5 months" next to an event's absolute date, client-side.
//
// It has to run in the browser: these sites are statically generated, so a
// countdown baked in at build time would be wrong within days of shipping.
// The absolute date is always in the HTML — this only ever adds a second
// reading of it, so with no JS the date still stands on its own.
---
<script is:inline>
  (() => {
    const DAY = 86400000;
    const phrase = (days) => {
      if (days < 0) return null;
      if (days === 0) return "today";
      if (days === 1) return "tomorrow";
      if (days < 14) return `in ${days} days`;
      if (days < 60) return `in ${Math.round(days / 7)} weeks`;
      if (days < 345) return `in ${Math.round(days / 30.4)} months`;
      const years = Math.round(days / 365);
      return years <= 1 ? "in a year" : `in ${years} years`;
    };
    const midnightUtc = (d) => Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate());
    const today = midnightUtc(new Date());
    for (const el of document.querySelectorAll("[data-countdown]")) {
      const iso = el.getAttribute("datetime") || el.closest("[datetime]")?.getAttribute("datetime");
      if (!iso) continue;
      const text = phrase(Math.round((Date.parse(`${iso}T00:00:00Z`) - today) / DAY));
      if (text) el.textContent = text;
    }
  })();
</script>
