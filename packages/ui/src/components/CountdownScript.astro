---
// Client-side time relative to now: "in 5 months" next to an upcoming
// event's date, and an "ended" flag once it has passed.
//
// It has to run in the browser: these sites are statically generated, so
// anything baked in at build time would be wrong within days of shipping —
// and a page still advertising a date that has gone is the standard
// failure mode of event listings. The absolute date is always in the HTML,
// so with no JS the date still stands on its own.
---
<script is:inline>
  (() => {
    const DAY = 86400000;
    // Built from the page's own lang rather than hard-coded English, so a
    // site in another language gets "en 6 días" and "mañana" without this
    // file knowing anything about that language. numeric:"auto" is what
    // turns 0 and 1 days into "today" and "tomorrow" in every locale.
    const lang = document.documentElement.lang || "en";
    // A browser without this language's data does not fail: it quietly
    // answers in its own, and an Armenian card says "tomorrow". Chromium
    // builds ship without Armenian, so on those the label is left out and
    // the absolute date — rendered at build time, in the right language —
    // stands alone, as it does with no JS at all.
    const known = Intl.RelativeTimeFormat.supportedLocalesOf([lang]).length > 0;
    const rtf = new Intl.RelativeTimeFormat(known ? lang : "en", { numeric: "auto" });
    const ahead = (days) => {
      if (days < 14) return rtf.format(days, "day");
      if (days < 60) return rtf.format(Math.round(days / 7), "week");
      if (days < 345) return rtf.format(Math.round(days / 30.4), "month");
      return rtf.format(Math.round(days / 365), "year");
    };
    const midnightUtc = (d) => Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate());
    const today = midnightUtc(new Date());
    const daysFrom = (el) => {
      const iso = el.getAttribute("datetime") || el.closest("[datetime]")?.getAttribute("datetime");
      if (!iso) return null;
      return Math.round((Date.parse(`${iso}T00:00:00Z`) - today) / DAY);
    };

    for (const el of document.querySelectorAll("[data-countdown]")) {
      const days = daysFrom(el);
      if (days === null || days < 0 || !known) continue;
      el.textContent = ahead(days);
    }

    // The live variant, on an event page that asks for it: the day count
    // above until the start is under two days away, then hours and minutes
    // — but only when the stamp carries a clock time and an offset. A bare
    // date is a day in some time zone the page does not know, and counting
    // down to its UTC midnight would be precise and wrong. "Under way" while
    // it runs, and nothing after: the ended badge takes over from there.
    const timed = (iso) => /T\d\d:\d\d/.test(iso || "");
    const at = (iso) => Date.parse(timed(iso) ? iso : `${iso}T00:00:00Z`);
    const live = [...document.querySelectorAll("[data-countdown-live]")];
    const tick = () => {
      const now = Date.now();
      for (const el of live) {
        const { start, end, now: runningLabel } = el.dataset;
        // An end with no clock time runs to the end of that day.
        const endAt = timed(end) ? at(end) : at(end) + DAY;
        const left = at(start) - now;
        let text = "";
        if (left <= 0) text = now < endAt ? runningLabel || "" : "";
        else if (left >= 2 * DAY || !timed(start)) {
          const days = Math.round((Date.parse(`${start.slice(0, 10)}T00:00:00Z`) - midnightUtc(new Date())) / DAY);
          text = ahead(Math.max(days, 0));
        } else if (left >= 3600000) text = rtf.format(Math.floor(left / 3600000), "hour");
        else text = rtf.format(Math.max(1, Math.ceil(left / 60000)), "minute");
        el.textContent = known ? text : "";
        el.hidden = !el.textContent;
      }
    };
    if (live.length) {
      tick();
      setInterval(tick, 30000);
    }

    // An end date means the event runs until then; without one, the start
    // date is also the last day.
    for (const el of document.querySelectorAll("[data-event-ended]")) {
      const days = daysFrom(el);
      if (days !== null && days < 0) el.hidden = false;
    }
  })();
</script>
