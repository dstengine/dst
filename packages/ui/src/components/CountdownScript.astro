---
// Client-side time relative to now: "in 5 months" next to an upcoming
// event's date, and an "ended" flag once it has passed.
//
// It has to run in the browser: these sites are statically generated, so
// anything baked in at build time would be wrong within days of shipping —
// and a page still advertising a date that has gone is the standard
// failure mode of event listings. The absolute date is always in the HTML,
// so with no JS the date still stands on its own.
---
<script is:inline>
  (() => {
    const DAY = 86400000;
    const ahead = (days) => {
      if (days === 0) return "today";
      if (days === 1) return "tomorrow";
      if (days < 14) return `in ${days} days`;
      if (days < 60) return `in ${Math.round(days / 7)} weeks`;
      if (days < 345) return `in ${Math.round(days / 30.4)} months`;
      const years = Math.round(days / 365);
      return years <= 1 ? "in a year" : `in ${years} years`;
    };
    const midnightUtc = (d) => Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate());
    const today = midnightUtc(new Date());
    const daysFrom = (el) => {
      const iso = el.getAttribute("datetime") || el.closest("[datetime]")?.getAttribute("datetime");
      if (!iso) return null;
      return Math.round((Date.parse(`${iso}T00:00:00Z`) - today) / DAY);
    };

    for (const el of document.querySelectorAll("[data-countdown]")) {
      const days = daysFrom(el);
      if (days === null || days < 0) continue;
      el.textContent = ahead(days);
    }

    // An end date means the event runs until then; without one, the start
    // date is also the last day.
    for (const el of document.querySelectorAll("[data-event-ended]")) {
      const days = daysFrom(el);
      if (days !== null && days < 0) el.hidden = false;
    }
  })();
</script>
