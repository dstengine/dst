---
// GA4 tag, rendered from BaseLayout so every site in the network is measured
// from one place rather than each app pasting a snippet.
//
// Renders nothing at all when no measurement ID is configured, which keeps
// local builds, previews and the test suite from sending hits.
//
// The snippet is emitted verbatim, in Google's canonical shape, rather than
// via define:vars. Two reasons, both learned the hard way:
//   - define:vars wraps the script in an IIFE, which trapped gtag in a
//     closure where nothing on the page could call gtag("event", …);
//   - it also forced the measurement ID to be passed as a variable, and
//     Search Console's ownership check scans the markup for a literal
//     gtag('config', 'G-…') — with a variable there it reports finding no
//     Analytics code at all.
import { GA_MEASUREMENT_ID } from "../analytics";

const id = GA_MEASUREMENT_ID;

// Interpolated straight into a <script>, so refuse anything that isn't the
// shape of a measurement ID.
const valid = /^G-[A-Z0-9]+$/.test(id);
if (id && !valid) {
  throw new Error(`Analytics: "${id}" is not a valid GA4 measurement ID`);
}

const snippet = `window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', '${id}', { cookie_domain: '.dst.llc' });`;
---
{valid && (
  <>
    {/* The tag is fetched from a second origin on every page. Opening the
        connection while the HTML is still parsing takes the DNS, TCP and
        TLS round trips off the critical path. */}
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${id}`}></script>
    <script is:inline set:html={snippet} />
  </>
)}

{/* One delegated listener for the outward moves worth counting, rather
    than a handler wired into each component that happens to render such a
    link. track() is a no-op when the tag isn't on the page, so this costs
    nothing on a preview or a local build. */}
<script>
  import { track } from "../track";

  addEventListener("click", (event) => {
    const link = (event.target as Element | null)?.closest?.("a");
    if (!link) return;
    const href = link.getAttribute("href") ?? "";

    if (href.startsWith("/go/")) {
      // The hop's own slug, which names the destination without putting a
      // third-party URL into the report.
      track("outbound_click", { hop: href.replace(/^\/go\/|\/$/g, ""), text: link.textContent?.trim() });
    } else if (href.endsWith(".ics")) {
      track("add_to_calendar", { event_slug: href.split("/").pop()?.replace(/\.ics$/, "") });
    } else if (href.startsWith("tel:")) {
      track("phone_click");
    }
  });
</script>
