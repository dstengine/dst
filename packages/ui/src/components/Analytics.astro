---
// GA4 tag, rendered from BaseLayout so every site in the network is measured
// from one place rather than each app pasting a snippet.
//
// Renders nothing at all when no measurement ID is configured, which keeps
// local builds, previews and the test suite from sending hits.
//
// The snippet is emitted verbatim, in Google's canonical shape, rather than
// via define:vars. Two reasons, both learned the hard way:
//   - define:vars wraps the script in an IIFE, which trapped gtag in a
//     closure where nothing on the page could call gtag("event", …);
//   - it also forced the measurement ID to be passed as a variable, and
//     Search Console's ownership check scans the markup for a literal
//     gtag('config', 'G-…') — with a variable there it reports finding no
//     Analytics code at all.
import { getMeasurementId } from "../analytics";
import { needsConsent, CONSENT_KEY, CONSENT_MAX_AGE_MS } from "../consent";

interface Props {
  id?: string;
  networkFooter?: boolean;
}

const host = Astro.site?.hostname ?? "";
const isDst = (host === "dst.llc" || host.endsWith(".dst.llc")) && Astro.props.networkFooter !== false;

const id = getMeasurementId({
  host,
  networkFooter: Astro.props.networkFooter,
  gaId: Astro.props.id,
});

// Interpolated straight into a <script>, so refuse anything that isn't the
// shape of a measurement ID.
const valid = /^G-[A-Z0-9]+$/.test(id);
if (id && !valid) {
  throw new Error(`Analytics: "${id}" is not a valid GA4 measurement ID`);
}

// One cookie on .dst.llc keeps a session intact as someone moves between
// the verticals, which is the point of cross-linking them. A host outside
// that domain cannot write it — the browser drops a cookie for a domain
// the page isn't on, and the site would report no sessions at all. Those
// hosts get 'auto', which is the same measurement without the shared
// session that would be meaningless for them anyway.
const cookieDomain = isDst ? "'.dst.llc'" : "'auto'";

const snippet = `window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', '${id}', { cookie_domain: ${cookieDomain} });`;

// A site that asks first (consent.ts) gets none of the above in its HTML:
// no preconnect, no loader, no gtag. It gets this instead, which does the
// same three calls and fetches the same loader — once the reader has said
// yes, on this visit or an earlier one, and not before.
//
//   - No answer yet: `gtag` is a stand-in that keeps what the page would
//     have reported in a short list in memory. Nothing is stored, nothing
//     is fetched, nothing leaves the page. A yes sends the list after the
//     config call, so the page view that was asked the question is counted
//     like any other — and with it the impression of a running A/B test,
//     which is reported at load and would otherwise be lost for every
//     reader who agrees. A no throws the list away and removes `gtag`.
//   - An earlier no: there is no `gtag` at all, and track() does nothing.
//   - A no after a yes: the property is switched off, its cookies are
//     deleted, and the page reloads into the state above. Google documents
//     the switch as one to set before the first gtag() call, and the tests
//     answer for Google with a stub, so what the real tag does with a
//     switch thrown late is not proven here. Whatever it does, the page
//     that follows deletes the cookies again and never loads the tag.
//   - The answer is read again when it changes in another tab and when
//     Back restores this page from the browser's cache: a page that was
//     loaded under a yes must not go on measuring after a no given
//     elsewhere.
//
// forget() takes every cookie named _ga or _ga_…, not this property's two:
// a reader who came before 24 Oct 2026 also holds those of the two ids the
// sites reported to earlier. It runs on a stored no and on an answer that
// has lapsed — not on a reader who has never been asked, whose cookie from
// before the question existed is left unread until they answer: deleting
// it would turn every returning reader who agrees into a new one.
//
// A page that stop() reloaded says so to the page it becomes, through
// sessionStorage: the tag it is leaving may write its cookies once more on
// the way out, and if the answer itself has gone by then — cleared in
// another tab — nothing else would tell the new page to delete them.
//
// An answer dated more than a day ahead of the clock is no answer; without
// that bound a wrong date would be a yes that never lapses.
//
// Advertising is off whatever the answer: nobody is asked about it. The
// consent defaults deny it, and the config call turns off Google signals
// and ad personalisation by Google's own switches, which override whatever
// the property is set to.
//
// The config call still carries the id as a literal, as it does above.
const gated = needsConsent(host);
const gate = `(function () {
  var KEY = '${CONSENT_KEY}', MAX = ${CONSENT_MAX_AGE_MS}, on = false, held = [];
  function raw() { try { return localStorage.getItem(KEY) || ''; } catch (e) { return ''; } }
  function read() {
    var v = raw().split(':'), age = Date.now() - Number(v[1]);
    return (v[0] === 'yes' || v[0] === 'no') && age > -864e5 && age < MAX ? v[0] : '';
  }
  function write(v) { try { localStorage.setItem(KEY, v + ':' + Date.now()); } catch (e) {} }
  function load() {
    if (on) return;
    on = true;
    window.dataLayer = window.dataLayer || [];
    window.gtag = function gtag(){dataLayer.push(arguments);};
    gtag('consent', 'default', { analytics_storage: 'granted', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' });
    gtag('js', new Date());
    gtag('config', '${id}', { cookie_domain: ${cookieDomain}, allow_google_signals: false, allow_ad_personalization_signals: false });
    for (var i = 0; i < held.length; i++) dataLayer.push(held[i]);
    held = [];
    var s = document.createElement('script');
    s.async = true;
    s.src = 'https://www.googletagmanager.com/gtag/js?id=${id}';
    document.head.appendChild(s);
  }
  function forget() {
    try {
      var parts = location.hostname.split('.'), domains = [''];
      for (var i = 0; i < parts.length - 1; i++) domains.push('; domain=.' + parts.slice(i).join('.'));
      document.cookie.split(';').forEach(function (c) {
        var n = c.split('=')[0].trim();
        if (n !== '_ga' && n.indexOf('_ga_') !== 0) return;
        domains.forEach(function (d) { document.cookie = n + '=; Max-Age=0; path=/' + d; });
      });
    } catch (e) {}
  }
  function stop() {
    held = [];
    if (on) window['ga-disable-${id}'] = true;
    forget();
    if (on) { try { sessionStorage.setItem(KEY, '1'); } catch (e) {} location.reload(); }
    else { try { delete window.gtag; } catch (e) { window.gtag = undefined; } }
  }
  function sync() {
    var s = read();
    if (on) { if (s !== 'yes') stop(); }
    else if (s === 'yes') load();
    else if (s === 'no') stop();
  }
  var state = read(), again = false;
  try { again = !!sessionStorage.getItem(KEY); sessionStorage.removeItem(KEY); } catch (e) {}
  if (state === 'yes') load();
  else {
    if (raw() || again) forget();
    if (!state) window.gtag = function () { if (held.length < 20) held.push(arguments); };
  }
  window.analyticsConsent = {
    state: read,
    grant: function () { write('yes'); load(); },
    deny: function () { write('no'); stop(); }
  };
  addEventListener('storage', function (e) { if (e.key === KEY || e.key === null) sync(); });
  addEventListener('pageshow', function (e) { if (e.persisted) sync(); });
})();`;
---
{valid && gated && <script is:inline set:html={gate} />}
{valid && !gated && (
  <>
    {/* The tag is fetched from a second origin on every page. Opening the
        connection while the HTML is still parsing takes the DNS, TCP and
        TLS round trips off the critical path. */}
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${id}`}></script>
    <script is:inline set:html={snippet} />
  </>
)}

{/* One delegated listener for the outward moves worth counting, rather
    than a handler wired into each component that happens to render such a
    link. track() is a no-op when the tag isn't on the page, so this costs
    nothing on a preview or a local build. */}
<script>
  import { track } from "../track";

  // A call to action is a styled link, not a <button>: the network's four
  // real <button> elements are the theme toggle, the form submit and the
  // lightbox controls. The submit is already counted, more precisely, as
  // generate_lead or lead_failed. The theme toggle sits on all 385 pages
  // and would out-number every other event on the network several times
  // over to answer a question `prefers-color-scheme` mostly answers first.
  // `data-cta="<kind>"` lets a component name its own kind of call to
  // action — a feed card, the Halloween pumpkin — without this file
  // learning its class: the attribute is the kind the report shows.
  const CTA = ".button, .button-secondary, .link-card, .cta-banner, [data-cta]";

  /** A card's label can be a whole paragraph. Reports want the thing that
      was clicked, not the copy around it — and only the words on screen:
      a button under test carries every variant's label, hidden but for
      one, and textContent would report all three run together. */
  // A link with no words — the pumpkin, a floating mark — is named by its
  // aria-label, which is what a screen reader would have said for it.
  const label = (el: Element) =>
    (((el as HTMLElement).innerText ?? el.textContent)?.trim() || el.getAttribute("aria-label") || "").replace(/\s+/g, " ").slice(0, 60);

  // One impression per test this page view shows, once, at load: the
  // denominator of every A/B/n result. A page test is in the page itself;
  // a visitor test counts only where its markup is on the page, since the
  // script that picks the variant runs on every page in the test's scope.
  // A forced variant (?exp=) never reaches data-experiments, so it is
  // never counted.
  const root = document.documentElement;
  for (const tag of (root.getAttribute("data-experiments") ?? "").split(" ").filter(Boolean)) {
    const id = tag.slice(0, tag.indexOf(":"));
    if (root.hasAttribute(`data-exp-${id}`) && !document.querySelector(`[data-variant^="${id}:"]`)) continue;
    track("experience_impression", { exp_variant_string: tag });
  }

  addEventListener("click", (event) => {
    const link = (event.target as Element | null)?.closest?.("a");
    if (!link) return;
    const href = link.getAttribute("href") ?? "";

    // A ticket link is a /go/ hop like any other, and counting it as one
    // would be true and useless: the reports would hold a single
    // outbound_click total mixing "buy a ticket" with "read the theatre's
    // own page", and the first of those is the only thing this network is
    // for. So the link says what it is, and gets its own name.
    //
    // Deliberately before the /go/ branch, not beside it — one tap must
    // produce one event, or every ticket click is counted twice and the
    // outbound_click total stops meaning anything.
    if (link.hasAttribute("data-ticket")) {
      track("ticket_click", {
        // The seller, by the same slug outbound_click uses, so the two can
        // be read together without a second registered dimension.
        hop: href.replace(/^\/go\/|\/$/g, ""),
        text: label(link),
      });
    } else if (href.startsWith("/go/")) {
      // The hop's own slug, which names the destination without putting a
      // third-party URL into the report.
      track("outbound_click", { hop: href.replace(/^\/go\/|\/$/g, ""), text: label(link) });
    } else if (href.endsWith(".ics")) {
      track("add_to_calendar", { event_slug: href.split("/").pop()?.replace(/\.ics$/, "") });
    } else if (href.startsWith("tel:")) {
      track("phone_click");
    } else if (link.matches(CTA)) {
      // Everything above already says what it was, and says it better, so
      // this branch is deliberately last: a Tickets button is a
      // ticket_click, not a second, blurrier cta_click for the same tap.
      // What is left is the network's internal calls to action — the ones
      // that move a visitor towards a form rather than off the site.
      track("cta_click", {
        cta_text: label(link),
        // The path only. A full URL would carry the query string, and the
        // query string is where UTM tags and anything a visitor typed live.
        cta_href: href.split(/[?#]/)[0] || href,
        cta_kind: link.getAttribute("data-cta")
          ? link.getAttribute("data-cta")
          : link.classList.contains("link-card")
          ? "card"
          : link.classList.contains("cta-banner")
            ? "banner"
            : link.classList.contains("button-secondary")
              ? "button-secondary"
              : "button",
        // An in-page jump and a move to another page are both worth
        // counting and are not the same act; without this they add up into
        // a number that answers neither.
        cta_target: href.startsWith("#") ? "anchor" : "page",
      });
    }
  });
</script>
