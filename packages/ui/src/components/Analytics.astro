---
// GA4 tag, rendered from BaseLayout so every site in the network is measured
// from one place rather than each app pasting a snippet.
//
// Renders nothing at all when no measurement ID is configured, which keeps
// local builds, previews and the test suite from sending hits.
//
// The snippet is emitted verbatim, in Google's canonical shape, rather than
// via define:vars. Two reasons, both learned the hard way:
//   - define:vars wraps the script in an IIFE, which trapped gtag in a
//     closure where nothing on the page could call gtag("event", …);
//   - it also forced the measurement ID to be passed as a variable, and
//     Search Console's ownership check scans the markup for a literal
//     gtag('config', 'G-…') — with a variable there it reports finding no
//     Analytics code at all.
import { GA_MEASUREMENT_ID } from "../analytics";

const id = GA_MEASUREMENT_ID;

// Interpolated straight into a <script>, so refuse anything that isn't the
// shape of a measurement ID.
const valid = /^G-[A-Z0-9]+$/.test(id);
if (id && !valid) {
  throw new Error(`Analytics: "${id}" is not a valid GA4 measurement ID`);
}

// One cookie on .dst.llc keeps a session intact as someone moves between
// the verticals, which is the point of cross-linking them. A host outside
// that domain cannot write it — the browser drops a cookie for a domain
// the page isn't on, and the site would report no sessions at all. Those
// hosts get 'auto', which is the same measurement without the shared
// session that would be meaningless for them anyway.
const host = Astro.site?.hostname ?? "";
const cookieDomain = host === "dst.llc" || host.endsWith(".dst.llc") ? "'.dst.llc'" : "'auto'";

const snippet = `window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', '${id}', { cookie_domain: ${cookieDomain} });`;
---
{valid && (
  <>
    {/* The tag is fetched from a second origin on every page. Opening the
        connection while the HTML is still parsing takes the DNS, TCP and
        TLS round trips off the critical path. */}
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${id}`}></script>
    <script is:inline set:html={snippet} />
  </>
)}

{/* One delegated listener for the outward moves worth counting, rather
    than a handler wired into each component that happens to render such a
    link. track() is a no-op when the tag isn't on the page, so this costs
    nothing on a preview or a local build. */}
<script>
  import { track } from "../track";

  // A call to action is a styled link, not a <button>: the network's four
  // real <button> elements are the theme toggle, the form submit and the
  // lightbox controls. The submit is already counted, more precisely, as
  // generate_lead or lead_failed. The theme toggle sits on all 385 pages
  // and would out-number every other event on the network several times
  // over to answer a question `prefers-color-scheme` mostly answers first.
  const CTA = ".button, .button-secondary, .link-card, .cta-banner";

  /** A card's label can be a whole paragraph. Reports want the thing that
      was clicked, not the copy around it. */
  const label = (el: Element) => el.textContent?.trim().replace(/\s+/g, " ").slice(0, 60);

  addEventListener("click", (event) => {
    const link = (event.target as Element | null)?.closest?.("a");
    if (!link) return;
    const href = link.getAttribute("href") ?? "";

    if (href.startsWith("/go/")) {
      // The hop's own slug, which names the destination without putting a
      // third-party URL into the report.
      track("outbound_click", { hop: href.replace(/^\/go\/|\/$/g, ""), text: link.textContent?.trim() });
    } else if (href.endsWith(".ics")) {
      track("add_to_calendar", { event_slug: href.split("/").pop()?.replace(/\.ics$/, "") });
    } else if (href.startsWith("tel:")) {
      track("phone_click");
    } else if (link.matches(CTA)) {
      // Everything above already says what it was, and says it better, so
      // this branch is deliberately last: a Tickets button is an
      // outbound_click, not a second, blurrier cta_click for the same tap.
      // What is left is the network's internal calls to action — the ones
      // that move a visitor towards a form rather than off the site.
      track("cta_click", {
        cta_text: label(link),
        // The path only. A full URL would carry the query string, and the
        // query string is where UTM tags and anything a visitor typed live.
        cta_href: href.split(/[?#]/)[0] || href,
        cta_kind: link.classList.contains("link-card")
          ? "card"
          : link.classList.contains("cta-banner")
            ? "banner"
            : link.classList.contains("button-secondary")
              ? "button-secondary"
              : "button",
        // An in-page jump and a move to another page are both worth
        // counting and are not the same act; without this they add up into
        // a number that answers neither.
        cta_target: href.startsWith("#") ? "anchor" : "page",
      });
    }
  });
</script>
