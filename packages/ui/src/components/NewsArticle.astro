---
import Photo from "./Photo.astro";
import { itemContext } from '../schema';
// Detail page body for a single news item. Every block below renders only
// when its data is present (see the news/events spec's page anatomy) — a
// missing optional field leaves no empty wrapper behind, not just hidden
// content, since a stray `<section>` with nothing in it is what a
// downstream test here specifically catches.
import type { EventItem, NewsItem } from "@dst/content/types";
import LeadForm from "./LeadForm.astro";
import VentureGrid from "./VentureGrid.astro";
import FeedCards from "./FeedCards.astro";
import CountdownScript from "./CountdownScript.astro";
import SourceLine from "./SourceLine.astro";
import ImageNote from "./ImageNote.astro";
import { ICONS } from "../icons.ts";
import { formatDate } from "../date.ts";
import { readingMinutes } from "@dst/content/reading";

interface Props {
  item: NewsItem;
  backHref: string;
  /** The rest of the site's news. Without it an article is a dead end: the
      only way on is the back link, since `related` is filled in by hand and
      most items don't have any. */
  more?: NewsItem[];
  /** Fallback for a site with only one news item: an article there would
      otherwise still end in a back link and nothing else. */
  moreEvents?: EventItem[];
}
const { item, backHref, more = [], moreEvents = [] } = Astro.props;

const moreCards = more
  .filter((other) => other.slug !== item.slug && Array.isArray(other.body) && other.body.length > 0)
  .sort((a, b) => (a.date < b.date ? 1 : a.date > b.date ? -1 : 0))
  .slice(0, 3)
  .map((other) => ({
    href: `/news/${other.slug}/`,
    eyebrow: other.category,
    date: other.date,
    title: other.title,
    text: other.summary,
    image: other.image,
    imageAlt: other.imageAlt,
  }));

const todayIso = new Date().toISOString().slice(0, 10);
const eventCards = moreEvents
  .filter((e) => e.start >= todayIso && Array.isArray(e.body) && e.body.length > 0)
  .sort((a, b) => (a.start < b.start ? -1 : 1))
  .slice(0, 3)
  .map((e) => ({
    href: `/events/${e.slug}/`,
    eyebrow: e.category,
    date: e.start,
    title: e.title,
    text: [e.venue, e.city].filter(Boolean).join(" · ") || e.summary,
    image: e.image,
    imageAlt: e.imageAlt,
    imageFit: "cover" as const,
    event: true,
  }));
const tail = moreCards.length > 0
  ? { heading: "More news", cards: moreCards }
  : eventCards.length > 0
    ? { heading: "Coming up", cards: eventCards }
    : null;
const minutes = readingMinutes(item);

// `jsonLd` on the item is a manual override for cases automation doesn't
// fit; otherwise built from whatever fields are actually present, since an
// Article block with none of its optional fields filled is worse than no
// block at all.
// Absolute, because a crawler resolves a relative URL in JSON-LD against
// nothing in particular; and tied to the page's own graph, so the article
// has a named publisher instead of standing on its own.
const absolute = (url: string) => (Astro.site ? new URL(url, Astro.site).href : url);
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;

const jsonLd =
  item.jsonLd ??
  {
    "@context": "https://schema.org",
    "@type": "NewsArticle",
    headline: item.title,
    description: item.summary,
    datePublished: item.date,
    ...(canonical ? itemContext(canonical) : {}),
    ...(item.image ? { image: absolute(item.image) } : {}),
    // Not isBasedOn: item.source.url — the URL is an internal audit trail
    // only (see the news/events spec's rule 1) and must never reach
    // rendered output, JSON-LD included. The source's name alone is public.
    ...(item.source ? { isBasedOn: item.source.name } : {}),
  };

// RelatedCard carries no VentureGrid-style status pill or icon, so both
// get a plain fallback here rather than an empty pill or a blank media
// panel — VentureGrid itself renders whatever is passed in verbatim.
const relatedItems = (item.related ?? []).map((card) => ({
  href: card.href,
  title: card.title, // VentureGrid's anchor title attribute
  eyebrow: card.eyebrow ?? "Related",
  status: "Read more",
  name: card.title,
  text: card.text,
  image: card.image,
  imageAlt: card.imageAlt,
  icon: card.image ? undefined : ICONS.link,
}));
---
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
<article class="container news-article">
  <header class="news-article-header">
    <p class="news-article-meta">
      {item.category && <span class="news-article-category">{item.category}</span>}
      <time datetime={item.date}>{formatDate(item.date)}</time>
      {minutes > 0 && <span class="news-article-reading">{minutes} min read</span>}
    </p>
    <h1>{item.title}</h1>
  </header>

  {item.image && (
    <figure class:list={["news-article-figure", { "figure-diagram": item.imageKind && item.imageKind !== "photo" }]}>
      <Photo
        src={item.image}
        alt={item.imageAlt ?? ""}
        narrow={item.imageNarrow}
        loading="eager"
        fetchpriority="high"
        sizes="(max-width: 46rem) 100vw, 46rem"
        width={item.imageWidth}
        height={item.imageHeight}
      />
      <ImageNote kind={item.imageKind} credit={item.imageCredit} />
    </figure>
  )}

  {item.body && item.body.length > 0 && (
    <div class="prose">
      {/* set:html so a paragraph can carry <strong> on the fact it turns
          on — a figure, a resolution number, a date. Content is authored in
          this repo, never user input, same as the district ContentPage. */}
      {item.body.map((p) => <p set:html={p} />)}
    </div>
  )}

  {item.expertise && (
    <div class="prose news-article-expertise">
      <p set:html={item.expertise} />
    </div>
  )}

  {item.geo && (
    <section class="locate">
      <h2>Locate</h2>
      <div class="locate-map">
        <iframe
          src={`https://www.openstreetmap.org/export/embed.html?bbox=${item.geo.lng - 0.02}%2C${item.geo.lat - 0.01}%2C${item.geo.lng + 0.02}%2C${item.geo.lat + 0.01}&layer=mapnik&marker=${item.geo.lat}%2C${item.geo.lng}`}
          loading="lazy"
          title={`Map — ${item.geo.name}`}
        />
      </div>
    </section>
  )}

  {item.form && (
    <section class="news-article-form">
      {item.form.title && <h2>{item.form.title}</h2>}
      {item.form.description && <p>{item.form.description}</p>}
      <LeadForm formName={item.form.title} formDescription={item.form.description} submitLabel={item.form.submitLabel}>
        {Object.entries(item.form.meta ?? {}).map(([key, value]) => (
          <input type="hidden" name={`meta.${key}`} value={value} />
        ))}
      </LeadForm>
    </section>
  )}

  {relatedItems.length > 0 && (
    <section class="news-article-related">
      <h2>Related</h2>
      <VentureGrid items={relatedItems} />
    </section>
  )}

  {item.source && <SourceLine source={item.source} />}

  {tail && (
    <section class="news-article-more">
      <h2>{tail.heading}</h2>
      <FeedCards items={tail.cards} columns={tail.cards.length} />
      {/* Only when the tail is events: the countdown markup is inert without
          it, and a news article otherwise has nothing to count down to. */}
      {tail.cards[0].event && <CountdownScript />}
    </section>
  )}

  <nav class="news-article-back">
    <a href={backHref} title="All news">&larr; All news</a>
  </nav>
</article>

<style>
  /* One column for the whole article, centred — every block inside runs
     edge to edge of it. Previously each block set its own width (measure
     on the text, full container on images, fit-content on diagrams) and
     the page came out as a ragged stack of three different alignments.
     Wider than the bare reading measure so a diagram still has room. */
  .news-article {
    max-width: 46rem;
    padding-top: var(--space-5);
    padding-bottom: var(--space-5);
  }
  .news-article-header { max-width: none; }
  .news-article-meta { display: flex; align-items: center; gap: var(--space-2); margin: 0 0 var(--space-1); font-size: var(--step--1); color: var(--ink-faint); }
  .news-article-category { font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--accent, #1F5C4E); }
  .news-article-header h1 { margin: 0; }
  .news-article-reading { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }

  .news-article-figure { margin: var(--space-4) 0 0; }
  .news-article-figure img { display: block; width: 100%; max-height: 60vh; object-fit: cover; background: var(--surface-sunk); border-radius: var(--radius); }
  /* Cropping a photograph loses scenery; cropping a diagram loses data. On
     a wide, short window `cover` was cutting 71px off a chart — enough to
     take a whole line of it — so anything that isn't a photograph is
     fitted whole instead.

     The figure then has to shrink to the picture rather than stay
     full-width: with `contain` inside a stretched figure the image centres
     itself and the caption stays pinned to the figure's left edge, ending
     up nowhere near the thing it describes. Capped short of the container
     so a diagram reads as wider than the text column without becoming a
     separate full-bleed band. */
  .figure-diagram img { object-fit: contain; background: transparent; height: auto; max-height: none; }

  .prose { margin-top: var(--space-4); max-width: none; }
  /* Justified, with hyphenation on. Justification without hyphens opens
     rivers of white space in a column this narrow — the two go together or
     not at all. */
  .prose p {
    /* The global `p, li` measure is 38rem; the article column is 46rem. Left
       in place it held every paragraph ~80px short of the figure above it,
       so the text looked inset from its own column. The column is the
       measure here. */
    max-width: none;
    text-align: justify;
    hyphens: auto;
    -webkit-hyphens: auto;
  }
  /* Justification needs room to distribute: on a phone the column is short
     enough that it opens rivers between words and hyphenates every other
     line. Ragged right is the better reading experience there. */
  @media (max-width: 640px) {
    .prose p { text-align: left; hyphens: manual; -webkit-hyphens: manual; }
  }
  /* Roughly one line of leading. At --space-2 the gap was half the
     line-height and paragraphs ran together. */
  .prose p + p { margin-top: var(--space-3); }
  .news-article-expertise p { color: var(--ink-muted); font-style: italic; }

  .locate { margin-top: var(--space-4); }
  .locate-map { margin-top: var(--space-2); border: 1px solid var(--border); }
  .locate-map iframe { display: block; width: 100%; height: clamp(300px, 34vw, 440px); border: 0; }

  .news-article-form { margin-top: var(--space-4); }

  .news-article-related { margin-top: var(--space-4); }
  .news-article-more { margin-top: var(--space-5); }


  .news-article-back { margin-top: var(--space-4); font-family: var(--font-mono); font-size: var(--step--1); }
  /* A tap target, not just a line of text: 44px is the smallest a finger
     reliably hits, and this is the main way back to the feed. */
  .news-article-back a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-right: var(--space-2);
    color: var(--ink-muted);
    text-decoration: none;
  }
  .news-article-back a:hover { color: var(--accent); }
</style>
