---
// Plain HTML form matching the network's universal lead object
// (local/dubai/dstengine/dtos/lead.dto.md): name optional, at least one
// contact required, extra context fields via the default slot.
// The webhook only accepts JSON (nested {lead: {...}}), so a real submit
// needs the inline script below - the `action`/`method` attributes are
// just a same-page fallback if JS fails to load, not a working no-JS path.
interface Props {
  // Every site posts to the same central webhook by default - see
  // apps/api/README.md. Only override for local testing against a
  // different deployment.
  endpoint?: string;
  submitLabel?: string;
  formId?: string;
  // Optional lead.form.{name,description} - identifies which form on the
  // network a lead came from (independent of ref.url, which identifies the
  // page). Only set where a site actually wants that distinction.
  formName?: string;
  formDescription?: string;
}
const {
  endpoint = "https://api.dst.llc/api/v1/lead",
  submitLabel = "Request a consultation",
  formId = "lead-form",
  formName,
  formDescription,
} = Astro.props;
---
<form class="lead-form" method="post" action={endpoint} id={formId} data-lead-form>
  {formName && <input type="hidden" name="form.name" value={formName} />}
  {formDescription && <input type="hidden" name="form.description" value={formDescription} />}
  <div class="field">
    <label for={`${formId}-name`}>Name</label>
    <input id={`${formId}-name`} name="name" type="text" autocomplete="name" />
  </div>
  <div class="field">
    <label for={`${formId}-email`}>Email</label>
    <input id={`${formId}-email`} name="contacts.email" type="email" autocomplete="email" />
  </div>
  <div class="field">
    <label for={`${formId}-phone`}>Phone / WhatsApp</label>
    <input id={`${formId}-phone`} name="contacts.phone" type="tel" autocomplete="tel" />
  </div>
  {/* Honeypot - see lead.dto.md. Off-screen via CSS, not type="hidden" or
      display:none - both of those are exactly what a bot checks for before
      deciding a field is safe to skip. A real visitor never reaches it;
      tabindex=-1 keeps it out of keyboard tab order and aria-hidden keeps
      it out of screen readers, so it's invisible by every means a human
      actually uses, not just visually. */}
  <div class="field lead-form-hp" aria-hidden="true">
    <label for={`${formId}-company`}>Company</label>
    <input id={`${formId}-company`} name="company" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <slot />
  <button class="button" type="submit">{submitLabel}</button>
  <p class="lead-form-status" data-lead-form-status role="status" aria-live="polite"></p>
</form>

<script>
  // Field names use dot-paths ("contacts.email", "meta.unitType") so a
  // form can add arbitrary lead.meta.* fields via its slot without this
  // component knowing about them - this nests FormData back into the
  // {lead: {...}} object the webhook expects, skipping blank fields so an
  // unanswered "Prefer not to say" select never creates an empty key.
  function setDeep(target: Record<string, any>, path: string, value: string) {
    const keys = path.split(".");
    let node = target;
    for (let i = 0; i < keys.length - 1; i++) {
      const key = keys[i];
      if (typeof node[key] !== "object" || node[key] === null) node[key] = {};
      node = node[key];
    }
    node[keys[keys.length - 1]] = value;
  }

  // First-touch UTM params - captured and persisted by LeadTracking.astro
  // the moment the visitor first landed (localStorage + cookie, same as
  // history), so a form submitted pages later still carries the campaign
  // that brought them in rather than whatever this page's own query string
  // happens to be. Falls back to reading the current URL directly only if
  // LeadTracking.astro's capture (window.dstGetUtm) isn't present for some
  // reason - a site that forgot to include it shouldn't lose UTM entirely.
  const UTM_KEYS = ["utm_source", "utm_medium", "utm_campaign", "utm_term", "utm_content"];
  function utmFromQuery(): Record<string, string> {
    const params = new URLSearchParams(location.search);
    const out: Record<string, string> = {};
    for (const key of UTM_KEYS) {
      const value = params.get(key);
      if (value) out[key] = value;
    }
    return out;
  }
  function firstTouchUtm(): Record<string, string> {
    const stored = (window as any).dstGetUtm?.();
    return stored && Object.keys(stored).length > 0 ? stored : utmFromQuery();
  }

  document.querySelectorAll<HTMLFormElement>("form[data-lead-form]").forEach((form) => {
    // Starting to fill the form in is the equivalent "intent" moment DKey
    // treats as the trigger for its own forms - asking for location the
    // instant a page loads, before the visitor has expressed any interest,
    // reads as random and gets declined out of reflex.
    form.addEventListener(
      "focusin",
      () => (window as any).dstRequestLeadLocation?.(),
      { once: true }
    );

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const status = form.querySelector<HTMLElement>("[data-lead-form-status]");
      const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      // Guards against a double-click (or an impatient second tap while the
      // request is in flight) creating two leads for the same submission.
      if (submitButton?.disabled) return;
      if (submitButton) submitButton.disabled = true;
      const lead: Record<string, any> = {};
      for (const [key, value] of new FormData(form).entries()) {
        if (typeof value !== "string" || value.trim() === "") continue;
        setDeep(lead, key, value);
      }
      lead.ref = { ...lead.ref, url: location.href, domain: location.hostname, title: document.title, ...firstTouchUtm() };
      lead.meta = { ...lead.meta, referrer: document.referrer || undefined, language: navigator.language };
      const geo = (window as any).__dstGeoMeta;
      if (geo?.source) lead.geo = geo;
      const history = (window as any).dstGetHistory?.();
      if (history?.length) lead.meta.history = history;
      try {
        const res = await fetch(form.action, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ lead }),
        });
        if (!res.ok) throw new Error(String(res.status));
        if (status) status.textContent = "Thanks — we'll be in touch shortly.";
        form.reset();
      } catch {
        if (status) status.textContent = "Something went wrong — please try again, or contact us directly.";
        // Only re-enable on failure - a successful submit should stay
        // disabled (the form is reset anyway) so a stray extra click right
        // after can't fire a second one.
        if (submitButton) submitButton.disabled = false;
      }
    });
  });
</script>

<style>
  .lead-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: 32rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-3);
  }
  .field { display: flex; flex-direction: column; gap: 0.3em; }
  /* Off-screen, not display:none/visibility:hidden - a bot's DOM scraper
     often checks computed visibility before deciding what to fill, and
     those two are the first properties it checks for. Positioning off
     the viewport instead still leaves the field "visible" by that check. */
  .lead-form-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  label { font-size: var(--step--1); font-weight: 600; color: var(--ink-muted); }
  input, select {
    font: inherit;
    padding: 0.6em 0.75em;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--ink);
  }
  input:focus, select:focus {
    outline: 2px solid var(--accent, #1F5C4E);
    outline-offset: 1px;
  }
  /* Chrome forces its own light autofill background regardless of the
     input's own color; the box-shadow inset is the only reliable override,
     and the transition delay hack pushes the text-fill-color to apply too. */
  input:-webkit-autofill,
  input:-webkit-autofill:hover,
  input:-webkit-autofill:focus {
    -webkit-text-fill-color: var(--ink);
    -webkit-box-shadow: 0 0 0 1000px var(--bg) inset;
    box-shadow: 0 0 0 1000px var(--bg) inset;
    transition: background-color 9999s ease-in-out 0s;
  }
  .lead-form-status { font-size: var(--step--1); color: var(--ink-muted); min-height: 1.2em; margin: 0; }
</style>
