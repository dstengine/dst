---
import Photo from "../Photo.astro";
// A geo-object (café, restaurant, gym…) surfaced on a topic page or as a
// "related" tile, linking through to its own VenuePage.
//
// Deliberately square-cornered: the photo runs full-bleed to the card edge,
// and a rounded frame would either round the photo with it or leave the
// corner mismatched. Sharp edges read as editorial/gallery rather than
// generic web-card, which is the register these venue pages are aiming for.
import { iconFor } from "../../icons";

interface Props {
  href: string;
  name: string;
  blurb: string;
  meta?: string;
  tag?: string;
  icon?: string;
  image?: string;
  /** Whether the card has a picture area at all. A grid where a few cards
      lack a photo keeps the frame so the rows stay even; a grid where none
      of them has one — a site with no licensed photography — drops it, since
      an empty 4:3 box on every card reads as a broken page. */
  media?: boolean;
}

const { href, name, blurb, meta, tag, icon = "pin", image, media = true } = Astro.props;
const placeholderPath = iconFor(`/${icon}/`);
const pinPath = iconFor("/pin/");
---
<a class="venue-card" href={href} title={blurb}>
  {media && (
  <div class:list={["venue-card-media", !image && "mark-cover"]}>
    {image ? (
      <Photo src={image} alt={name} sizes="(max-width: 700px) 100vw, 380px" />
    ) : (
      placeholderPath && (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d={placeholderPath} />
        </svg>
      )
    )}
    {tag && <span class="venue-card-tag">{tag}</span>}
  </div>
  )}
  <div class="venue-card-body">
    <h3>{name}</h3>
    <p class="venue-card-blurb">{blurb}</p>
    {meta && (
      <p class="venue-card-meta">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={pinPath} /></svg>
        <span>{meta}</span>
      </p>
    )}
  </div>
</a>

<style>
  .venue-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
    transition: border-color 200ms ease, transform 200ms ease;
  }
  .venue-card:hover { border-color: var(--accent); transform: translateY(-2px); }

  .venue-card-media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  /* See VentureGrid: .mark-cover paints the no-photo case from tokens.css,
     and a background here would load after it and win. */
  .venue-card-media:not(.mark-cover) { background: var(--surface-sunk); }
  .venue-card-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 400ms ease;
  }
  .venue-card:hover .venue-card-media img { transform: scale(1.03); }

  /* No photograph: .mark-cover in tokens.css paints the card a cover of its
     own rather than a small grey glyph that reads as a broken image. */

  /* Status/category chip over the image — square to match the card, and
     backed by a solid surface so it stays legible on any photograph. */
  .venue-card-tag {
    position: absolute;
    top: 0;
    left: 0;
    padding: 0.35em 0.7em;
    background: var(--surface);
    color: var(--ink-muted);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .venue-card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3);
  }
  .venue-card h3 {
    margin: 0;
    font-size: var(--step-2);
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .venue-card:hover h3 { color: var(--accent); }
  .venue-card-blurb {
    margin: 0;
    font-size: var(--step--1);
    line-height: 1.55;
    color: var(--ink-muted);
  }
  .venue-card-meta {
    display: flex;
    align-items: center;
    gap: 0.45em;
    margin: var(--space-1) 0 0;
    padding-top: var(--space-2);
    border-top: 1px solid var(--border);
    font-size: var(--step--1);
    color: var(--ink-faint);
  }
  .venue-card-meta svg { width: 15px; height: 15px; flex-shrink: 0; color: var(--accent); }
</style>
