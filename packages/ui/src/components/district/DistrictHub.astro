---
// Home-page body shared by every district site: a "start here" grid of links
// into the site's other pages, then whatever the page slots in (the news and
// events blocks), then the district write-up, then a featured CTA banner for
// the commercial page (rent). The page opener is rendered by DistrictLayout.
// Sites differ only in the data passed in.
//
// The write-up used to come first. Someone who has just landed wants to know
// where to go and what is happening, and reading two paragraphs of background
// is not how they want to find out — so the links and the dated blocks come
// first and the background sits under them, for the reader who wants it.
import { iconFor } from "../../icons";

interface HubLink {
  href: string;
  title: string;
  description: string;
}

interface Cta {
  href: string;
  eyebrow: string;
  h3: string;
  description: string;
}

interface Props {
  sections: { heading?: string; paragraphs: string[] }[];
  links: HubLink[];
  cta: Cta;
}

const { sections, links, cta } = Astro.props;
---
<section class="container">
  <h2>Start here</h2>
  <div class="link-grid">
    {links.map((link) => (
      <a class="card link-card" href={link.href} title={link.description}>
        {iconFor(link.href) && (
          <svg class="link-card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d={iconFor(link.href)} />
          </svg>
        )}
        <h3>{link.title}</h3>
        <p>{link.description}</p>
      </a>
    ))}
  </div>
</section>

{/* News and events, passed in by the page that owns the data. */}
<slot />

{sections.map((section) => (
  <section class="container">
    {section.heading && <h2>{section.heading}</h2>}
    {section.paragraphs.map((paragraph) => <p set:html={paragraph} />)}
  </section>
))}

<section class="container cta-section">
  <a class="cta-banner" href={cta.href} title={cta.description}>
    <div>
      <p class="eyebrow">{cta.eyebrow}</p>
      <h3>{cta.h3}</h3>
      <p>{cta.description}</p>
    </div>
    <span class="cta-banner-arrow" aria-hidden="true">&rarr;</span>
  </a>
</section>

<style>
  /* The CTA banner has no heading of its own to carry h2's margin-top,
     so without this it sits flush against the grid above it instead of
     reading as its own section. Match the grid's own row gap so it reads
     as one more row in the same rhythm, not a separate section. */
  .cta-section { margin-top: var(--space-3); }


  .link-card-icon {
    width: 22px;
    height: 22px;
    margin-bottom: var(--space-2);
    color: var(--accent);
  }
</style>
