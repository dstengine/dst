---
// Home-page body shared by every district site: hero, a "start here" grid
// of links into the site's other pages, then a featured CTA banner for the
// commercial page (rent). Sites differ only in the data passed in.
interface HubLink {
  href: string;
  title: string;
  description: string;
}

interface Cta {
  href: string;
  eyebrow: string;
  h3: string;
  description: string;
}

interface Props {
  eyebrow: string;
  h1: string;
  lede: string;
  sections: { heading?: string; paragraphs: string[] }[];
  links: HubLink[];
  cta: Cta;
  ledeWidth?: string;
}

const { eyebrow, h1, lede, sections, links, cta, ledeWidth } = Astro.props;

// One icon per topic slug, shared across every district site since the
// page set (coffee/food/pools/water/money/news/events/rent) is fixed by
// this same engine — see DistrictLayout. Plain stroke icons, not emoji,
// to stay in line with the rest of the design system.
const ICONS: Record<string, string> = {
  coffee: "M3 8h13a3 3 0 0 1 0 6h-1M3 8v7a3 3 0 0 0 3 3h6a3 3 0 0 0 3-3V8M3 8V5h9v3M6 2v1.5M9 2v1.5",
  food: "M4 2v7a2 2 0 0 0 2 2v9M4 2v4M6 2v4M8 2v4M8 2v9a2 2 0 0 1-2 2M16 2c-2 0-3 2-3 5s1 4 3 4v9",
  pools: "M2 8c1.5-1.5 3-1.5 4.5 0s3 1.5 4.5 0 3-1.5 4.5 0 3 1.5 4.5 0M2 14c1.5-1.5 3-1.5 4.5 0s3 1.5 4.5 0 3-1.5 4.5 0 3 1.5 4.5 0M2 20c1.5-1.5 3-1.5 4.5 0s3 1.5 4.5 0 3-1.5 4.5 0 3 1.5 4.5 0",
  water: "M12 2c3 4.5 6 8.2 6 11.5a6 6 0 0 1-12 0C6 10.2 9 6.5 12 2Z",
  money: "M12 3a9 9 0 1 0 0 18a9 9 0 1 0 0-18ZM12 7v10M15 10c0-1.4-1.3-2.5-3-2.5s-3 1.1-3 2.5c0 1.4 1.3 2 3 2.5s3 1.1 3 2.5-1.3 2.5-3 2.5-3-1.1-3-2.5",
  news: "M4 4h13a2 2 0 0 1 2 2v13a1 1 0 0 1-1 1H6a2 2 0 0 1-2-2V4ZM4 4a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2M8 8h8M8 12h8M8 16h4",
  events: "M4 5h16v15a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5ZM4 9h16M8 2v4M16 2v4M8 13h2M14 13h2M8 17h2M14 17h2",
  rent: "M15 7a4 4 0 1 1-4 4M15 7a4 4 0 0 0-4-4M15 7v2m-4 2H4l2 2m0-4-2 2",
};

function iconFor(href: string): string | undefined {
  const slug = href.replace(/\//g, "");
  return ICONS[slug];
}
---
<section class="container hero">
  <p class="eyebrow">{eyebrow}</p>
  <h1>{h1}</h1>
  <p class="lede" style={ledeWidth ? `max-width: ${ledeWidth}` : undefined} set:html={lede} />
</section>

{sections.map((section) => (
  <section class="container">
    {section.heading && <h2>{section.heading}</h2>}
    {section.paragraphs.map((paragraph) => <p set:html={paragraph} />)}
  </section>
))}

<section class="container">
  <h2>Start here</h2>
  <div class="link-grid">
    {links.map((link) => (
      <a class="card link-card" href={link.href} title={link.description}>
        {iconFor(link.href) && (
          <svg class="link-card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d={iconFor(link.href)} />
          </svg>
        )}
        <h3>{link.title}</h3>
        <p>{link.description}</p>
      </a>
    ))}
  </div>
</section>

<section class="container cta-section">
  <a class="cta-banner" href={cta.href} title={cta.description}>
    <div>
      <p class="eyebrow">{cta.eyebrow}</p>
      <h3>{cta.h3}</h3>
      <p>{cta.description}</p>
    </div>
    <span class="cta-banner-arrow" aria-hidden="true">&rarr;</span>
  </a>
</section>

<style>
  /* The CTA banner has no heading of its own to carry h2's margin-top,
     so without this it sits flush against the grid above it instead of
     reading as its own section. Match the grid's own row gap so it reads
     as one more row in the same rhythm, not a separate section. */
  .cta-section { margin-top: var(--space-3); }

  .link-card-icon {
    width: 22px;
    height: 22px;
    margin-bottom: var(--space-2);
    color: var(--accent);
  }
</style>
