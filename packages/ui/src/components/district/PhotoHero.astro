---
import Photo from "../Photo.astro";
// Photographic page opener: image with a bottom-weighted scrim carrying the
// eyebrow, title and an optional line under it. Shared by the district index
// and by venue pages so the two don't drift apart.
//
// Square corners on purpose, same reasoning as VenueCard — see that file.
// With no image it drops back to plain type on the page rather than showing
// an empty grey box.
interface Props {
  eyebrow: string;
  title: string;
  tagline?: string;
  image?: string;
  /** Describe what the image actually is — including whether it's a
      photograph or an illustration. Falls back to the title. */
  imageAlt?: string;
  /** Rendered as <h1> by default; venue/section openers may want otherwise. */
  level?: "h1" | "h2";
  /** Says what the picture is. Anything that isn't a photograph gets a
      visible mark, since a page-wide opener is the image most likely to be
      taken for a photograph of the place. */
  imageKind?: "photo" | "diagram" | "illustration" | "render" | "generated";
}

const { eyebrow, title, tagline, image, imageAlt, level = "h1", imageKind } = Astro.props;
const Heading = level;

// Naming the kind is enough — "Render" already says it isn't a photograph.
// No label for `generated`: stamping how a picture was made across the
// opener is a note about our production process, not about the place, and it
// is the first thing a visitor reads.
const KIND_LABEL: Record<string, string> = {
  diagram: "Diagram",
  illustration: "Illustration",
  render: "Render",
};
const kindLabel = imageKind && imageKind !== "photo" ? KIND_LABEL[imageKind] : undefined;
---
<div class:list={["photo-hero", { "is-plain": !image }]}>
  {image && <Photo src={image} alt={imageAlt ?? title} loading="eager" fetchpriority="high" sizes="100vw" />}
  {image && kindLabel && <p class="photo-hero-kind">{kindLabel}</p>}
  <div class="photo-hero-caption">
    <p class="eyebrow">{eyebrow}</p>
    <Heading>{title}</Heading>
    {tagline && <p class="photo-hero-tagline">{tagline}</p>}
  </div>
</div>

<style>
  .photo-hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    /* Scales with the viewport so the opener stays a proper image on a wide
       screen instead of a letterbox strip. */
    min-height: clamp(300px, 34vw, 460px);
    overflow: hidden;
    background: var(--surface-sunk);
  }
  .photo-hero img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .photo-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    /* Deep enough to carry white text over anything the picture puts under
       it. At 0.45 across the caption band the eyebrow landed on a lit sign
       in the fwf photo and the two sets of white letters read as one. The
       band the caption occupies is now held dark; the top of the picture is
       left alone. */
    background: linear-gradient(
      to top,
      rgba(8, 10, 13, 0.93) 0%,
      rgba(8, 10, 13, 0.82) 35%,
      rgba(8, 10, 13, 0.5) 62%,
      rgba(8, 10, 13, 0) 88%
    );
  }

  .photo-hero.is-plain { min-height: 0; background: none; }
  .photo-hero.is-plain::after { display: none; }
  .photo-hero.is-plain .photo-hero-caption { padding: 0; }
  .photo-hero.is-plain :is(h1, h2) { color: var(--ink); text-shadow: none; }
  .photo-hero.is-plain .photo-hero-tagline { color: var(--ink-muted); text-shadow: none; }

  /* Bottom-right, out of the way of the heading but on the image itself —
     it has to travel with the picture, not sit in body copy below it. */
  .photo-hero-kind {
    position: absolute;
    right: var(--space-2);
    bottom: var(--space-2);
    z-index: 1;
    margin: 0;
    padding: 0.25em 0.6em;
    border-radius: var(--radius);
    background: rgba(8, 10, 13, 0.55);
    color: rgba(255, 255, 255, 0.92);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.02em;
  }
  @media (max-width: 640px) {
    .photo-hero-kind { font-size: 0.8rem; }
  }

  .photo-hero-caption {
    position: relative;
    z-index: 1;
    padding: var(--space-4) var(--space-3) var(--space-3);
    /* A rem cap, not ch: ch resolves against this box's own (body-sized)
       font, which left a display-sized heading wrapping in a ~320px column. */
    max-width: 42rem;
  }
  /* Opaque white, not 0.75: the gradient under it varies with the photo, and
     a label the reader has to work at is not worth the extra softness. */
  .photo-hero-caption .eyebrow { margin: 0 0 var(--space-1); color: #fff; }
  .photo-hero-caption :is(h1, h2) {
    margin: 0;
    color: #fff;
    font-size: clamp(var(--step-4), 5vw, 3.6rem);
    letter-spacing: -0.015em;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.35);
  }
  .photo-hero-tagline {
    margin: var(--space-1) 0 0;
    color: rgba(255, 255, 255, 0.85);
    font-size: var(--step-1);
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.35);
  }

  @media (max-width: 640px) {
    .photo-hero { min-height: 260px; }
    /* The box is shorter but the caption isn't, so it reaches further up
       into the picture — the same stops leave the eyebrow on a thinner part
       of the scrim than they do on a desktop-height hero. */
    .photo-hero::after {
      background: linear-gradient(
        to top,
        rgba(8, 10, 13, 0.94) 0%,
        rgba(8, 10, 13, 0.82) 45%,
        rgba(8, 10, 13, 0.45) 72%,
        rgba(8, 10, 13, 0) 92%
      );
    }
    .photo-hero-caption :is(h1, h2) { font-size: var(--step-3); }
  }
</style>
