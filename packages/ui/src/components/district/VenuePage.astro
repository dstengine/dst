---
// Detail page for a single geo-object (café, restaurant, gym…). Every block
// below the hero is optional and renders only when its data exists, so the
// same template covers a venue we know one paragraph about and one we've
// written a full guide to — see each app's src/pages/<topic>/[slug].astro.
import { iconFor } from "../../icons";
import VenueCard from "./VenueCard.astro";
import PhotoHero from "./PhotoHero.astro";

interface Highlight {
  title: string;
  text: string;
}

interface Detail {
  label: string;
  value: string;
}

interface HoursRow {
  days: string;
  time: string;
}

interface Related {
  href: string;
  name: string;
  blurb: string;
  meta?: string;
  image?: string;
}

interface Props {
  eyebrow: string;
  name: string;
  tagline?: string;
  description: string;
  image?: string;
  gallery?: string[];
  building?: string;
  hours?: string | HoursRow[];
  phone?: string;
  details?: Detail[];
  highlights?: Highlight[];
  sections?: { heading?: string; paragraphs: string[] }[];
  externalHref?: string;
  externalLabel?: string;
  mapHref?: string;
  related?: Related[];
  relatedHeading?: string;
  backHref: string;
  backLabel: string;
}

const {
  eyebrow,
  name,
  tagline,
  description,
  image,
  gallery,
  building,
  hours,
  phone,
  details,
  highlights,
  sections,
  externalHref,
  externalLabel = "Instagram",
  mapHref,
  related,
  relatedHeading = "Nearby",
  backHref,
  backLabel,
} = Astro.props;

const pinPath = iconFor("/pin/");
const clockPath = iconFor("/clock/");
const phonePath = iconFor("/phone/");

const hourRows: HoursRow[] = typeof hours === "string" ? [{ days: "Daily", time: hours }] : hours ?? [];
const hasPanel = Boolean(building || hourRows.length || phone || details?.length || externalHref || mapHref);
---
<nav class="container venue-crumb">
  <a href={backHref} title={backLabel}>&larr; {backLabel}</a>
</nav>

<header class="container venue-hero">
  <PhotoHero eyebrow={eyebrow} title={name} tagline={tagline} image={image} />
</header>

<div class="container venue-body">
  <div class="venue-main">
    <p class="lede">{description}</p>

    {highlights && highlights.length > 0 && (
      <ul class="venue-highlights">
        {highlights.map((highlight) => (
          <li>
            <h2>{highlight.title}</h2>
            <p set:html={highlight.text} />
          </li>
        ))}
      </ul>
    )}

    {sections?.map((section) => (
      <section class="venue-section">
        {section.heading && <h2>{section.heading}</h2>}
        {section.paragraphs.map((paragraph) => <p set:html={paragraph} />)}
      </section>
    ))}
  </div>

  {hasPanel && (
    <aside class="venue-panel">
      <div class="venue-panel-inner">
        {building && (
          <div class="venue-fact">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={pinPath} /></svg>
            <div>
              <p class="venue-fact-label">Address</p>
              <p class="venue-fact-value">{building}</p>
            </div>
          </div>
        )}

        {hourRows.length > 0 && (
          <div class="venue-fact">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={clockPath} /></svg>
            <div>
              <p class="venue-fact-label">Hours</p>
              {hourRows.map((row) => (
                <p class="venue-fact-value">
                  {hourRows.length > 1 && <span class="venue-fact-days">{row.days}</span>}
                  {row.time}
                </p>
              ))}
            </div>
          </div>
        )}

        {phone && (
          <div class="venue-fact">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={phonePath} /></svg>
            <div>
              <p class="venue-fact-label">Phone</p>
              <p class="venue-fact-value"><a href={`tel:${phone.replace(/\s/g, "")}`} title={`Call ${name}`}>{phone}</a></p>
            </div>
          </div>
        )}

        {details && details.length > 0 && (
          <dl class="venue-details">
            {details.map((detail) => (
              <div>
                <dt>{detail.label}</dt>
                <dd>{detail.value}</dd>
              </div>
            ))}
          </dl>
        )}

        {(externalHref || mapHref) && (
          <div class="venue-panel-actions">
            {externalHref && <a class="button" href={externalHref} title={`${name} on ${externalLabel}`}>{externalLabel} &rarr;</a>}
            {mapHref && <a class="button button-secondary" href={mapHref} title={`${name} on the map`}>Directions</a>}
          </div>
        )}
      </div>
    </aside>
  )}
</div>

{gallery && gallery.length > 0 && (
  <section class="container venue-gallery">
    {gallery.map((src) => <img src={src} alt="" loading="lazy" />)}
  </section>
)}

{related && related.length > 0 && (
  <section class="container venue-related">
    <h2>{relatedHeading}</h2>
    <div class="venue-grid">
      {related.map((venue) => <VenueCard {...venue} />)}
    </div>
  </section>
)}

<style>
  .venue-crumb {
    padding-top: var(--space-4);
    font-size: var(--step--1);
    font-weight: 600;
  }
  .venue-crumb a { text-decoration: none; }
  .venue-crumb a:hover { text-decoration: underline; }

  .venue-hero { margin-top: var(--space-2); }

  .venue-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: var(--space-5);
    align-items: start;
    margin-top: var(--space-4);
  }
  .venue-main .lede { margin-top: 0; }

  /* Hairline-separated notes rather than a row of boxes — fewer frames on
     the page reads more considered next to the full-bleed hero. */
  .venue-highlights {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  .venue-highlights li {
    max-width: none;
    padding-top: var(--space-3);
    border-top: 1px solid var(--border);
  }
  .venue-highlights h2 {
    margin: 0 0 var(--space-1);
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .venue-highlights p { margin: 0; color: var(--ink-muted); }

  .venue-section h2 { font-size: var(--step-2); }

  .venue-panel-inner {
    position: sticky;
    top: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-3);
    background: var(--surface);
    border: 1px solid var(--border);
  }
  .venue-fact { display: flex; gap: var(--space-2); }
  .venue-fact svg { width: 18px; height: 18px; flex-shrink: 0; margin-top: 2px; color: var(--accent); }
  .venue-fact-label {
    margin: 0 0 2px;
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .venue-fact-value { margin: 0; font-size: var(--step--1); line-height: 1.5; color: var(--ink); }
  .venue-fact-days { display: block; color: var(--ink-faint); }

  .venue-details { margin: 0; display: grid; gap: var(--space-1); }
  .venue-details > div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    padding-top: var(--space-1);
    border-top: 1px solid var(--border);
    font-size: var(--step--1);
  }
  .venue-details dt { color: var(--ink-faint); }
  .venue-details dd { margin: 0; text-align: right; color: var(--ink); }

  .venue-panel-actions { display: flex; flex-direction: column; gap: var(--space-1); }
  .venue-panel-actions .button { justify-content: center; }

  .venue-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-2);
    margin-top: var(--space-4);
  }
  .venue-gallery img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .venue-related h2 { font-size: var(--step-2); }

  @media (max-width: 900px) {
    .venue-body { grid-template-columns: 1fr; gap: var(--space-4); }
    .venue-panel-inner { position: static; }
  }
</style>
