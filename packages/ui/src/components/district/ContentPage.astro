---
// Generic content-page body shared by every district site's coffee/food/
// pools/water/money/news/events pages: hero, then a list of sections, then
// an optional callout. Sites differ only in the data passed in — see each
// app's src/content.ts.
import Callout from "../Callout.astro";
import VenueCard from "./VenueCard.astro";

interface Section {
  heading?: string;
  paragraphs: string[];
}

interface Venue {
  href: string;
  name: string;
  blurb: string;
  meta?: string;
  tag?: string;
  icon?: string;
  image?: string;
}

interface Props {
  sections: Section[];
  venues?: Venue[];
  venuesHeading?: string;
  calloutKind?: "note" | "warn";
  callout?: string;
}

const { sections, venues, venuesHeading, calloutKind = "warn", callout } = Astro.props;
---
{sections.map((section) => (
  <section class="container">
    {section.heading && <h2>{section.heading}</h2>}
    {section.paragraphs.map((paragraph) => <p set:html={paragraph} />)}
  </section>
))}

{venues && venues.length > 0 && (
  <section class="container">
    {venuesHeading && <h2>{venuesHeading}</h2>}
    <div class="venue-grid">
      {venues.map((venue) => <VenueCard {...venue} />)}
    </div>
  </section>
)}

{callout && (
  <Callout kind={calloutKind}>
    <p set:html={callout} />
  </Callout>
)}
