---
// Rent-page body shared by every district site: hero, a short list of what
// varies, then a lead form with site-specific extra fields.
import LeadForm from "../LeadForm.astro";

interface FormField {
  id: string;
  name: string;
  label: string;
  defaultOption: string;
  options: { value: string; label: string }[];
}

interface Props {
  varies: { label: string; text: string }[];
  formSubmitLabel: string;
  formFields: FormField[];
  formName: string;
  formDescription: string;
}

const { varies, formSubmitLabel, formFields, formName, formDescription } = Astro.props;
---
<section class="container">
  <h2>What actually varies</h2>
  <ul>
    {varies.map((item) => (
      <li><strong>{item.label}</strong> &mdash; <span set:html={item.text} /></li>
    ))}
  </ul>
</section>

<section class="container">
  <h2>Get a shortlist</h2>
  <LeadForm submitLabel={formSubmitLabel} formName={formName} formDescription={formDescription}>
    <input type="hidden" name="type" value="district-rent" />
    {formFields.map((field) => (
      <div class="field">
        <label for={field.id}>{field.label}</label>
        <select id={field.id} name={field.name}>
          <option value="">{field.defaultOption}</option>
          {field.options.map((option) => (
            <option value={option.value}>{option.label}</option>
          ))}
        </select>
      </div>
    ))}
  </LeadForm>
</section>
