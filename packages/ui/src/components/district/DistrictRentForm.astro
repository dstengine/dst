---
// Rent-page body shared by every district site: hero, a short list of what
// varies, then a lead form with site-specific extra fields.
import LeadForm from "../LeadForm.astro";

interface FormField {
  id: string;
  name: string;
  label: string;
  defaultOption: string;
  options: { value: string; label: string }[];
}

interface Props {
  eyebrow: string;
  h1: string;
  lede: string;
  varies: { label: string; text: string }[];
  formSubmitLabel: string;
  formFields: FormField[];
  ledeWidth?: string;
}

const { eyebrow, h1, lede, varies, formSubmitLabel, formFields, ledeWidth } = Astro.props;
---
<section class="container hero">
  <p class="eyebrow">{eyebrow}</p>
  <h1>{h1}</h1>
  <p class="lede" style={ledeWidth ? `max-width: ${ledeWidth}` : undefined} set:html={lede} />
</section>

<section class="container">
  <h2>What actually varies</h2>
  <ul>
    {varies.map((item) => (
      <li><strong>{item.label}</strong> &mdash; <span set:html={item.text} /></li>
    ))}
  </ul>
</section>

<section class="container">
  <h2>Get a shortlist</h2>
  <LeadForm endpoint="/api/lead" submitLabel={formSubmitLabel}>
    {formFields.map((field) => (
      <div class="field">
        <label for={field.id}>{field.label}</label>
        <select id={field.id} name={field.name}>
          <option value="">{field.defaultOption}</option>
          {field.options.map((option) => (
            <option value={option.value}>{option.label}</option>
          ))}
        </select>
      </div>
    ))}
  </LeadForm>
</section>
