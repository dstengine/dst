---
// "Source: Nakheel · verified 25 Aug 2026".
//
// The name is plain text on purpose — source URLs are an audit trail and
// never reach rendered HTML (see the news/events spec). The verified date
// is the part nobody else publishes: a property portal will quote a price
// without ever saying when anyone last checked it, so a reader has no way
// to tell a fact confirmed this week from one left over from last year.
import type { Source } from "@dst/content/types";
import { formatDate } from "../date.ts";
import { EN, type ArticleLabels } from "../labels.ts";

interface Props {
  source: Source;
  /** Locale for the checked-on date. Defaults to the network's English. */
  locale?: string;
  /** Already merged by the article above; English when rendered alone. */
  labels?: ArticleLabels;
}
const { source, locale = "en-US", labels: L = EN } = Astro.props;
---
<p class="source-line">
  <span>{L.source}: {source.name}</span>
  {source.verifiedOn && (
    <>
      <span class="source-line-sep" aria-hidden="true">·</span>
      {/* Spelled out rather than left as "verified": readers — and review
          tools — kept reading a later check date as a contradiction with
          the publication date instead of as what it is. */}
      <span class="source-line-checked" title={L.checkedTitle(source.name)}>
        {L.checkedAgainstSource} <time datetime={source.verifiedOn}>{formatDate(source.verifiedOn, locale)}</time>
      </span>
    </>
  )}
</p>

<style>
  .source-line {
    /* One value for the column gap and the dot drawn inside it (below). */
    --source-line-gap: 1.4em;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5em var(--source-line-gap);
    /* Not stray: when the checked span starts a line, its dot sits left of
       the paragraph, and this clip is what keeps it from being painted.
       Remove it and every wrapped line opens with a lone "·". Nothing in
       the line takes focus today; a link added here would have its focus
       ring cut, and needs `clip-path: inset(-1em -1em -1em 0)` (the left
       edge only) in place of this. */
    overflow: hidden;
    margin: var(--space-4) 0 0;
    font-size: var(--step--1);
    color: var(--ink-faint);
  }
  /* The dot is drawn by .source-line-checked::before. This span stays in the
     HTML (aria-hidden) so the markup of every entry page is unchanged. As a
     flex item of its own it went wherever wrapping put it: alone on a line,
     after the name with nothing following, or ahead of the checked line. */
  .source-line-sep { display: none; }
  .source-line-checked {
    position: relative;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }
  /* Centred in the column gap to the left of the span: between name and
     check when both are on one line, outside the paragraph (and clipped)
     when the span starts a line. A separator only where it separates. */
  .source-line-checked::before {
    content: "\00B7";
    /* Empty alternative text: screen readers stay as silent as they were for
       the aria-hidden span. A browser that cannot parse it keeps the line above. */
    content: "\00B7" / "";
    position: absolute;
    left: calc(-1 * var(--source-line-gap));
    width: var(--source-line-gap);
    text-align: center;
    color: var(--border);
  }
  /* The date is the one thing this line publishes that nobody else does: it
     stays whole, and the span wraps before it ("Sep" / "15, 2026" at 320). */
  .source-line time { white-space: nowrap; }
</style>
