---
// The card layout shared by news and events, everywhere either appears: the
// blocks on a front page, the /news/ and /events/ listings, and the feed at
// the foot of an article.
//
// It replaces a date-and-headline list. The list was the format of a press
// centre — right for a reader who already came for the fact, wrong for a page
// whose job is to make the network look worth reading.
//
// The date cover belongs to events only. It was written as the fallback for
// any card without a picture, which was fine while most news carried one — but
// a site with no photography at all turned every card into a slab of accent
// tint, four of them to a screen, and the accent stopped reading as an accent.
// A date block also says something an event means and a news item does not:
// there is a day you can turn up. News without a picture now opens on its
// headline, and keeps its date in the meta line where it already was.
// A card with no picture puts its date on the cover instead. For an event
// that is the point of the card anyway — the date is what a reader is deciding
// about, and a stock skyline over every conference would say less. For a news
// item without artwork it beats both a blank panel and a lopsided grid where
// one card has a cover and the next starts with a headline.
import Photo from "./Photo.astro";
import { formatDate } from "../date.ts";
import { EN, type ArticleLabels } from "../labels.ts";

export interface FeedCardItem {
  href?: string;
  /** Category, or the source site on a network-wide roundup. */
  eyebrow?: string;
  /** ISO date: publication date for news, start date for an event. */
  date: string;
  title: string;
  /** Shown in place of `title` when the headline is too long for a column
      215px wide. The h3 is not clamped — a four-line headline raises every
      card in the row and squeezes the summary under it into an ellipsis.
      `title` still goes on the anchor's title attribute, so the full
      headline stays one hover away and the h1 behind the card is unchanged. */
  short?: string;
  /** Summary for news; venue and city for an event. */
  text?: string;
  image?: string;
  imageAlt?: string;
  /** How the picture meets its box. A photograph fills it; a diagram is
      fitted whole, because cropping a chart cuts off the numbers. */
  imageFit?: "cover" | "contain";
  /** Events render a date cover and a countdown instead of an image. */
  event?: boolean;
  /** Set when the picture already carries the date — a poster, a printed
      programme. Then the cover is left alone, because two dates on one
      card is worse than none. Nothing in the network sets it yet; the
      generated covers deliberately carry no lettering at all. */
  dateInImage?: boolean;
  /** Marks an event that has already happened. */
  past?: boolean;
}

interface Props {
  items: FeedCardItem[];
  /** Pin the column count when the caller knows how many cards there are. */
  columns?: number;
  /** Locale for dates on this page. Defaults to the network's English;
      a site writing in another language passes its own. */
  locale?: string;
  /** Already merged by the article or block above; English on its own. */
  labels?: ArticleLabels;
}
const { items, columns, locale = "en-US", labels: L = EN } = Astro.props;

// en-GB rather than en-US for the cover month only: it abbreviates
// September as "Sept", which is what the network has always shown.
const monthLocale = locale === "en-US" ? "en-GB" : locale;
/* An event card carries the date cover. It used to lose it as soon as the
   event had a picture, and the card came out as artwork with a headline —
   the one thing a reader is deciding about, gone. Nothing about the block
   changes when there is a picture: the same numbers at the same size in the
   same place. Only what is behind it changes, from a flat panel of accent
   tint to the picture under a wash of that same tint.

   A picture that already has the date printed on it — a poster, a printed
   programme — opts out, because two dates on one card is worse than none.
   Nothing sets it yet; the covers deliberately carry no lettering at all.
   News keeps its date in the meta line, where a filing stamp belongs. */
const dated = (item: FeedCardItem) => Boolean(item.event && !item.dateInImage);

const parts = (iso: string) => {
  const d = new Date(`${iso}T00:00:00Z`);
  return {
    day: String(d.getUTCDate()).padStart(2, "0"),
    month: d.toLocaleString(monthLocale, { month: "short", timeZone: "UTC" }).toUpperCase(),
    year: d.getUTCFullYear(),
  };
};
---
<div class="feed-shell">
<div
  class:list={["feed-cards", columns && "feed-cards-pinned", items.length === 1 && "feed-cards-single"]}
  style={columns ? `--feed-columns: ${columns}` : undefined}
>
  {items.map((item) => {
    const Tag = item.href ? "a" : "article";
    const when = parts(item.date);
    return (
      <Tag class="feed-card" href={item.href} title={item.href ? item.title : undefined}>
        {(item.image || item.event) && (
          <div class:list={["feed-cover", dated(item) && "feed-cover-date", dated(item) && item.image && "feed-cover-backed"]}>
            {item.image && (
              <Photo class:list={[item.imageFit === "cover" && "feed-cover-fill"]} src={item.image} alt={item.imageAlt ?? ""} sizes="(max-width: 700px) 100vw, 380px" />
            )}
            {dated(item) && (
              <div class="feed-date" aria-hidden="true">
                <span class="feed-date-day">{when.day}</span>
                <span class="feed-date-month">{when.month}</span>
                <span class="feed-date-year">{when.year}</span>
              </div>
            )}
          </div>
        )}
        <div class="feed-body">
          <p class="feed-meta">
            {item.eyebrow && <span class="feed-eyebrow">{item.eyebrow}</span>}
            <time datetime={item.date}>{formatDate(item.date, locale)}</time>
            {/* Filled in by CountdownScript where it's loaded; empty without
                JavaScript, where the date above already says everything. */}
            {item.event && !item.past && <span class="feed-countdown" data-countdown datetime={item.date}></span>}
            {item.past && <span class="feed-past">{L.past}</span>}
          </p>
          <h3>{item.short ?? item.title}</h3>
          {item.text && <p class="feed-text">{item.text}</p>}
        </div>
      </Tag>
    );
  })}
</div>
</div>

<style>
  /* Container queries, not media queries: these cards sit in a full-width
     section on one page, in a 46rem article column on another, and in a ~310px
     sidebar column on the district template. Keyed to the viewport, the
     side-by-side layout below switched on in that 310px column too and clipped
     the date clean off the cover. What matters is the space the cards have. */
  .feed-shell { container-type: inline-size; }

  .feed-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(260px, 100%), 1fr));
    gap: var(--space-3);
    margin-top: var(--space-3);
  }
  @container (min-width: 560px) {
    .feed-cards-pinned { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    /* An odd card out spans the row rather than leaving a gap — and turns
       sideways while it does, for the same reason a lone card does below.
       It's the first card that gets the space, not the last: in a feed
       sorted soonest-first, the one being given a whole row is the one the
       reader is most likely to act on. `:first-child:nth-last-child(odd)`
       is "first of an odd number of cards" — the same count test as before,
       read from the other end. */
    .feed-cards-pinned > :first-child:nth-last-child(odd) {
      grid-column: span 2;
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
    .feed-cards-pinned > :first-child:nth-last-child(odd) .feed-cover { height: 100%; max-height: none; aspect-ratio: auto; }
    .feed-cards-pinned > :first-child:nth-last-child(odd) .feed-body { align-self: center; padding: var(--space-4); }
  }
  @container (min-width: 760px) {
    .feed-cards { grid-template-columns: repeat(var(--feed-columns, auto-fill), minmax(var(--feed-min, 260px), 1fr)); }
    .feed-cards-pinned { --feed-min: 0; }
    .feed-cards-pinned > :first-child:nth-last-child(odd) { grid-column: auto; display: flex; }
    /* The card goes back to being a plain column here, so its cover has to go
       back to a plain cover: the rule above only undid the layout, and the
       first card of an odd-numbered row kept height:100% and no ratio. Given
       a long headline the row's coloured band stepped down 30px on that card
       alone. Not for a lone card, which stays side by side at this width. */
    .feed-cards:not(.feed-cards-single).feed-cards-pinned > :first-child:nth-last-child(odd) .feed-cover {
      height: auto;
      aspect-ratio: 16 / 9;
    }
    /* And its body has to go back to a plain body, for the same reason: the
       560px rule gave the odd card the deeper padding and the vertical
       centring that go with the side-by-side layout, and neither was undone
       when the layout was. In a row of three that left card one sitting on
       4px more padding than the two beside it — visible as one card whose
       text starts lower and further in than its neighbours. */
    .feed-cards:not(.feed-cards-single).feed-cards-pinned > :first-child:nth-last-child(odd) .feed-body {
      align-self: auto;
      padding: var(--space-3);
    }
    /* Unless it is the only card there is: then it stays side by side. This
       rule has to out-specify the one above it, or a single-item feed came
       out as one full-width card with the cover blown up to the picture's own
       proportions — a portrait photo 1483px tall on a 1132px card. */
    .feed-cards-single.feed-cards-pinned > :first-child:nth-last-child(odd) {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
  }

  /* A lone card stretched across the grid blew its 16:9 cover up to the full
     width of the page — a chart three times the size of the headline under it.
     Given room it turns sideways instead: cover on the left at a sane size,
     text beside it. It also stops a single-entry feed reading as a fragment. */
  @container (min-width: 620px) {
    /* The row is one track wide, or auto-fill drops the lone card into the
       first of four and the side-by-side layout below plays out inside 265px. */
    .feed-cards.feed-cards-single { grid-template-columns: minmax(0, 1fr); }
    .feed-cards-single .feed-card { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
    /* Grid stretch doesn't apply to an item with an aspect-ratio, so the
       cover kept its 16:9 height and left an empty band under it whenever the
       text beside it ran taller. Dropping the ratio is part of the fix: with
       it still in force the height drives the width and the cover spills over
       the column of text next to it. */
    .feed-cards-single .feed-cover { height: 100%; max-height: none; aspect-ratio: auto; }
    /* Out of flow, so the cover takes the row's height rather than the
       picture's: a portrait photo otherwise stretched the card to 1710px. */
    .feed-cards-single .feed-cover img,
    .feed-cards-pinned > :first-child:nth-last-child(odd) .feed-cover img {
      position: absolute;
      inset: 0;
    }
    /* A floor as well as a ceiling: side by side, the cover's height comes
       from the text beside it, and a two-line summary left a 90px sliver. */
    .feed-cards-single .feed-card { min-height: 15rem; }
    .feed-cards-single .feed-body { align-self: center; padding: var(--space-4); }
    /* The date is the cover here, and at grid-card size it sat as a small mark
       in a large empty field. */
    .feed-cards-single .feed-date-day { font-size: clamp(3.5rem, 9cqw, 5.5rem); }
    .feed-cards-single .feed-date-month { font-size: var(--step-0); }
    .feed-cards-single .feed-date-year { font-size: var(--step-0); }
  }

  .feed-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  a.feed-card:hover { border-color: var(--accent); transform: translateY(-2px); }

  .feed-cover {
    position: relative;
    /* The card is a stretched flex column, so a cover with an aspect-ratio
       was the item that gave way when the text beside it in the row ran
       longer: in a row of three, one cover came out 161px tall and the other
       two 193px, and the coloured band stepped down mid-row. The cover keeps
       its ratio; the slack goes to the body. */
    flex: none;
    /* Explicit, not left to stretch. `flex: none` on a column flex item with
       both an aspect-ratio and a max-height gives WebKit two ways to size the
       cross axis, and it takes the ratio: the date cover, capped at 220px
       tall, came out 220 x 16/9 = 391px wide inside a 552px card and sat
       against the left edge with a third of the card empty beside it. Safari
       only — Chrome stretches — so it survived every check until it was seen.
       A definite width leaves the ratio only the height to determine. */
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: linear-gradient(140deg, var(--surface-sunk), var(--surface));
  }
  .feed-cover img {
    width: 100%;
    height: 100%;
    /* contain by default: a diagram cropped is a chart with its numbers cut
       off. A photograph says so with imageFit and fills the box instead. */
    object-fit: contain;
    transition: transform 0.4s ease;
  }
  a.feed-card:hover .feed-cover img { transform: scale(1.03); }
  /* Qualified by the element: `.feed-cover img` above is one step more
     specific than a lone class, so the bare selector never won. */
  .feed-cover img.feed-cover-fill { object-fit: cover; }

  /* The picture behind the date, rather than in place of it. Nothing about
     the block itself changes — same numerals at the same size in the same
     place — only what is behind them, from a flat panel of accent tint to
     the cover art. The scrim over that art is neutral and as light as it can
     be: enough to hold white at 4.5:1 over the brightest thing a cover has
     put under it, and not a second colour cast on a picture that already has
     its own. White rather than accent ink for the same reason — over a
     photograph the ink is a colour on a colour, and in one of the two themes
     it is the wrong one. */
  .feed-cover-backed .feed-date::before {
    content: "";
    position: absolute;
    inset: 0;
    /* 0.64, not less: the pale covers are the ones that set this floor —
       a cream ground under a lighter scrim measured 3.3:1 against white. */
    background: rgb(0 0 0 / 0.64);
  }
  .feed-cover-backed .feed-date {
    position: absolute;
    inset: 0;
    justify-content: center;
    color: #fff;
  }
  .feed-cover-backed .feed-date > * { position: relative; }

  .feed-cover-date {
    background: var(--accent-tint);
    /* A photograph deserves whatever height its ratio asks for; a date does
       not. Left at 16:9, a card that spans the full row turned three lines of
       numbers into a 450px field of flat colour. */
    max-height: 220px;
  }
  .feed-date {
    display: flex;
    max-width: 100%;
    flex-direction: column;
    align-items: center;
    line-height: 1;
    font-family: var(--font-mono);
    color: var(--accent-ink);
  }
  .feed-date-day { font-size: var(--step-4); font-weight: 600; letter-spacing: -0.03em; }
  .feed-date-month { margin-top: 0.35em; font-size: var(--step--1); letter-spacing: 0.18em; }
  .feed-date-year { margin-top: 0.35em; font-size: var(--step--1); opacity: 0.65; }

  .feed-body { padding: var(--space-3); }
  /* Single-column width: the card is the whole screen, so its padding is
     read as the page margin on top of the page margin. It comes down, and
     so do the gaps that were sized for cards sitting side by side. */
  @container (max-width: 559px) {
    .feed-cards { gap: var(--space-2); }
    .feed-body { padding: var(--space-2); }
    .feed-meta { gap: 0.35em 0.6em; }
    .feed-card h3 { margin-top: var(--space-1); }
  }
  .feed-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6em;
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    /* muted, not faint: a card sits on --surface, which is lighter than the
       page in dark mode, and --ink-faint came out at 4.24:1 against it. */
    color: var(--ink-muted);
  }
  .feed-eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    font-weight: 600;
  }
  /* A non-breaking space, not a plain one: the countdown is a flex item, so
     the trailing space in generated content collapsed and every card read
     "Nov 17, 2026 ·in 3 months". */
  .feed-countdown:not(:empty)::before { content: "\00b7\00a0"; }
  /* A chip, not a bare word: after a category and a date it read as a third
     run-on fragment of the same sentence. */
  .feed-past {
    padding: 0.15em 0.5em;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.85em;
    color: var(--ink-muted);
  }

  .feed-card h3 {
    margin-top: var(--space-2);
    margin-bottom: var(--space-1);
    font-size: var(--step-1);
    font-weight: 600;
  }
  .feed-text {
    margin: 0;
    font-size: var(--step--1);
    color: var(--ink-muted);
    /* Three lines: enough for a summary to make its point, capped so cards in
       a row keep the same height whatever the copy does. */
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }
</style>
