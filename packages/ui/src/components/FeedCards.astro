---
// The card layout shared by news and events, everywhere either appears: the
// blocks on a front page, the /news/ and /events/ listings, and the feed at
// the foot of an article.
//
// It replaces a date-and-headline list. The list was the format of a press
// centre — right for a reader who already came for the fact, wrong for a page
// whose job is to make the network look worth reading.
//
// An event card carries no photograph and doesn't want one: the date is the
// thing a reader is deciding about, so it becomes the cover. That's a design,
// not a placeholder — a stock skyline over every conference would say less.
import { formatDate } from "../date.ts";

export interface FeedCardItem {
  href?: string;
  /** Category, or the source site on a network-wide roundup. */
  eyebrow?: string;
  /** ISO date: publication date for news, start date for an event. */
  date: string;
  title: string;
  /** Summary for news; venue and city for an event. */
  text?: string;
  image?: string;
  imageAlt?: string;
  /** Events render a date cover and a countdown instead of an image. */
  event?: boolean;
  /** Marks an event that has already happened. */
  past?: boolean;
}

interface Props {
  items: FeedCardItem[];
  /** Pin the column count when the caller knows how many cards there are. */
  columns?: number;
}
const { items, columns } = Astro.props;

const parts = (iso: string) => {
  const d = new Date(`${iso}T00:00:00Z`);
  return {
    day: String(d.getUTCDate()).padStart(2, "0"),
    month: d.toLocaleString("en-GB", { month: "short", timeZone: "UTC" }).toUpperCase(),
    year: d.getUTCFullYear(),
  };
};
---
<div
  class:list={["feed-cards", columns && "feed-cards-pinned", items.length === 1 && "feed-cards-single"]}
  style={columns ? `--feed-columns: ${columns}` : undefined}
>
  {items.map((item) => {
    const Tag = item.href ? "a" : "article";
    const when = parts(item.date);
    return (
      <Tag class="feed-card" href={item.href} title={item.href ? item.title : undefined}>
        <div class:list={["feed-cover", item.event && "feed-cover-date"]}>
          {item.event ? (
            <div class="feed-date" aria-hidden="true">
              <span class="feed-date-day">{when.day}</span>
              <span class="feed-date-month">{when.month}</span>
              <span class="feed-date-year">{when.year}</span>
            </div>
          ) : (
            item.image && <img src={item.image} alt={item.imageAlt ?? ""} loading="lazy" />
          )}
        </div>
        <div class="feed-body">
          <p class="feed-meta">
            {item.eyebrow && <span class="feed-eyebrow">{item.eyebrow}</span>}
            <time datetime={item.date}>{formatDate(item.date)}</time>
            {/* Filled in by CountdownScript where it's loaded; empty without
                JavaScript, where the date above already says everything. */}
            {item.event && !item.past && <span class="feed-countdown" data-countdown datetime={item.date}></span>}
            {item.past && <span class="feed-past">Past</span>}
          </p>
          <h3>{item.title}</h3>
          {item.text && <p class="feed-text">{item.text}</p>}
        </div>
      </Tag>
    );
  })}
</div>

<style>
  .feed-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-3);
    margin-top: var(--space-3);
  }
  @media (min-width: 560px) and (max-width: 759px) {
    .feed-cards-pinned { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .feed-cards-pinned > :last-child:nth-child(odd) { grid-column: span 2; }
  }
  @media (min-width: 760px) {
    .feed-cards { grid-template-columns: repeat(var(--feed-columns, auto-fill), minmax(var(--feed-min, 260px), 1fr)); }
    .feed-cards-pinned { --feed-min: 0; }
  }

  /* A lone card stretched across the grid blew its 16:9 cover up to the full
     width of the page — a chart three times the size of the headline under it.
     On its own it turns sideways instead: cover on the left at a sane size,
     text beside it. It also stops a single-entry feed reading as a fragment. */
  @media (min-width: 760px) {
    .feed-cards-single .feed-card { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
    .feed-cards-single .feed-body { align-self: center; padding: var(--space-4); }
    /* The date is the cover here, and at grid-card size it sat as a small mark
       in a large empty field. */
    .feed-cards-single .feed-date-day { font-size: clamp(3.5rem, 7vw, 5.5rem); }
    .feed-cards-single .feed-date-month { font-size: var(--step-0); }
    .feed-cards-single .feed-date-year { font-size: var(--step-0); }
  }

  .feed-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  a.feed-card:hover { border-color: var(--accent); transform: translateY(-2px); }

  .feed-cover {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: linear-gradient(140deg, var(--surface-sunk), var(--surface));
  }
  .feed-cover img {
    width: 100%;
    height: 100%;
    /* contain, not cover: every news image in the network is a diagram, and
       cropping a chart cuts off the numbers it exists to show. */
    object-fit: contain;
    transition: transform 0.4s ease;
  }
  a.feed-card:hover .feed-cover img { transform: scale(1.03); }

  .feed-cover-date { background: var(--accent-tint); }
  .feed-date {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
    font-family: var(--font-mono);
    color: var(--accent-ink);
  }
  .feed-date-day { font-size: var(--step-4); font-weight: 600; letter-spacing: -0.03em; }
  .feed-date-month { margin-top: 0.35em; font-size: var(--step--1); letter-spacing: 0.18em; }
  .feed-date-year { margin-top: 0.35em; font-size: var(--step--1); opacity: 0.65; }

  .feed-body { padding: var(--space-3); }
  .feed-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6em;
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    /* muted, not faint: a card sits on --surface, which is lighter than the
       page in dark mode, and --ink-faint came out at 4.24:1 against it. */
    color: var(--ink-muted);
  }
  .feed-eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    font-weight: 600;
  }
  .feed-countdown:not(:empty)::before { content: "· "; }
  .feed-past { color: var(--ink-muted); }

  .feed-card h3 {
    margin-top: var(--space-2);
    margin-bottom: var(--space-1);
    font-size: var(--step-1);
    font-weight: 600;
  }
  .feed-text {
    margin: 0;
    font-size: var(--step--1);
    color: var(--ink-muted);
    /* Three lines: enough for a summary to make its point, capped so cards in
       a row keep the same height whatever the copy does. */
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }
</style>
