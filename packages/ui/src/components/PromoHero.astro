---
// A page's intro row with the promo card beside it (PromoCode.astro). The
// intro — breadcrumbs, h1, lede, a search box — keeps the left edge in the
// slot; the card takes the room to its right that the 34rem lede leaves
// empty, level with the top of the intro: a venue page keeps its fact
// table in the same row, and a card aligned to the bottom read as part of
// that table. On a phone it follows the intro. Every `container hero`
// section on the network goes through this since 31 Oct 2026; without a
// code to show (no `Astro.site`), the row is the plain hero it was.
import PromoCode from "./PromoCode.astro";

interface Props {
  lang?: "en" | "es" | "de" | "hy";
}
const { lang = "en" } = Astro.props;
const code = Astro.site ? new URL(Astro.site).hostname : "";
---
<section class:list={["container", "hero", { "hero-promo": code }]}>
  {code ? (
    <>
      <div><slot /></div>
      <PromoCode lang={lang} code={code} />
    </>
  ) : <slot />}
</section>

<style>
  .hero-promo {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: var(--space-4);
    row-gap: var(--space-3);
    align-items: start;
  }
  @media (max-width: 700px) {
    .hero-promo { grid-template-columns: minmax(0, 1fr); }
    /* Stacked, the card is the last thing in the hero and the next heading
       sat on its border. On the section, not the card: a scoped selector
       does not reach a child component's root. */
    .hero-promo { padding-bottom: var(--space-4); }
  }
</style>
