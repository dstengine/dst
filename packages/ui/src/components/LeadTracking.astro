---
// Ports the lead-metadata collection from DKey (dkey-theme/js/main.js) to
// the DST network, same mechanism and shape - just renamed dkey_ -> dst_:
//   - geo: requested at the moment of form interaction (not on page load,
//     so the permission prompt reads as a response to intent rather than
//     random), GPS first with an IP-based fallback if denied, unavailable,
//     or geolocation doesn't exist; GPS gives coordinates only, so a
//     country/city name is filled in after the fact via free, keyless
//     reverse geocoding (Nominatim/OpenStreetMap), best-effort.
//     The IP fallback asks our own API, which reads the coarse location
//     Vercel's edge already puts on the request. It used to ask ipapi.co
//     on every page load, which sent every visitor's address to a third
//     party before the visitor had done anything, and whose free tier is
//     rated per client IP - over the limit it answers 429 with no CORS
//     headers, so the failure showed up as a CORS error in the console on
//     all seven sites. api/v1/lead fills the same fields server-side as a
//     backstop, so a lead carries a location even if this never runs.
//     The partner's DKey site has its own mechanism and does not use
//     this API.
//   - history: a unified page-view + link-click log, one entry shape
//     distinguished by "type", mirrored into localStorage and a cookie
//     (so it survives either being cleared) and capped at 50 entries.
//   - utm: first-touch UTM params, captured once from whichever page's query
//     string the visitor actually landed on and never overwritten after -
//     same persistence as history, so a form submitted pages later still
//     carries the campaign that brought the visitor in.
// Included once in BaseLayout so it runs on every page of every site -
// history/utm in particular need to see the pages visited before whichever
// one the visitor eventually converts on, not just the form page itself.
// LeadForm.astro reads window.__dstGeoMeta / window.dstGetHistory() /
// window.dstGetUtm() at submit time into lead.geo / lead.meta.history / lead.ref.
---
<script>
  // *** IP geolocation, from our own API, and only once the visitor has
  // engaged with a form - see the note above for what this replaced ***
  const GEO_ENDPOINT = "https://api.dst.llc/api/v1/geo";

  (window as any).__dstGeoMeta = { source: "", lat: "", lng: "", accuracy: "", country: "", city: "", region: "" };

  function applyIpFallbackGeo() {
    fetch(GEO_ENDPOINT)
      .then((r) => (r.ok ? r.json() : null))
      .then((data) => {
        if (!data || !data.source) return;
        (window as any).__dstGeoMeta = {
          source: "ip",
          lat: data.lat || "",
          lng: data.lng || "",
          accuracy: "",
          country: data.country || "",
          city: data.city || "",
          region: data.region || "",
        };
      })
      .catch(() => {});
  }

  // GPS gives coordinates only, not a place name - fill in country/city
  // after the fact via reverse geocoding. Best-effort: if it errors, times
  // out, or the visitor already submitted before it resolves, the
  // submission just goes out with lat/lng and no country/city.
  function reverseGeocodeGps(lat: number, lng: number) {
    fetch(`https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${lat}&lon=${lng}&zoom=10&addressdetails=1`)
      .then((r) => r.json())
      .then((data) => {
        const addr = data && data.address;
        const geo = (window as any).__dstGeoMeta;
        if (!addr || geo.source !== "gps") return;
        (window as any).__dstGeoMeta = Object.assign({}, geo, {
          country: addr.country || "",
          city: addr.city || addr.town || addr.village || addr.county || "",
          region: addr.state || "",
        });
      })
      .catch(() => {});
  }

  let geoRequested = false;
  (window as any).dstRequestLeadLocation = function dstRequestLeadLocation() {
    if (geoRequested) return; // ask at most once per page load
    geoRequested = true;

    if (navigator.geolocation) {
      navigator.geolocation.getCurrentPosition(
        (pos) => {
          (window as any).__dstGeoMeta = {
            source: "gps",
            lat: pos.coords.latitude,
            lng: pos.coords.longitude,
            accuracy: pos.coords.accuracy,
            country: "",
            city: "",
            region: "",
          };
          reverseGeocodeGps(pos.coords.latitude, pos.coords.longitude);
        },
        () => applyIpFallbackGeo(), // denied, timed out, or position unavailable
        { timeout: 8000, maximumAge: 300000 }
      );
    } else {
      applyIpFallbackGeo();
    }
  };

  // *** Persisted activity history: page views + link clicks ***
  const PREFIX = "dst_";
  const COOKIE_DAYS = 365;
  const HISTORY_KEY = "history";
  const HISTORY_MAX = 50;
  const UTM_KEY = "utm";
  const UTM_PARAMS = ["utm_source", "utm_medium", "utm_campaign", "utm_term", "utm_content"];

  function setCookie(name: string, value: string) {
    const expires = new Date(Date.now() + COOKIE_DAYS * 864e5).toUTCString();
    document.cookie = `${name}=${encodeURIComponent(value)}; expires=${expires}; path=/; SameSite=Lax`;
  }

  function getCookie(name: string) {
    const escaped = name.replace(/([.$?*|{}()[\]\\/+^])/g, "\\$1");
    const match = document.cookie.match(new RegExp(`(?:^|; )${escaped}=([^;]*)`));
    return match ? decodeURIComponent(match[1]) : null;
  }

  function saveValue(key: string, value: string) {
    const full = PREFIX + key;
    try {
      localStorage.setItem(full, value);
    } catch {}
    setCookie(full, value);
  }

  function loadValue(key: string): string | null {
    const full = PREFIX + key;
    try {
      const fromStorage = localStorage.getItem(full);
      if (fromStorage !== null) return fromStorage;
    } catch {}
    return getCookie(full);
  }

  function getHistory(): Array<Record<string, unknown>> {
    try {
      return JSON.parse(loadValue(HISTORY_KEY) || "[]");
    } catch {
      return [];
    }
  }

  function addToHistory(entry: Record<string, unknown>) {
    const history = getHistory();
    history.push(Object.assign({ ts: Date.now() }, entry));
    saveValue(HISTORY_KEY, JSON.stringify(history.slice(-HISTORY_MAX)));
  }

  (window as any).dstGetHistory = getHistory;

  // *** First-touch UTM capture ***
  // Read once, on whichever page the visitor actually arrived on - a form
  // submitted three pages later (after browsing away from the landing URL)
  // should still get credit for the campaign that brought them in, not lose
  // it because that page's own query string is empty. First-touch, not
  // last-touch: an existing stored value is never overwritten by a later
  // visit's UTM params (e.g. an organic revisit with no params, or a
  // different campaign link clicked after the fact).
  (function captureUtmFirstTouch() {
    if (loadValue(UTM_KEY)) return; // already captured on an earlier visit
    const params = new URLSearchParams(location.search);
    const utm: Record<string, string> = {};
    for (const key of UTM_PARAMS) {
      const value = params.get(key);
      if (value) utm[key] = value;
    }
    if (Object.keys(utm).length > 0) saveValue(UTM_KEY, JSON.stringify(utm));
  })();

  (window as any).dstGetUtm = function dstGetUtm(): Record<string, string> {
    try {
      return JSON.parse(loadValue(UTM_KEY) || "{}");
    } catch {
      return {};
    }
  };

  // - page: every page visited. Skips an immediate repeat (reload) so the
  //   log doesn't fill up with the same URL.
  const lastEntry = getHistory().slice(-1)[0];
  if (!lastEntry || lastEntry.type !== "page" || lastEntry.url !== location.href) {
    addToHistory({ type: "page", url: location.href, title: document.title });
  }

  // - click: every real link click. "#"/javascript: hrefs are UI toggles
  //   (menu, popup close), not real navigation/interest, so skipped.
  document.addEventListener("click", (event) => {
    const link = (event.target as HTMLElement)?.closest?.("a[href]") as HTMLAnchorElement | null;
    if (!link) return;
    const href = link.getAttribute("href") || "";
    if (href === "#" || href.startsWith("javascript:")) return;
    const label = (link.getAttribute("aria-label") || link.textContent || "").trim().replace(/\s+/g, " ").slice(0, 80);
    addToHistory({ type: "click", label, url: link.href });
  });
</script>
