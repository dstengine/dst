---
// Shared shell for every district site (riviera, mbr, and any future
// per-development or per-district guide). The nav and page set are the
// same across all of them by construction — a district site is defined
// as "one that has these pages" — so it's fixed here rather than repeated
// per app. What actually differs between sites (name, accent, compliance
// text) comes in as config from the app's own site.config.ts.
import BaseLayout from "./BaseLayout.astro";
import PhotoHero from "../components/district/PhotoHero.astro";

interface Props {
  title: string;
  description: string;
  siteName: string;
  titleSuffix: string;
  complianceNote: string;
  partnerDisclosure?: boolean;
  jsonLd?: Record<string, unknown>[];
  // Page opener. Every district page has one, so it lives here rather than
  // being repeated in each body component. `image` is resolved by the app's
  // Layout: the site's default header unless the page overrides it.
  eyebrow?: string;
  h1?: string;
  lede?: string;
  ledeWidth?: string;
  image?: string;
  imageAlt?: string;
  /** What the opener actually is — anything but a photograph is labelled. */
  imageKind?: "photo" | "illustration" | "render" | "generated";
}

const {
  title, description, siteName, titleSuffix, complianceNote,
  partnerDisclosure = true, jsonLd,
  eyebrow, h1, lede, ledeWidth, image, imageAlt, imageKind,
} = Astro.props;

// Titles are built from siteName so the same nav reads specifically on
// each district site rather than repeating the bare label.
const nav = [
  { href: "/", label: "Living here", title: `Living in ${siteName}` },
  { href: "/coffee/", label: "Coffee", title: `Coffee in ${siteName}` },
  { href: "/food/", label: "Food", title: `Restaurants and groceries in ${siteName}` },
  { href: "/pools/", label: "Pools", title: `Pool access in ${siteName}` },
  { href: "/water/", label: "Water", title: `Where to swim near ${siteName}` },
  { href: "/money/", label: "Money", title: `Exchange and crypto near ${siteName}` },
  { href: "/news/", label: "News", title: `What's changing in ${siteName}` },
  { href: "/events/", label: "Events", title: `What's on in ${siteName}` },
  { href: "/rent/", label: "Rent", title: `Renting in ${siteName}` },
];
---
<BaseLayout
  title={`${title} — ${titleSuffix}`}
  description={description}
  siteName={siteName}
  nav={nav}
  complianceNote={complianceNote}
  partnerDisclosure={partnerDisclosure}
  jsonLd={jsonLd}
>
  {h1 && (
    <header class:list={["container", "district-hero", { "has-photo": image }]}>
      {image ? (
        <PhotoHero eyebrow={eyebrow ?? ""} title={h1} image={image} imageAlt={imageAlt} imageKind={imageKind} />
      ) : (
        <>
          <p class="eyebrow">{eyebrow}</p>
          <h1>{h1}</h1>
        </>
      )}
      {lede && <p class="lede" style={ledeWidth ? `max-width: ${ledeWidth}` : undefined} set:html={lede} />}
    </header>
  )}
  <slot />
</BaseLayout>

<style>
  .district-hero { padding-top: var(--space-5); }
  /* The photograph already carries the eyebrow and heading, so the block
     above the lede needs less breathing room than the plain version. */
  .district-hero.has-photo { padding-top: var(--space-4); }
  .district-hero.has-photo .lede { margin-top: var(--space-3); }
</style>
