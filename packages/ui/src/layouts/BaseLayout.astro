---
import '../styles/tokens.css';
import Analytics from '../components/Analytics.astro';
import LeadTracking from '../components/LeadTracking.astro';

interface Props {
  title: string;
  description: string;
  siteName: string;
  // `title` expands on a nav label for the tooltip and for crawlers — a
  // title identical to the link text adds nothing, so it's only worth
  // setting where it says more than the label does.
  nav: { href: string; label: string; title?: string }[];
  complianceNote?: string;
  jsonLd?: Record<string, unknown>[];
  logoSrc?: string;
  favicon?: boolean;
  partnerDisclosure?: boolean;
  // Secondary links (privacy, terms) that don't belong in the primary nav —
  // most sites don't set this, so the footer stays exactly as before.
  footerLinks?: { href: string; label: string }[];
  // Overrides `siteName` in the footer's copyright line only — the header
  // brand next to the logo still reads plain `siteName`. For sites that
  // want the DST name spelled out in the copyright line specifically
  // without it showing up twice in the header too.
  footerSiteName?: string;
  // Sites with an Instagram account get an icon link in the header —
  // sites without one show nothing rather than a dead placeholder icon.
  instagram?: string;
  /** Share picture for og:image, resolved to an absolute URL. Pages that
      have their own lead image should pass it; otherwise the card falls
      back to a text-only summary rather than showing the wrong picture. */
  image?: string;
}

const { title, description, siteName, nav, complianceNote, jsonLd = [], logoSrc = "/logo-mini.png", favicon = true, partnerDisclosure = true, footerLinks = [], footerSiteName = siteName, instagram, image } = Astro.props;
const isDstHome = Astro.site?.hostname === "dst.llc";

// Absolute URLs: canonical and og:image are both meaningless as relative
// paths — a crawler or a chat client resolves them against its own host.
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
// SVG is excluded on purpose: Telegram, WhatsApp and Facebook don't render
// it in a link preview, so passing one produces an empty card rather than
// no card. A text-only summary is the better failure.
const shareable = image && !/\.svgz?($|\?)/i.test(image);
const shareImage = shareable && Astro.site ? new URL(image, Astro.site).href : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* iOS Safari auto-links any digit run that looks like a phone number
        - e.g. the DED License No. in the footer - into a blue tel: link.
        This site doesn't rely on that auto-detection anywhere (call
        buttons are explicit <a href="tel:">), so it's pure false-positive
        styling on numbers that aren't phone numbers. */}
    <meta name="format-detection" content="telephone=no" />
    {/* Without these a link shared into WhatsApp, Telegram or LinkedIn
        renders as a bare URL with no title, summary or picture — on a
        network whose whole plan is being passed around and linked to. */}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {shareImage && <meta property="og:image" content={shareImage} />}
    <meta name="twitter:card" content={shareImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {favicon ? (
      <>
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
      </>
    ) : (
      <link rel="icon" href="data:," />
    )}
    {jsonLd.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
    <Analytics />
    <LeadTracking />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="site-name" href="/" title={siteName}>
          <img class="site-logo" src={logoSrc} alt="DST" width="28" height="28" />
          {siteName}
        </a>
        <div class="header-actions">
          <nav class="site-nav">
            <ul class="nav-desktop">
              {nav.map((item) => (
                <li><a href={item.href} title={item.title ?? item.label}>{item.label}</a></li>
              ))}
            </ul>
            <details class="nav-toggle">
              <summary aria-label="Toggle menu">
                <span class="nav-toggle-icon" aria-hidden="true"></span>
              </summary>
              <ul>
                {nav.map((item) => (
                  <li><a href={item.href} title={item.title ?? item.label}>{item.label}</a></li>
                ))}
              </ul>
            </details>
          </nav>
          {instagram && (
            <a class="social-icon" href={instagram} target="_blank" rel="me noopener" aria-label="Instagram" title="Instagram">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                <circle cx="12" cy="12" r="4"></circle>
                <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" stroke="none"></circle>
              </svg>
            </a>
          )}
        </div>
      </div>
    </header>
    <script>
      // Native <details> only closes on a second click of its own summary.
      // Close it on an outside click or Escape too, like any other menu.
      document.querySelectorAll<HTMLDetailsElement>(".nav-toggle").forEach((toggle) => {
        document.addEventListener("click", (event) => {
          if (toggle.open && !toggle.contains(event.target as Node)) toggle.open = false;
        });
        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && toggle.open) toggle.open = false;
        });
      });
    </script>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <div class="footer-brand">
          <img class="footer-logo" src={logoSrc} alt="DST" width="20" height="20" />
          <span>{siteName}</span>
        </div>
        <p class="footer-note">{complianceNote}</p>
        <p class="footer-copy">
          &copy; {new Date().getFullYear()} {footerSiteName}. Part of the{" "}
          {isDstHome ? "DST network" : <a href="https://dst.llc" title="DST — the group behind this site">DST network</a>}{partnerDisclosure && (<>, digital partner of DEAL KEY PROPERTIES LLC, DED License No. 1523000 &middot; RERA ORN 52875</>
          )}.
        </p>
        {footerLinks.length > 0 && (
          <p class="footer-links">
            {footerLinks.map((link, i) => (
              <>
                {i > 0 && " · "}
                <a href={link.href} title={link.label}>{link.label}</a>
              </>
            ))}
          </p>
        )}
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: relative;
    /* Lifts the header and, with it, the absolutely-positioned dropdown
       above page content. Without this the header is position:relative with
       z-index:auto, so it creates no stacking context and anything
       positioned later in the document — the photo hero's caption, the
       sticky venue panel — paints straight through the open menu. */
    z-index: var(--z-header);
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-2);
    padding-bottom: var(--space-2);
  }
  .site-name {
    display: flex;
    align-items: center;
    /* The logo is the way back to the front page and was a 29px target. */
    min-height: 44px;
    gap: var(--space-1);
    flex-shrink: 0;
    white-space: nowrap;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-1);
    color: var(--ink);
    text-decoration: none;
  }
  .site-logo {
    /* The source art already has its own rounded-square corners baked in
       at a much larger relative radius than the design system's --radius;
       clipping a second, tighter CSS radius over it produced a visible
       double-corner artifact. Let the image's own rounding stand alone. */
    display: block;
    height: 28px;
    width: 28px;
  }
  .header-actions { display: flex; align-items: center; gap: var(--space-3); }
  .site-nav { display: flex; align-items: center; }

  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--ink-muted);
  }
  .social-icon svg { width: 20px; height: 20px; }
  .social-icon:hover { color: var(--accent, #1F5C4E); }

  /* Desktop: a plain inline row. The mobile <details> dropdown is a
     separate, hidden-by-default element rather than something CSS
     "forces open" here — content inside a closed <details> is suppressed
     by the browser in a way author CSS can't override, so reusing one
     <details> for both breakpoints left this nav at zero width on desktop
     whenever it happened to render closed. Two elements, one per
     breakpoint, sidesteps that entirely. */
  .nav-desktop {
    display: flex;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }
  .nav-desktop li { display: block; }
  .nav-toggle { display: none; }

  .site-nav a {
    color: var(--ink-muted);
    text-decoration: none;
    font-size: var(--step--1);
    font-weight: 600;
  }
  .site-nav a:hover { color: var(--accent, #1F5C4E); }

  /* Mobile and tablet: the wrapping inline nav read as a jumbled grid
     tangled with the site name, so at and below tablet width it's
     replaced by a native <details> dropdown — zero JS, same pattern as
     the Faq component elsewhere in this design system. */
  /* The name is nowrap and doesn't shrink, so on a phone the longest one in
     the network ("Dubai Company Formation") took 335px of the 342px the
     header has at 390px and shoved the menu button off the screen. */
  @media (max-width: 560px) {
    .site-name { font-size: var(--step-0); }
    .site-logo { width: 24px; height: 24px; }
  }

  /* A 320px phone is narrower still — the same name overflows again there. */
  @media (max-width: 380px) {
    .site-name { font-size: var(--step--1); }
  }

  @media (max-width: 1024px) {
    .nav-desktop { display: none; }
    .nav-toggle { display: block; }

    .nav-toggle summary {
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      width: 24px;
      height: 24px;
      cursor: pointer;
      list-style: none;
    }
    /* The 44px touch target is an overlay rather than the box itself. As a
       44px box with a -10px margin it hung past the header's right padding
       and pushed the whole document 3px sideways at 390px. */
    .nav-toggle summary::before {
      content: "";
      position: absolute;
      inset: -10px;
    }
    .nav-toggle summary::-webkit-details-marker { display: none; }
    .nav-toggle summary::marker { content: ""; }

    .nav-toggle-icon,
    .nav-toggle-icon::before,
    .nav-toggle-icon::after {
      display: block;
      width: 22px;
      height: 2px;
      border-radius: 2px;
      background: var(--ink);
      transition: transform 150ms ease-in-out, opacity 150ms ease-in-out, top 150ms ease-in-out;
    }
    .nav-toggle-icon { position: relative; }
    .nav-toggle-icon::before,
    .nav-toggle-icon::after { content: ""; position: absolute; left: 0; }
    .nav-toggle-icon::before { top: -7px; }
    .nav-toggle-icon::after { top: 7px; }

    .nav-toggle[open] .nav-toggle-icon { background: transparent; }
    .nav-toggle[open] .nav-toggle-icon::before { top: 0; transform: rotate(45deg); }
    .nav-toggle[open] .nav-toggle-icon::after { top: 0; transform: rotate(-45deg); }

    /* [open], not just .nav-toggle: a bare `display: flex` overrode the
       browser's own hiding of a closed <details>, so the shut menu still took
       part in layout and pushed the document 3px sideways at 390px. */
    .nav-toggle[open] ul {
      display: flex;
      flex-direction: column;
      gap: 0;
      list-style: none;
      margin: 0;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--surface);
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      padding: var(--space-2) var(--space-3);
      box-shadow: 0 8px 16px rgba(0, 0, 0, 0.12);
    }
    .nav-toggle[open] li { display: block; border-top: 1px solid var(--border); }
    .nav-toggle[open] li:first-child { border-top: none; }
    .nav-toggle[open] a { display: block; padding: var(--space-2) 0; }
  }

  .site-footer {
    margin-top: var(--space-6);
    border-top: 1px solid var(--border);
    padding: var(--space-4) 0;
    color: var(--ink-faint);
    font-size: var(--step--1);
  }
  .footer-brand {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin: 0 0 var(--space-3);
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-0);
  }
  .footer-logo { display: block; border-radius: 4px; }
  .footer-note { max-width: 60ch; margin: 0 0 var(--space-2); }
  .footer-copy { margin: 0; }
  .footer-copy a { color: inherit; text-decoration: underline; text-underline-offset: 2px; }
  .footer-links { margin: var(--space-2) 0 0; }
  .footer-links a { color: inherit; text-decoration: underline; text-underline-offset: 2px; }
</style>
