---
import ThemeToggle from "../components/ThemeToggle.astro";
import '../styles/tokens.css';
import Analytics from '../components/Analytics.astro';
import { ICONS, navIconFor } from '../icons';
import { pageGraph } from '../schema';
import type { Publisher } from '../schema';
import NetworkLinks from '../components/NetworkLinks.astro';
import { NETWORK, relatedLinks } from '@dst/content/network';
import type { NetworkSite } from '@dst/content/network';
import { lastModified } from '@dst/content/lastmod';

interface Props {
  title: string;
  /** Appended to `title` after an em dash. Every site puts its own name at
      the end of every page title; the string lives in the app's
      site.config.ts so a new site declares it once instead of composing the
      same template literal in its own layout — which is where it used to be,
      and where it was easy to copy a sibling's name in along with it. */
  titleSuffix?: string;
  description: string;
  siteName: string;
  // `title` expands on a nav label for the tooltip and for crawlers — a
  // title identical to the link text adds nothing, so it's only worth
  // setting where it says more than the label does.
  // `icon` names a mark from the shared set for a link the network-wide
  // href map can't know about — a city, a show, a venue. Without it the
  // icon is still resolved from the href, so every other site is unchanged.
  nav: { href: string; label: string; title?: string; icon?: string }[];
  complianceNote?: string;
  jsonLd?: Record<string, unknown>[];
  logoSrc?: string;
  favicon?: boolean;
  partnerDisclosure?: boolean;
  // Secondary links (privacy, terms) that don't belong in the primary nav —
  // most sites don't set this, so the footer stays exactly as before.
  footerLinks?: { href: string; label: string }[];
  // Overrides `siteName` in the footer's copyright line only — the header
  // brand next to the logo still reads plain `siteName`. For sites that
  // want the DST name spelled out in the copyright line specifically
  // without it showing up twice in the header too.
  footerSiteName?: string;
  // Sites with an Instagram account get an icon link in the header —
  // sites without one show nothing rather than a dead placeholder icon.
  instagram?: string;
  /** Share picture for og:image, resolved to an absolute URL. Pages that
      have their own lead image should pass it; otherwise the card falls
      back to a text-only summary rather than showing the wrong picture. */
  image?: string;
  /** The hub's full listing of the network, with the pages worth arriving
      on directly. In the footer rather than the body: on the home page it
      was a second navigation block under the one that already named the
      same six sites, and here it reaches every page of the hub instead of
      one — which is the whole point of it, since for some of those inner
      pages the hub is the only site linking to them at all. */
  footerSites?: NetworkSite[];
  /** Who the structured data names as publisher. Defaults to DST; a site
      that is not being tied to the group passes its own, so the markup says
      the same thing the footer does. */
  publisher?: Publisher;
  /** Whether the footer names DST as the network behind the site. A site
      that is not being tied to the group yet passes false — the line is a
      link to dst.llc, and a link is exactly what such a site must not
      carry until someone decides it should. */
  networkFooter?: boolean;
  /** Keep this page out of the index while still letting a crawler follow
      it onward. For an index page that holds fewer entries than the pages
      it links to: it is thinner than its own children, so it is not worth
      indexing yet, but it is the only route to them and must stay
      crawlable. Lifts itself once the section fills up. */
  noindex?: boolean;
  /** A page with nothing on it but text. The container is wide because most
      pages fill it with a grid; a paragraph stops at its reading measure, so
      on a text-only page the headings run full-bleed while every line under
      them stops halfway and the right half of the screen sits empty. This
      narrows the container to the measure instead, so heading and paragraph
      share both edges. Set it only when nothing on the page wants the width. */
  prose?: boolean;
  /** BCP 47 tag for the page's language. Defaults to English; a site in
      another language passes its own so `<html lang>` and the structured
      data agree with the words on the page. */
  lang?: string;
}

const { title, titleSuffix, description, siteName, nav, complianceNote, jsonLd = [], logoSrc = "/logo-mini.png", favicon = true, partnerDisclosure = true, footerLinks = [], footerSiteName = siteName, instagram, image, footerSites = [], networkFooter = true, publisher, lang = "en", noindex = false, prose = false } = Astro.props;
const pageTitle = titleSuffix ? `${title} \u2014 ${titleSuffix}` : title;
const isDstHome = Astro.site?.hostname === "dst.llc";
// The two strings the shell says on its own, in the language of the page.
// Everything else in the chrome comes from the app; these were hardcoded in
// English and so spoke English on the two sites that publish in Spanish.
// Keyed on the `lang` the site already passes, so a site gets them right by
// declaring its language rather than by remembering two more props.
const CHROME: Record<string, { skip: string; menu: string }> = {
  en: { skip: "Skip to content", menu: "Toggle menu" },
  es: { skip: "Saltar al contenido", menu: "Abrir menú" },
};
const chrome = CHROME[lang.slice(0, 2)] ?? CHROME.en;

// Absolute URLs: canonical and og:image are both meaningless as relative
// paths — a crawler or a chat client resolves them against its own host.
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
// SVG is excluded on purpose: Telegram, WhatsApp and Facebook don't render
// it in a link preview, so passing one produces an empty card rather than
// no card. A page with no usable picture of its own falls back to the
// site's share card — every site has one, drawn by tools/share-cards.mjs
// from its own accent and its own words, so a shared link is never a bare
// grey rectangle.
const shareable = image && !/\.svgz?($|\?)/i.test(image);
const shareImage = Astro.site
  ? new URL(shareable ? image! : "/share.png", Astro.site).href
  : undefined;

// Roughly how much room the inline nav wants, in px: label text, the gaps
// between items, and the site name beside it. The header's content column
// caps at 1180px and the name eats into that, so anything over ~900 wraps
// onto a second row. llc (ten long labels, "Dubai Company Formation")
// measures 1189 and did wrap; riviera's nine short ones measure 759 and fit.
// The sites next door. Driven by the host rather than a prop, so every
// page of every vertical carries the same short row without each app
// having to remember to pass it. The hub sets its own, fuller listing on
// the home page instead.
const networkKey = NETWORK.find((s) => s.host === Astro.site?.hostname)?.key;
const related = networkKey ? relatedLinks(networkKey) : [];

// Who published this page, which site it belongs to, and where it sits.
// Emitted on every page of every host: the Organization node carries one
// @id network-wide, which is what ties seven separate hostnames back to a
// single company.
const graph = Astro.site
  ? pageGraph({
      origin: Astro.site.origin,
      siteName,
      pathname: Astro.url.pathname,
      canonical: canonical!,
      title: pageTitle,
      description,
      image: shareImage,
      dateModified: lastModified(Astro.site.hostname, Astro.url.pathname),
      nav,
      publisher,
    })
  : undefined;

// A nav item's mark: the one it names, or the one its href implies. Every
// item in the network has an icon or the row looks half-finished, which is
// what tests/build-output.test.js now checks.
const navIcon = (item: { href: string; icon?: string }) =>
  item.icon ? ICONS[item.icon] : navIconFor(item.href);

const navFootprint =
  nav.reduce((sum, item) => sum + item.label.length, 0) * 8 +
  nav.length * 24 +
  siteName.length * 11;
const denseNav = navFootprint > 900;
// A short row has width to spare: it keeps its marks all the way down to the
// point where the dropdown takes over. A fuller one drops them earlier, or it
// wraps. One threshold, applied to each site's own row, rather than a single
// width guessed for nine different navs.
const lateIcons = navFootprint > 700;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Both schemes exist, so form controls, scrollbars and the address bar
        follow the page rather than staying light. */}
    <meta name="color-scheme" content="light dark" />
    {/* Before the first paint, or the page flashes the default theme and then
        corrects itself. Inline and synchronous on purpose: a module script
        is deferred, which is exactly late enough to see the flash. */}
    <script is:inline>
      (() => {
        try {
          const v = localStorage.getItem("theme");
          if (v === "light" || v === "dark") document.documentElement.setAttribute("data-theme", v);
        } catch { /* private mode: fall through to the reader's own setting */ }
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {/* iOS Safari auto-links any digit run that looks like a phone number
        - e.g. the DED License No. in the footer - into a blue tel: link.
        This site doesn't rely on that auto-detection anywhere (call
        buttons are explicit <a href="tel:">), so it's pure false-positive
        styling on numbers that aren't phone numbers. */}
    <meta name="format-detection" content="telephone=no" />
    {/* Without these a link shared into WhatsApp, Telegram or LinkedIn
        renders as a bare URL with no title, summary or picture — on a
        network whose whole plan is being passed around and linked to. */}
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    {/* The lead endpoint is only called once someone touches a form, so
        resolving DNS ahead of time is worth it and holding a socket open on
        every page is not. Only for sites that carry the pipeline at all. */}
    {Astro.slots.has("tracking") && <link rel="dns-prefetch" href="https://api.dst.llc" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {shareImage && <meta property="og:image" content={shareImage} />}
    <meta name="twitter:card" content={shareImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {favicon ? (
      <>
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
      </>
    ) : (
      <link rel="icon" href="data:," />
    )}
    {graph && <script type="application/ld+json" set:html={JSON.stringify(graph)} />}
    {jsonLd.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
    <Analytics />
    {/* The lead pipeline is DST's, not every site's: it writes dst_ cookies
        and talks to api.dst.llc, so the layout no longer decides who is on
        it. A site hands it in — musical.today, which is not presented as
        part of the network, hands in nothing and ships none of the code. */}
    <slot name="tracking" />
  </head>
  <body>
    {/* First tab stop on every page. The header carries a nav of eight or
        more links plus the network menu, and without this a keyboard or
        switch user tabs through all of it again on each page before
        reaching a word of the content. Off-screen until focused. */}
    <a class="skip-link" href="#content">{chrome.skip}</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="site-name" href="/" title={siteName}>
          {/* Decorative: the site name sits right beside it, and an alt of
              "DST" made the link announce itself twice — "DST DST" on the
              hub, where the name is the same word. */}
          <img class="site-logo" src={logoSrc} alt="" aria-hidden="true" width="28" height="28" />
          {siteName}
        </a>
        <div class="header-actions">
          <nav class:list={["site-nav", denseNav && "site-nav-dense"]}>
            <ul class:list={["nav-desktop", denseNav && "nav-desktop-dense", lateIcons && "nav-icons-late"]}>
              {nav.map((item) => (
                <li>
                  <a href={item.href} title={item.title ?? item.label}>
                    {navIcon(item) && (
                      <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d={navIcon(item)} />
                      </svg>
                    )}
                    <span>{item.label}</span>
                  </a>
                </li>
              ))}
            </ul>
            <details class="nav-toggle">
              <summary aria-label={chrome.menu}>
                <span class="nav-toggle-icon" aria-hidden="true"></span>
              </summary>
              <ul>
                {nav.map((item) => (
                  <li>
                    <a href={item.href} title={item.title ?? item.label}>
                      {navIcon(item) && (
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d={navIcon(item)} />
                        </svg>
                      )}
                      <span>{item.label}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          </nav>
          {instagram && (
            <a class="social-icon" href={instagram} target="_blank" rel="me noopener" aria-label="Instagram" title="Instagram">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                <circle cx="12" cy="12" r="4"></circle>
                <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" stroke="none"></circle>
              </svg>
            </a>
          )}
          <ThemeToggle />
        </div>
      </div>
    </header>
    <script>
      // Native <details> only closes on a second click of its own summary.
      // Close it on an outside click or Escape too, like any other menu.
      document.querySelectorAll<HTMLDetailsElement>(".nav-toggle").forEach((toggle) => {
        document.addEventListener("click", (event) => {
          if (toggle.open && !toggle.contains(event.target as Node)) toggle.open = false;
        });
        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && toggle.open) toggle.open = false;
        });
      });
    </script>
    {/* tabindex="-1" so the skip link actually moves focus here rather than
        only scrolling: without it the next Tab goes back to the second link
        in the header. */}
    <main id="content" tabindex="-1" class={prose ? "prose" : undefined}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <div class="footer-brand">
          <img class="footer-logo" src={logoSrc} alt="" aria-hidden="true" width="20" height="20" />
          <span>{siteName}</span>
        </div>
        {related.length > 0 && (
          <NetworkLinks heading="Elsewhere in the DST network" links={related} />
        )}
        {footerSites.length > 0 && (
          <NetworkLinks heading="Straight to" sites={footerSites} />
        )}
        <p class="footer-note">{complianceNote}</p>
        <p class="footer-copy">
          &copy; {new Date().getFullYear()} {footerSiteName}.{networkFooter && (<>{" "}Part of the{" "}
          {isDstHome ? "DST network" : <a href="https://dst.llc" title="DST — the group behind this site">DST network</a>}{partnerDisclosure && (<>, digital partner of DEAL KEY PROPERTIES LLC, DED License No. 1523000 &middot; RERA ORN 52875</>
          )}.</>)}
        </p>
        {footerLinks.length > 0 && (
          <p class="footer-links">
            {footerLinks.map((link, i) => (
              <>
                {i > 0 && " · "}
                <a href={link.href} title={link.label}>{link.label}</a>
              </>
            ))}
          </p>
        )}
      </div>
    </footer>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: var(--space-3);
    top: 0;
    z-index: 100;
    /* Above the viewport rather than clipped to a pixel: a link that is
       merely invisible still gets read out in the wrong place by some
       screen readers, and one that is display: none can never be focused. */
    transform: translateY(-150%);
    /* A control like any other: once it is on screen it has to be big
       enough to hit, which at this font size padding alone doesn't reach. */
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.6em 1em;
    background: var(--accent, #1F5C4E);
    color: #fff;
    border-radius: 0 0 var(--radius) var(--radius);
    text-decoration: none;
    font-size: var(--step--1);
  }
  .skip-link:focus { transform: translateY(0); }
  /* The dark-mode accent is the light one, so white on it ran 1.68:1 — the
     first tab stop on every page, unreadable, and invisible to review
     because it only appears under focus. Dark ink on the pale accent, the
     same swap `.button` already makes. */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .skip-link { color: var(--bg); }
  }
  :root[data-theme="dark"] .skip-link { color: var(--bg); }
  /* The target takes focus programmatically, which would otherwise draw a
     ring around the whole page. */
  main:focus { outline: none; }

  .site-header {
    position: relative;
    /* Lifts the header and, with it, the absolutely-positioned dropdown
       above page content. Without this the header is position:relative with
       z-index:auto, so it creates no stacking context and anything
       positioned later in the document — the photo hero's caption, the
       sticky venue panel — paints straight through the open menu. */
    z-index: var(--z-header);
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-2);
    padding-bottom: var(--space-2);
  }
  .site-name {
    display: flex;
    align-items: center;
    /* The logo is the way back to the front page and was a 29px target. */
    min-height: 44px;
    gap: var(--space-1);
    flex-shrink: 0;
    white-space: nowrap;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-1);
    color: var(--ink);
    text-decoration: none;
  }
  .site-logo {
    /* The source art already has its own rounded-square corners baked in
       at a much larger relative radius than the design system's --radius;
       clipping a second, tighter CSS radius over it produced a visible
       double-corner artifact. Let the image's own rounding stand alone. */
    display: block;
    height: 28px;
    width: 28px;
  }
  .header-actions { display: flex; align-items: center; gap: var(--space-3); }
  .site-nav { display: flex; align-items: center; }

  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--ink-muted);
    /* The mark is 20px; the thing a thumb has to hit is not. The box grows
       to 44px and the negative inline margin gives most of that back to the
       row, so the header keeps the spacing the 20px glyph implies. */
    min-width: 44px;
    min-height: 44px;
    margin-inline: -0.5rem;
  }
  .social-icon svg { width: 20px; height: 20px; }
  .social-icon:hover { color: var(--accent, #1F5C4E); }

  /* Desktop: a plain inline row. The mobile <details> dropdown is a
     separate, hidden-by-default element rather than something CSS
     "forces open" here — content inside a closed <details> is suppressed
     by the browser in a way author CSS can't override, so reusing one
     <details> for both breakpoints left this nav at zero width on desktop
     whenever it happened to render closed. Two elements, one per
     breakpoint, sidesteps that entirely. */
  .nav-desktop {
    display: flex;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }
  .nav-desktop li { display: block; }
  .nav-toggle { display: none; }

  .site-nav a {
    color: var(--ink-muted);
    text-decoration: none;
    font-size: var(--step--1);
    font-weight: 600;
  }
  .site-nav a:hover { color: var(--accent, #1F5C4E); }
  .site-nav a { display: inline-flex; align-items: center; gap: 0.5em; }
  /* Sized in em so the mark tracks the label rather than the root font, and
     muted a step below the text: it labels the item, it isn't the item. */
  .nav-icon {
    width: 1.15em;
    height: 1.15em;
    flex-shrink: 0;
    opacity: 0.65;
  }
  .site-nav a:hover .nav-icon { opacity: 1; }
  /* The vertical menu always keeps its marks — that is where they earn their
     place, one per row to scan down. The horizontal row is the opposite case:
     the marks buy nothing next to a label already in view, and they cost
     width. A row of eight or more wraps onto a second line with them (llc has
     ten), and a narrow window wraps whatever the count, so they come off in
     both cases. */
  .nav-desktop-dense .nav-icon { display: none; }
  @media (max-width: 1400px) {
    .nav-icons-late .nav-icon { display: none; }
  }

  /* Mobile and tablet: the wrapping inline nav read as a jumbled grid
     tangled with the site name, so at and below tablet width it's
     replaced by a native <details> dropdown — zero JS, same pattern as
     the Faq component elsewhere in this design system. */
  /* The name is nowrap and doesn't shrink, so on a phone the longest one in
     the network ("Dubai Company Formation") took 335px of the 342px the
     header has at 390px and shoved the menu button off the screen. */
  @media (max-width: 560px) {
    .site-name { font-size: var(--step-0); }
    .site-logo { width: 24px; height: 24px; }
  }

  /* A 320px phone is narrower still — the same name overflows again there. */
  @media (max-width: 380px) {
    .site-name { font-size: var(--step--1); }
  }

  /* Which of the two navs is on screen. The dropdown's own styling sits
     below, outside any breakpoint: it only takes effect where the toggle is
     shown, and keeping it breakpoint-free lets a second rule show the same
     dropdown on a site whose inline row would wrap. */
  @media (max-width: 1024px) {
    .nav-desktop { display: none; }
    .nav-toggle { display: block; }
  }
  /* A long nav gets a tightened row — smaller type, no icons, narrower gaps
     — which is enough to hold one line on a wide screen: llc's ten items and
     its 335px name fit from 1164px up. Below that the row wraps, so there
     such a site gets the dropdown instead. */
  @media (max-width: 1200px) {
    .site-nav-dense .nav-desktop { display: none; }
    .site-nav-dense .nav-toggle { display: block; }
  }
  .nav-desktop-dense { gap: var(--space-2); }
  .nav-desktop-dense a { font-size: 0.875rem; }


  .nav-toggle summary {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    width: 24px;
    height: 24px;
    cursor: pointer;
    list-style: none;
  }
  /* The 44px touch target is an overlay rather than the box itself. As a
     44px box with a -10px margin it hung past the header's right padding
     and pushed the whole document 3px sideways at 390px. */
  .nav-toggle summary::before {
    content: "";
    position: absolute;
    inset: -10px;
  }
  .nav-toggle summary::-webkit-details-marker { display: none; }
  .nav-toggle summary::marker { content: ""; }

  .nav-toggle-icon,
  .nav-toggle-icon::before,
  .nav-toggle-icon::after {
    display: block;
    width: 22px;
    height: 2px;
    border-radius: 2px;
    background: var(--ink);
    transition: transform 150ms ease-in-out, opacity 150ms ease-in-out, top 150ms ease-in-out;
  }
  .nav-toggle-icon { position: relative; }
  .nav-toggle-icon::before,
  .nav-toggle-icon::after { content: ""; position: absolute; left: 0; }
  .nav-toggle-icon::before { top: -7px; }
  .nav-toggle-icon::after { top: 7px; }

  .nav-toggle[open] .nav-toggle-icon { background: transparent; }
  .nav-toggle[open] .nav-toggle-icon::before { top: 0; transform: rotate(45deg); }
  .nav-toggle[open] .nav-toggle-icon::after { top: 0; transform: rotate(-45deg); }

  /* [open], not just .nav-toggle: a bare `display: flex` overrode the
     browser's own hiding of a closed <details>, so the shut menu still took
     part in layout and pushed the document 3px sideways at 390px. */
  /* Anchored to the button rather than to the header, so the panel opens
     under the hamburger instead of spanning the window. A menu that takes
     the full width reads as part of the page; a panel reads as a menu. */
  .nav-toggle { position: relative; }
  .nav-toggle[open] ul {
    display: flex;
    flex-direction: column;
    gap: 0;
    list-style: none;
    margin: 0;
    position: absolute;
    z-index: 1;
    top: calc(100% + var(--space-2));
    right: 0;
    left: auto;
    width: max-content;
    min-width: 12rem;
