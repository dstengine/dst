---
import Layout from "../../layouts/Layout.astro";
import { site } from "../../site.config";
import { eventMeta } from "@dst/ui/meta";
import { pluralOf } from "../../sections";
import EventArticle from "@dst/ui/EventArticle.astro";
import { newsBySite } from "@dst/content/news";
import { siteId, otherEvents } from "../../content";
import { go } from "../../outbound";

// The forum itself is deliberately not in here: its page is the home page,
// and a second copy under /events/ would be the same event twice.
export function getStaticPaths() {
  const items = otherEvents.filter((item) => Array.isArray(item.body) && item.body.length > 0);
  return items.map((item) => ({ params: { slug: item.slug }, props: { item, more: items } }));
}

const moreNews = newsBySite(siteId);
const { item, more } = Astro.props;
// A seller or form if we have one, the source if we don't — see src/outbound.ts.
const ticketHref = item.ticket ? go(`${item.slug}-ticket`) : undefined;
const sourceHref = item.source?.url ? go(`${item.slug}-source`) : undefined;
// The search title and description, with the meta-hook page test applied
// (@dst/ui/meta); the control is the dated title and the summary.
const meta = eventMeta(item, site, { host: Astro.site?.hostname ?? "", path: Astro.url.pathname });
---
<Layout title={meta.title} description={meta.description} image={item.image}>
  <EventArticle item={item} more={more} moreNews={moreNews} backHref="/events/"
  ticketHref={ticketHref}
  sourceHref={sourceHref}
  where={site.keyword}
  pluralOf={pluralOf}
  moreEventsText={item.moreEventsText}
/>
</Layout>
