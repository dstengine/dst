---
import Layout from "../layouts/Layout.astro";
import NewsList from "@dst/ui/NewsList.astro";
import { newsBySite } from "@dst/content/news";

const items = newsBySite("fwf");
---
<Layout
  title="Dubai smart city and PropTech news"
  description="Dubai smart city, PropTech, fintech and mobility news — the subjects Future World Forum Dubai covers, reported from the bodies that announced them."
>
  <section class="container hero">
    <p class="eyebrow">News</p>
    <h1>The subjects the forum covers</h1>
    <p class="lede">
      Smart cities, PropTech, digital finance and mobility in Dubai — the
      things actually happening in the sectors on the forum's programme. Every
      item is sourced from the body that announced it, and says what it means
      rather than repeating the press release.
    </p>
  </section>

  <section class="container">
    <NewsList items={items} />
  </section>
</Layout>
