---
import BaseLayout from "@dst/ui/BaseLayout.astro";
import { site } from "../site.config";
import "../styles/theme.css";

interface Props {
  /** Forwarded to BaseLayout: see its `prose` prop. */
  prose?: boolean;
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>[];
  image?: string;
  noindex?: boolean;
}
const { title, description, jsonLd, image, noindex, prose } = Astro.props;

const nav = [
  { href: "/", label: "Was ist los", title: "Was heute in Wien los ist", icon: "home" },
  { href: "/nachrichten/", label: "Nachrichten", title: "Nachrichten aus Wien, mit Quelle bei jedem Eintrag", icon: "news" },
  // "Veranstaltungen", nicht "Termine": das ist das Wort, mit dem hier
  // gesucht wird, und es steht schon im Titelzusatz. Ein Termin ist etwas,
  // das man beim Amt bekommt.
  { href: "/veranstaltungen/", label: "Veranstaltungen", title: "Der Kalender: jedes Datum beim Veranstalter bestätigt", icon: "events" },
  { href: "/ueber-uns/", label: "Über uns", title: "Wer diese Seite macht und wie jedes Datum geprüft wird", icon: "id" },
];

---
<BaseLayout
  {...site}
  prose={prose}
  title={title}
  description={description}
  nav={nav}
  jsonLd={jsonLd}
  image={image}
  noindex={noindex}
>
  <slot />
</BaseLayout>
