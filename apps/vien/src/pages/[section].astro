---
// A subject page. Which subjects exist is decided in ../sections.ts against
// the data, so this file never needs editing when one earns or loses its
// page.
import Layout from "../layouts/Layout.astro";
import SectionNav from "@dst/ui/SectionNav.astro";
import SectionFeed from "@dst/ui/SectionFeed.astro";
import { siteId, newsBase, eventsBase, labels } from "../content";
import { sections, NAV } from "../sections";
import { eventsBySite } from "@dst/content/events";
import { newsBySite } from "@dst/content/news";

export function getStaticPaths() {
  const all = sections([...eventsBySite(siteId), ...newsBySite(siteId)]);
  return all.map((section) => ({ params: { section: section.slug }, props: { section, all } }));
}

const { section, all } = Astro.props;
---
<Layout title={section.title} description={section.description}>
  <section class="container hero">
    <h1>{section.h1}</h1>
    <p class="lede">{section.lede}</p>
  </section>
  <section class="container">
    <SectionNav sections={all} current={`/${section.slug}/`} allHref="/" {...NAV} />
    <SectionFeed
      items={section.items}
      eventsBase={eventsBase}
      newsBase={newsBase}
      locale="de-AT"
      labels={labels}
      headings={section.headings}
    />
  </section>
</Layout>
