{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "git rev-parse HEAD^ >/dev/null 2>&1 || exit 1; git diff --quiet HEAD^ HEAD -- . ../../packages",
  "redirects": [
    {
      "source": "/art",
      "destination": "/exhibitions/",
      "statusCode": 301
    },
    {
      "source": "/art/",
      "destination": "/exhibitions/",
      "statusCode": 301
    }
  ]
}
