---
import BaseLayout from "@dst/ui/BaseLayout.astro";
import { site } from "../site.config";
import "../styles/theme.css";

interface Props {
  /** Forwarded to BaseLayout: see its `prose` prop. */
  prose?: boolean;
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>[];
  image?: string;
  noindex?: boolean;
}
const { title, description, jsonLd, image, noindex, prose } = Astro.props;

const nav = [
  { href: "/", label: "What's on", title: "What's on in London today", icon: "home" },
  { href: "/news/", label: "News", title: "London news, with a source on every entry", icon: "news" },
  { href: "/events/", label: "Events", title: "The London events calendar", icon: "events" },
  { href: "/about/", label: "About", title: "Who publishes this and how every date is checked", icon: "id" },
];

---
<BaseLayout
  {...site}
  prose={prose}
  title={title}
  description={description}
  nav={nav}
  jsonLd={jsonLd}
  image={image}
  noindex={noindex}
>
  <slot />
</BaseLayout>
