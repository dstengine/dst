---
import BaseLayout from "@dst/ui/BaseLayout.astro";
import { publisher } from "../content";
import "../styles/theme.css";

interface Props {
  /** Forwarded to BaseLayout: see its `prose` prop. */
  prose?: boolean;
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>[];
  image?: string;
  noindex?: boolean;
}
const { title, description, jsonLd, image, noindex, prose } = Astro.props;

const nav = [
  { href: "/", label: "What's on", icon: "home" },
  { href: "/news/", label: "News", icon: "news" },
  { href: "/events/", label: "Events", icon: "events" },
  { href: "/about/", label: "About", icon: "id" },
];

---
<BaseLayout
  prose={prose}
  title={`${title} — ldn.lol`}
  description={description}
  siteName="ldn.lol"
  lang="en-GB"
  nav={nav}
  jsonLd={jsonLd}
  image={image}
  noindex={noindex}
  publisher={publisher}
  partnerDisclosure={false}
  networkFooter={false}
  footerLinks={[{ href: "/about/", label: "About" }]}
>
  <slot />
</BaseLayout>
