---
import Layout from "../layouts/Layout.astro";
import NewsList from "@dst/ui/NewsList.astro";
import FeedCards from "@dst/ui/FeedCards.astro";
import { newsBySite, allNews, latestNews } from "@dst/content/news";

const SITE_HOSTS: Record<string, string> = {
  llc: "llc.dst.llc",
  visas: "visas.dst.llc",
  riviera: "riviera.dst.llc",
  mbr: "mbr.dst.llc",
  palmcentral: "palmcentral.dst.llc",
  eco: "eco.dst.llc",
};
const SITE_LABELS: Record<string, string> = {
  llc: "Company formation",
  visas: "Visas",
  riviera: "Riviera",
  mbr: "MBR City",
  palmcentral: "Palm Central",
  eco: "Eco",
};

const items = newsBySite("dst");

// The hub carries its own news first, then a network-wide roundup below,
// each item labelled with its source site. This isn't NewsList — a
// cross-site item's detail page and its image both live on that site's own
// host (riviera.dst.llc/news/slug), which NewsList's same-site relative
// links can't express.
const networkCards = latestNews(
  allNews.filter((item) => item.site !== "dst"),
  9,
).map((item) => {
  const host = SITE_HOSTS[item.site];
  const hasPage = Array.isArray(item.body) && item.body.length > 0;
  return {
    href: hasPage && host ? `https://${host}/news/${item.slug}/` : undefined,
    // The site, not the category: on a roundup, where an item comes from is
    // the thing a reader is sorting by.
    eyebrow: SITE_LABELS[item.site] ?? item.site,
    date: item.date,
    title: item.title,
    text: item.summary,
    image: item.image && host ? `https://${host}${item.image}` : undefined,
    imageAlt: item.imageAlt,
    imageFit: (item.imageKind === "photo" || item.imageKind === "render" ? "cover" : "contain") as "cover" | "contain",
  };
});
---
<Layout
  title="DST news"
  description="What moves the markets DST works in, and what the group is doing in them, with a roundup of what's changing across the network's sites."
>
  <section class="container hero">
    <p class="eyebrow">News</p>
    <h1>What's changing at DST</h1>
    {/* Deliberately not "new integrations / how the network's systems
        work": how leads and internal plumbing are wired is not something a
        reader came here for, and advertising it reads badly to a
        prospective client. What the group is doing, not how it is built. */}
    <p class="lede">
      What moves the markets the group works in, and what DST is doing in
      them — followed by a roundup of what's changing across the network's
      individual sites.
    </p>
  </section>

  <section class="container">
    {/* The roundup below carries a heading, so without one here the group's
        own news is the only unlabelled thing on the page. */}
    <h2>From the group</h2>
    {items.length > 0 ? (
      <NewsList items={items} />
    ) : (
      /* An empty feed used to render nothing at all, leaving the heading
         hanging over the next section. Say why it's empty instead. */
      <p class="feed-empty">
        Nothing filed at group level yet. What the individual sites are
        publishing is below.
      </p>
    )}
  </section>

  {networkCards.length > 0 && (
    <section class="container">
      <h2>Across the network</h2>
      <FeedCards items={networkCards} />
    </section>
  )}
</Layout>

<style>
  .feed-empty { margin-top: var(--space-2); color: var(--ink-muted); }
</style>
