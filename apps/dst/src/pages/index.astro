---
import Layout from "../layouts/Layout.astro";
import { ICONS } from "@dst/ui/icons";

// Every hub card carries a media panel so the grid reads as one row of
// equals. Hubs without their own photography yet fall back to a mark on a
// tinted panel rather than leaving a hole where the image will go.
const hubs = [
  {
    href: "https://riviera.dst.llc",
    title: "Riviera community guide — riviera.dst.llc",
    eyebrow: "Community",
    status: "Live",
    name: "Riviera",
    text: "Coffee, food, pools, water — the Riviera community, block by block.",
    image: "/riviera.jpg",
    imageAlt: "Illustration of the Azizi Riviera promenade at night — a generated image, not a photograph of the development.",
  },
  {
    href: "https://palmcentral.dst.llc",
    title: "Palm Central by Nakheel — palmcentral.dst.llc",
    eyebrow: "Real Estate",
    status: "Live",
    name: "Palm Central",
    text: "Nakheel's Palm Jebel Ali residences — current pricing, payment plan, and what's actually for sale.",
    image: "/palmcentral.jpg",
    imageAlt: "Night aerial render of Palm Central's beachfront residences and central Spine, Palm Jebel Ali.",
  },
  {
    href: "https://llc.dst.llc",
    title: "Company formation in Dubai — llc.dst.llc",
    eyebrow: "Company formation",
    status: "Live",
    name: "Company formation",
    text: "Free zones, mainland, banking, payment processing — company formation in Dubai.",
    icon: ICONS.briefcase,
  },
  {
    eyebrow: "Crypto",
    status: "In development",
    inProgress: true,
    name: "Crypto in the UAE",
    text: "UAE crypto regulation and events, and the mechanics of buying property and other assets with digital currency.",
    icon: ICONS.money,
  },
  {
    href: "https://eco.dst.llc",
    title: "DST's environmental work — eco.dst.llc",
    eyebrow: "Environment",
    status: "Live",
    name: "Environment",
    // Not a vertical: nothing here is sold. It sits in the grid because it
    // is part of what the group does, and burying it would be its own kind
    // of statement.
    text: "Conifer planting in the Urals, work starting in Yerevan — and what we haven't done yet, said plainly.",
    icon: ICONS.star,
  },
];
---
<Layout
  title="AI, Crypto & Real Estate Ventures"
  description="DST builds and operates digital ventures across AI, Crypto, and Real Estate, starting in Dubai — the systems are ours; execution in each vertical runs through licensed local partners."
>
  <section class="container hero">
    <p class="eyebrow">AI · Crypto · Real Estate</p>
    <h1>We build the systems. Partners execute the vertical.</h1>
    <p class="lede">
      DST is an operating group, not a single business. We design and run the
      digital infrastructure behind ventures in three fast-moving spaces, and
      pair each one with a licensed local partner who handles the regulated,
      on-the-ground side. The first builds are live in Dubai.
    </p>
    <div class="hero-actions">
      <a class="button" href="#hubs" title="What DST is building">Hubs</a>
      <a class="button button-secondary" href="/contact/" title="Get in touch with DST">Get in touch</a>
    </div>
  </section>

  <section id="hubs" class="container">
    <h2>Hubs</h2>
    <div class="venture-grid">
      {hubs.map((hub) => {
        const Tag = hub.href ? "a" : "article";
        return (
          <Tag class="venture" href={hub.href} title={hub.title}>
            <div class="venture-media">
              {hub.image ? (
                <img src={hub.image} alt={hub.imageAlt ?? ""} loading="lazy" />
              ) : (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={hub.icon} />
                </svg>
              )}
            </div>
            <div class="venture-body">
              <div class="venture-meta">
                <p class="eyebrow">{hub.eyebrow}</p>
                <span class:list={["venture-status", { "venture-status-progress": hub.inProgress }]}>{hub.status}</span>
              </div>
              <h3>{hub.name}</h3>
              <p>{hub.text}</p>
            </div>
          </Tag>
        );
      })}
    </div>
  </section>

  <section id="approach" class="container">
    <h2>How we work</h2>
    <p>
      The model is consistent across every vertical we open:
    </p>
    <ol class="approach-list">
      <li>
        <strong>We build the system.</strong> Content, site architecture, lead
        capture, and CRM routing — engineered for organic search rather than
        paid acquisition, so each site keeps earning traffic long after it
        ships.
      </li>
      <li>
        <strong>A local partner executes.</strong> We don't originate or
        close real estate deals, hold crypto on anyone's behalf, or practice
        regulated advice ourselves — licensed partners on the ground do that
        part, and we route qualified leads to them.
      </li>
      <li>
        <strong>Each vertical compounds the network.</strong> Sites
        cross-link, share a design system, and point real, qualified traffic
        at each other — a visitor researching a Golden Visa is one click from
        the company-formation guide that half of them also need.
      </li>
    </ol>
  </section>
</Layout>

<style>
  /* .hero and .lede: shared in @dst/ui tokens.css. This page's hero is
     followed immediately by another section, so it adds bottom padding
     the shared default doesn't have. */
  .hero { padding-bottom: var(--space-4); }
  .hero-actions { display: flex; gap: var(--space-2); margin-top: var(--space-3); flex-wrap: wrap; }

  .venture-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-3);
    margin-top: var(--space-3);
  }
  /* Square-cornered, full-bleed media, same register as the venue cards on
     the district sites — see @dst/ui VenueCard. */
  .venture {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
    transition: border-color 200ms ease, transform 200ms ease;
  }
  a.venture:hover { border-color: var(--accent, #1F5C4E); transform: translateY(-2px); }

  .venture-media {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: linear-gradient(140deg, var(--surface-sunk), var(--surface));
  }
  .venture-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease;
  }
  a.venture:hover .venture-media img { transform: scale(1.03); }
  .venture-media svg { width: 30px; height: 30px; color: var(--ink-faint); }

  .venture-body { padding: var(--space-3); }
  .venture-meta { display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); }
  .venture-meta .eyebrow { margin: 0; }
  .venture-status {
    flex-shrink: 0;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ok);
    background: var(--ok-bg);
    padding: 0.15em 0.6em;
    border-radius: 999px;
  }
  .venture-status-progress { color: var(--warn); background: var(--warn-bg); }
  .venture h3 { margin-top: var(--space-2); margin-bottom: var(--space-1); font-size: var(--step-1); font-weight: 600; }
  .venture-body p { margin: 0; font-size: var(--step--1); color: var(--ink-muted); }

  .approach-list { display: flex; flex-direction: column; gap: var(--space-2); padding-left: 1.2em; }
  .approach-list li { max-width: var(--content-width); }
</style>
