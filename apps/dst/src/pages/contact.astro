---
import Layout from "../layouts/Layout.astro";
import LeadForm from "@dst/ui/LeadForm.astro";
---
<Layout
  title="Contact"
  description="Get in touch with DST — about a specific venture, a partnership, or the group generally."
>
  <section class="container">
    <p class="eyebrow">Contact</p>
    <h1>Get in touch</h1>
    <p class="lede">
      Looking for one of the verticals specifically? The
      <a href="https://llc.dst.llc" title="Company formation in Dubai">company formation</a> and
      <a href="https://visas.dst.llc" title="UAE residency and Golden Visa">Golden Visa</a> sites each have their
      own consultation forms that route straight to that team. Use this form
      for anything else — partnerships, press, or a venture that doesn't
      exist yet.
    </p>
  </section>

  <section class="container">
    <LeadForm endpoint="/api/lead" submitLabel="Send message">
      <div class="field">
        <label for="topic">What's this about?</label>
        <select id="topic" name="meta.topic">
          <option value="">Prefer not to say</option>
          <option value="partnership">A partnership</option>
          <option value="press">Press / media</option>
          <option value="vertical">A vertical not yet listed</option>
          <option value="other">Something else</option>
        </select>
      </div>
    </LeadForm>
  </section>
</Layout>
