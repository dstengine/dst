---
import BaseLayout from "@dst/ui/BaseLayout.astro";
import LeadTracking from "@dst/ui/LeadTracking.astro";
import { NETWORK } from "@dst/content/network";
import "../styles/theme.css";

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>[];
  /** og:image for this page — see BaseLayout. */
  image?: string;
}
const { title, description, jsonLd, image } = Astro.props;

const nav = [
  { href: "/#hubs", label: "Hubs", title: "What DST is building" },
  { href: "/#approach", label: "Approach", title: "How DST works" },
  { href: "/news/", label: "News", title: "What's changing at DST" },
  { href: "/events/", label: "Events", title: "DST events" },
  { href: "/contact/", label: "Contact", title: "Get in touch with DST" },
];
---
<BaseLayout
  title={`${title} — DST`}
  description={description}
  siteName="DST"
  nav={nav}
  complianceNote="DST builds and operates the systems behind each venture; execution in regulated verticals (real estate, financial services) is carried out by licensed local partners."
  jsonLd={jsonLd}
  image={image}
  logoSrc="/logo-mini.png"
  footerSites={NETWORK}
  favicon
>
  <LeadTracking slot="tracking" />
  <slot />
</BaseLayout>
