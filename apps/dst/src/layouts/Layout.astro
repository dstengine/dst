---
import BaseLayout from "@dst/ui/BaseLayout.astro";
import LeadTracking from "@dst/ui/LeadTracking.astro";
import { site } from "../site.config";
import "../styles/theme.css";

interface Props {
  /** Forwarded to BaseLayout: see its `prose` prop. */
  prose?: boolean;
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>[];
  /** og:image for this page — see BaseLayout. */
  image?: string;
}
const { title, description, jsonLd, image, prose } = Astro.props;

const nav = [
  { href: "/#hubs", label: "Hubs", title: "What DST is building" },
  { href: "/#approach", label: "Approach", title: "How DST works" },
  { href: "/news/", label: "News", title: "What's changing at DST" },
  { href: "/events/", label: "Events", title: "DST events" },
  { href: "/contact/", label: "Contact", title: "Get in touch with DST" },
];
---
<BaseLayout
  {...site}
  prose={prose}
  title={title}
  description={description}
  nav={nav}
  jsonLd={jsonLd}
  image={image}
>
  <LeadTracking slot="tracking" />
  <slot />
</BaseLayout>
