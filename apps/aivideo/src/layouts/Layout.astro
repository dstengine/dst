---
import BaseLayout from "@dst/ui/BaseLayout.astro";
import { site } from "../site.config";
import "../styles/theme.css";

interface Props {
  /** Forwarded to BaseLayout: see its `prose` prop. */
  prose?: boolean;
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>[];
  image?: string;
  noindex?: boolean;
}
const { title, description, jsonLd, image, noindex, prose } = Astro.props;

// The label is what fits in the bar; the title is what the link is about.
// A title attribute that repeats its own label spends a slot on nothing —
// here every one of them can say "AI video", the words the site is for.
const nav = [
  { href: "/", label: "Home", title: "AI video news: models, tools and AI editing", icon: "home" },
  { href: "/news/", label: "News", title: "Every AI video story, newest first", icon: "news" },
  { href: "/guides/", label: "Guides", title: "AI video guides: comparisons and how-tos", icon: "document" },
  { href: "/about/", label: "About", title: "About aivideo.zone and its AI video coverage", icon: "id" },
];
---
<BaseLayout
  {...site}
  prose={prose}
  title={title}
  description={description}
  nav={nav}
  jsonLd={jsonLd}
  image={image}
  noindex={noindex}
>
  <slot />
</BaseLayout>
