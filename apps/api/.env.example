# Set these in the Vercel project's Environment Variables, not here.
# Create the bot via @BotFather in Telegram, then add it to the target chat
# and grab the chat ID (e.g. via https://api.telegram.org/bot<token>/getUpdates
# after sending it a message).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Planfix has no inbound webhook URL - leads go in via its REST API
# (POST /task/), authenticated with a per-account bearer token from
# Account management -> Access to API -> REST API. PLANFIX_TEMPLATE_ID is
# optional.
PLANFIX_API_TOKEN=
PLANFIX_ACCOUNT=
PLANFIX_TEMPLATE_ID=

# Uspacy's incoming-webhook base URL (Automation -> Webhooks -> Incoming,
# access: CRM), with /crm/v1/entities/leads appended - the bare webhook
# URL alone just returns a list of valid paths, it won't create a lead.
USPACY_WEBHOOK_URL=

# Linear has no inbound webhook URL either - leads go in as issues via its
# GraphQL API (issueCreate), authenticated with a personal API key scoped
# to "Create issues" only (Settings -> Security & access -> Personal API
# keys). LINEAR_TEAM_ID is the target team's UUID (GraphQL `teams` query,
# or capture it from a temporary Read-scoped key and delete that key after).
LINEAR_API_KEY=
LINEAR_TEAM_ID=
