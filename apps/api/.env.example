# Set these in the Vercel project's Environment Variables, not here.
# Create the bot via @BotFather in Telegram, then add it to the target chat
# and grab the chat ID (e.g. via https://api.telegram.org/bot<token>/getUpdates
# after sending it a message).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Planfix has no inbound webhook URL - leads go in via its REST API
# (POST /task/), authenticated with a per-account bearer token from
# Account management -> Access to API -> REST API. PLANFIX_TEMPLATE_ID is
# optional.
PLANFIX_API_TOKEN=
PLANFIX_ACCOUNT=
PLANFIX_TEMPLATE_ID=

# Inbound webhook URL from Uspacy's own settings.
USPACY_WEBHOOK_URL=
