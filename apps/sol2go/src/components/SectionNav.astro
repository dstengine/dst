---
// This site's sections, drawn as @dst/ui's ChipNav. All that is left here
// is the vocabulary — what a section's link says and where it points —
// because the row itself is a shape any site cutting a feed into slices
// will want.
import ChipNav from "@dst/ui/ChipNav.astro";
import type { Section } from "../sections";

interface Props {
  sections: Section[];
  /** Href of the page being read, if it is one of these. */
  current?: string;
  /** The calendar itself, as the first item in the row. Given here rather
      than assumed, because the front page's block already carries an "All
      events" link of its own and a second one beside it leads nowhere new. */
  allHref?: string;
}
const { sections, current, allHref } = Astro.props;

const items = [
  ...(allHref
    ? [{ href: allHref, label: "All", title: "The whole Solana events calendar" }]
    : []),
  ...sections.map((s) => ({ href: `/${s.slug}/`, label: s.label, title: s.h1 })),
];
---
{sections.length > 0 && (
  <ChipNav items={items} current={current} label="Events by country and kind" />
)}
