---
import Layout from "../layouts/Layout.astro";
import EventsList from "@dst/ui/EventsList.astro";
import SectionNav from "../components/SectionNav.astro";
import { events, site, eventsBase } from "../content";
import { sections } from "../sections";
import { eventsBySite } from "@dst/content/events";

const items = eventsBySite(site);
const sectionLinks = sections(items);
const thin = items.length < 3;
---
<Layout title={events.title} description={events.description} noindex={thin}>
  <section class="container hero">
    <h1>{events.h1}</h1>
    <p class="lede">{events.lede}</p>
  </section>
  <section class="container">
    <SectionNav sections={sectionLinks} />
    <EventsList items={items} eventsBase={eventsBase} />
  </section>
</Layout>
