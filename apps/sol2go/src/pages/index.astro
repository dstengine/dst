---
import Layout from "../layouts/Layout.astro";
import PromoHero from "@dst/ui/PromoHero.astro";
import NewsBlock from "@dst/ui/NewsBlock.astro";
import EventsBlock from "@dst/ui/EventsBlock.astro";
import SectionNav from "@dst/ui/SectionNav.astro";
import { home, siteId, newsBase, eventsBase } from "../content";
import { sections, NAV } from "../sections";
import { newsBySite } from "@dst/content/news";
import { eventsBySite } from "@dst/content/events";

const newsItems = newsBySite(siteId);
const eventItems = eventsBySite(siteId);
const sectionLinks = sections(eventItems);
---
<Layout title={home.title} description={home.description}>
  <PromoHero>
    <h1>{home.h1}</h1>
    <p class="lede">{home.lede}</p>
  </PromoHero>
  <EventsBlock items={eventItems} heading="Events" eventsBase={eventsBase}>
    <SectionNav slot="nav" sections={sectionLinks} {...NAV} />
  </EventsBlock>
  <NewsBlock items={newsItems} heading="News" newsBase={newsBase} />
</Layout>
