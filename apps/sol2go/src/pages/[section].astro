---
import Layout from "../layouts/Layout.astro";
import { site } from "../site.config";
import EventsList from "@dst/ui/EventsList.astro";
import SectionNav from "@dst/ui/SectionNav.astro";
import { siteId, eventsBase } from "../content";
import { sections, NAV } from "../sections";
import { eventsBySite } from "@dst/content/events";

export function getStaticPaths() {
  const all = sections(eventsBySite(siteId));
  return all.map((section) => ({ params: { section: section.slug }, props: { section, all } }));
}

const { section, all } = Astro.props;
---
<Layout title={section.title} description={section.description}>
  <section class="container hero">
    <h1>{section.h1}</h1>
    <p class="lede">{section.lede}</p>
  </section>
  <section class="container">
    <SectionNav sections={all} current={`/${section.slug}/`} allHref={eventsBase} {...NAV} />
    <EventsList items={section.items} eventsBase={eventsBase}
    where={site.keyword}
  />
  </section>
</Layout>
