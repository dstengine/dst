---
import Guide from "../../components/Guide.astro";
import { siteId } from "../../content";
import { newsBySite } from "@dst/content/news";

export function getStaticPaths() {
  // No body, no page — the card says everything the entry has.
  const items = newsBySite(siteId).filter((i) => Array.isArray(i.body) && i.body.length > 0);
  // An entry with a short address of its own is built there instead — see
  // ../[page].astro — and its old /guides/ address redirects (vercel.json).
  return items.filter((i) => !i.path).map((item) => ({ params: { slug: item.slug }, props: { item, more: items } }));
}

const { item, more } = Astro.props;
---
<Guide item={item} more={more} />
