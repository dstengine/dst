---
import Layout from "../layouts/Layout.astro";
import PromoHero from "@dst/ui/PromoHero.astro";
import NewsList from "@dst/ui/NewsList.astro";
import SectionNav from "@dst/ui/SectionNav.astro";
import { guides, siteId, newsBase } from "../content";
import { sections, NAV } from "../sections";
import { newsBySite } from "@dst/content/news";

const items = newsBySite(siteId);
// An index holding fewer than three entries is thinner than the pages it
// links to, so it stays out of the index until it has something to be an
// index of. It keeps `follow` either way — the guides must stay reachable.
const thin = items.length < 3;
---
<Layout title={guides.title} description={guides.description} noindex={thin}>
  <PromoHero>
    <h1>{guides.h1}</h1>
    <p class="lede">{guides.lede}</p>
  </PromoHero>
  <section class="container">
    <SectionNav sections={sections(items)} current={newsBase} allHref={newsBase} {...NAV} />
    <NewsList items={items} newsBase={newsBase} locale="en-GB" />
  </section>
</Layout>
