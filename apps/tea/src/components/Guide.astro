---
// One guide's page, wherever it lives: under /guides/ like nearly all of
// them, or at a short address of its own (`path`, see @dst/content/types).
// The two routes share this so the page is the same page at either.
import Layout from "../layouts/Layout.astro";
import NewsArticle from "@dst/ui/NewsArticle.astro";
import { sectionHrefFor } from "@dst/content/sections";
import type { NewsItem } from "@dst/content/types";
import { siteId, newsBase, publisher } from "../content";
import { sections, tagLinks } from "../sections";
import { newsBySite } from "@dst/content/news";
import { go } from "../outbound";
import { moments } from "../schedule";
import Ceremony from "./Ceremony.astro";
import NightCover from "./NightCover.astro";

interface Props {
  item: NewsItem;
  more: NewsItem[];
}
const { item, more } = Astro.props;
const all = sections(newsBySite(siteId));
// The tea times this page is the page about, in the order of the day.
const ceremony = moments.filter((m) => m.guide?.slug === item.slug && m.guide.about);
// Whether those tea times bring a picture that follows the clock.
const clockCover = ceremony.some((m) => m.cover);
---
<Layout title={item.titleSeo ?? item.title} description={item.summary} image={item.image}>
  <NewsArticle
    item={item}
    more={more}
    backHref={newsBase}
    newsBase={newsBase}
    publisher={publisher}
    locale="en-GB"
    labels={{ moreNews: () => "More tea guides" }}
    categoryHref={sectionHrefFor(item, all)}
    tagLinks={tagLinks(item, all)}
    tagsLabel="More on"
    actionHref={item.action ? go(`${item.slug}-action`) : undefined}
  >
    {ceremony.length > 0 && (
      <Ceremony slot="lead" moments={ceremony}>
        {clockCover && item.image && (
          <NightCover slot="cover" moments={ceremony} image={item.image} alt={item.imageAlt ?? ""} />
        )}
      </Ceremony>
    )}
  </NewsArticle>
</Layout>
