---
import BaseLayout from "@dst/ui/BaseLayout.astro";
import { site } from "../site.config";
import "../styles/theme.css";

interface Props {
  /** Forwarded to BaseLayout: see its `prose` prop. */
  prose?: boolean;
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>[];
  image?: string;
  noindex?: boolean;
}
const { title, description, jsonLd, image, noindex, prose } = Astro.props;

// The label is what fits in the bar; the title is what the link is about.
// A title attribute that repeats its own label spends a slot on nothing —
// here every one of them can say "tea", the word the site is for.
const nav = [
  { href: "/", label: "Home", title: "Tea guides and the countdown to the next tea time", icon: "home" },
  { href: "/guides/", label: "Guides", title: "How to brew tea: every kind, with temperatures and times", icon: "leaf" },
  { href: "/schedule/", label: "Tea times", title: "The tea calendar: daily tea times and tea days, counting down", icon: "clock" },
  { href: "/about/", label: "About", title: "About tea.ceo and its tea guides", icon: "id" },
];
---
<BaseLayout
  {...site}
  prose={prose}
  title={title}
  description={description}
  nav={nav}
  jsonLd={jsonLd}
  image={image}
  noindex={noindex}
>
  <slot />
</BaseLayout>
