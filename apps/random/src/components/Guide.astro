---
// One guide's page. A component of its own, as on tea.ceo, so a guide that
// later earns a short address (`path`, see @dst/content/types) is the same
// page at either route.
import Layout from "../layouts/Layout.astro";
import NewsArticle from "@dst/ui/NewsArticle.astro";
import { sectionHrefFor } from "@dst/content/sections";
import type { NewsItem } from "@dst/content/types";
import { siteId, newsBase, publisher } from "../content";
import { sections, tagLinks } from "../sections";
import { newsBySite } from "@dst/content/news";
import { go } from "../outbound";

interface Props {
  item: NewsItem;
  more: NewsItem[];
}
const { item, more } = Astro.props;
const all = sections(newsBySite(siteId));
---
<Layout title={item.titleSeo ?? item.title} description={item.summary} image={item.image}>
  <NewsArticle
    item={item}
    more={more}
    backHref={newsBase}
    newsBase={newsBase}
    publisher={publisher}
    locale="en"
    labels={{ moreNews: () => "More RandomX guides" }}
    categoryHref={sectionHrefFor(item, all)}
    tagLinks={tagLinks(item, all)}
    tagsLabel="More on"
    actionHref={item.action ? go(`${item.slug}-action`) : undefined}
  />
</Layout>
