---
import Layout from "../layouts/Layout.astro";
import NewsBlock from "@dst/ui/NewsBlock.astro";
import EventsBlock from "@dst/ui/EventsBlock.astro";
import SectionNav from "@dst/ui/SectionNav.astro";
import { home, siteId, newsBase, eventsBase, labels } from "../content";
import { newsBySite } from "@dst/content/news";
import { eventsBySite } from "@dst/content/events";
import { sections, NAV } from "../sections";

const newsItems = newsBySite(siteId);
const eventItems = eventsBySite(siteId);
const sectionLinks = sections([...eventItems, ...newsItems]);
---
<Layout title={home.title} description={home.description}>
  <section class="container hero">
    <h1>{home.h1}</h1>
    <p class="lede">{home.lede}</p>
    <SectionNav sections={sectionLinks} label={NAV.label} />
  </section>
  <EventsBlock locale="en-GB" items={eventItems} heading="Events" eventsBase={eventsBase} labels={labels} />
  <NewsBlock locale="en-GB" items={newsItems} heading="News" newsBase={newsBase} />
</Layout>
