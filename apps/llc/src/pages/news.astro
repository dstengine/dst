---
import Layout from "../layouts/Layout.astro";
import SectionNav from "@dst/ui/SectionNav.astro";
import NewsList from "@dst/ui/NewsList.astro";
import { newsBySite } from "@dst/content/news";
import { eventsBySite } from "@dst/content/events";
import { sections, NAV } from "../sections";

const items = newsBySite("llc");

// The subject row. Empty until a subject earns a page, and then it
// appears here without this file changing — see ../sections.ts.
const sectionLinks = sections([...eventsBySite("llc"), ...newsBySite("llc")]);
---
<Layout
  title="Business setup news"
  description="Updates on Dubai company formation — regulatory changes, new guidance, and updates to this site's own tools."
>
  <section class="container hero">
    <p class="eyebrow">News</p>
    <h1>What's changing in Dubai company formation</h1>
    <p class="lede">
      Regulatory changes and updates that affect setting up or running a
      Dubai company, kept apart from the reference pages themselves.
    </p>
  </section>

  <section class="container">
    <SectionNav sections={sectionLinks} {...NAV} />
    <NewsList items={items} />
  </section>
</Layout>
