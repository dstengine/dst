---
import Layout from "../layouts/Layout.astro";
import SectionNav from "@dst/ui/SectionNav.astro";
import EventsList from "@dst/ui/EventsList.astro";
import { eventsBySite } from "@dst/content/events";
import { newsBySite } from "@dst/content/news";
import { sections, NAV } from "../sections";

const items = eventsBySite("llc");

// The subject row. Empty until a subject earns a page, and then it
// appears here without this file changing — see ../sections.ts.
const sectionLinks = sections([...eventsBySite("llc"), ...newsBySite("llc")]);
---
<Layout
  title="Business setup events"
  description="Webinars and in-person sessions on Dubai company formation, when there are any scheduled."
>
  <section class="container hero">
    <p class="eyebrow">Events</p>
    <h1>Company formation events</h1>
    <p class="lede">
      Sessions on setting up or running a Dubai company, published here
      once there's something scheduled.
    </p>
  </section>

  <section class="container">
    <SectionNav sections={sectionLinks} {...NAV} />
    <EventsList items={items} />
  </section>
</Layout>
