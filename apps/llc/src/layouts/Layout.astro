---
import BaseLayout from "@dst/ui/BaseLayout.astro";
import "../styles/theme.css";

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>[];
}
const { title, description, jsonLd } = Astro.props;

const nav = [
  { href: "/", label: "Getting started", title: "How to start a business in Dubai" },
  { href: "/zones/", label: "Free zones", title: "Dubai free zone comparison" },
  { href: "/mainland/", label: "Mainland", title: "Mainland company setup in Dubai" },
  { href: "/registration/", label: "Registration", title: "Company registration, step by step" },
  { href: "/taxation/", label: "Taxation", title: "Corporate tax and filing in Dubai" },
  { href: "/banking/", label: "Banking", title: "Business banking for Dubai companies" },
  { href: "/financing/", label: "Financing", title: "Business financing once the company trades" },
  { href: "/payments/", label: "Payments", title: "Accepting card payments as a Dubai company" },
];
---
<BaseLayout
  title={`${title} — Company Formation in Dubai`}
  description={description}
  siteName="Dubai Company Formation"
  nav={nav}
  complianceNote="Informational content, not legal or financial advice. Always confirm current requirements with DED or your chosen free zone authority before acting."
  jsonLd={jsonLd}
  partnerDisclosure={false}
>
  <slot />
</BaseLayout>
