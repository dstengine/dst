---
import BaseLayout from "@dst/ui/BaseLayout.astro";
import { site } from "../site.config";
import LeadTracking from "@dst/ui/LeadTracking.astro";
import "../styles/theme.css";

interface Props {
  /** Forwarded to BaseLayout: see its `prose` prop. */
  prose?: boolean;
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>[];
  /** og:image for this page — see BaseLayout. */
  image?: string;
}
const { title, description, jsonLd, image, prose } = Astro.props;

const nav = [
  { href: "/", label: "Overview", title: "How to start a business in Dubai" },
  { href: "/zones/", label: "Zones", title: "Dubai free zone comparison" },
  { href: "/mainland/", label: "Mainland", title: "Mainland company setup in Dubai" },
  { href: "/registration/", label: "Registration", title: "Company registration, step by step" },
  { href: "/taxation/", label: "Taxation", title: "Corporate tax and filing in Dubai" },
  { href: "/banking/", label: "Banking", title: "Business banking for Dubai companies" },
  { href: "/financing/", label: "Financing", title: "Business financing once the company trades" },
  { href: "/payments/", label: "Payments", title: "Accepting card payments as a Dubai company" },
  { href: "/news/", label: "News", title: "What's changing in Dubai company formation" },
  { href: "/events/", label: "Events", title: "Company formation events" },
];
---
<BaseLayout
  {...site}
  prose={prose}
  title={title}
  description={description}
  nav={nav}
  jsonLd={jsonLd}
  image={image}
>
  <LeadTracking slot="tracking" />
  <slot />
</BaseLayout>
