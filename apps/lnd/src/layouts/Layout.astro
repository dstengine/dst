---
import BaseLayout from "@dst/ui/BaseLayout.astro";
import { site } from "../site.config";
import { promoted } from "../sections";
import "../styles/theme.css";

interface Props {
  /** Forwarded to BaseLayout: see its `prose` prop. */
  prose?: boolean;
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>[];
  image?: string;
  noindex?: boolean;
}
const { title, description, jsonLd, image, noindex, prose } = Astro.props;

const nav = [
  { href: "/", label: "What's on", title: "What's on in London this season", icon: "home" },
  // Second, not last: it is the one link on the page that is about what
  // is being asked for this month, and it disappears on its own when the
  // last date under it has gone.
  ...(promoted
    ? [{ href: `/${promoted.slug}/`, label: promoted.label, title: promoted.title, icon: "star" }]
    : []),
  { href: "/news/", label: "News", title: "London news, each entry with the source it came from", icon: "news" },
  { href: "/events/", label: "Events", title: "The London events calendar", icon: "events" },
  { href: "/about/", label: "About", title: "Who publishes this and how every date is checked", icon: "id" },
];

---
<BaseLayout
  {...site}
  prose={prose}
  title={title}
  description={description}
  nav={nav}
  jsonLd={jsonLd}
  image={image}
  noindex={noindex}
>
  <slot />
</BaseLayout>
