---
import Layout from "../../layouts/Layout.astro";
import { site } from "../../site.config";
import { eventMeta } from "@dst/ui/meta";
import EventArticle from "@dst/ui/EventArticle.astro";
import { siteId, newsBase, eventsBase, publisher, labels } from "../../content";
import { eventsBySite } from "@dst/content/events";
import { go } from "../../outbound";
import { newsBySite } from "@dst/content/news";
import { sectionHrefFor } from "@dst/content/sections";
import { allSections, promoted, pluralOf } from "../../sections";

export function getStaticPaths() {
  const items = eventsBySite(siteId).filter((i) => Array.isArray(i.body) && i.body.length > 0);
  return items.map((item) => ({ params: { slug: item.slug }, props: { item, more: items } }));
}

const moreNews = newsBySite(siteId);
const { item, more } = Astro.props;
// The subject page, when the subject has earned one. Built from the whole
// feed, not from `more`: that one is filtered down to entries with a page,
// and the threshold counts entries — a section the nav shows and this did
// not would be a link missing from exactly the pages that belong under it.
const categoryHref = sectionHrefFor(item, allSections);
// A seller if we have one, the source if we don't — see src/outbound.ts.
const ticketHref = item.ticket ? go(`${item.slug}-ticket`) : undefined;
const sourceHref = item.source?.url ? go(`${item.slug}-source`) : undefined;
// The search title and description, with the meta-hook page test applied
// (@dst/ui/meta); the control is the dated title and the summary.
const meta = eventMeta(item, site, { host: Astro.site?.hostname ?? "", path: Astro.url.pathname, siblings: more });
---
<Layout title={meta.title} description={meta.description} image={item.image}>
  <EventArticle
    item={item}
    locale="en-GB"
    labels={labels}
    ticketHref={ticketHref} mapHref={item.geo ? `/go/${item.slug}-map/` : undefined}
    sourceHref={sourceHref}
    more={more}
    moreNews={moreNews}
    backHref={eventsBase}
    newsBase={newsBase}
    eventsBase={eventsBase}
    publisher={publisher}
    promoted={promoted}
    categoryHref={categoryHref}
    where={site.keyword}
    pluralOf={pluralOf}
    moreEventsText={item.moreEventsText}
  />
</Layout>
