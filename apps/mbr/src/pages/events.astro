---
import Layout from "../layouts/Layout.astro";
import ContentPage from "@dst/ui/district/ContentPage.astro";
import EventsList from "@dst/ui/EventsList.astro";
import { events } from "../content";
import { eventsBySite } from "@dst/content/events";

const items = eventsBySite("mbr");
---
<Layout {...events}>
  <ContentPage {...events} />
  <section class="container">
    <EventsList items={items} />
  </section>
</Layout>
