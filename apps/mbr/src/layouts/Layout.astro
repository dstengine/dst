---
import DistrictLayout from "@dst/ui/DistrictLayout.astro";
import "../styles/theme.css";
import { site } from "../site.config";

interface Props {
  /** Forwarded to DistrictLayout, and on to BaseLayout. */
  prose?: boolean;
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>[];
  // Page opener. Pages pass their whole content object, so these arrive
  // alongside fields the layout ignores.
  eyebrow?: string;
  h1?: string;
  lede?: string;
  ledeWidth?: string;
  image?: string;
  imageAlt?: string;
  /** Every page cover on this site is drawn rather than photographed. The
      opener prints no label for "generated" — how a picture was made is our
      business — but the field has to travel or ImageNote elsewhere would
      have to guess. */
  imageKind?: "photo" | "diagram" | "illustration" | "render" | "generated";
}

const { title, description, jsonLd, eyebrow, h1, lede, ledeWidth, image, imageAlt, imageKind, prose } = Astro.props;

// The site's header image is the default; a page overrides it by setting
// its own `image` in content.ts.
const headerImage = image ?? site.headerImage;
const headerImageAlt = imageAlt ?? (image ? undefined : site.headerImageAlt);
---
<DistrictLayout
  prose={prose}
  {...site}
  title={title}
  description={description}
  jsonLd={jsonLd}
  eyebrow={eyebrow}
  h1={h1}
  lede={lede}
  ledeWidth={ledeWidth}
  image={headerImage}
  imageAlt={headerImageAlt}
  imageKind={image ? (imageKind ?? "generated") : undefined}
>
  <slot />
</DistrictLayout>
