---
import DistrictLayout from "@dst/ui/DistrictLayout.astro";
import "../styles/theme.css";
import { site } from "../site.config";

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>[];
}
const { title, description, jsonLd } = Astro.props;
---
<DistrictLayout title={title} description={description} jsonLd={jsonLd} {...site}>
  <slot />
</DistrictLayout>
