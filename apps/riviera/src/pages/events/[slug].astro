---
import Layout from "../../layouts/Layout.astro";
import EventArticle from "@dst/ui/EventArticle.astro";
import { eventsBySite } from "@dst/content/events";
import { newsBySite } from "@dst/content/news";
import { outbound } from "../../outbound";

export function getStaticPaths() {
  const items = eventsBySite("riviera").filter((item) => Array.isArray(item.body) && item.body.length > 0);
  // The rest of the feed travels with each page so the article can end
  // with somewhere to go instead of only a back link.
  return items.map((item) => ({ params: { slug: item.slug }, props: { item, more: items } }));
}

const moreNews = newsBySite("riviera");
const { item, more } = Astro.props;
const ticketSlug = `${item.slug}-ticket`;
const ticketHref = item.ticket && outbound[ticketSlug] ? `/go/${ticketSlug}/` : undefined;
---
<Layout title={item.titleSeo ?? item.title} description={item.summary} image={item.image}>
  <EventArticle item={item} more={more} moreNews={moreNews} backHref="/events/" ticketHref={ticketHref} />
</Layout>
