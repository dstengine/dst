---
import Layout from "../../layouts/Layout.astro";
import VenuePage from "@dst/ui/district/VenuePage.astro";
import { coffeeVenues } from "../../content";

export function getStaticPaths() {
  return Object.values(coffeeVenues).map((venue) => ({
    params: { slug: venue.slug },
    props: { venue },
  }));
}

const { venue } = Astro.props;
---
<Layout title={`${venue.name} — Coffee in Azizi Riviera`} description={venue.description}>
  <VenuePage {...venue} backHref="/coffee/" backLabel="Coffee in Azizi Riviera" />
</Layout>
