---
import Layout from "../../layouts/Layout.astro";
import VenuePage from "@dst/ui/district/VenuePage.astro";
import { coffeeVenues } from "../../content";

export function getStaticPaths() {
  return Object.values(coffeeVenues).map((venue) => ({
    params: { slug: venue.slug },
    props: { venue },
  }));
}

const { venue } = Astro.props;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CafeOrCoffeeShop",
    name: venue.name,
    description: venue.description,
    ...(venue.image && { image: new URL(venue.image, Astro.site).toString() }),
    ...(venue.building && {
      address: {
        "@type": "PostalAddress",
        streetAddress: venue.building,
        addressLocality: "Dubai",
        addressCountry: "AE",
      },
    }),
    ...(venue.phone && { telephone: venue.phone }),
    ...(venue.openingHours && { openingHours: venue.openingHours }),
    ...(venue.externalHref && { sameAs: [venue.externalHref] }),
    url: new URL(`/coffee/${venue.slug}/`, Astro.site).toString(),
  },
];
---
<Layout title={`${venue.name} — Coffee in Azizi Riviera`} description={venue.description} jsonLd={jsonLd}>
  <VenuePage {...venue} backHref="/coffee/" backLabel="Coffee in Azizi Riviera" />
</Layout>
