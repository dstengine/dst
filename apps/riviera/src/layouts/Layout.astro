---
import DistrictLayout from "@dst/ui/DistrictLayout.astro";
import "../styles/theme.css";
import { site } from "../site.config";

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>[];
  // Page opener. Pages pass their whole content object, so these arrive
  // alongside fields the layout ignores.
  eyebrow?: string;
  h1?: string;
  lede?: string;
  ledeWidth?: string;
  image?: string;
  imageAlt?: string;
}

const { title, description, jsonLd, eyebrow, h1, lede, ledeWidth, image, imageAlt } = Astro.props;

// The site's header image is the default; a page overrides it by setting
// its own `image` in content.ts.
const headerImage = image ?? site.headerImage;
const headerImageAlt = imageAlt ?? (image ? undefined : site.headerImageAlt);
// A page supplying its own image is supplying a real photograph (a venue
// shot); only the site default is the generated one.
const headerImageKind = image ? "photo" : site.headerImageKind;
---
<DistrictLayout
  {...site}
  title={title}
  description={description}
  jsonLd={jsonLd}
  eyebrow={eyebrow}
  h1={h1}
  lede={lede}
  ledeWidth={ledeWidth}
  image={headerImage}
  imageAlt={headerImageAlt}
  imageKind={headerImageKind}
>
  <slot />
</DistrictLayout>
