---
import BaseLayout from "@dst/ui/BaseLayout.astro";
import { site as SITES } from "../site.config";
import { promotedAll, cityDayAhead, iconOf } from "../sections";
import { alternates, prefix } from "../i18n";
import { topFor } from "../top";
import { portal, type Lang } from "../content";
import { NAV as NAVS } from "./nav";
import "../styles/theme.css";

interface Props {
  lang: Lang;
  /** Forwarded to BaseLayout: see its `prose` prop. */
  prose?: boolean;
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>[];
  image?: string;
  noindex?: boolean;
  /** Forwarded to BaseLayout, for the breadcrumb trail in the structured
      data: see its props. The calendar is not in the menu, so its crumb
      is named here for every page under it. */
  crumbLabels?: Record<string, string>;
  crumbCurrent?: string;
}
const { lang, title, description, jsonLd, image, noindex, prose, crumbLabels, crumbCurrent } = Astro.props;
const site = SITES[lang];
const p = prefix(lang);
const hots = promotedAll[lang];

const NAV = NAVS[lang].filter((l) => cityDayAhead[lang] || !l.href.endsWith("yerevan-city-day/"));

// Second, not last, when there are any: first the entries the site is
// pushing hardest (../top.ts), then the links here about what is being asked
// for this month, each removing itself when its last date has gone. An
// entry's title attribute is its search title, so the slot names the city
// rather than repeating the label.
const nav = [
  NAV[0],
  ...topFor(lang).map((t) => ({ href: t.href, label: t.label, title: t.item.titleSeo ?? t.item.title, icon: t.icon })),
  ...hots.map((hot) => ({ href: `${p}${hot.slug}/`, label: hot.label, title: hot.title, icon: iconOf(hot.slug) })),
  ...NAV.slice(1),
];
---
<BaseLayout
  {...site}
  prose={prose}
  title={title}
  description={description}
  nav={nav}
  jsonLd={jsonLd}
  image={image}
  noindex={noindex}
  crumbLabels={{ calendar: portal[lang].calendar, ...crumbLabels }}
  crumbCurrent={crumbCurrent}
  homeHref={p}
  feedHref={`${p}rss.xml`}
  alternates={alternates(Astro.url.pathname)}
>
  <slot />
</BaseLayout>
