---
// A page's intro row with the promo card beside it (../promo.ts). The
// intro — breadcrumbs, h1, lede, a search box — keeps the left edge in the
// slot; the card takes the room to its right that the 34rem lede leaves
// empty, level with the top of the intro: a venue page keeps its fact table
// in the same row, and a card aligned to the bottom read as part of that
// table. On a phone it follows the intro. With no code to show, the row is the plain hero it
// was before.
import PromoCode from "./PromoCode.astro";
import { promoFor } from "../promo";
import type { Lang } from "../content";

interface Props { lang: Lang }
const { lang } = Astro.props;
const today = new Date().toISOString().slice(0, 10);
const promo = promoFor(today);
---
<section class:list={["container", "hero", { "hero-promo": promo }]}>
  {promo ? (
    <>
      <div><slot /></div>
      <PromoCode code={promo.code} lang={lang} />
    </>
  ) : <slot />}
</section>

<style>
  .hero-promo {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: var(--space-4);
    row-gap: var(--space-3);
    align-items: start;
  }
  @media (max-width: 700px) {
    .hero-promo { grid-template-columns: minmax(0, 1fr); }
    /* Stacked, the card is the last thing in the hero and the next heading
       sat on its border. On the section, not the card: a scoped selector
       does not reach a child component's root. */
    .hero-promo { padding-bottom: var(--space-4); }
  }
</style>
