---
import Layout from "../layouts/Layout.astro";
import NewsBlock from "@dst/ui/NewsBlock.astro";
import EventsBlock from "@dst/ui/EventsBlock.astro";
import SectionNav from "@dst/ui/SectionNav.astro";
import FeedCards from "@dst/ui/FeedCards.astro";
import BlockHead from "@dst/ui/BlockHead.astro";
import CountdownScript from "@dst/ui/CountdownScript.astro";
import SiteSearch from "@dst/ui/SiteSearch.astro";
import VenueCards from "@dst/ui/VenueCards.astro";
import MonthChips from "../components/MonthChips.astro";
import { withLabels } from "@dst/ui/labels";
import { site } from "../site.config";
import { allVenues, venuesBase } from "../venues";
import { cardCountdown } from "@dst/ui/date";
import { eventHref, newsHref } from "@dst/content/paths";
import { home, words, labels, type Lang } from "../content";
import { LOCALE, eventsFor, newsFor, eventsBase, newsBase, prefix } from "../i18n";
import { allSections, NAV } from "../sections";
import { topFor } from "../top";

interface Props { lang: Lang }
const { lang } = Astro.props;
const page = home[lang];
const w = words[lang];

// The spotlight: ../top.ts, as cards, ahead of the date-ordered blocks —
// and left out of those blocks, so no card shows twice on the page.
const events = eventsFor(lang);
const news = newsFor(lang);
const top = topFor(lang).map((t) =>
  t.kind === "event"
    ? {
        href: t.href,
        eyebrow: t.item.category,
        date: t.item.start,
        title: t.item.title,
        short: t.item.cardTitle,
        text: [t.item.venue, t.item.city].filter(Boolean).join(" · ") || t.item.summary,
        image: t.item.image,
        imageAlt: t.item.imageAlt,
        imageFit: "cover" as const,
        event: true,
        countdown: cardCountdown(t.item),
        dateInImage: t.item.dateInImage,
        editorsChoice: t.item.editorsChoice,
      }
    : {
        href: t.href,
        eyebrow: t.item.category,
        date: t.item.date,
        title: t.item.title,
        short: t.item.cardTitle,
        text: t.item.summary,
        image: t.item.image,
        imageAlt: t.item.imageAlt,
        imageFit: "cover" as const,
      },
);
const shown = new Set(top.map((c) => c.href));
const p = prefix(lang);
const L = withLabels(labels[lang]);
const today = new Date().toISOString().slice(0, 10);
// The rooms with the most still to come, four of them: the venues page
// has the rest.
const venues = allVenues[lang].slice(0, 4).map((v) => ({
  href: `${venuesBase(lang)}${v.slug}/`,
  name: v.name,
  kind: v.kind,
  address: v.address,
  next: v.next ? (v.next.start < today ? today : v.next.start) : undefined,
  count: v.items.length,
}));
---
<Layout lang={lang} title={page.title} description={page.description}>
  <section class="container hero">
    <h1>{page.h1}</h1>
    <p class="lede">{page.lede}</p>
    <SiteSearch indexHref={`${p}search.json`} locale={LOCALE[lang]} labels={labels[lang]} />
  </section>
  {top.length > 0 && (
    <section class="container home-top">
      <BlockHead heading={w.top} />
      <FeedCards items={top} columns={top.length} locale={LOCALE[lang]} labels={labels[lang]} />
    </section>
  )}
  <EventsBlock locale={LOCALE[lang]} items={events.filter((e) => !shown.has(eventHref(e, eventsBase(lang))))} heading={w.upcoming} eventsBase={eventsBase(lang)} allLabel={w.allEvents} labels={labels[lang]}>
    {/* The ways into the calendar, under the spotlight rather than above
        it: the first event is the point of the page, and a row of chips
        before it pushed it below the fold on a phone. */}
    <Fragment slot="nav">
      <SectionNav sections={allSections[lang]} label={NAV[lang].label} base={p} />
      <MonthChips lang={lang} />
    </Fragment>
  </EventsBlock>
  {venues.length > 0 && (
    <section class="container home-venues">
      <BlockHead heading={L.venues(site[lang].keyword)} link={{ href: venuesBase(lang), label: L.allVenues, title: L.venues(site[lang].keyword) }} />
      <VenueCards items={venues} columns={venues.length} locale={LOCALE[lang]} labels={labels[lang]} />
    </section>
  )}
  <NewsBlock locale={LOCALE[lang]} items={news.filter((n) => !shown.has(newsHref(n, newsBase(lang))))} heading={w.news} newsBase={newsBase(lang)} allLabel={w.allNews} />
  {top.some((c) => "event" in c) && <CountdownScript />}
</Layout>

<style>
  .home-top { margin-top: var(--space-5); }
  .home-venues { margin-top: var(--space-5); }
</style>
