---
import Layout from "../layouts/Layout.astro";
import NewsBlock from "@dst/ui/NewsBlock.astro";
import EventsBlock from "@dst/ui/EventsBlock.astro";
import SectionNav from "@dst/ui/SectionNav.astro";
import FeedCards from "@dst/ui/FeedCards.astro";
import BlockHead from "@dst/ui/BlockHead.astro";
import CountdownScript from "@dst/ui/CountdownScript.astro";
import { cardCountdown } from "@dst/ui/date";
import { isOn } from "@dst/content/when";
import { home, words, labels, type Lang } from "../content";
import { LOCALE, eventsFor, newsFor, eventsBase, newsBase, prefix } from "../i18n";
import { allSections, NAV } from "../sections";
import { TOP } from "../top";

interface Props { lang: Lang }
const { lang } = Astro.props;
const page = home[lang];
const w = words[lang];

// The spotlight: ../top.ts, as cards, ahead of the date-ordered blocks —
// and left out of those blocks, so no card shows twice on the page.
const today = new Date().toISOString().slice(0, 10);
const events = eventsFor(lang);
const news = newsFor(lang);
const top = TOP.flatMap((slug) => {
  const e = events.find((i) => i.slug === slug);
  if (e) {
    return isOn(e, today)
      ? [{
          href: `${eventsBase(lang)}${e.slug}/`,
          eyebrow: e.category,
          date: e.start,
          title: e.title,
          short: e.cardTitle,
          text: [e.venue, e.city].filter(Boolean).join(" · ") || e.summary,
          image: e.image,
          imageAlt: e.imageAlt,
          imageFit: "cover" as const,
          event: true,
          countdown: cardCountdown(e),
          dateInImage: e.dateInImage,
          editorsChoice: e.editorsChoice,
        }]
      : [];
  }
  const n = news.find((i) => i.slug === slug);
  return n
    ? [{
        href: `${newsBase(lang)}${n.slug}/`,
        eyebrow: n.category,
        date: n.date,
        title: n.title,
        short: n.cardTitle,
        text: n.summary,
        image: n.image,
        imageAlt: n.imageAlt,
        imageFit: "cover" as const,
      }]
    : [];
});
const shown = new Set(top.map((c) => c.href));
---
<Layout lang={lang} title={page.title} description={page.description}>
  <section class="container hero">
    <h1>{page.h1}</h1>
    <p class="lede">{page.lede}</p>
    <SectionNav sections={allSections[lang]} label={NAV[lang].label} base={prefix(lang)} />
  </section>
  {top.length > 0 && (
    <section class="container home-top">
      <BlockHead heading={w.top} />
      <FeedCards items={top} columns={top.length} locale={LOCALE[lang]} labels={labels[lang]} />
    </section>
  )}
  <EventsBlock locale={LOCALE[lang]} items={events.filter((e) => !shown.has(`${eventsBase(lang)}${e.slug}/`))} heading={w.upcoming} eventsBase={eventsBase(lang)} allLabel={w.allEvents} labels={labels[lang]} />
  <NewsBlock locale={LOCALE[lang]} items={news.filter((n) => !shown.has(`${newsBase(lang)}${n.slug}/`))} heading={w.news} newsBase={newsBase(lang)} allLabel={w.allNews} />
  {top.some((c) => "event" in c) && <CountdownScript />}
</Layout>

<style>
  .home-top { margin-top: var(--space-5); }
</style>
