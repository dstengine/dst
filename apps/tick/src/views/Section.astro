---
// A subject page. Which subjects exist is decided in ../sections.ts
// against the data, so this file never needs editing when one earns or
// loses its page.
import Layout from "../layouts/Layout.astro";
import SectionNav from "@dst/ui/SectionNav.astro";
import SectionFeed from "@dst/ui/SectionFeed.astro";
import FeedCards from "@dst/ui/FeedCards.astro";
import BlockHead from "@dst/ui/BlockHead.astro";
import CountdownScript from "@dst/ui/CountdownScript.astro";
import ArticleBody from "@dst/ui/ArticleBody.astro";
import AgeGate from "@dst/ui/AgeGate.astro";
import type { Section as SectionT } from "@dst/content/sections";
import type { EventItem } from "@dst/content/types";
import { withLabels } from "@dst/ui/labels";
import { cardCountdown } from "@dst/ui/date";
import { isOn } from "@dst/content/when";
import { eventHref } from "@dst/content/paths";
import { labels, type Lang } from "../content";
import { site } from "../site.config";
import { LOCALE, eventsBase, newsBase, prefix } from "../i18n";
import { allSections, NAV, promotedAll, linkFor, ADULT } from "../sections";
import { guides } from "../guides";
import PromoHero from "@dst/ui/PromoHero.astro";
import Share from "@dst/ui/Share.astro";

interface Props { lang: Lang; section: SectionT }
const { lang, section } = Astro.props;
const p = prefix(lang);
const L = withLabels(labels[lang]);
// The standing guide some subjects carry under their dates (../guides.ts).
const guide = guides[lang][section.slug];
// Asked once per browser, in either language: the answer is shared.
const AGE = {
  hy: {
    title: "Ձեզ 18 տարեկան լրացե՞լ է",
    text: "Այս էջը գինու համտեսների և ալկոհոլի մասին է։ Խնդրում ենք հաստատել, որ ձեզ 18 տարեկան լրացել է։",
    yes: "Այո, ինձ 18 լրացել է",
    no: "Ոչ, ինձ 18 չի լրացել",
    noTitle: "Գլխավոր էջ՝ ամեն ինչ, որ կա Երևանում",
  },
  en: {
    title: "Are you 18 or over?",
    text: "This page is about wine tastings and alcohol. Please confirm that you are 18 or older.",
    yes: "Yes, I am 18 or over",
    no: "No, I am under 18",
    noTitle: "The front page: everything on in Yerevan",
  },
}[lang];

// The tag the site is pushing this month, as three cards under every other
// subject and a link to its own page — the same block the event pages end
// with, gone by itself once its last date has passed. Not on the tag's own
// page, which is that list. No hours on these cards, for the reason
// EventArticle gives: the block repeats on every page, and its hours were
// the same phrase a hundred times. They stay on the Halloween pages.
const today = new Date().toISOString().slice(0, 10);
const blocks = promotedAll[lang]
  .filter((hot) => hot.slug !== section.slug)
  .map((hot) => ({ hot, cards: hot.items
      .filter((i): i is EventItem => "start" in i && isOn(i, today))
      .sort((a, b) => (a.start < b.start ? -1 : 1))
      .slice(0, 3)
      .map((e) => ({
        href: eventHref(e, eventsBase(lang)),
        eyebrow: e.category,
        date: e.start,
        title: e.title,
        short: e.cardTitle,
        text: [e.venue, e.city].filter(Boolean).join(" · ") || e.summary,
        image: e.image,
        imageAlt: e.imageAlt,
        imageFit: "cover" as const,
        event: true,
        countdown: cardCountdown(e),
        dateInImage: e.dateInImage,
        editorsChoice: e.editorsChoice,
      })) }))
  .filter((b) => b.cards.length > 0);
---
<Layout lang={lang} title={section.title} description={section.description}>
  <PromoHero lang={lang}>
    {/* A subject page is the one a reader sends on: "where do we go for
        Halloween" is answered by the list, not by one event. The button sits
        in the heading's row, level with the name it shares; on a phone the
        floating mark (Share.astro) is the control, and the button alone
        under the lede read as an orphan. */}
    <div class="section-head">
      <h1>{section.h1}</h1>
      <Share title={section.h1} labels={labels[lang]} />
    </div>
    <p class="lede">{section.lede}</p>
  </PromoHero>
  <section class="container">
    <SectionFeed
      items={section.items}
      eventsBase={eventsBase(lang)}
      newsBase={newsBase(lang)}
      locale={LOCALE[lang]}
      labels={labels[lang]}
      headings={section.headings}
      where={site[lang].keyword}
    />
    {/* The other subjects come after this one's list, not before it: a
        reader who searched "Halloween" chooses another subject once the
        list is read. Before this, the eleven chips took four rows at 320 (six in
        Armenian) and put the first card 746px down, 882 on /am/ (scan
        2026-10-24-halloween, hw-tick-04) — the move tick-04 made on the
        front page. */}
    <div class="section-ways">
      <SectionNav sections={allSections[lang]} current={`${p}${section.slug}/`} allHref={p} base={p} {...NAV[lang]} />
    </div>
  </section>
  {guide && (
    <section class="container section-guide">
      <ArticleBody blocks={guide} />
    </section>
  )}
  {blocks.map(({ hot, cards }) => (
    <section class="container section-promoted">
      <BlockHead heading={L.moreTagged(hot.label, hot.where, hot.year)} link={linkFor(lang, hot)} />
      <FeedCards items={cards} columns={cards.length} locale={LOCALE[lang]} labels={L} />
    </section>
  ))}
  {blocks.length > 0 && <CountdownScript />}
  {section.kind === "tag" && ADULT.has(section.slug) && <AgeGate storageKey="tick-age-18" noHref={p} {...AGE} />}
</Layout>

<style>
  /* The heading wraps its words, the button never wraps the heading: the
     heading keeps a 20rem floor and the row wraps the button under it when
     the two cannot share a line (DESIGN.md, a heading beside a link). */
  .section-head { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-4); }
  .section-head h1 { flex: 1 1 20rem; margin: 0; }
  @media (max-width: 700px) {
    .section-head :global(.share-button) { display: none; }
  }
  .section-ways { margin-top: var(--space-5); }
  .section-promoted { margin-top: var(--space-5); }
  .section-guide { margin-top: var(--space-5); }
</style>
