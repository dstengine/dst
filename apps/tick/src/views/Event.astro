---
import Layout from "../layouts/Layout.astro";
import EventArticle from "@dst/ui/EventArticle.astro";
import type { EventItem } from "@dst/content/types";
import { publisher, labels, type Lang } from "../content";
import { site } from "../site.config";
import { eventMeta } from "@dst/ui/meta";
import { LOCALE, newsFor, eventsBase, newsBase, alternates } from "../i18n";
import { go } from "../outbound";
import { sectionHref, promotedFor, linkFor, pluralOf } from "../sections";
import { venueHref, placeOf } from "../venues";

interface Props { lang: Lang; item: EventItem; more: EventItem[] }
const { lang, item, more } = Astro.props;
// A seller if we have one, the source if we don't — see ../outbound.ts.
const ticketHref = item.ticket ? go(`${item.slug}-ticket`) : undefined;
const sourceHref = item.source?.url ? go(`${item.slug}-source`) : undefined;
// The search title and description, with the meta-hook page test applied
// (@dst/ui/meta). Keyed like BaseLayout keys the page: its English path,
// so both language twins show the same variant.
const meta = eventMeta(item, site[lang], { host: Astro.site?.hostname ?? "", path: Astro.url.pathname, key: alternates(Astro.url.pathname)[0].href, siblings: more });
---
<Layout lang={lang} title={meta.title} description={meta.description} image={item.image}>
  <EventArticle
    locale={LOCALE[lang]}
    item={item}
    ticketHref={ticketHref} mapHref={item.geo ? `/go/${item.slug}-map/` : undefined}
    sourceHref={sourceHref}
    more={more}
    moreNews={newsFor(lang)}
    backHref={eventsBase(lang)}
    newsBase={newsBase(lang)}
    eventsBase={eventsBase(lang)}
    publisher={publisher}
    share
    countdown
    categoryHref={sectionHref(item, lang)}
    venueHref={venueHref(item, lang)}
    place={placeOf(item, lang)}
    promoted={promotedFor(lang, item.category)}
    promotedLink={linkFor(lang, promotedFor(lang, item.category))}
    labels={labels[lang]}
    where={site[lang].keyword}
    pluralOf={pluralOf(lang)}
    moreEventsText={item.moreEventsText}
  />
</Layout>
