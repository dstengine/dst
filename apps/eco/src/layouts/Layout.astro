---
import { site } from "../site.config";
import BaseLayout from "@dst/ui/BaseLayout.astro";
import LeadTracking from "@dst/ui/LeadTracking.astro";
import "../styles/theme.css";

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>[];
  /** og:image for this page — see BaseLayout. */
  image?: string;
}
const { title, description, jsonLd, image } = Astro.props;

const nav = [
  { href: "/#portfolio", label: "Portfolio", title: "DST's eco portfolio — plantings and initiatives" },
  { href: "/news/", label: "News", title: "What's new in the eco portfolio" },
  { href: "/events/", label: "Events", title: "Eco events" },
];
---
<BaseLayout
  {...site}
  title={title}
  description={description}
  nav={nav}
  jsonLd={jsonLd}
  image={image}
>
  <LeadTracking slot="tracking" />
  <slot />
</BaseLayout>
