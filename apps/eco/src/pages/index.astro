---
import Layout from "../layouts/Layout.astro";
import Callout from "@dst/ui/Callout.astro";
import VentureGrid from "@dst/ui/VentureGrid.astro";
import { stories } from "../data/stories";

// Same card shape as the dst.llc hub grid: eyebrow + status pill up top,
// name and one line of text below. The funder/location detail lives on
// the story's own page, not squeezed onto the card.
const items = stories.map((story) => ({
  href: `/portfolio/${story.slug}/`,
  title: story.title,
  eyebrow: story.species ?? "Eco portfolio",
  status: "Live",
  name: story.title,
  text: story.body[0],
  image: story.photo,
  imageAlt: story.photoAlt,
}));
---
<Layout
  title="Eco portfolio"
  description="DST's eco portfolio — a running record of individual, funded environmental initiatives, added as they happen."
>
  <section class="container hero">
    <p class="eyebrow">Eco</p>
    <h1>What we actually do</h1>
    <p class="lede">
      Most company pages under this heading are a stock photograph of a leaf
      and a paragraph about caring deeply. This is a portfolio instead:
      specific, funded initiatives, each added once it's actually happened —
      not a recurring programme with a reporting cycle.
    </p>
  </section>

  <section class="container" id="portfolio">
    <h2>Eco portfolio</h2>
    <VentureGrid items={items}>
      <div class="venture-placeholder">
        <p>Next entries land here as they happen.</p>
      </div>
    </VentureGrid>
  </section>

  <Callout>
    Nothing on this page is an offset. DST doesn't sell carbon credits,
    doesn't count any of this against its own footprint, and makes no
    neutrality claim. It's work we do because we want to, described as
    plainly as we can manage.
  </Callout>
</Layout>

<style>
  .venture-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 12rem;
    padding: var(--space-3);
    border: 1px dashed var(--border);
    text-align: center;
  }
  .venture-placeholder p {
    margin: 0;
    font-size: var(--step--1);
    color: var(--ink-faint);
  }
</style>
