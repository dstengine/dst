---
import Layout from "../layouts/Layout.astro";
import Callout from "@dst/ui/Callout.astro";
import VentureGrid from "@dst/ui/VentureGrid.astro";
import NewsBlock from "@dst/ui/NewsBlock.astro";
import EventsBlock from "@dst/ui/EventsBlock.astro";
import { stories } from "../data/stories";
import { newsBySite } from "@dst/content/news";
import { eventsBySite } from "@dst/content/events";

const newsItems = newsBySite("eco");
const eventItems = eventsBySite("eco");

// Same card shape as the dst.llc hub grid: eyebrow + status pill up top,
// name and one line of text below. The funder/location detail lives on
// the story's own page, not squeezed onto the card.
const items = stories.map((story) => ({
  href: `/portfolio/${story.slug}/`,
  title: story.title,
  eyebrow: story.species ?? "Eco portfolio",
  status: "Live",
  name: story.title,
  text: story.body[0],
  image: story.photo,
  imageAlt: story.photoAlt,
}));
---
<Layout
  title="Eco portfolio"
  description="DST's eco portfolio — a running record of individual, funded environmental initiatives, added as they happen."
>
  <section class="container hero">
    <p class="eyebrow">Eco</p>
    <h1>Where the money went</h1>
    <p class="lede">
      A portfolio, not a programme: individual initiatives, each one funded and
      each one added here after it happened rather than before. The first is a
      stand of Douglas fir on the Shaytanka river, in the Sverdlovsk region.
    </p>
  </section>

  <section class="container" id="portfolio">
    <h2>Eco portfolio</h2>
    <VentureGrid items={items}>
      <div class="venture-placeholder">
        <p>Next entries land here as they happen.</p>
      </div>
    </VentureGrid>
  </section>

  <NewsBlock items={newsItems} />
  <EventsBlock items={eventItems} />

  <Callout>
    Nothing on this page is an offset. DST doesn't sell carbon credits,
    doesn't count any of this against its own footprint, and makes no
    neutrality claim. It's work we do because we want to, described as
    plainly as we can manage.
  </Callout>
</Layout>

<style>
  .venture-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 12rem;
    padding: var(--space-3);
    border: 1px dashed var(--border);
    text-align: center;
  }
  .venture-placeholder p {
    margin: 0;
    font-size: var(--step--1);
    color: var(--ink-faint);
  }
</style>
