---
import { siteId } from "../content";
import { site } from "../site.config";
import Layout from "../layouts/Layout.astro";
import SectionNav from "@dst/ui/SectionNav.astro";
import EventsList from "@dst/ui/EventsList.astro";
import { eventsBySite } from "@dst/content/events";
import { newsBySite } from "@dst/content/news";
import { sections, NAV } from "../sections";

const items = eventsBySite(siteId);

// The subject row. Empty until a subject earns a page, and then it
// appears here without this file changing — see ../sections.ts.
const sectionLinks = sections([...eventsBySite(siteId), ...newsBySite(siteId)]);
---
<Layout
  title="Environment and sustainability events in Dubai"
  description="Planting days and other in-person eco events, when there are any to list."
>
  <section class="container hero">
    <p class="eyebrow">Events</p>
    <h1>Events in the eco portfolio</h1>
    <p class="lede">
      Planting days and other in-person activity, published here once
      there's something scheduled.
    </p>
  </section>

  <section class="container">
    <SectionNav sections={sectionLinks} {...NAV} />
    <EventsList items={items}
      calendarHref={new URL("/events.ics", Astro.site).href}
      where={site.keyword}
    />
  </section>
</Layout>
