---
import { siteId } from "../../content";
import { site } from "../../site.config";
import { pluralOf } from "../../sections";
import Layout from "../../layouts/Layout.astro";
import EventArticle from "@dst/ui/EventArticle.astro";
import { eventsBySite } from "@dst/content/events";
import { newsBySite } from "@dst/content/news";

// The /go/<slug>-ticket/ hop is registered in this app's outbound.ts, which
// loops over the feed. The comment that used to sit here said eco had no
// ticketed events and therefore no outbound.ts; both halves went stale, and
// the first ticketed event shipped a link to a page that was never built.
export function getStaticPaths() {
  const items = eventsBySite(siteId).filter((item) => Array.isArray(item.body) && item.body.length > 0);
  // The rest of the feed travels with each page so the article can end
  // with somewhere to go instead of only a back link.
  return items.map((item) => ({ params: { slug: item.slug }, props: { item, more: items } }));
}

const moreNews = newsBySite(siteId);
const { item, more } = Astro.props;
const ticketHref = item.ticket ? `/go/${item.slug}-ticket/` : undefined;
---
<Layout title={item.titleSeo ?? item.title} description={item.summary} image={item.image}>
  <EventArticle item={item} more={more} moreNews={moreNews} backHref="/events/" ticketHref={ticketHref}
  where={site.keyword}
  pluralOf={pluralOf}
  moreEventsText={item.moreEventsText}
/>
</Layout>
