---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "@dst/ui/Breadcrumbs.astro";
import Glance from "@dst/ui/Glance.astro";
import SourceNote from "../../components/SourceNote.astro";
import Dates from "../../components/Dates.astro";
import { ICONS } from "@dst/ui/icons";
import { formatDate } from "@dst/ui/date";
import { origin } from "../../content";
import { cities, type City } from "../../data/cities";
import { tourBySlug, arenaTour2026 } from "../../data/tours";
import { musicGroup, musicEvent } from "../../schema";

export function getStaticPaths() {
  return cities.map((city) => ({ params: { slug: city.slug }, props: { city } }));
}

const { city } = Astro.props as { city: City };
const canonical = `${origin}/cities/${city.slug}/`;
const arena = tourBySlug("arena-tour-2026")!;
const playing = city.shows.length > 0;

const title = `Tokio Hotel in ${city.name}`;
const description = playing
  ? `Tokio Hotel play ${city.name} on ${formatDate(city.shows[0].date, "en-GB")}${city.shows[0].venue ? `, ${city.shows[0].venue}` : ""} — night ${city.night} of seventeen on the Arena Tour 2026.`
  : `No Tokio Hotel date is announced in ${city.name}. When they last played there, and what the current tour does instead.`;

// The gap either side of a stop, in nights. Derived, not written: it is the
// one thing a routing tells you that no listing bothers to print.
const nights = (a: string, b: string) =>
  Math.round((Date.parse(b) - Date.parse(a)) / 86_400_000);

const facts = playing
  ? [
      { label: "Date", value: formatDate(city.shows[0].date, "en-GB"), icon: ICONS.events },
      ...(city.shows.length > 1
        ? [{ label: "And again", value: formatDate(city.shows[1].date, "en-GB"), icon: ICONS.events }]
        : []),
      ...(city.shows[0].venue
        ? [{ label: "Venue", value: city.shows[0].venue, icon: ICONS.pin }]
        : [{ label: "Venue", value: "Not announced", icon: ICONS.pin }]),
      ...(city.shows[0].startTime
        ? [{ label: "Starts", value: `${city.shows[0].startTime} local time`, icon: ICONS.clock }]
        : []),
      { label: "Night", value: `${city.night} of ${arenaTour2026.length}`, icon: ICONS.list, href: "/tours/arena-tour-2026/" },
      { label: "Country", value: city.country, icon: ICONS.map },
    ]
  : [
      { label: "Upcoming", value: "Nothing announced", icon: ICONS.events },
      { label: "Last played", value: formatDate(city.lastVisit!.date, "en-GB"), icon: ICONS.clock },
      { label: "Venue", value: city.lastVisit!.venue, icon: ICONS.pin },
      { label: "On tour", value: tourBySlug(city.lastVisit!.tour)!.name, icon: ICONS.stage, href: `/tours/${city.lastVisit!.tour}/` },
    ];

const jsonLd = playing
  ? [musicGroup, ...city.shows.map((s) => musicEvent(s, arena.name, canonical))]
  : [];
---
<Layout prose title={title} description={description} jsonLd={jsonLd}>
  <section class="container hero">
    <Breadcrumbs crumbs={[{ href: "/cities/", label: "Cities" }]} current={city.name} homeLabel="Dates" />
    <h1>{title}</h1>
    <p class="lede">{description}</p>
    <Glance facts={facts} />
  </section>

  {playing && (
    <section class="container">
      <h2>The date{city.shows.length > 1 ? "s" : ""}</h2>
      <Dates shows={city.shows} linkCities={false} />
      <p>
        Part of the <a href={`/tours/${arena.slug}/`}>{arena.name} {arena.years}</a>, behind the
        album <a href="/albums/encore/">Encore</a>, which lands on 16 October 2026.
      </p>
    </section>
  )}

  {playing && (city.previous || city.next) && (
    <section class="container">
      <h2>Where it sits in the run</h2>
      <p>
        {city.previous ? (
          <>
            The band come here from <a href={city.previous.cityPage!}>{city.previous.city}</a>,
            {" "}{nights(city.previous.date, city.shows[0].date)} night
            {nights(city.previous.date, city.shows[0].date) === 1 ? "" : "s"} earlier.
          </>
        ) : (
          <>This is opening night: nothing comes before it.</>
        )}
        {" "}
        {city.next ? (
          <>
            They go on to <a href={city.next.cityPage!}>{city.next.city}</a>
            {" "}{nights(city.shows[city.shows.length - 1].date, city.next.date)} night
            {nights(city.shows[city.shows.length - 1].date, city.next.date) === 1 ? "" : "s"} later.
          </>
        ) : (
          <>Nothing follows it: the tour ends here.</>
        )}
      </p>
      <p class="meta">
        The routing runs {formatDate(arenaTour2026[0].date, "en-GB")} to
        {" "}{formatDate(arenaTour2026[arenaTour2026.length - 1].date, "en-GB")} &mdash;
        {" "}<a href="/cities/">every stop is here</a>.
      </p>
    </section>
  )}

  {city.notes && (
    <section class="container">
      <h2>{playing ? "This city, before now" : "What there was"}</h2>
      {city.notes.map((p) => <p>{p}</p>)}
    </section>
  )}

  {city.cityGuide && (
    <section class="container">
      <h2>Elsewhere</h2>
      <p>
        We run a listings site for this city as well.
        {" "}<a href={city.cityGuide.url}>{city.cityGuide.label}</a> &mdash; {city.cityGuide.note}.
      </p>
    </section>
  )}

  <section class="container">
    <SourceNote source={city.source} />
  </section>
</Layout>

<style>
  .meta { color: var(--ink-faint); font-size: 0.9rem; }
</style>
