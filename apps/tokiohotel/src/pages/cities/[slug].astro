---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "@dst/ui/Breadcrumbs.astro";
import Glance from "@dst/ui/Glance.astro";
import SourceNote from "../../components/SourceNote.astro";
import Dates from "../../components/Dates.astro";
import { ICONS } from "@dst/ui/icons";
import { formatDate } from "@dst/ui/date";
import { origin } from "../../content";
import { cities, type City } from "../../data/cities";
import { tourBySlug } from "../../data/tours";
import { musicGroup, musicEvent } from "../../schema";

export function getStaticPaths() {
  return cities.map((city) => ({ params: { slug: city.slug }, props: { city } }));
}

const { city } = Astro.props as { city: City };
const canonical = `${origin}/cities/${city.slug}/`;
const playing = city.shows.length > 0;
const first = city.shows[0];
const both = city.stops.length > 1;

const title = `Tokio Hotel in ${city.name}`;
const description = playing
  ? both
    ? `Tokio Hotel play ${city.name} twice: ${city.stops.map((s) => `${formatDate(s.shows[0].date, "en-GB")} on the ${s.tour.name} ${s.tour.years}`).join(", and ")}.`
    : `Tokio Hotel play ${city.name} on ${formatDate(first.date, "en-GB")}${first.venue ? `, ${first.venue}` : ""} — night ${city.stops[0].night} of ${city.stops[0].total} on the ${city.stops[0].tour.name} ${city.stops[0].tour.years}.`
  : `No Tokio Hotel date is announced in ${city.name}. When they last played there, and what the announced tours do instead.`;

// The gap either side of a stop, in nights. Derived, not written: it is the
// one thing a routing tells you that no listing bothers to print.
const nights = (a: string, b: string) =>
  Math.round((Date.parse(b) - Date.parse(a)) / 86_400_000);

const facts = playing
  ? [
      { label: "Next date", value: formatDate(first.date, "en-GB"), icon: ICONS.events },
      ...(city.shows.length > 1
        ? [{
            label: "And again",
            value: city.shows.slice(1).map((s) => formatDate(s.date, "en-GB")).join(" · "),
            icon: ICONS.events,
          }]
        : []),
      { label: "Venue", value: first.venue ?? "Not announced", icon: ICONS.pin },
      ...(first.startTime
        ? [{ label: "Starts", value: `${first.startTime} local time`, icon: ICONS.clock }]
        : []),
      ...city.stops.map((s) => ({
        label: s.tour.years,
        value: `Night ${s.night} of ${s.total}, ${s.tour.name}`,
        icon: ICONS.stage,
        href: `/tours/${s.tour.slug}/`,
      })),
      { label: "Country", value: city.country, icon: ICONS.map },
    ]
  : [
      { label: "Upcoming", value: "Nothing announced", icon: ICONS.events },
      { label: "Last played", value: formatDate(city.lastVisit!.date, "en-GB"), icon: ICONS.clock },
      { label: "Venue", value: city.lastVisit!.venue, icon: ICONS.pin },
      { label: "On tour", value: tourBySlug(city.lastVisit!.tour)!.name, icon: ICONS.stage, href: `/tours/${city.lastVisit!.tour}/` },
    ];

const jsonLd = playing
  ? [musicGroup, ...city.stops.flatMap((s) => s.shows.map((show) => musicEvent(show, s.tour.name, canonical)))]
  : [];
---
<Layout prose title={title} description={description} jsonLd={jsonLd}>
  <section class="container hero">
    <Breadcrumbs crumbs={[{ href: "/cities/", label: "Cities" }]} current={city.name} homeLabel="Dates" />
    <h1>{title}</h1>
    <p class="lede">{description}</p>
    <Glance facts={facts} />
  </section>

  {playing && city.stops.map((stop) => (
    <section class="container">
      <h2>{both ? `${stop.tour.name} ${stop.tour.years}` : `The date${stop.shows.length > 1 ? "s" : ""}`}</h2>
      <Dates shows={stop.shows} linkCities={false} />
      <p>
        Night {stop.night} of {stop.total} on the
        {" "}<a href={`/tours/${stop.tour.slug}/`}>{stop.tour.name} {stop.tour.years}</a>.
        {stop.tour.slug === "arena-tour-2026" && (
          <> The run is behind the album <a href="/albums/encore/">Encore</a>, which lands on 16 October 2026.</>
        )}
      </p>
      {(stop.previous || stop.next) && (
        <p>
          {stop.previous ? (
            <>
              They come here from <a href={stop.previous.cityPage!}>{stop.previous.city}</a>,
              {" "}{nights(stop.previous.date, stop.shows[0].date)} night
              {nights(stop.previous.date, stop.shows[0].date) === 1 ? "" : "s"} earlier.
            </>
          ) : (
            <>This is opening night: nothing comes before it.</>
          )}
          {" "}
          {stop.next ? (
            <>
              They go on to <a href={stop.next.cityPage!}>{stop.next.city}</a>
              {" "}{nights(stop.shows[stop.shows.length - 1].date, stop.next.date)} night
              {nights(stop.shows[stop.shows.length - 1].date, stop.next.date) === 1 ? "" : "s"} later.
            </>
          ) : (
            <>Nothing follows it: the tour ends here.</>
          )}
        </p>
      )}
    </section>
  ))}

  {both && (
    <section class="container">
      <h2>Twice in ten months</h2>
      <p>
        This is one of four cities on both announced runs. The arena night and the summer night are
        {" "}{Math.round(nights(city.shows[0].date, city.shows[city.shows.length - 1].date) / 30)} months
        apart, indoors and then outdoors, and nothing says the two shows are the same show.
      </p>
    </section>
  )}

  {playing && (
    <p class="container meta">
      Every stop on both tours is on <a href="/cities/">the cities page</a>.
    </p>
  )}

  {city.notes && (
    <section class="container">
      <h2>{playing ? "This city, before now" : "What there was"}</h2>
      {city.notes.map((p) => <p>{p}</p>)}
    </section>
  )}

  {city.cityGuide && (
    <section class="container">
      <h2>Elsewhere</h2>
      <p>
        We run a listings site for this city as well.
        {" "}<a href={city.cityGuide.url}>{city.cityGuide.label}</a> &mdash; {city.cityGuide.note}.
      </p>
    </section>
  )}

  <section class="container">
    <SourceNote source={city.source} />
  </section>
</Layout>

<style>
  .meta { color: var(--ink-faint); font-size: 0.9rem; }
</style>
