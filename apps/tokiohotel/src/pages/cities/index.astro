---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "@dst/ui/Breadcrumbs.astro";
import { cities as copy } from "../../content";
import { citiesOn, pastOnlyCities } from "../../data/cities";
import { tourBySlug } from "../../data/tours";
import { checkedOn } from "../../data/band";
import { formatDate } from "@dst/ui/date";

// Grouped by tour, not merged into one list: two runs a year apart are two
// different maps, and a city on both appears on both.
const runs = ["arena-tour-2026", "summer-encore-2027"].map((slug) => {
  const tour = tourBySlug(slug)!;
  return {
    tour,
    stops: citiesOn(slug)
      .map((city) => ({ city, stop: city.stops.find((s) => s.tour.slug === slug)! }))
      .sort((a, b) => a.stop.night - b.stop.night),
  };
});
const past = pastOnlyCities();
---
<Layout prose title={copy.title} description={copy.description}>
  <section class="container hero">
    <Breadcrumbs crumbs={[]} current={copy.title} homeLabel="Dates" />
    <h1>{copy.h1}</h1>
    <p class="lede">{copy.lede}</p>
  </section>

  {runs.map(({ tour, stops }) => (
    <section class="container">
      <h2><a href={`/tours/${tour.slug}/`}>{tour.name} {tour.years}</a></h2>
      <p class="meta">{tour.blurb}</p>
      <ol class="cities">
        {stops.map(({ city, stop }) => (
          <li>
            <span class="night">Night {stop.night}</span>
            <span class="body">
              <strong><a href={`/cities/${city.slug}/`}>{city.name}</a></strong>
              <span class="meta">
                {city.country} &middot; {stop.shows.map((s) => formatDate(s.date, "en-GB")).join(" and ")}
                {stop.shows[0].venue && <> &middot; {stop.shows[0].venue}</>}
              </span>
            </span>
          </li>
        ))}
      </ol>
    </section>
  ))}

  <section class="container">
    <h2>Not on it</h2>
    <p>
      Two cities get asked about more than any others on the map, and neither has anything
      announced. They have pages anyway, because &ldquo;no&rdquo; with a date attached is an answer
      and silence is not.
    </p>
    <ul class="past">
      {past.map((city) => (
        <li>
          <strong><a href={`/cities/${city.slug}/`}>{city.name}</a></strong>
          <span class="meta">
            Nothing upcoming &middot; last played {formatDate(city.lastVisit!.date, "en-GB")},
            {" "}{city.lastVisit!.venue}
          </span>
        </li>
      ))}
    </ul>
    <p class="source-line">Last checked {checkedOn}.</p>
  </section>
</Layout>

<style>
  .cities, .past {
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-2);
  }
  .cities li, .past li {
    display: grid;
    gap: 0.1rem 1.25rem;
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border);
  }
  .cities li:last-child, .past li:last-child { border-bottom: 0; }
  .night { font-variant-numeric: tabular-nums; color: var(--ink-faint); font-size: 0.92rem; }
  .body { display: grid; gap: 0.15rem; }
  .meta { color: var(--ink-muted); font-size: 0.95rem; }
  .source-line { margin-top: var(--space-3); color: var(--ink-faint); font-size: 0.9rem; }

  @media (min-width: 40rem) {
    .cities li { grid-template-columns: 6rem 1fr; align-items: baseline; }
  }
</style>
