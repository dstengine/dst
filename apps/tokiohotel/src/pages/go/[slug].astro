---
import Redirect from "@dst/ui/Redirect.astro";
import { isSellerHop, outbound } from "../../outbound";

export function getStaticPaths() {
  return Object.entries(outbound).map(([slug, to]) => ({
    params: { slug },
    props: { to },
  }));
}

const { to } = Astro.props;
const { slug } = Astro.params;
---
<Redirect to={to} ticket={isSellerHop(slug)} />
