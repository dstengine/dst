---
import Layout from "../layouts/Layout.astro";
import Dates from "../components/Dates.astro";
import { home, origin } from "../content";
import { band, tours, tourBySlug, checkedOn } from "../data/tours";
import { musicGroup, musicEvent } from "../schema";

const arena = tourBySlug("arena-tour-2026")!;
const shows = arena.shows!;
const canonical = `${origin}/`;

const countries = [...new Set(shows.map((s) => s.country))].length;
const opener = shows[0];
const closer = shows[shows.length - 1];

const jsonLd = [
  musicGroup,
  ...shows.map((show) => musicEvent(show, arena.name, canonical)),
];
---
<Layout title={home.title} description={home.description} jsonLd={jsonLd}>
  <section class="container hero">
    <h1>{home.h1}</h1>
    <p class="lede">{home.lede}</p>
  </section>

  <section class="container">
    <h2>Arena Tour 2026</h2>
    <p>
      {shows.length} nights, {countries} countries, twenty-seven days. It opens in {opener.city} on
      28 October and finishes in {closer.city} on 23 November. One city on the run gets the band
      twice &mdash; Paris, on the way out and on the way back.
    </p>
    <Dates shows={shows} />
    <p class="source-line">
      Routing from {arena.source!.name}; the London date confirmed against OVO Arena Wembley.
      Last checked {checkedOn}.
    </p>
    <p><a href={`/tours/${arena.slug}/`}>More on the 2026 run</a></p>
  </section>

  <section class="container">
    <h2>The band</h2>
    <p>
      {band.name} formed in {band.origin} in {band.formed}:
      {band.members.map((m, i) => (
        <>{i > 0 && (i === band.members.length - 1 ? " and " : ", ")}{m.name} ({m.role})</>
      ))}. Twenty-five years later they are still the same four people, which is the part of the
      story most bands of that vintage cannot tell.
    </p>
    <p>
      Ten tours stand behind the 2026 arenas, from the Schrei Tour in 2005 onwards.
      <a href="/tours/">The full list is here</a> &mdash; including one leg we can document
      night by night because we published it ourselves at the time.
    </p>
  </section>

  <section class="container">
    <h2>Cities</h2>
    <p>
      A city gets a page when there is something to say about it.
      <a href="/cities/london/">London</a> has the only United Kingdom date of the run;
      <a href="/cities/new-york/">New York</a> and
      <a href="/cities/mexico-city/">Mexico City</a> have nothing upcoming, and say so.
    </p>
  </section>
</Layout>

<style>
  .source-line {
    margin-top: var(--space-2);
    color: var(--ink-faint);
    font-size: 0.9rem;
  }
</style>
