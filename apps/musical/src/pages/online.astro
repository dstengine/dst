---
// The site-wide online page. It plays what it is allowed to play — and the
// rule is now the practical one: on YouTube, embedding not disabled by the
// uploader, checked through oEmbed before it goes on a page.
import Layout from "../layouts/Layout.astro";
import Clips from "../components/Clips.astro";
import { checkedOn, shows } from "../content";

const withClips = shows.filter((show) => (show.clips ?? []).length > 0);
const total = withClips.reduce((n, show) => n + (show.clips?.length ?? 0), 0);
---
<Layout
  title="Musicals online"
  description="Musicals you can watch right now, legally and for nothing: numbers the productions publish themselves and cast recordings on the rights holders' own channels, playing on this page."
>
  <section class="container hero">
    <p class="eyebrow">At home</p>
    <h1>Musicals you can watch right now</h1>
    <p class="lede">
      A stage musical is the one art form that mostly refuses to be recorded —
      and yet the producers themselves put whole numbers on YouTube, and the
      labels put the cast albums up beside them. {total} of them play on this
      page, in their owners' own player, checked {checkedOn}.
    </p>
  </section>

  {withClips.map((show) => (
    <section class="container">
      <h2><a href={`/${show.slug}/online/`} title={`Everything from ${show.title} you can legally watch`}>{show.title}</a></h2>
      <p>{show.tagline}</p>
      <Clips clips={show.clips!} showSlug={show.slug} heading={3} />
    </section>
  ))}

  <section class="container prose">
    <h2>What is here and what is not</h2>
    <p>
      Here: numbers a production or a broadcaster published on its own channel,
      and cast recordings on the rights holders' channels. Each one is checked
      with YouTube before it goes up — where an uploader does not allow their
      video to play on other sites, it does not appear.
    </p>
    <p>
      Not here: full stage performances filmed from a seat and uploaded by
      someone who did not make them. The reason is practical before it is
      principled — they get taken down, and a page of dead frames is worse than
      a shorter page.
    </p>
    <p>
      None of it is a substitute for the room. It is a good way to find out
      whether you want the room.
    </p>
  </section>
</Layout>

<style>
  .prose p { max-width: 68ch; }
</style>
