---
import Layout from "../../layouts/Layout.astro";
import Promo from "../../components/Promo.astro";
import { shows, type Section, type Show } from "../../content";
import { go } from "../../outbound";

export function getStaticPaths() {
  return shows.flatMap((show) =>
    show.sections.map((section) => ({
      params: { show: show.slug, section: section.slug },
      props: { show, section },
    })),
  );
}

interface Props { show: Show; section: Section }
const { show, section } = Astro.props;
// The ticket button belongs on the page about the run, not on the history.
const run = section.slug === "dubai" ? show.runs.find((r) => r.city === "dubai") : undefined;
---
<Layout title={section.title} description={section.description}>
  <section class="container hero">
    <p class="eyebrow"><a href={`/${show.slug}/`} title={`Everything on ${show.title}`}>{show.title}</a></p>
    <h1>{section.title}</h1>
    {run?.ticketSlug && (
      <p class="actions">
        <a class="button" href={go(run.ticketSlug)} rel="nofollow" title={`Buy tickets for ${show.title} in Dubai on Ticketmaster AE`}>Tickets on Ticketmaster AE</a>
      </p>
    )}
  </section>

  <section class="container prose">
    {section.body.map((paragraph) => <p>{paragraph}</p>)}
  </section>

  {section.slug !== "dubai" && <div class="container"><Promo level={2} compact /></div>}

  <section class="container">
    <p class="back"><a href={`/${show.slug}/`} title={`${show.title}: where it plays, what it is, and its history`}>← Everything on {show.title}</a></p>
  </section>
</Layout>

<style>
  .actions { margin-top: var(--space-3); }
  .prose p { max-width: 68ch; }
  .back { color: var(--ink-muted); }
</style>
