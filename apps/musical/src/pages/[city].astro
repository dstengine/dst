---
import Layout from "../layouts/Layout.astro";
import Promo from "../components/Promo.astro";
import Callout from "@dst/ui/Callout.astro";
import { checkedOn, cities, showsInCity, type City } from "../content";
import { go } from "../outbound";

export function getStaticPaths() {
  return cities.map((city) => ({ params: { city: city.slug }, props: { city } }));
}

interface Props { city: City }
const { city } = Astro.props;
const playing = showsInCity(city.slug);
---
<Layout
  title={`Musicals in ${city.name}`}
  description={`Musicals playing ${city.name}: what is on sale, what has only been announced, and where each one is actually booked. Read ${checkedOn}.`}
>
  <section class="container hero">
    <p class="eyebrow">{city.country}</p>
    <h1>Musicals in {city.name}</h1>
    <p class="lede">{city.summary}</p>
  </section>

  {city.slug === "dubai" && <div class="container"><Promo level={2} /></div>}

  <section class="container">
    <h2>On sale</h2>
    {playing.map((show) => {
      const run = show.runs.find((r) => r.city === city.slug)!;
      return (
        <article class="listing">
          <h3><a href={`/${show.slug}/`} title={`${show.title}: the show, its history, and where it plays`}>{show.title}</a></h3>
          <p>{show.tagline}</p>
          <dl class="pending">
            <div class="pending-row">
              <dt>Dates</dt>
              <dd>{run.start ?? <span class="tba">Not announced</span>}</dd>
            </div>
            <div class="pending-row">
              <dt>Venue</dt>
              <dd>{run.venue ?? <span class="tba">Not announced</span>}</dd>
            </div>
            <div class="pending-row">
              <dt>Booking</dt>
              <dd>
                {run.ticketSlug
                  ? <a href={go(run.ticketSlug)} rel="nofollow" title={`Buy tickets for ${show.title} in ${city.name} on Ticketmaster AE`}>Ticketmaster AE</a>
                  : "No seller listed"}
              </dd>
            </div>
          </dl>
          <p class="listing-note">{run.note}</p>
        </article>
      );
    })}
  </section>

  <Callout kind="note">
    <strong>Nothing else is listed for {city.name} yet.</strong> A show turns up
    here the day it goes on sale with a seller we can name — not on the day a
    poster appears.
  </Callout>
</Layout>

<style>
  .listing {
    padding: var(--space-3) 0 var(--space-4);
    border-top: 1px solid var(--border);
  }
  .listing h3 { margin: 0 0 0.2em; font-size: var(--step-2); }
  .listing h3 a { text-decoration: none; }
  .listing h3 a:hover { text-decoration: underline; }
  .listing-note { color: var(--ink-muted); font-size: var(--step--1); max-width: 60ch; }
</style>
