---
// The front page. It has one job: show what is actually on, soonest first,
// and make the hero event look like the standard rather than the exception.
import Glance from "@dst/ui/Glance.astro";
import { ICONS } from "@dst/ui/icons";
import Layout from "../layouts/Layout.astro";
import Promo from "../components/Promo.astro";
import RunTable from "../components/RunTable.astro";
import {
  checkedOn, citiesWithPages, cityBySlug, runs, shows, upcomingRuns, venues,
} from "../content";

const upcoming = upcomingRuns();
const soon = upcoming.slice(0, 8);
const cityPages = citiesWithPages();
const cityCount = new Set(runs.map((r) => r.city)).size;
const countries = new Set(runs.map((r) => cityBySlug(r.city)?.country).filter(Boolean)).size;
const chicago = shows[0]!;

const glance = [
  { label: "Runs listed", value: `${runs.length}`, icon: ICONS.events },
  { label: "Cities", value: `${cityCount} in ${countries} countries`, icon: ICONS.map },
  { label: "Venues", value: `${venues.length} with pages`, icon: ICONS.pin, href: "/venues/" },
  { label: "Last checked", value: checkedOn, icon: ICONS.list },
];
---
<Layout
  title="Musicals on sale now"
  description="Musicals, city by city: what is on sale, which theatre, which dates, and who is actually selling. Every listing read from the production's own source and dated."
>
  <section class="container hero">
    <p class="eyebrow">Musicals, city by city</p>
    <h1>What is on, where, and who is selling it</h1>
    <p class="lede">
      A musical is not one event. The production filling a 17,000-seat arena in
      Dubai this December is the same show that plays a theatre on the north
      Wales coast in October 2027 — different room, different seller, different
      idea of what a ticket costs. This site lists all of it: the theatre, the
      dates, and who is actually selling, with the day each listing was read.
    </p>
    <Glance facts={glance} />
  </section>

  <section class="container">
    <h2>On sale now</h2>
    <RunTable runs={soon} lead="event" caption="Soonest first. Each row goes to that run's own page — theatre, times, sellers and what is not yet known." />
    <p class="more">
      <a href={`/${chicago.slug}/tickets/`} title="Every run this site tracks, with every seller">All {upcoming.length} upcoming runs</a>
    </p>
  </section>

  <div class="container">
    <Promo />
  </div>

  <section class="container" id="cities">
    <h2>Cities</h2>
    <p>
      A city gets its own page once it has more than one event to compare —
      until then its listing lives on the event's page, where the facts are,
      rather than at a second address that repeats them.
    </p>
    <div class="link-grid city-grid">
      {cityPages.map((city) => (
        <a class="card link-card" href={`/${city.slug}/`} title={`Musicals playing ${city.name}`}>
          <h3>{city.name}</h3>
          <p>{city.summary ?? city.country}</p>
        </a>
      ))}
      <a class="card link-card" href="/venues/" title="Every theatre and arena on this site">
        <h3>All venues</h3>
        <p>{venues.length} theatres and arenas, with what plays in each and how to get there.</p>
      </a>
    </div>
  </section>

  <section class="container">
    <h2>{chicago.title}</h2>
    <p>{chicago.tagline}</p>
    <div class="link-grid">
      <a class="card link-card" href={`/${chicago.slug}/`} title={`${chicago.title}: every run, the history, the video`}>
        <h3>Everything on the show</h3>
        <p>Every run, the tour, a hundred years of it, and what you can watch tonight for nothing.</p>
      </a>
      {chicago.sections.map((section) => (
        <a class="card link-card" href={`/${chicago.slug}/${section.slug}/`} title={section.title}>
          <h3>{section.label}</h3>
          <p>{section.description}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="container">
    <h2>At home</h2>
    <p>
      Some of it plays here: numbers the productions publish themselves and cast
      recordings on the rights holders' own channels are collected on
      {" "}<a href="/online/" title="Musicals you can legally watch at home">the online page</a>, embedded rather than
      linked away. Reuploads of full stage recordings are not — not out of
      caution, but because they stop working.
    </p>
  </section>
</Layout>

<style>
  .city-grid { grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); }
  .more { margin-top: var(--space-3); }
</style>
