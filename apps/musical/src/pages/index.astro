---
// The front page. It has one job: show what is actually on, soonest first,
// and make the hero event look like the standard rather than the exception.
import Layout from "../layouts/Layout.astro";
import Promo from "../components/Promo.astro";
import EventCards from "../components/EventCards.astro";
import VentureGrid from "@dst/ui/VentureGrid.astro";
import { ICONS } from "@dst/ui/icons";
import {
  citiesWithPages, cityBySlug, formatRun, runsFor, runsInCity, shows, showBySlug,
  statusOf, upcomingRuns, venueBySlug, venues, type Venue,
} from "../content";

const upcoming = upcomingRuns();
const soon = upcoming.slice(0, 6);
const cityPages = citiesWithPages();
// Cities, soonest first and only as many as anyone will actually look at.
// Twenty-two picture cards is a directory, and a directory is what /venues/
// is for; six is a listing. The rest keep their links, on one line under it,
// because a city page that nothing points at may as well not be built.
const cityDate = new Map<string, string>();
for (const run of upcoming) {
  if (run.start && !cityDate.has(run.city)) cityDate.set(run.city, run.start);
}
const citiesByDate = [...cityPages].sort((a, b) => {
  // A city marked featured is a standing decision about this site's markets,
  // and it outranks whatever happens to be playing next.
  if (Boolean(a.featured) !== Boolean(b.featured)) return a.featured ? -1 : 1;
  return (cityDate.get(a.slug) ?? "9999").localeCompare(cityDate.get(b.slug) ?? "9999");
});
const cityCards = citiesByDate.slice(0, 6).map((city) => {
  const here = runsInCity(city.slug)
    .filter((r) => statusOf(r) !== "ended")
    .sort((a, b) => (a.start ?? "9999").localeCompare(b.start ?? "9999"));
  const next = here.find((r) => r.start);
  const houses = [...new Set(here.map((r) => r.venue).filter(Boolean))]
    .map((slug) => venueBySlug(slug!))
    .filter(Boolean) as Venue[];
  // One theatre gets its size as well, because that is the fact that decides
  // what the evening is like; two get their names and no room for more.
  const where = houses.length === 1 && houses[0]!.capacity
    ? `${houses[0]!.name}, ${houses[0]!.capacity!.toLocaleString("en-GB")} seats.`
    : houses.map((v) => v.name).join(" and ") + ".";
  const titles = [...new Set(here.map((r) => showBySlug(r.show)?.title ?? r.show))];
  return {
    href: `/${city.slug}/`,
    title: `Musicals playing ${city.name}`,
    eyebrow: city.country,
    name: city.name,
    // No count pill on a city card. "One musical" is not something a
    // reader can act on — the card already names the theatre and the date —
    // and a badge that exists to fill the corner is what a cheap page looks
    // like from across the room.
    // The theatre, not the shows: the show names are already on every card in
    // the row above this one, and the house is the thing that differs.
    text: houses.length > 0 ? where : titles.join(" and "),
    meta: next ? formatRun(next) : undefined,
    image: city.image,
    imageAlt: city.imageAlt,
    icon: ICONS.map,
  };
});
const citiesRest = citiesByDate.slice(6);

const lead = shows.find((show) => show.featured) ?? shows[0]!;
const alsoListed = shows.filter((show) => show !== lead);
---
<Layout
  title="Musicals on sale now"
  description="Musicals, city by city: what is on sale, which theatre, which dates, and who is actually selling. Every listing read from the production's own source and dated."
>
  <section class="container hero">
    <p class="eyebrow">Musicals, city by city</p>
    <h1>What is on, where, and who is selling it</h1>
    <p class="lede">
      A musical is not one event. The production filling a 17,000-seat arena in
      Dubai this December is the same show that plays a theatre on the north
      Wales coast in October 2027 — different room, different seller, different
      idea of what a ticket costs. This site lists all of it: the theatre, the
      dates, and who is actually selling, with the day each listing was read.
    </p>
  </section>

  <section class="container">
    <h2>On sale now</h2>
    <p>Soonest first. Each card goes to that run's own page — the theatre, the dates, who is selling and what is not yet known.</p>
    <EventCards runs={soon} />
    <p class="more">
      {shows.map((show) => (
        <a href={`/${show.slug}/tickets/`} title={`Every run of ${show.title} this site tracks, with every seller`}>
          All {runsFor(show.slug).length} dates of {show.title}
        </a>
      ))}
      {/* Two shows, read on two different days: one date here would be wrong
          for one of them. The date lives on each show's own page, where it
          belongs to the listings it describes. */}
      <span class="checked">Read from each production's own listing, on the date its page carries.</span>
    </p>
  </section>

  <div class="container">
    <Promo />
  </div>

  <section class="container" id="cities">
    <h2>Cities</h2>
    <p>
      A city page is the local answer: which theatres take touring musicals,
      what is booked into them and when the season runs. Cities with one event
      are listed on that event's page instead, and every theatre has a page of
      its own either way.
    </p>
    <VentureGrid items={cityCards} columns={3} />
    {citiesRest.length > 0 && (
      <p class="more city-rest">
        <span>Also on:</span>
        {citiesRest.map((city) => (
          <a href={`/${city.slug}/`} title={`Musicals playing ${city.name}`}>{city.name}</a>
        ))}
        <a href="/venues/" title="Every theatre and arena on this site">all {venues.length} theatres</a>
      </p>
    )}
  </section>

  {/* One section for the show this site is about, and a line for the rest.
      A second show listed in full is not a second subject: giving it the
      same grid would say the site had two, which it has not. */}
  <section class="container">
    <h2>{lead.title}</h2>
    <p>{lead.tagline}</p>
    <div class="link-grid">
        {/* One line per show, written for it. A single fixed line would have
            promised Cats a history and a video it has not got; the show's own
            summary would have been accurate and flat. */}
      <a class="card link-card" href={`/${lead.slug}/`} title={`${lead.title}: every run, and what is on this site about it`}>
        <h3>Everything on the show</h3>
        <p>{lead.hubCard}</p>
      </a>
      {lead.sections.map((section) => (
        <a class="card link-card" href={`/${lead.slug}/${section.slug}/`} title={section.title}>
          <h3>{section.label}</h3>
          <p>{section.description}</p>
        </a>
      ))}
    </div>
  </section>

  {alsoListed.length > 0 && (
    <section class="container">
      <h2>Also listed</h2>
      <p>Every run, theatre and seller, checked the same way — without the editorial pages the lead show carries.</p>
      <div class="link-grid also-grid">
        {alsoListed.map((show) => (
          <a class="card link-card" href={`/${show.slug}/`} title={`${show.title}: every stop, its theatre and its seller`}>
            <h3>{show.title}</h3>
            <p>{show.hubCard}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="container">
    <h2>At home</h2>
    <p>
      No, you cannot watch the whole show at home. You can watch the numbers the
      productions filmed themselves and the cast recordings the rights holders
      put up, and they play on
      {" "}<a href="/online/" title="Musicals you can legally watch at home">the online page</a> rather than
      somewhere else.
    </p>
  </section>
</Layout>

<style>
  /* Sixteen city names on one line, reading as a line and not as sixteen
     buttons: the gap does the separating, and the label sits in front of
     them at the same baseline. */
  /* One card should look like one card, not like a banner: auto-fit gives a
     lone item the whole row. */
  .also-grid { grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); }
  .city-rest { gap: 0.4em var(--space-2); }
  .city-rest span { color: var(--ink-faint); font-size: var(--step--1); }
  .more {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5em var(--space-3);
    margin-top: var(--space-3);
  }
  /* One line of text is 29px tall and a thumb is not. */
  .more a { display: inline-flex; align-items: center; min-height: 44px; }
  /* The date the listings were read, kept next to the listings it applies to
     rather than in a panel of site statistics at the top of the page. */
  .checked { color: var(--ink-faint); font-size: var(--step--1); }
</style>
