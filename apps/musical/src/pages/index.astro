---
// The front page. It has one job: show what is actually on, soonest first,
// and make the hero event look like the standard rather than the exception.
import Layout from "../layouts/Layout.astro";
import Promo from "../components/Promo.astro";
import EventCards from "../components/EventCards.astro";
import { citiesWithPages, runsFor, shows, upcomingRuns, venues } from "../content";

const upcoming = upcomingRuns();
const soon = upcoming.slice(0, 6);
const cityPages = citiesWithPages();
---
<Layout
  title="Musicals on sale now"
  description="Musicals, city by city: what is on sale, which theatre, which dates, and who is actually selling. Every listing read from the production's own source and dated."
>
  <section class="container hero">
    <p class="eyebrow">Musicals, city by city</p>
    <h1>What is on, where, and who is selling it</h1>
    <p class="lede">
      A musical is not one event. The production filling a 17,000-seat arena in
      Dubai this December is the same show that plays a theatre on the north
      Wales coast in October 2027 — different room, different seller, different
      idea of what a ticket costs. This site lists all of it: the theatre, the
      dates, and who is actually selling, with the day each listing was read.
    </p>
  </section>

  <section class="container">
    <h2>On sale now</h2>
    <p>Soonest first. Each card goes to that run's own page — the theatre, the dates, who is selling and what is not yet known.</p>
    <EventCards runs={soon} />
    <p class="more">
      {shows.map((show) => (
        <a href={`/${show.slug}/tickets/`} title={`Every run of ${show.title} this site tracks, with every seller`}>
          All {runsFor(show.slug).length} dates of {show.title}
        </a>
      ))}
      {/* Two shows, read on two different days: one date here would be wrong
          for one of them. The date lives on each show's own page, where it
          belongs to the listings it describes. */}
      <span class="checked">Read from each production's own listing, on the date its page carries.</span>
    </p>
  </section>

  <div class="container">
    <Promo />
  </div>

  <section class="container" id="cities">
    <h2>Cities</h2>
    <p>
      A city page is the local answer: which theatres take touring musicals,
      what is booked into them and when the season runs. Cities with one event
      are listed on that event's page instead, and every theatre has a page of
      its own either way.
    </p>
    <div class="link-grid city-grid">
      {cityPages.map((city) => (
        <a class="card link-card" href={`/${city.slug}/`} title={`Musicals playing ${city.name}`}>
          <h3>{city.name}</h3>
          <p>{city.summary ?? city.country}</p>
        </a>
      ))}
      <a class="card link-card" href="/venues/" title="Every theatre and arena on this site">
        <h3>All venues</h3>
        <p>{venues.length} theatres and arenas, with what plays in each and how to get there.</p>
      </a>
    </div>
  </section>

  {shows.map((show) => (
    <section class="container">
      <h2>{show.title}</h2>
      <p>{show.tagline}</p>
      <div class="link-grid">
        {/* The show's own summary rather than a written-out promise: one show
            here has a history and a video and the other has a tour, and a
            fixed line would be selling one of them something it has not got. */}
        <a class="card link-card" href={`/${show.slug}/`} title={`${show.title}: every run, and what is on this site about it`}>
          <h3>Everything on the show</h3>
          <p>{show.summary}</p>
        </a>
        {show.sections.map((section) => (
          <a class="card link-card" href={`/${show.slug}/${section.slug}/`} title={section.title}>
            <h3>{section.label}</h3>
            <p>{section.description}</p>
          </a>
        ))}
      </div>
    </section>
  ))}

  <section class="container">
    <h2>At home</h2>
    <p>
      No, you cannot watch the whole show at home. You can watch the numbers the
      productions filmed themselves and the cast recordings the rights holders
      put up, and they play on
      {" "}<a href="/online/" title="Musicals you can legally watch at home">the online page</a> rather than
      somewhere else.
    </p>
  </section>
</Layout>

<style>
  .city-grid { grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); }
  .more {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5em var(--space-3);
    margin-top: var(--space-3);
  }
  /* One line of text is 29px tall and a thumb is not. */
  .more a { display: inline-flex; align-items: center; min-height: 44px; }
  /* The date the listings were read, kept next to the listings it applies to
     rather than in a panel of site statistics at the top of the page. */
  .checked { color: var(--ink-faint); font-size: var(--step--1); }
</style>
