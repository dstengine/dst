---
// The front page. It has one job: show what is actually on, soonest first,
// and make the hero event look like the standard rather than the exception.
import Layout from "../layouts/Layout.astro";
import Hero from "@dst/ui/Hero.astro";
import Promo from "../components/Promo.astro";
import EventCards from "../components/EventCards.astro";
import VentureGrid from "@dst/ui/VentureGrid.astro";
import { ICONS } from "@dst/ui/icons";
import Icon from "@dst/ui/Icon.astro";
import ChipNav from "@dst/ui/ChipNav.astro";
import { citiesWithPages, cityBySlug, collections, datedRuns, formatRun, runsInCity, shows, showBySlug, statusOf, ticketButtons, upcomingRuns, venueBySlug, venues, type Venue, } from "../content";

const upcoming = upcomingRuns();
const soon = upcoming.slice(0, 6);
const cityPages = citiesWithPages();
// Cities, soonest first and only as many as anyone will actually look at.
// Twenty-two picture cards is a directory, and a directory is what /venues/
// is for; six is a listing. The rest keep their links, on one line under it,
// because a city page that nothing points at may as well not be built.
const cityDate = new Map<string, string>();
for (const run of upcoming) {
  if (run.start && !cityDate.has(run.city)) cityDate.set(run.city, run.start);
}
const citiesByDate = [...cityPages].sort((a, b) => {
  // A city marked featured is a standing decision about this site's markets,
  // and it outranks whatever happens to be playing next.
  if (Boolean(a.featured) !== Boolean(b.featured)) return a.featured ? -1 : 1;
  return (cityDate.get(a.slug) ?? "9999").localeCompare(cityDate.get(b.slug) ?? "9999");
});
const cityCards = citiesByDate.slice(0, 6).map((city) => {
  const here = runsInCity(city.slug)
    .filter((r) => statusOf(r) !== "ended")
    .sort((a, b) => (a.start ?? "9999").localeCompare(b.start ?? "9999"));
  const next = here.find((r) => r.start);
  const houses = [...new Set(here.map((r) => r.venue).filter(Boolean))]
    .map((slug) => venueBySlug(slug!))
    .filter(Boolean) as Venue[];
  // One theatre gets its size as well, because that is the fact that decides
  // what the evening is like; two get their names and no room for more.
  const where = houses.length === 1 && houses[0]!.capacity
    ? `${houses[0]!.name}, ${houses[0]!.capacity!.toLocaleString("en-GB")} seats.`
    : houses.map((v) => v.name).join(" and ") + ".";
  const titles = [...new Set(here.map((r) => showBySlug(r.show)?.title ?? r.show))];
  return {
    href: `/${city.slug}/`,
    title: `Musicals playing ${city.name}`,
    eyebrow: city.country,
    name: city.name,
    // No count pill on a city card. "One musical" is not something a
    // reader can act on — the card already names the theatre and the date —
    // and a badge that exists to fill the corner is what a cheap page looks
    // like from across the room.
    // The theatre, not the shows: the show names are already on every card in
    // the row above this one, and the house is the thing that differs.
    text: houses.length > 0 ? where : titles.join(" and "),
    meta: next ? formatRun(next) : undefined,
    image: city.image,
    imageAlt: city.imageAlt,
    icon: ICONS.map,
  };
});
const citiesRest = citiesByDate.slice(6);

// The chips under the listings. Both rows are links to pages that exist and
// nothing else: a show's own page already carries every date of it, and a
// city page already carries everything booked into that city.
const showChips = shows.map((show) => ({
  href: `/${show.slug}/`,
  label: show.short ?? show.title,
  title: `${show.title}: every run this site tracks, with every seller`,
}));
const cityChips = citiesByDate.map((city) => ({
  href: `/${city.slug}/`,
  label: city.name,
  title: `Musicals playing ${city.name}`,
}));

const lead = shows.find((show) => show.featured) ?? shows[0]!;
const alsoListed = shows.filter((show) => show !== lead);

// What goes beside the headline: the very next run, which is the one fact a
// visitor came for and the only one that changes on its own. Everything in
// it is already on the page further down — this is the same card promoted
// to where it can be seen without scrolling, not a second source of truth.
// The soonest *dated* run, not upcoming[0]: the open Broadway run sorts
// first and has no next date, so "Next up — playing since 14 November 1996"
// is both true and useless. A run with a date is the thing a visitor can
// act on this month.
const next = upcoming.find((run) => run.start && !run.openRun) ?? upcoming[0];
const nextShow = next ? showBySlug(next.show) : undefined;
const nextCity = next ? cityBySlug(next.city) : undefined;
const nextVenue = next?.venue ? venueBySlug(next.venue) : undefined;
const nextTickets = next ? ticketButtons(next) : [];
---
<Layout
  title="Musicals on sale now"
  description="Musicals, city by city: what is on sale, which theatre, which dates, and who is actually selling. Every listing read from the production's own source and dated."
>
  <Hero
    eyebrow="Musicals, city by city"
    title="What is on, where, and who is selling it"
    lede="The same show fills a 17,000-seat arena in Dubai and a seaside theatre in north Wales — different room, different seller, different idea of what a ticket costs. This site lists all of it."
    asideLabel="The next run"
  >
    {next && (
      <a
        class="next-run"
        slot="aside"
        href={`/${next.show}/${next.slug}/`}
        title={`${nextShow?.title ?? next.show} in ${nextCity?.name ?? next.city}: dates, theatre and sellers`}
      >
        <p class="eyebrow">Next up</p>
        <p class="next-run-show">{nextShow?.title ?? next.show}</p>
        {(nextVenue || nextCity) && (
          <p class="next-run-where">
            {[nextVenue?.name, nextCity?.name].filter(Boolean).join(", ")}
          </p>
        )}
        <p class="next-run-when">{formatRun(next)}</p>
        {nextTickets.length > 0 && <span class="next-run-cta">{nextTickets[0]!.label}</span>}
      </a>
    )}
  </Hero>

  <section class="container">
    <h2>On sale now</h2>
    {/* Two rows of chips, not a sentence per show. A reader who came for one
        title is scanning for that title, and "All 37 dates of Chicago The
        Musical" spends a whole line saying what the link already says. Shows
        first, because the title is what gets typed into a search box; then
        the cities that have a page of their own, soonest first.

        Above the cards rather than below them: this is how a reader narrows
        six cards to the one they came for, and a way of narrowing that only
        appears after you have already read everything is furniture. */}
    <ChipNav items={showChips} label="Musicals on this site" />
    <ChipNav items={cityChips} label="Cities with a page of their own" />
    {/* The show on the picture, the city above it. The picture is the show's
        own art now, and a half-mask captioned "London" is a caption for the
        wrong thing. */}
    <EventCards runs={soon} lead="event" labelOnMedia />
    {/* Two shows, read on two different days: one date here would be wrong
        for one of them. The date lives on each show's own page, where it
        belongs to the listings it describes. */}
    <p class="checked">Read from each production's own listing, on the date its page carries.</p>

    {/* A tour asks a different question from a weekend listing: not what is
        on now, but when it reaches you. Subscribing answers that once and
        keeps answering it as stops are added. webcal:, not https: — the
        scheme is the whole difference between subscribing and saving a file. */}
    <a
      class="subscribe"
      href="webcal://musical.today/events.ics"
      title="Opens your calendar app and subscribes to every dated run"
    >
      <Icon name="events" />
      <span class="subscribe-text">
        <span class="subscribe-label">Subscribe to every date</span>
        <span class="subscribe-note">
          All {datedRuns().length} dated runs, city by city, kept up to date in your own calendar.
        </span>
      </span>
    </a>
  </section>

  <div class="container">
    <Promo />
  </div>

  <section class="container" id="cities">
    <h2>Cities</h2>
    <p>
      A city page is the local answer: which theatres take touring musicals,
      what is booked into them and when the season runs. Cities with one event
      are listed on that event's page instead, and every theatre has a page of
      its own either way.
    </p>
    <VentureGrid items={cityCards} columns={3} />
    {citiesRest.length > 0 && (
      <p class="more city-rest">
        <span>Also on:</span>
        {citiesRest.map((city) => (
          <a href={`/${city.slug}/`} title={`Musicals playing ${city.name}`}>{city.name}</a>
        ))}
        <a href="/venues/" title="Every theatre and arena on this site">all {venues.length} theatres</a>
      </p>
    )}
  </section>

  {/* The two ways in that are neither a city nor a show: a district and a
      season. Both are searched for by name far more often than any title on
      this site, and neither can be answered by a page about one production. */}
  <section class="container" id="collections">
    <h2>By district and by season</h2>
    <p>
      Pages that cut across the listings: everything playing in one part of one
      city, and everything playing at one time of year. Membership is written
      out rather than worked out, so nothing lands on them by accident.
    </p>
    <div class="link-grid">
      {collections.map((collection) => (
        <a class="card link-card" href={`/${collection.slug}/`} title={collection.title}>
          <h3>{collection.name}</h3>
          <p>{collection.lede}</p>
        </a>
      ))}
    </div>
  </section>

  {/* One section for the show this site is about, and a line for the rest.
      A second show listed in full is not a second subject: giving it the
      same grid would say the site had two, which it has not. */}
  <section class="container">
    <h2>{lead.title}</h2>
    <p>{lead.tagline}</p>
    <div class="link-grid">
        {/* One line per show, written for it. A single fixed line would have
            promised Cats a history and a video it has not got; the show's own
            summary would have been accurate and flat. */}
      <a class="card link-card" href={`/${lead.slug}/`} title={`${lead.title}: every run, and what is on this site about it`}>
        <h3>Everything on the show</h3>
        <p>{lead.hubCard}</p>
      </a>
      {lead.sections.map((section) => (
        <a class="card link-card" href={`/${lead.slug}/${section.slug}/`} title={section.title}>
          <h3>{section.label}</h3>
          <p>{section.description}</p>
        </a>
      ))}
    </div>
  </section>

  {alsoListed.length > 0 && (
    <section class="container">
      <h2>Also listed</h2>
      <p>Every run, theatre and seller, checked the same way — without the editorial pages the lead show carries.</p>
      <div class="link-grid also-grid">
        {alsoListed.map((show) => (
          <a class="card link-card" href={`/${show.slug}/`} title={`${show.title}: every stop, its theatre and its seller`}>
            <h3>{show.title}</h3>
            <p>{show.hubCard}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="container">
    <h2>At home</h2>
    <p>
      No, you cannot watch the whole show at home. You can watch the numbers the
      productions filmed themselves and the cast recordings the rights holders
      put up, and they play on
      {" "}<a href="/online/" title="Musicals you can legally watch at home">the online page</a> rather than
      somewhere else.
    </p>
  </section>
</Layout>

<style>
  /* The next run, promoted into the hero. It is a card and it is a link,
     so it gets a card's surface and a link's affordance — but no shadow
     and no accent rail, because it sits beside an h1 and must not compete
     with it. The measure cap that running text carries would be nonsense
     in a 20rem column, so it is lifted here. */
  .next-run {
    display: block;
    padding: var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: inherit;
    text-decoration: none;
  }
  .next-run:hover { border-color: var(--accent); }
  .next-run p { max-width: none; margin: 0; }
  .next-run .eyebrow { margin-bottom: var(--space-1); }
  .next-run-show { font-family: var(--font-display); font-size: var(--step-1); font-weight: 600; line-height: 1.2; }
  .next-run-where { color: var(--ink-muted); }
  .next-run-when { font-variant-numeric: tabular-nums; margin-top: 0.25em !important; }
  /* Reads as the button it behaves like without being one: the whole card
     is the link, so a nested button would be a second target for the same
     destination. */
  .next-run-cta {
    display: inline-block;
    margin-top: var(--space-2);
    color: var(--accent);
    font-weight: 600;
  }
  /* No underline on hover. The whole card is the link, so underlining one
     line inside it says that line is the target and the rest is not; the
     border carries the hover state. */
  /* Subscribing to the tour, under the dates it is about. Same shape the
     rest of the network uses for its calendars, written here because this
     site keeps its own run model and does not render EventsList. */
  .subscribe {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    margin-top: var(--space-3);
    padding: var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-size: var(--step--1);
    color: inherit;
    text-decoration: none;
  }
  .subscribe:hover,
  .subscribe:focus-visible { border-color: var(--accent); }
  /* :global because Icon.astro renders the svg, not this file, and Astro
     scopes every part of a selector. Unsized, the mark comes out 95px. */
  .subscribe :global(svg) {
    flex: none;
    width: 1.4em;
    height: 1.4em;
    color: var(--accent);
    margin-top: 0.1em;
  }
  .subscribe-text { display: flex; flex-direction: column; gap: 0.15em; }
  .subscribe-label { font-weight: 600; color: var(--accent); }
  .subscribe-note { color: var(--ink-muted); }
  /* Sixteen city names on one line, reading as a line and not as sixteen
     buttons: the gap does the separating, and the label sits in front of
     them at the same baseline. */
  /* One card should look like one card, not like a banner: auto-fit gives a
     lone item the whole row. */
  .also-grid { grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); }
  .city-rest { gap: 0.4em var(--space-2); }
  .city-rest span { color: var(--ink-faint); font-size: var(--step--1); }
  .more {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5em var(--space-3);
    margin-top: var(--space-3);
  }
  /* One line of text is 29px tall and a thumb is not. */
  .more a { display: inline-flex; align-items: center; min-height: 44px; }
  /* The date the listings were read, kept next to the listings it applies to
     rather than in a panel of site statistics at the top of the page. */
  .checked { color: var(--ink-faint); font-size: var(--step--1); }
</style>
