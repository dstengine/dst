---
// A dated list where the date is doing the work. Ordered, because the order
// is the argument: the show failed first, was revived cheaply, and won
// because the cheap idea was the right one.
import type { Milestone } from "../content";

interface Props { items: Milestone[] }
const { items } = Astro.props;
---
<ol class="timeline">
  {items.map((item) => (
    <li>
      <p class="timeline-date">{item.date}</p>
      <h3 class="timeline-title">{item.title}</h3>
      <p class="timeline-text">{item.text}</p>
    </li>
  ))}
</ol>

<style>
  .timeline { margin: var(--space-4) 0 0; padding: 0; list-style: none; }
  .timeline li {
    position: relative;
    padding: 0 0 var(--space-4) var(--space-4);
    border-left: 2px solid var(--border);
  }
  .timeline li:last-child { padding-bottom: 0; }
  .timeline li::before {
    content: "";
    position: absolute;
    left: -0.4rem;
    top: 0.45rem;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--accent);
  }
  .timeline-date {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .timeline-title { margin: 0.15em 0 0.35em; font-size: var(--step-1); }
  .timeline-text { margin: 0; color: var(--ink-muted); max-width: 68ch; }
</style>
