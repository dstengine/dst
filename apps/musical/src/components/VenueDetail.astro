---
// A theatre or arena, with what plays there. Built on the network's venue
// template — the one the district guides use — because a venue page is a
// venue page: hero, facts panel, prose, related places. What this site adds
// through its slots is the map and the calendar of runs.
import VenuePage from "@dst/ui/district/VenuePage.astro";
import MapEmbed from "@dst/ui/MapEmbed.astro";
import Breadcrumbs from "@dst/ui/Breadcrumbs.astro";
import Layout from "../layouts/Layout.astro";
import RunTable from "./RunTable.astro";
import EventCards from "./EventCards.astro";
import { go } from "../outbound";
import {
  checkedOn, cityBySlug, cityHasPage, formatRun, runsInGroup, showBySlug, statusOf,
  runsAtVenue, venueBySlug, venues, venuePath, type Venue,
} from "../content";

interface Props { venue: Venue }
const { venue } = Astro.props;

const city = cityBySlug(venue.city)!;
const here = runsAtVenue(venue.slug);
const upcoming = here.filter((r) => statusOf(r) !== "ended");
const past = here.filter((r) => statusOf(r) === "ended");
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;

// The address is already the panel's first block (`building`), so it is not
// repeated as a row underneath it.
const details = [
  ...(venue.details ?? []),
  { label: "City", value: `${city.name}, ${city.country}` },
  { label: "Last checked", value: checkedOn },
];

// One line per neighbouring theatre: what is booked there and when. The
// venue's own summary belongs on the venue's own page — printed here it
// makes a page that is mostly somebody else's writing.
const blurbFor = (v: Venue): string => {
  const soon = runsAtVenue(v.slug).filter((r) => statusOf(r) !== "ended")[0];
  const title = soon ? showBySlug(soon.show)?.title ?? soon.show : undefined;
  return soon && title ? `${title}, ${formatRun(soon)}.` : "No dates on this site's calendar yet.";
};

// Other theatres this site knows. Not "the first three in the file": that
// put the same three summaries, a hundred and seventy words of them, on
// every one of thirty-three otherwise thin pages. The theatres either side
// of this one on the tour are both different per page and the thing a
// reader actually asks — where else is it, and when.
const tourNeighbours = (() => {
  const run = here[0];
  if (!run?.group) return [];
  const ordered = runsInGroup(run.group)
    .sort((a, b) => (a.start ?? "").localeCompare(b.start ?? ""));
  const at = ordered.findIndex((r) => r.slug === run.slug);
  return ordered
    .filter((r) => r.slug !== run.slug && r.venue)
    .sort((a, b) => Math.abs(ordered.indexOf(a) - at) - Math.abs(ordered.indexOf(b) - at))
    .map((r) => venueBySlug(r.venue!))
    .filter((v): v is Venue => Boolean(v));
})();

const related = [
  ...tourNeighbours,
  ...venues.filter((v) => v.city === venue.city),
  ...venues,
]
  .filter((v, i, all) => v.slug !== venue.slug && all.findIndex((o) => o.slug === v.slug) === i)
  .slice(0, 3)
  .map((v) => ({
    href: venuePath(v),
    name: v.name,
    blurb: blurbFor(v),
    meta: cityBySlug(v.city)?.name,
    ...(v.image ? { image: v.image, imageAlt: v.imageAlt } : {}),
    // Nineteen of the thirty-six have a licensed photograph; the rest take
    // the network's no-photo cover until one is found for them.
    icon: "stage",
  }));

const placeLd: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "PerformingArtsTheatre",
  name: venue.name,
  ...(canonical ? { url: canonical, "@id": `${canonical}#place` } : {}),
  ...(venue.address
    ? { address: { "@type": "PostalAddress", streetAddress: venue.address, addressLocality: city.name, addressCountry: city.country } }
    : { address: { "@type": "PostalAddress", addressLocality: city.name, addressCountry: city.country } }),
  ...(venue.lat && venue.lon ? { geo: { "@type": "GeoCoordinates", latitude: venue.lat, longitude: venue.lon } } : {}),
  ...(venue.capacity ? { maximumAttendeeCapacity: venue.capacity } : {}),
  ...(venue.summary ? { description: venue.summary } : {}),
  ...(venue.image && Astro.site ? { photo: new URL(venue.image, Astro.site).href } : {}),
};

// Two different jobs, and one string cannot do both. The head wants the
// venue's name and city in the first words; the page wants a sentence a
// person would read, which is why an unwritten venue opens on what is
// booked there rather than on its own name repeated back at the reader.
const next = upcoming[0];
const nextShow = next ? showBySlug(next.show)?.title ?? next.show : undefined;
const lede = venue.summary
  ?? (next && nextShow
    ? next.openRun
      ? `${nextShow} has been playing here since ${formatRun(next).replace(/^Playing since /, "")}.`
      : `${nextShow} plays here, ${formatRun(next)}.`
    : "Nothing on this site's calendar is booked here at the moment. The address and the directions are below.");
const description = venue.summary
  ?? `${venue.name} in ${city.name}: address, how to get there, and what is playing.`;
---
<Layout
  title={`${venue.name}, ${city.name}`}
  description={description.slice(0, 300)}
  jsonLd={[placeLd]}
>
  <div class="container venue-crumbs">
    <Breadcrumbs
      crumbs={[{ href: "/venues/", label: "Venues" }]}
      current={venue.name}
      homeLabel="What's on"
    />
  </div>
  <VenuePage
    eyebrow={`${city.name}, ${city.country}`}
    name={venue.name}
    tagline={venue.capacity ? `${venue.capacity.toLocaleString("en-GB")} seats` : undefined}
    description={lede}
    image={venue.image}
    imageAlt={venue.imageAlt}
    imagePosition={venue.imagePosition}
    imageCredit={venue.imageCredit && venue.imageLicense
      ? { name: venue.imageCredit, license: venue.imageLicense, licenseUrl: venue.imageLicenseUrl, sourceUrl: venue.imageSourceUrl }
      : undefined}
    building={venue.address}
    details={details}
    highlights={venue.highlights}
    sections={venue.sections}
    externalHref={venue.officialSlug ? go(venue.officialSlug) : undefined}
    externalLabel="Official site"
    related={related}
    relatedHeading="Other theatres on this site"
    backHref="/venues/"
    backLabel="All venues"
  >
    {venue.sections && venue.sections.length > 0 && (
      <p class="venue-sources">
        Opening dates, capacities and architects on this page come from the theatre's
        own history pages and from Wikipedia.
      </p>
    )}
    {venue.transit && (
      <section class="venue-section">
        <h2>Getting there</h2>
        <p>{venue.transit}</p>
      </section>
    )}
    {venue.lat && venue.lon && <MapEmbed lat={venue.lat} lon={venue.lon} name={venue.name} />}

    <section slot="after" class="container">
      <h2>What is playing here</h2>
      {upcoming.length > 0
        ? <EventCards runs={upcoming} lead="event" eyebrow="tour" venueInMeta={false} />
        : <p>Nothing on this site's calendar is playing here at the moment.</p>}
      {past.length > 0 && (
        <RunTable runs={past} lead="event" cityColumn={false} caption="Already played." />
      )}
      {cityHasPage(city) && (
        <p class="venue-city">
          <a href={`/${city.slug}/`} title={`Musicals playing ${city.name}`}>Everything on in {city.name}</a>
        </p>
      )}
    </section>
  </VenuePage>
</Layout>

<style>
  .venue-crumbs { padding-top: var(--space-4); }
  .venue-section h2 { margin-top: var(--space-4); }
  .venue-sources { margin-top: var(--space-3); color: var(--ink-muted); font-size: var(--step--1); }
  .venue-city { margin-top: var(--space-3); }
</style>
