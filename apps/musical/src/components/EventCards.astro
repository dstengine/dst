---
// Runs as cards, in the same card language the rest of the network uses:
// a cover, the city, a status badge and the one fact that decides whether a
// ticket can be bought today.
//
// Cards, not a table, wherever a reader is browsing — the front page, a city,
// a venue, "the same show elsewhere". RunTable stays where a page is a
// reference to be scanned in full: a 33-stop tour, the ticket index, runs
// that have already played.
import VentureGrid from "@dst/ui/VentureGrid.astro";
import { ICONS } from "@dst/ui/icons";
import { cityBySlug, formatRun, groupBySlug, runCardLine, runSellerLine, showBySlug, showImage, statusLabel, statusOf, venueBySlug, type Run, } from "../content";

interface Props {
  runs: Run[];
  /** Which fact leads the card. A page about one show leads with the city;
      a page about one city or one theatre leads with the show. */
  lead?: "city" | "event";
  /** A grid of stops on the same tour, where the composed sentences would
      otherwise repeat each other down the page: the card keeps its dates,
      its theatre and its status, and says only who is selling. */
  compact?: boolean;
  /** Whether the theatre belongs on the meta line. It does everywhere except
      the theatre's own page, where the reader is already standing in it. */
  venueInMeta?: boolean;
  /** What goes above the title. "show" is right where the reader may not
      know what is playing; on a page that is already about one show, the
      show's name six times over is wallpaper, so the tour or the country
      takes the line instead. */
  eyebrow?: "show" | "tour";
  /** Whether a picture belongs on the card at all. It does wherever the
      cards differ in the thing the picture shows. It does not where every
      card would carry the same one: on a theatre's own page and under "Also
      on in this city", one photograph would run identically down every card,
      which reads as two pictures of two different things and is neither. The
      mark takes over there. */
  photo?: boolean;
  columns?: number;
  /** Passed straight through: the front page puts the city on the picture
      because its cards are the first thing at the fold. */
  labelOnMedia?: boolean;
}
const { runs, lead = "city", eyebrow = "show", venueInMeta = true, compact = false, photo = true, columns, labelOnMedia = false } = Astro.props;

// Three across from a tablet up: at four the cards drop to 265px and the
// venue line starts wrapping every time. One or two runs keep the same
// column width rather than falling back to auto-fill, where a lone card
// came out 260px wide in the corner of a 1280px page with its own title
// wrapping inside it.
const across = columns ?? 3;

// Which picture the cards carry is decided by what the cards differ in, not
// by the page that drew them. A grid of one show in many cities — a tour, a
// show's own page — differs by place, so the city photograph is the useful
// picture. A grid of many shows in one city, or the front page, differs by
// show, so the show's own art is: three identical London skylines under
// three different titles say nothing about any of them, which is what the
// front page looked like before this.
const oneShow = new Set(runs.map((run) => run.show)).size <= 1;

const items = runs.map((run) => {
  const place = cityBySlug(run.city);
  const city = place?.name ?? run.city;
  const show = showBySlug(run.show)?.title ?? run.show;
  const venue = run.venue ? venueBySlug(run.venue)?.name : undefined;
  const art = showImage(run.show);
  const tour = eyebrow === "tour"
    ? (run.group ? groupBySlug(run.show, run.group)?.name : undefined) ?? place?.country
    : undefined;
  return {
    href: `/${run.show}/${run.slug}/`,
    title: `${show} in ${city}: dates, theatre and sellers`,
    eyebrow: tour ?? (lead === "city" ? show : city),
    name: lead === "city" ? city : show,
    status: statusLabel(run),
    // Amber, the same badge the network uses for "in progress": announced
    // dates with nobody selling them yet are exactly that.
    inProgress: statusOf(run) === "announced",
    text: compact ? runSellerLine(run) : runCardLine(run),
    meta: venue && venueInMeta ? `${formatRun(run)} · ${venue}` : formatRun(run),
    // A reader scanning thirty-three stops recognises Newcastle faster than
    // they read it; a reader scanning six shows recognises the half-mask.
    // The show's art is the fallback for a city with no picture and the other
    // way round, and the mark is the fallback for neither. A card is a link,
    // so it can hold neither a caption nor the two links a caption needs: the
    // photographer and the licence are named on the city's own page, where
    // the same picture runs full size.
    image: photo ? (oneShow ? place?.image ?? art?.image : art?.image ?? place?.image) : undefined,
    imageAlt: photo ? (oneShow ? place?.imageAlt ?? art?.imageAlt : art?.imageAlt ?? place?.imageAlt) : undefined,
    icon: ICONS.stage,
  };
});
---
<VentureGrid items={items} columns={across} labelOnMedia={labelOnMedia} />
