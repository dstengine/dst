---
// Where a run stands, in one word. Four states, and each of them means
// something different to a reader holding a credit card: playing with no end
// date, on sale, dated but not sellable yet, over.
import { statusLabel, statusOf, type Run } from "../content";

interface Props { run: Run }
const { run } = Astro.props;
const status = statusOf(run);
---
<span class:list={["status", `status-${status}`]}>{statusLabel(run)}</span>

<style>
  /* inline-flex with line-height 1, so the capsule is sized by the letters
     rather than by the line box around them — as inline-block it inherited
     the paragraph's leading and drew a lozenge with a band of empty tint
     above and below the caps. */
  .status {
    display: inline-flex;
    align-items: center;
    padding: 0.4em 0.75em;
    border-radius: 999px;
    line-height: 1;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    border: 1px solid currentColor;
  }
  /* A filled state does not also need an outline: two signals for one fact
     read as a heavier badge than the fact deserves. */
  .status-on-sale, .status-open-run {
    color: var(--accent-ink, var(--accent));
    background: var(--accent-tint);
    border-color: transparent;
  }
  .status-announced { color: var(--ink-muted); }
  .status-ended { color: var(--ink-faint); }
</style>
