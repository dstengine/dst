---
// The event this site leads with, in a block that runs across the front
// page, the city pages and the show's own pages. It is not what the site is
// about — it is what the site does with an event worth the attention, and
// the next one gets the same treatment.
//
// The button says Tickets and goes to the run's own page, not to a seller.
// The seller is a decision, and the run page is where the reader has what
// they need to make it: dates, theatre, who is selling, what is not known.
//
// The picture is the city, not the show. Production stills are the
// producer's and this site is licensed to none of them; the city is a place
// anyone may photograph, it is the half of "Chicago in Dubai" a reader can
// actually recognise, and it is the same photograph the run cards carry
// three sections above. Where a city has none, the drawn stage stands in.
import { cityBySlug, formatRun, runBySlug, showBySlug, featuredRun, venueBySlug } from "../content";
import Icon from "@dst/ui/Icon.astro";
import Photo from "@dst/ui/Photo.astro";
import StatusBadge from "./StatusBadge.astro";

interface Props {
  /** Heading level, so the block can sit under an h1 or as a page section. */
  level?: 2 | 3;
  compact?: boolean;
  /** Defaults to the site's featured run. */
  show?: string;
  run?: string;
}
const { level = 2, compact = false, show: showSlug = featuredRun.show, run: runSlug = featuredRun.run } = Astro.props;
const show = showBySlug(showSlug)!;
const run = runBySlug(showSlug, runSlug)!;
const city = cityBySlug(run.city)!;
const venue = run.venue ? venueBySlug(run.venue) : undefined;
const Heading = `h${level}` as "h2" | "h3";
const href = `/${show.slug}/${run.slug}/`;
---
<aside class:list={["promo", compact && "promo-compact"]}>
  {city.image ? (
    <figure class="promo-media">
      <Photo src={city.image} alt={city.imageAlt ?? city.name} sizes="(min-width: 50rem) 15rem, 100vw" />
    </figure>
  ) : (
    <svg class="promo-art" viewBox="0 0 240 200" role="img" aria-label="A theatre stage with its curtains drawn back">
      <defs>
        <linearGradient id="promo-drape" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="var(--accent)" stop-opacity="0.95" />
          <stop offset="1" stop-color="var(--accent)" stop-opacity="0.55" />
        </linearGradient>
      </defs>
      <rect x="0" y="0" width="240" height="200" fill="var(--surface-sunk)" />
      <rect x="40" y="30" width="160" height="140" fill="var(--bg)" />
      <path d="M40 30 h44 c-6 40 -14 62 -30 84 c14 20 18 38 16 56 h-30 z" fill="url(#promo-drape)" />
      <path d="M200 30 h-44 c6 40 14 62 30 84 c-14 20 -18 38 -16 56 h30 z" fill="url(#promo-drape)" />
      <rect x="40" y="20" width="160" height="14" rx="3" fill="var(--accent)" />
      <g fill="var(--surface)">
        <circle cx="56" cy="27" r="3" /><circle cx="80" cy="27" r="3" /><circle cx="104" cy="27" r="3" />
        <circle cx="128" cy="27" r="3" /><circle cx="152" cy="27" r="3" /><circle cx="176" cy="27" r="3" />
      </g>
      <rect x="94" y="120" width="52" height="50" fill="var(--accent-tint)" />
      <rect x="40" y="170" width="160" height="6" fill="var(--accent-ink)" />
    </svg>
  )}
  <div class="promo-text">
    <p class="eyebrow">The event we are following closest</p>
    <Heading class="promo-title">{show.title} in {city.name}</Heading>
    <p class="promo-line">{venue ? `${venue.name} · ` : ""}{formatRun(run)}</p>
    <p class="promo-status"><StatusBadge run={run} /></p>
    <p class="promo-actions">
      <a class="button" href={href} title={`${show.title} in ${city.name}: dates, theatre and sellers`}><Icon name="ticket" />Tickets</a>
      <a class="button button-secondary" href={`/${show.slug}/`} title={`Every run of ${show.title}, and what the show is`}><Icon name="events" />All dates</a>
    </p>
  </div>
</aside>

<style>
  .promo {
    display: grid;
    gap: var(--space-3);
    align-items: center;
    margin: var(--space-4) 0;
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-left: 4px solid var(--accent);
    border-radius: var(--radius);
    background: var(--surface);
  }
  @media (min-width: 800px) {
    /* Text first on a wide screen, picture beside it; on a phone the order
       is the other way round, which is what the DOM says. */
    .promo { grid-template-columns: 1fr 15rem; }
    .promo-text { order: 1; }
    .promo-media, .promo-art { order: 2; }
  }
  .promo-text > :global(*) { max-width: 54ch; }
  .promo-title { margin: 0.1em 0 0.4em; font-size: var(--step-2); }
  .promo-line { margin: 0; color: var(--ink-muted); }
  .promo-status { margin: var(--space-2) 0 0; }
  .promo-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-3) 0 0;
  }
  .promo-media { margin: 0; }
  .promo-media :global(img) {
    width: 100%;
    height: clamp(150px, 34vw, 220px);
    object-fit: cover;
    border-radius: var(--radius);
    display: block;
  }
  .promo-compact .promo-media { display: none; }
  .promo-art {
    width: 100%;
    height: auto;
    max-height: 12rem;
    border-radius: var(--radius);
  }
  /* On the show's own pages the block is a reminder, not the pitch — the
     drawing would be the third stage curtain on one screen. */
  .promo-compact .promo-art { display: none; }
  @media (max-width: 799px) {
    .promo-art { max-height: 8rem; }
    /* The block is nearly a screen tall on a phone; space-4 on all four
       sides made it two. */
    .promo { padding: var(--space-3); }
    .promo-title { font-size: var(--step-1); }
    /* One under the other, each the full width of the card. Side by side
       they came out as a short solid button and a wide outlined one whose
       label wrapped around its icon, which reads as two accidents rather
       than as a pair. */
    .promo-actions :global(.button) {
      flex: 1 1 100%;
      justify-content: center;
    }
  }
</style>
