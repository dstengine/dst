---
// A country page is the level above a city: it exists so the front page can
// offer four chips instead of twenty-four, and so a city without a page of
// its own is still reachable by name. What it answers that no city page can
// is "where else" — the same tour, two hundred miles away, three weeks later.
//
// It lists every city in the country, not only the ones with pages: a single
// stop in Hull has no page because a page would repeat its run page word for
// word, but the reader looking for Hull is looking for exactly that run.
import Glance from "@dst/ui/Glance.astro";
import Callout from "@dst/ui/Callout.astro";
import Breadcrumbs from "@dst/ui/Breadcrumbs.astro";
import ChipNav from "@dst/ui/ChipNav.astro";
import { ICONS } from "@dst/ui/icons";
import Layout from "../layouts/Layout.astro";
import RunTable from "./RunTable.astro";
import { checkedOn, checkedOnFor, cityHasPage, citiesInCountry, formatRun, runsInCountry, showBySlug, spell, statusOf, venuesInCity, type Country, } from "../content";

interface Props { country: Country }
const { country } = Astro.props;

const all = runsInCountry(country).sort((a, b) => (a.start ?? "").localeCompare(b.start ?? ""));
const upcoming = all.filter((r) => statusOf(r) !== "ended");
const past = all.filter((r) => statusOf(r) === "ended");
// The soonest *dated* run that is not an open one. An open run sorts first
// and has no next date, so "Next — playing since 8 October 1985" is both
// true and useless to somebody deciding what to book.
const next = upcoming.find((r) => r.start && !r.openRun) ?? upcoming.find((r) => r.start);
const titles = [...new Set(upcoming.map((r) => showBySlug(r.show)?.title ?? r.show))];

// Cities with something still to come, soonest first. A city whose only runs
// have played is listed under "already played" with them and nowhere else.
const live = new Map<string, string>();
for (const run of upcoming) if (run.start && !live.has(run.city)) live.set(run.city, run.start);
const cityList = citiesInCountry(country)
  .filter((c) => upcoming.some((r) => r.city === c.slug))
  .sort((a, b) => (live.get(a.slug) ?? "9999").localeCompare(live.get(b.slug) ?? "9999"));

// A city with a page goes to it; a city without one goes to the run that is
// the whole of what it has. Either way the chip lands on a page that exists.
const cityChips = cityList.map((city) => {
  const here = upcoming.filter((r) => r.city === city.slug);
  const only = here[0]!;
  const many = here.length > 1;
  return {
    href: cityHasPage(city) ? `/${city.slug}/` : `/${only.show}/${only.slug}/`,
    label: city.name,
    // The chip is the city's name; the title says what opens — the city's own
    // listing where there is one, and otherwise the single run that is the
    // whole of what that city has.
    title: many || cityHasPage(city)
      ? `Musicals in ${city.name}: dates, theatres and tickets`
      : `${showBySlug(only.show)?.title ?? only.show} in ${city.name}: dates, theatre and tickets`,
  };
});

// A country with one city is named by that city, not counted: "playing one
// city" is a sentence that withholds the one word the reader wants, and the
// city's name is also what they would have typed.
const subject = titles.length === 1 ? titles[0]! : `${spell(titles.length)} musicals`;
const where = cityList.length === 1
  ? `in ${cityList[0]!.name}`
  : `across ${spell(cityList.length)} cities in ${country.in}`;

const houses = new Set(cityList.flatMap((c) => venuesInCity(c.slug).map((v) => v.slug)));

// As on a city page: the date this page can stand behind is the date its own
// shows were read at their source.
const read = checkedOnFor(runsInCountry(country)) ?? checkedOn;

const glance = [
  { label: "Musicals", value: titles.length === 1 ? "One" : spell(titles.length), icon: ICONS.events },
  cityList.length === 1
    ? { label: "City", value: cityList[0]!.name, icon: ICONS.map }
    : { label: "Cities", value: spell(cityList.length), icon: ICONS.map },
  houses.size > 0 && { label: "Theatres", value: houses.size === 1 ? "One" : spell(houses.size), icon: ICONS.pin },
  next && { label: "Next", value: formatRun(next), icon: ICONS.clock, href: `/${next.show}/${next.slug}/` },
  { label: "Last checked", value: read, icon: ICONS.list },
].filter(Boolean) as { label: string; value: string; icon: string; href?: string }[];
---
<Layout
  title={country.titleSeo}
  description={country.summary}
>
  <section class="container hero">
    <Breadcrumbs crumbs={[]} current={country.name} homeLabel="What's on" />
    <p class="eyebrow">Every city, every date</p>
    <h1>Musicals in {country.in}</h1>
    <p class="lede">
      {subject} playing {where}, with the theatre, the dates and the seller for each.
    </p>
    <Glance facts={glance} />
  </section>

  {country.intro && (
    <section class="container prose">
      {country.intro.map((paragraph) => <p>{paragraph}</p>)}
    </section>
  )}

  {cityChips.length > 1 && (
    <section class="container">
      <h2>Musicals by city</h2>
      <p>Every city in {country.in} with a date still to come.</p>
      <ChipNav items={cityChips} label={`Cities in ${country.name}`} />
    </section>
  )}

  <section class="container">
    <h2>{upcoming.length === 1 ? "What is on" : "What is on, soonest first"}</h2>
    {upcoming.length > 0
      ? <><p>Every date this site tracks in {country.in}. The seller's own page is where the price is.</p><RunTable runs={upcoming} lead="event" /></>
      : <p>Nothing is currently on sale in {country.in}.</p>}
  </section>

  {past.length > 0 && (
    <section class="container">
      <h2>Already played</h2>
      <RunTable runs={past} lead="event" caption="Kept rather than deleted: a country that has had a tour once tends to get the next one." />
    </section>
  )}

  <Callout kind="note">
    <strong>Check the date before you book anything else.</strong> Everything
    here was read from the production's own listing on {read}; runs move
    and performances sell out, and the seller's page is the one that is
    current.
  </Callout>
</Layout>

<style>
  .prose p { max-width: 68ch; }
</style>
