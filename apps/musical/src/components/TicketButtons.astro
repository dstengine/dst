---
// The ticket call to action, and the only place on the site that renders
// one. The wording comes from ticketButtons() in ../rules.ts: one seller and
// the button says "Tickets", several and each says who it goes to, because
// at that point the reader is choosing between them.
//
// A run with nothing on sale gets no button at all — an inert "Tickets" that
// leads to a page without a price is worse than an honest gap.
//
// Under the buttons, who actually takes the money. A button that says only
// "Tickets" answers where to press and not what happens next, and this site
// sells nothing: the reader is about to be handed to somebody else, and
// should read that here rather than work it out from the address bar.
import Icon from "@dst/ui/Icon.astro";
import { go } from "../outbound";
import { priceLabel, sellsItsOwn, statusOf, ticketButtons, type Run } from "../content";

interface Props {
  run: Run;
  showName: string;
  cityName: string;
  /* The .ics link, when the run has a date to put in a calendar. It renders
     here rather than in its own paragraph below: buying and saving the date
     are the same decision, and a bare text link under a solid button read as
     an orphan rather than as the second half of a pair. */
  calendarHref?: string;
}
const { run, showName, cityName, calendarHref } = Astro.props;
const buttons = ticketButtons(run);
const status = statusOf(run);
// "Tickets from £25" on the button itself, when somebody has checked and the
// check is recent. A price is the thing a reader is actually deciding on,
// and making them press to find it out is the extra step this site cannot
// afford — it already costs them one hop to the seller.
const from = priceLabel(run);
---
{buttons.length > 0 && (
  <p class="ticket-actions">
    {buttons.map((button, i) => (
      <a
        class:list={["button", i > 0 && "button-secondary"]}
        href={button.href}
        rel="nofollow"
        title={`Buy tickets for ${showName} in ${cityName} from ${button.seller.name}`}
      ><Icon name="ticket" />{button.label}{i === 0 && from && buttons.length === 1 && <span class="ticket-from"> {from}</span>}</a>
    ))}
    {calendarHref && (
      <a class="button button-secondary" href={calendarHref} title={`Add ${showName} in ${cityName} to a calendar`}><Icon name="events" />Add to calendar</a>
    )}
  </p>
)}
{buttons.length === 0 && calendarHref && (
  <p class="ticket-actions">
    <a class="button button-secondary" href={calendarHref} title={`Add ${showName} in ${cityName} to a calendar`}><Icon name="events" />Add to calendar</a>
  </p>
)}
{buttons.length > 0 && (
  <p class="ticket-seller">
    {buttons.length > 1
      ? "They sell the same performances. The booking is completed on the seller's own site."
      : sellsItsOwn(run)
        ? "The theatre sells its own tickets. The booking is completed on its site."
        : `Sold by ${buttons[0]!.seller.name}. The booking is completed on their site.`}
  </p>
)}
{buttons.length === 0 && run.infoSlug && (
  <p class="ticket-actions">
    <a class="button button-secondary" href={go(run.infoSlug)} rel="nofollow" title={`Venue information for ${showName} in ${cityName}`}><Icon name="pin" />Venue information</a>
  </p>
)}
{buttons.length === 0 && status === "announced" && (
  <p class="ticket-none">No tickets are on sale for these dates yet.</p>
)}

<style>
  .ticket-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    /* Buttons are not prose: the 60ch measure that keeps the lede readable
       was breaking a row of two sellers onto two lines. */
    max-width: none;
    margin: var(--space-3) 0 0;
  }
  /* Bigger than the network button, which is built for a link inside a
     paragraph — but only by a step. At --step-1 with 0.9em padding this
     measured 78px tall against a 28px line of type beside it, and read as
     an app's sticky CTA dropped into an editorial page. */
  .ticket-actions :global(.button) {
    padding: 0.75em 1.5em;
    font-size: var(--step-0);
    /* A seller's name wraps on a phone; centred, the two lines read as a
       label rather than as a paragraph that happens to sit in a box. */
    justify-content: center;
    text-align: center;
  }
  /* On a phone the row wraps anyway, and a short solid button sitting above
     a wider outlined one reads as a mistake rather than as a pair. Full
     width each, stacked, the same as the promo block. */
  @media (max-width: 520px) {
    .ticket-actions :global(.button) { flex: 1 1 100%; }
  }
  .ticket-none { margin: var(--space-3) 0 0; color: var(--ink-muted); }
  /* The price rides on the button rather than under it: a reader deciding
     whether to press wants the number inside the thing they are pressing.
     Lighter than the label so "Tickets" still reads first. */
  .ticket-from { font-weight: 400; opacity: 0.85; }
  .ticket-seller {
    margin: var(--space-2) 0 0;
    color: var(--ink-muted);
    font-size: var(--step--1);
  }
</style>
