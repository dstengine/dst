---
// A city page exists once a city has something to compare — two events, or a
// standing reason of its own (see cityHasPage in ../rules.ts). So this page
// is never a second copy of a run page: it answers "what is on here", which
// the run page cannot, and it lists the theatres that answer it next season.
import Glance from "@dst/ui/Glance.astro";
import Callout from "@dst/ui/Callout.astro";
import Breadcrumbs from "@dst/ui/Breadcrumbs.astro";
import MapEmbed from "@dst/ui/MapEmbed.astro";
import VenueCard from "@dst/ui/district/VenueCard.astro";
import { ICONS } from "@dst/ui/icons";
import Layout from "../layouts/Layout.astro";
import RunTable from "./RunTable.astro";
import EventCards from "./EventCards.astro";
import {
  checkedOn, formatRun, runsInCity, spell, statusOf, venuePath, venuesInCity, type City,
} from "../content";

interface Props { city: City }
const { city } = Astro.props;

const inCity = runsInCity(city.slug).sort((a, b) => (a.start ?? "").localeCompare(b.start ?? ""));
const upcoming = inCity.filter((r) => statusOf(r) !== "ended");
const past = inCity.filter((r) => statusOf(r) === "ended");
const venues = venuesInCity(city.slug);
const next = upcoming.find((r) => r.start);
const mapped = venues.filter((v) => v.lat && v.lon);

const glance = [
  { label: "Musicals", value: upcoming.length === 1 ? "One" : spell(upcoming.length), icon: ICONS.events },
  next && { label: "Next", value: formatRun(next), icon: ICONS.clock, href: `/${next.show}/${next.slug}/` },
  venues.length > 0 && { label: "Theatres", value: venues.map((v) => v.name).join(", "), icon: ICONS.pin },
  { label: "Country", value: city.country, icon: ICONS.map },
  { label: "Last checked", value: checkedOn, icon: ICONS.list },
].filter(Boolean) as { label: string; value: string; icon: string; href?: string }[];
---
<Layout
  title={`Musicals in ${city.name}`}
  description={`Musicals playing ${city.name}: what is on sale, which theatre, and who is selling. Listings read ${checkedOn}.`}
>
  <section class="container hero">
    <Breadcrumbs crumbs={[]} current={city.name} homeLabel="What's on" />
    <p class="eyebrow">{city.country}</p>
    <h1>Musicals in {city.name}</h1>
    {city.summary && <p class="lede">{city.summary}</p>}
    <Glance facts={glance} />
  </section>

  <section class="container">
    <h2>{upcoming.length === 1 ? "What is on" : "What is on, soonest first"}</h2>
    {upcoming.length > 0
      ? <><p>Every musical this site tracks in {city.name}. The seller's own page is where the price is.</p><EventCards runs={upcoming} lead="event" /></>
      : <p>Nothing is currently on sale in {city.name}.</p>}
  </section>

  {venues.length > 0 && (
    <section class="container">
      <h2>{venues.length === 1 ? "The theatre" : "The theatres"}</h2>
      <div class="venue-grid">
        {venues.map((venue) => (
          <VenueCard
            href={venuePath(venue)}
            name={venue.name}
            blurb={venue.summary ?? venue.address ?? city.name}
            meta={venue.capacity ? `${venue.capacity.toLocaleString("en-GB")} seats` : city.name}
            icon="stage"
          />
        ))}
      </div>
      {mapped.length === 1 && <MapEmbed lat={mapped[0]!.lat!} lon={mapped[0]!.lon!} name={mapped[0]!.name} />}
    </section>
  )}

  {past.length > 0 && (
    <section class="container">
      <h2>Already played</h2>
      <RunTable runs={past} lead="event" cityColumn={false} caption="Kept rather than deleted: a city that has had a show once tends to get it again." />
    </section>
  )}

  <Callout kind="note">
    <strong>Check the date before you book a flight.</strong> Everything here was
    read from the production's own listing on {checkedOn}; runs move and
    performances sell out, and the seller's page is the one that is current.
  </Callout>
</Layout>

<style>
  /* The same grid the venue template uses for its own cards, so a theatre
     looks like a theatre wherever the reader meets one. */
  .venue-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-3);
    margin-top: var(--space-3);
  }
</style>
