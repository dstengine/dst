---
import BaseLayout from "@dst/ui/BaseLayout.astro";
import { site } from "../site.config";
import "../styles/theme.css";

interface Props {
  /** Forwarded to BaseLayout: see its `prose` prop. */
  prose?: boolean;
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>[];
  /** og:image for this page — see BaseLayout. */
  image?: string;
  /** Kept out of the index while a page is thinner than what it links to. */
  noindex?: boolean;
}
const { title, description, jsonLd, image, prose, noindex } = Astro.props;

// The menu is about the site, not about one city: the hero event has a place
// in it because it is the worked example, and the rest is how anyone else
// arrives — by city, by building, or by what plays at home.
const nav = [
  { href: "/", label: "What's on", title: "Musicals on sale now, city by city", icon: "home" },
  { href: "/#cities", label: "Cities", title: "Cities with more than one musical listed", icon: "map" },
  { href: "/venues/", label: "Venues", title: "Every theatre and arena on this site", icon: "pin" },
  { href: "/chicago/", label: "Chicago", title: "Chicago The Musical: every run, its history and what to watch", icon: "stage" },
  { href: "/cats/", label: "Cats", title: "Cats on tour: every stop, its theatre and its seller", icon: "cat" },
  { href: "/news/", label: "News", title: "What changed in the listings, with a source on every entry", icon: "news" },
  { href: "/online/", label: "Online", title: "Musicals you can legally watch at home", icon: "play" },
  { href: "/about/", label: "About", title: "How these listings are built and checked", icon: "id" },
];

---
<BaseLayout
  {...site}
  prose={prose}
  title={title}
  description={description}
  nav={nav}
  jsonLd={jsonLd}
  image={image}
  noindex={noindex}
>
  <slot />
</BaseLayout>
