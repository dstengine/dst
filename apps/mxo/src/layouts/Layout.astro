---
import BaseLayout from "@dst/ui/BaseLayout.astro";
import { site } from "../site.config";
import "../styles/theme.css";

interface Props {
  /** Forwarded to BaseLayout: see its `prose` prop. */
  prose?: boolean;
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>[];
  image?: string;
  noindex?: boolean;
}
const { title, description, jsonLd, image, noindex, prose } = Astro.props;

const nav = [
  { href: "/", label: "Qué hacer", title: "Qué hacer hoy en México", icon: "home" },
  { href: "/noticias/", label: "Noticias", title: "Noticias de México, y del mundo contadas desde aquí", icon: "news" },
  { href: "/eventos/", label: "Eventos", title: "Ferias y festivales en todo México", icon: "events" },
  { href: "/acerca/", label: "Acerca", title: "Quién publica este sitio y cómo se verifica cada fecha", icon: "id" },
];

---
<BaseLayout
  {...site}
  prose={prose}
  title={title}
  description={description}
  nav={nav}
  jsonLd={jsonLd}
  image={image}
  noindex={noindex}
>
  <slot />
</BaseLayout>
