---
import Layout from "../layouts/Layout.astro";
import NewsBlock from "@dst/ui/NewsBlock.astro";
import EventsBlock from "@dst/ui/EventsBlock.astro";
import { home, site, newsBase, eventsBase } from "../content";
import { newsBySite } from "@dst/content/news";
import { eventsBySite } from "@dst/content/events";

const newsItems = newsBySite(site);
const eventItems = eventsBySite(site);
---
<Layout title={home.title} description={home.description}>
  <section class="container hero">
    <h1>{home.h1}</h1>
    <p class="lede">{home.lede}</p>
  </section>
  <EventsBlock locale="es-MX" items={eventItems} heading="Eventos" eventsBase={eventsBase} allLabel="Todos los eventos" />
  <NewsBlock locale="es-MX" items={newsItems} heading="Noticias" newsBase={newsBase} allLabel="Todas las noticias" />
</Layout>
