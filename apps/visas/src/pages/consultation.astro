---
import Layout from "../layouts/Layout.astro";
import LeadForm from "@dst/ui/LeadForm.astro";
---
<Layout
  title="Request a Consultation"
  description="Tell us your timeline and budget, and get a shortlist of Golden-Visa-eligible properties matched to your situation."
>
  <section class="container">
    <p class="eyebrow">Consultation</p>
    <h1>Request a consultation</h1>
    <p class="lede">
      A few details help us send a shortlist that's actually relevant, rather
      than a generic listings link. Nothing here is submitted anywhere
      binding — this starts a conversation, not an application.
    </p>
  </section>

  <section class="container">
    <LeadForm submitLabel="Request my shortlist">
      <input type="hidden" name="type" value="golden-visa-consultation" />
      <div class="field">
        <label for="timeline">When are you hoping to complete this?</label>
        <select id="timeline" name="meta.timeline">
          <option value="">Prefer not to say</option>
          <option value="0-3m">Within 3 months</option>
          <option value="3-12m">3–12 months</option>
          <option value="12m+">No fixed timeline</option>
        </select>
      </div>
      <div class="field">
        <label for="budget">Approximate investment size (AED)</label>
        <select id="budget" name="meta.investmentBudget">
          <option value="">Prefer not to say</option>
          <option value="2-3m">2,000,000–3,000,000</option>
          <option value="3-5m">3,000,000–5,000,000</option>
          <option value="5m+">5,000,000+</option>
        </select>
      </div>
    </LeadForm>
  </section>
</Layout>
