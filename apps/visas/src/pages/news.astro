---
import Layout from "../layouts/Layout.astro";
import SectionNav from "@dst/ui/SectionNav.astro";
import NewsList from "@dst/ui/NewsList.astro";
import { newsBySite } from "@dst/content/news";
import { eventsBySite } from "@dst/content/events";
import { sections, NAV } from "../sections";

const items = newsBySite("visas");

// The subject row. Empty until a subject earns a page, and then it
// appears here without this file changing — see ../sections.ts.
const sectionLinks = sections([...eventsBySite("visas"), ...newsBySite("visas")]);
---
<Layout
  title="Golden Visa & residency news"
  description="Updates on UAE residency routes and the Golden Visa — threshold changes, new guidance, and this site's own updates."
>
  <section class="container hero">
    <p class="eyebrow">News</p>
    <h1>What's changing in UAE residency</h1>
    <p class="lede">
      Threshold and eligibility changes for the Golden Visa and other
      residency routes, kept apart from the reference pages themselves.
    </p>
  </section>

  <section class="container">
    <SectionNav sections={sectionLinks} {...NAV} />
    <NewsList items={items} />
  </section>
</Layout>
