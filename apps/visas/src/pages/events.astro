---
import Layout from "../layouts/Layout.astro";
import SectionNav from "@dst/ui/SectionNav.astro";
import EventsList from "@dst/ui/EventsList.astro";
import { eventsBySite } from "@dst/content/events";
import { newsBySite } from "@dst/content/news";
import { sections, NAV } from "../sections";

const items = eventsBySite("visas");

// The subject row. Empty until a subject earns a page, and then it
// appears here without this file changing — see ../sections.ts.
const sectionLinks = sections([...eventsBySite("visas"), ...newsBySite("visas")]);
---
<Layout
  title="UAE residency and Golden Visa events"
  description="Sessions on UAE residency routes and the Golden Visa, when there are any scheduled."
>
  <section class="container hero">
    <p class="eyebrow">Events</p>
    <h1>Residency and Golden Visa events</h1>
    <p class="lede">
      Sessions on residency routes and the Golden Visa, published here
      once there's something scheduled.
    </p>
  </section>

  <section class="container">
    <SectionNav sections={sectionLinks} {...NAV} />
    <EventsList items={items} />
  </section>
</Layout>
