---
import BaseLayout from "@dst/ui/BaseLayout.astro";
import LeadTracking from "@dst/ui/LeadTracking.astro";
import "../styles/theme.css";

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>[];
  /** og:image for this page — see BaseLayout. */
  image?: string;
}
const { title, description, jsonLd, image } = Astro.props;

const nav = [
  { href: "/", label: "Visa types", title: "UAE residency routes compared" },
  { href: "/golden/", label: "Golden Visa", title: "Golden Visa via property investment" },
  { href: "/properties/", label: "Eligible properties", title: "Properties that qualify for the Golden Visa" },
  { href: "/family/", label: "Family & lifestyle", title: "What a Golden Visa changes day to day" },
  { href: "/consultation/", label: "Consultation", title: "Request a Golden Visa consultation" },
  { href: "/news/", label: "News", title: "What's changing in UAE residency" },
  { href: "/events/", label: "Events", title: "Residency and Golden Visa events" },
];
---
<BaseLayout
  title={`${title} — Dubai Residency & Golden Visa`}
  description={description}
  siteName="Dubai Residency"
  nav={nav}
  complianceNote="Informational content, not immigration or legal advice. Golden Visa thresholds and eligibility criteria are set by UAE federal authorities and can change — always confirm current requirements before making an investment decision."
  jsonLd={jsonLd}
  image={image}
  partnerDisclosure
>
  <LeadTracking slot="tracking" />
  <slot />
</BaseLayout>
