---
import BaseLayout from "@dst/ui/BaseLayout.astro";
import "../styles/theme.css";

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>[];
}
const { title, description, jsonLd } = Astro.props;

const nav = [
  { href: "/", label: "Visa types" },
  { href: "/golden/", label: "Golden Visa" },
  { href: "/properties/", label: "Eligible properties" },
  { href: "/family/", label: "Family & lifestyle" },
  { href: "/consultation/", label: "Consultation" },
];
---
<BaseLayout
  title={`${title} — Dubai Residency & Golden Visa`}
  description={description}
  siteName="Dubai Residency"
  nav={nav}
  complianceNote="Informational content, not immigration or legal advice. Golden Visa thresholds and eligibility criteria are set by UAE federal authorities and can change — always confirm current requirements before making an investment decision."
  jsonLd={jsonLd}
  partnerDisclosure
>
  <slot />
</BaseLayout>
