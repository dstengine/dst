---
// Every page of fest.one: the language's identity from site.config.ts, and
// for a guide's page, the guide's locale and anything the guide adds to the
// footer. Nothing here is a word of any page.
import BaseLayout from "@dst/ui/BaseLayout.astro";
import { chrome as words, langOf, site as sites, type Lang } from "../site.config";
import type { Guide } from "../data/types";
import "../styles/theme.css";

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>[];
  alternates?: { lang: string; href: string; label: string; title: string }[];
  /** Breadcrumb names for the trail in the structured data. */
  crumbLabels?: Record<string, string>;
  /** The last of them, where the page's crumb is not its title less the
      suffix. */
  crumbCurrent?: string;
  /** The whole trail for the structured data, home first and this page
      last, in place of the two above: a guide's page, whose trail is not
      its address (rules.ts, guideTrail). */
  crumbTrail?: { name: string; path: string }[];
  /** The guide the page belongs to; absent on the hub. */
  guide?: Guide;
  language?: Lang;
  /** The share picture (og:image), where the page has one of its own: a
      guide's cover. Absent, BaseLayout shares the site's card. */
  image?: string;
  /** Out of the index: the archive's /contacts/, which it kept out too. */
  noindex?: boolean;
  /** The title's suffix, over the language's: a legacy page's (legacy.ts). */
  titleSuffix?: string;
}
const { title, description, jsonLd, alternates, crumbLabels, crumbCurrent, crumbTrail, guide, language = "en", image, noindex, titleSuffix } = Astro.props;

// The guide's locale over the language's, and its own footer links after the
// hub's. Spread, like the rest of the identity, so the layout sets none of
// it by name. A guide's page takes the row of the guide's language (es-CL
// reads es); the hub, which has no guide, the one it names.
const own = sites[guide ? langOf(guide.lang) : language];
const site = {
  ...own,
  ...(guide ? { lang: guide.lang } : {}),
  ...(guide?.footerLinks ? { footerLinks: [...own.footerLinks, ...guide.footerLinks] } : {}),
  ...(guide?.footerNote ? { complianceNote: guide.footerNote } : {}),
  ...(titleSuffix ? { titleSuffix } : {}),
};
// The skip link and the menu button in the guide's language, where the
// shared layout's own table has no row for it (pt); otherwise its row.
const row = guide ? words[langOf(guide.lang)] : undefined;
const chrome = row?.skip || row?.menu ? { skip: row.skip, menu: row.menu } : undefined;
// A Thai page's text needs its face for the first paint as a Latin page
// needs Chivo: the Thai file is preloaded there, and only there.
const thai = guide ? langOf(guide.lang) === "th" : false;
---
<BaseLayout
  {...site}
  title={title}
  description={description}
  nav={[]}
  jsonLd={jsonLd}
  alternates={alternates}
  crumbLabels={crumbLabels}
  crumbCurrent={crumbCurrent}
  crumbTrail={crumbTrail}
  chrome={chrome}
  image={image}
  noindex={noindex}
>
  {/* Only the two faces the first paint needs: Chivo 400 for the text and
      Syne 800 for the headings, Latin subset. Everything else loads when a
      glyph asks for it (theme.css). */}
  <Fragment slot="head">
    <link rel="preload" href="/fonts/chivo-v21-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/syne-v24-latin.woff2" as="font" type="font/woff2" crossorigin />
    {thai && <link rel="preload" href="/fonts/noto-sans-thai-v29-thai.woff2" as="font" type="font/woff2" crossorigin />}
  </Fragment>
  <slot />
</BaseLayout>
