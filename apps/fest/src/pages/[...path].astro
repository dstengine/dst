---
// Every page of every guide, from the data: /beyond-the-valley/ and its
// subpages, a second language at /<event>/<hl>/; and every page of the
// archive of the old festival site, at the address it always had
// (legacy/pages.json). One rest route for both, so assertRoutesAreUnique
// sees every address the app serves.
import Layout from "../layouts/Layout.astro";
import GuidePage from "../components/GuidePage.astro";
import LegacyPage from "../components/LegacyPage.astro";
import { LEGACY_SUFFIX } from "../legacy";
import { assertRoutesAreUnique, alternatesFor, guideRoutes, legacyRoutes, type GuideRoute, type LegacyRoute } from "../routes";
import { assertTitle, guideTrail, mainPage, musicEvent, today } from "../rules";
import { withSuffix } from "@dst/ui/title";
import { langOf, site } from "../site.config";

export function getStaticPaths() {
  assertRoutesAreUnique();
  return [
    ...guideRoutes().map((route) => ({
      params: { path: route.page.slug },
      props: { route },
    })),
    ...legacyRoutes().map((legacy) => ({
      params: { path: legacy.path.replace(/^\/|\/$/g, "") },
      props: { legacy },
    })),
  ];
}

const { route, legacy } = Astro.props as { route?: GuideRoute; legacy?: LegacyRoute };
const { event, guide, page } = route ?? ({} as GuideRoute);
const day = today();
// The suffix and the keyword of the guide's language: a Spanish title ends
// "guía del festival" and is held to "festival" as Spanish has it.
const { titleSuffix, keyword } = site[langOf(guide?.lang ?? "en")];
// A legacy title is English, as the archive wrote it, and where it lacks
// "festival" takes the archive's suffix (Iron Maiden in Moscow, 25 June
// 2016 — festival archive), held to 60 and the keyword as a guide's is.
if (legacy) assertTitle(withSuffix(legacy.page.title, LEGACY_SUFFIX, keyword, "en"), keyword, legacy.path);
else assertTitle(withSuffix(page.title, titleSuffix, keyword, guide.lang), keyword, route!.path);

// One event, one URL: the MusicEvent goes on the guide's main page only,
// first, so the page reads as the event it is; and on a subpage that is an
// edition of its own, with its own markup (Igloofest's Québec and
// Gatineau, the SEO lead's gate-3 condition 4).
const jsonLd = !legacy && (page === mainPage(guide) || page.markup) ? [musicEvent(event, guide, page, day)] : [];
// The BreadcrumbList is the visible trail (GuidePage), whole: the hub under
// the language's home label, the guide's own page under the event's name as
// the guide gives it, and this page by its crumb where it has one, each at
// its own address (rules.ts, guideTrail). Given whole, not walked from the
// address, since a guide's second language sits at /zamna-tulum/en/ and the
// walk would name /zamna-tulum/ and a crumb "En". An archive page walks.
const trail = route
  ? (() => {
      const { crumbs, current } = guideTrail(event, guide, page);
      const { homeHref, homeLabel } = site[langOf(guide.lang)];
      return [{ name: homeLabel, path: homeHref }, ...crumbs.map((c) => ({ name: c.label, path: c.href })), { name: current, path: route.path }];
    })()
  : undefined;
// Every page of a guide shares its cover: a link to the camping page is a
// link to the same festival, and the picture says which one.
---
{legacy ? (
<Layout
  title={legacy.page.title}
  description={legacy.page.description}
  crumbLabels={Object.fromEntries(legacy.page.crumbs.map((c) => [c.href.replace(/^\/|\/$/g, ""), c.label]))}
  crumbCurrent={legacy.page.current}
  image={legacy.page.image}
  noindex={legacy.page.noindex}
  titleSuffix={LEGACY_SUFFIX}
>
  <LegacyPage page={legacy.page} />
</Layout>
) : (
<Layout
  title={page.title}
  description={page.description}
  jsonLd={jsonLd}
  alternates={alternatesFor(page, guide)}
  crumbTrail={trail}
  guide={guide}
  image={guide.cover}
>
  <GuidePage event={event} guide={guide} page={page} today={day} />
</Layout>
)}
