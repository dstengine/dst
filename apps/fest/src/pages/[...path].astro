---
// Every page of every guide, from the data: /beyond-the-valley/ and its
// subpages now, a second language at /<event>/<hl>/ later.
import Layout from "../layouts/Layout.astro";
import GuidePage from "../components/GuidePage.astro";
import { assertRoutesAreUnique, alternatesFor, guideRoutes, type GuideRoute } from "../routes";
import { assertTitle, mainPage, musicEvent, today } from "../rules";
import { withSuffix } from "@dst/ui/title";
import { langOf, site } from "../site.config";

export function getStaticPaths() {
  assertRoutesAreUnique();
  return guideRoutes().map((route) => ({
    params: { path: route.page.slug },
    props: { route },
  }));
}

const { route } = Astro.props as { route: GuideRoute };
const { event, guide, page } = route;
const day = today();
// The suffix and the keyword of the guide's language: a Spanish title ends
// "guía del festival" and is held to "festival" as Spanish has it.
const { titleSuffix, keyword } = site[langOf(guide.lang)];
assertTitle(withSuffix(page.title, titleSuffix, keyword, guide.lang), keyword, route.path);

// One event, one URL: the MusicEvent goes on the guide's main page only,
// first, so the page reads as the event it is.
const jsonLd = page === mainPage(guide) ? [musicEvent(event, guide, page, day)] : [];
// The BreadcrumbList names what the visible trail shows (GuidePage): the
// event as the guide names it, and this page by its crumb where it has one.
---
<Layout
  title={page.title}
  description={page.description}
  jsonLd={jsonLd}
  alternates={alternatesFor(page, guide)}
  crumbLabels={{ [event.slug]: guide.name ?? event.name }}
  crumbCurrent={page.crumb}
  guide={guide}
>
  <GuidePage event={event} guide={guide} page={page} today={day} />
</Layout>
