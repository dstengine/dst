---
// One page of a guide, whatever its kind: the trail, the h1 and the lede
// with the answer in it, the row of the guide's pages, the sections, the
// questions, the sources and the page's own closing line. Every word comes
// from the guide's data or, for the few the template says itself, from the
// language's row in site.config.ts.
//
// The blocks between the row and the sections (a ticket button with its
// seller's line, the facts at a glance, a status badge, a calendar file, a
// map link) are the guide's to fill. Beyond The Valley fills none: every
// ticket is sold out, and a button would be this site selling what nobody
// can buy. Each renders only when the page's data has it.
import Breadcrumbs from "@dst/ui/Breadcrumbs.astro";
import ChipNav from "@dst/ui/ChipNav.astro";
import OnThisPage from "@dst/ui/OnThisPage.astro";
import Faq from "@dst/ui/Faq.astro";
import Glance from "@dst/ui/Glance.astro";
import GuideCta from "./GuideCta.astro";
import { ICONS } from "@dst/ui/icons";
import type { FestEvent, Guide, GuidePage } from "../data/types";
import { applySpans, blocks, headingHtml, inline, inlineText, longDate, pathOf, sourcesHtml, withoutSuffix, type Ctx } from "../copy";
import { mainPage } from "../rules";
import { languagesFor } from "../routes";
import { chrome, langOf, site } from "../site.config";
import { datedPages } from "../dated";

interface Props {
  event: FestEvent;
  guide: Guide;
  page: GuidePage;
  today: string;
}
const { event, guide, page, today } = Astro.props;
const words = chrome[langOf(guide.lang)];
const home = site[langOf(guide.lang)];
const path = pathOf(page);
const ctx: Ctx = { event, guide, page, today, where: path };
const main = mainPage(guide);

// The trail matches the one in the structured data (schema.ts, through
// [...path].astro): the hub, then the guide's own page under the event's
// name as the guide gives it, then this page under its crumb, or its title
// without the suffix where it has none.
const crumbs = page === main ? [] : [{ href: guide.path, label: guide.name ?? event.name, title: main.linkTitle ?? withoutSuffix(main.title) }];
const current = page.crumb ?? withoutSuffix(page.title);

// The sibling row's tooltips say what each page holds (navTitle), as the
// other links to a page do (linkTitle, copy.ts), where the guide gives them.
const siblings = guide.pages.map((p) => ({ href: pathOf(p), label: p.label, title: p.navTitle ?? withoutSuffix(p.title) }));
// A tooltip that reads its label back says nothing (LOCAL.md): the build
// stops on one, here where the guide's own strings meet.
for (const c of crumbs) if (c.title === c.label) throw new Error(`${path}: the crumb "${c.label}" has its own label as its title`);
for (const s of siblings) if (s.title === s.label) throw new Error(`${path}: the row's "${s.label}" has its own label as its title`);
// The event's guides in other languages. BaseLayout would put them in the
// header, which cannot hold two names like "English (Australia)" beside the
// wordmark at 320 px (the fixture proof of 22 Oct 2026); theme.css hides
// that copy and the row sits here, under the guide's own pages.
const languages = languagesFor(page, guide);

// A heading or a question may hold a figure that expires ("The three $99.90
// tickets"): it reads as the day's copy does, words only, as it always
// printed.
const plain = (text: string) => applySpans(text, guide, today, path).trim();
const sections = page.sections
  .map((s) => ({ ...s, heading: plain(s.heading), html: blocks(s.body, ctx, s.kind) }))
  .filter((s) => s.html);
// A jump link's label is the whole of what it does, so it carries no
// tooltip: one that read the label back is the thing these pages may not
// carry anywhere.
// A page that names its own (Creamfields Chile's main page: four sections
// and the questions, under short labels) has them as given, each checked
// against what the page prints that day.
// A label may sit in a span with the section it points at (Primavera Sound
// São Paulo's "O que o organizador lista como valor", whose section goes
// with the prices), and leaves the list on the same day.
const jumpIds = new Set([...sections.map((s) => s.id), "questions"]);
const ownJumps = page.jumps?.map((j) => ({ ...j, label: plain(j.label) })).filter((j) => j.label);
for (const j of ownJumps ?? [])
  if (!jumpIds.has(j.id)) throw new Error(`${path}: the jump "${j.label}" names #${j.id}, which the page does not print`);
const jumps = ownJumps
  ? ownJumps.map((j) => ({ ...j, title: false as const }))
  : sections.map((s) => ({ id: s.id, label: s.heading, title: false as const }));

// Each answer twice: as the page prints it, with its links to the guide's
// other pages and the spans that keep a date whole, and as words alone for
// the FAQPage markup, which is read off the page (Faq.astro, `text`).
const faq = page.faq
  .map((row) => ({ q: plain(row.q), a: inline(row.a, ctx), text: inlineText(row.a, ctx), generic: row.generic }))
  .filter((row) => row.a);
// A page whose questions are the page (Field Day's FAQ) has them first and
// under no heading of its own: the h1 already names them. Without the
// heading there is nothing for aria-labelledby to point at, so the rows sit
// in a plain block. In the template the block and the note under Sources
// sit flush against what follows them: a line break between two
// expressions is a space in the HTML, and Beyond The Valley's pages, which
// have neither, must come out byte for byte as they were.
const faqFirst = page.faqFirst === true;
// Where the page gives its h1 an id (Wonderfruit's FAQ), the block is a
// section the h1 names.
// The lede is its first paragraph. A second, after a blank line, is the
// line on why the guide exists, set smaller under it (Creamfields Chile:
// the fest director's gate-3 condition 2), so the answer still comes first.
// A guide may keep more paragraphs as the lede (`ledeParas`: Wonderfruit's
// facts, then its prices with their reading date); the line on why is
// what follows them.
const [ledeFirst, ...ledeRest] = page.lede.split(/\n{2,}/);
const lede = inline(ledeFirst, ctx);
const ledeCount = page.ledeParas ?? 1;
const ledeMore = ledeRest.slice(0, ledeCount - 1).map((p) => inline(p, ctx)).filter(Boolean);
const whyParas = ledeRest.slice(ledeCount - 1);
const why = whyParas.length ? inline(whyParas.join(" "), ctx) : "";
// The ticket button sits at the top, or under the heading of the section
// the copy puts it in (`cta: true`), never both.
const ctaInSection = page.sections.some((s) => s.cta);
if (ctaInSection && !page.cta) throw new Error(`${path}: a section asks for the ticket button, and the page has none`);
// The facts at a glance print as text: a value's [key] tags are checked
// and left out, as in the copy. The line under them (the reading date they
// share) is copy like any other.
const glance = page.glance?.map((g) => ({ label: g.label, value: inlineText(g.value, ctx), icon: ICONS.list }));
const glanceNote = page.glanceNote === undefined ? "" : inline(page.glanceNote, ctx);
const sources = page.sources === undefined ? "" : sourcesHtml(page.sources, ctx);
const sourcesNote = page.sourcesNote === undefined ? "" : inline(page.sourcesNote, ctx);
const links = page.links === undefined ? "" : inline(page.links, ctx);
// The day the page last changed, under its lede, where the guide prints
// it (Igloofest: « Mis à jour le 22 octobre 2026 »): the day its sitemap
// entry gives, the newer of its own date and its event's (dated.ts, as
// tools/lastmod.mjs reads them), on that date's own clock.
let updated: { iso: string; text: string } | undefined;
if (guide.updatedLine) {
  if (!words.updated) throw new Error(`${path}: the guide prints the day it changed, and site.config.ts has no words for it in "${guide.lang}"`);
  const dated = datedPages().get(path)!;
  const newest = [dated.updatedAt, dated.with ?? dated.updatedAt].reduce((a, b) => (Date.parse(b) > Date.parse(a) ? b : a));
  updated = { iso: newest.slice(0, 10), text: longDate(newest, guide.lang) };
}
// A guide may label its row of pages and its questions with the event's
// name (Igloofest: « Pages du guide Igloofest », « Questions fréquentes sur
// Igloofest »); the questions are then named by that label, not by their
// heading.
const navLabel = guide.navLabel ?? words.siblingNav;
---
<article class="container guide">
  <Breadcrumbs
    crumbs={crumbs}
    current={current}
    homeHref={home.homeHref}
    homeLabel={home.homeLabel}
    homeTitle={words.rootCrumbTitle}
    label={words.breadcrumbs}
  />
  <header class="guide-head">
    <h1 id={page.h1Id}>{page.h1}</h1>
    {lede && <p class="lede" set:html={lede} />}{ledeMore.map((l) => <p class="lede" set:html={l} />)}{why && <p class="lede-why" set:html={why} />}{updated && <p class="guide-updated">{words.updated} <time datetime={updated.iso}>{updated.text}</time></p>}
  </header>

  <ChipNav items={siblings} current={path} label={navLabel} />
  {languages.length > 0 && (
    <nav class="guide-languages" aria-label={words.otherLanguages}>
      {languages.map((l) => <a href={l.href} hreflang={l.lang} lang={l.lang} dir={l.dir} title={l.title}>{l.label}</a>)}
    </nav>
  )}

  {page.badge && <p class="guide-badge">{page.badge.text}</p>}
  {page.cta && !ctaInSection && <GuideCta cta={page.cta} />}
  {glance && (page.glanceHeading ? (
    <section class="guide-glance" aria-labelledby="glance">
      <h2 id="glance">{page.glanceHeading}</h2>
      <Glance facts={glance} />
    </section>
  ) : <Glance facts={glance} />)}{glanceNote && <p class="guide-glance-note" set:html={glanceNote} />}
  {(page.calendar || page.map) && (
    <p class="guide-files">
      {page.calendar && <a href={page.calendar.href} title={page.calendar.title}>{page.calendar.label}</a>}
      {page.map && <a href={page.map.href} title={page.map.title} rel="nofollow">{page.map.label}</a>}
    </p>
  )}

  <OnThisPage items={jumps} min={page.jumps ? 1 : 5} heading={page.onThisPage ?? words.onThisPage} />

  {faqFirst && faq.length > 0 && (
    page.faqHeading ? (
      <section class="guide-section" aria-labelledby="questions">
        <h2 id="questions">{page.faqHeading}</h2>
        <Faq items={faq} />
      </section>
    ) : page.h1Id ? (
      <section class="guide-section guide-faq-first" aria-labelledby={page.h1Id}><Faq items={faq} /></section>
    ) : (
      <div class="guide-section guide-faq-first"><Faq items={faq} /></div>
    )
  )}{sections.map((s) => (
    <section class="guide-section" aria-labelledby={s.id}>
      <h2 id={s.id} set:html={headingHtml(s.heading, guide.lang)} />{s.cta && page.cta && <GuideCta cta={page.cta} />}
      <Fragment set:html={s.html} />
    </section>
  ))}

  {!faqFirst && faq.length > 0 && (
    <section class="guide-section" aria-labelledby={guide.faqLabel ? undefined : "questions"} aria-label={guide.faqLabel}>
      <h2 id="questions">{page.faqHeading}</h2>
      <Faq items={faq} />
    </section>
  )}

  {(sources || links) && (
    <section class="guide-section guide-sources" aria-labelledby="sources">
      <h2 id="sources">{page.sourcesHeading}</h2>
      {sourcesNote && <p class="guide-sources-note" set:html={sourcesNote} />}{sources && <Fragment set:html={sources} />}
      {links && <p class="guide-links" set:html={links} />}
    </section>
  )}

  {page.foot && <p class="guide-foot">{page.foot}</p>}
</article>
