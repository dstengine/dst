---
import Layout from "../../layouts/Layout.astro";
import EventArticle from "@dst/ui/EventArticle.astro";
import { eventsBySite } from "@dst/content/events";

// No ticketed events for palmcentral yet — see riviera's events/[slug].astro
// for the outbound.ts-backed /go/ pattern this would use once one exists.
export function getStaticPaths() {
  const items = eventsBySite("palmcentral").filter((item) => Array.isArray(item.body) && item.body.length > 0);
  return items.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
---
<Layout title={item.title} description={item.summary} image={item.image}>
  <EventArticle item={item} backHref="/events/" />
</Layout>
