---
import Layout from "../layouts/Layout.astro";
import Callout from "@dst/ui/Callout.astro";
import Faq from "@dst/ui/Faq.astro";
import InterestForm from "../components/InterestForm.astro";
import PhotoHero from "@dst/ui/district/PhotoHero.astro";
import { iconFor } from "@dst/ui/icons";
import {
  siteHeaderImage,
  currentPhase,
  soldOutPhase,
  currentUnits,
  phase1Units,
  amenities,
  distances,
  faqItems,
} from "../content";

const explore = [
  { href: "/prices/", icon: "chart", title: "Full price list", description: "Every unit type, both release phases, side by side." },
  { href: "/payment-plan/", icon: "money", title: "Payment plan", description: "What's confirmed, what isn't, and what to ask before you book." },
  { href: "/location/", icon: "pin", title: "Location", description: "Where the Spine sits on Palm Jebel Ali, and the real drive times." },
  { href: "/golden-visa/", icon: "star", title: "Golden Visa", description: "Eligibility, thresholds, and the property route specifically." },
];

// additionalProperty carries the facts an LLM/AI-answer engine is most
// likely to be asked for and would otherwise have to infer from prose —
// developer, current phase, starting price, handover — as unambiguous
// key/value pairs rather than something to extract from a sentence.
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "ApartmentComplex",
    name: "Palm Central Private Residences",
    url: "https://palmcentral.dst.llc/",
    description:
      "Beachfront apartments and townhouses on Palm Jebel Ali's central Spine, developed by Nakheel.",
    address: {
      "@type": "PostalAddress",
      addressLocality: "Palm Jebel Ali",
      addressRegion: "Dubai",
      addressCountry: "AE",
    },
    numberOfAccommodationUnits: currentPhase.units,
    additionalProperty: [
      { "@type": "PropertyValue", name: "Developer", value: "Nakheel" },
      { "@type": "PropertyValue", name: "Current release phase", value: currentPhase.label },
      { "@type": "PropertyValue", name: "Starting price (current phase)", value: currentUnits[0].priceFrom },
      { "@type": "PropertyValue", name: "Handover (current phase)", value: currentPhase.handover },
      { "@type": "PropertyValue", name: "Sold-out phase", value: `${soldOutPhase.label}, from ${phase1Units[0].priceFrom}` },
    ],
  },
];
---
<Layout
  title="Private Residences"
  description="Palm Central by Nakheel on Palm Jebel Ali — current Phase 2 pricing, payment plan, location and Golden Visa eligibility. Phase 1 is sold out; this page tracks what's actually for sale."
  jsonLd={jsonLd}
>
  <section class="container hero">
    <PhotoHero
      eyebrow="Nakheel · Palm Jebel Ali"
      title="Palm Central Private Residences"
      image={siteHeaderImage.src}
      imageAlt={siteHeaderImage.alt}
    />
    <p class="lede">
      <strong>Beachfront apartments and townhouses</strong> on
      <strong>Palm Jebel Ali's</strong> central Spine, developed by
      <strong>Nakheel</strong>. Two release phases exist for this project —
      this page tracks which one is actually buyable right now, not just the
      launch pricing most listings still quote.
    </p>
    <div class="hero-actions">
      <a class="button" href="#interest" title="Register interest in Palm Central">Register interest</a>
      <a class="button button-secondary" href="/prices/" title="See the full Palm Central price list">See prices</a>
    </div>
  </section>

  <Callout kind="note">
    <strong>Phase 1 ({soldOutPhase.released}, {soldOutPhase.units} residences) is sold out</strong> —
    {soldOutPhase.status} The current inventory is <strong>{currentPhase.label}</strong>,
    released {currentPhase.released}: {currentPhase.units} residences across the
    same three buildings, handover {currentPhase.handover}. Prices below are
    for Phase 2 — see the <a href="/prices/" title="Palm Central price list, both phases">full price list</a> for
    a side-by-side comparison with the sold-out phase.
  </Callout>

  <section class="container">
    <h2>What's for sale right now</h2>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Unit type</th><th>From (AED)</th><th>From (approx. USD)</th></tr>
        </thead>
        <tbody>
          {currentUnits.map((u) => (
            <tr>
              <td>{u.type}</td>
              <td>{u.priceFrom}</td>
              <td>{u.priceFromUsd}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="table-note">
      {currentPhase.units} residences, {currentPhase.buildings} buildings, handover {currentPhase.handover}.
      {currentPhase.sourceNote}
    </p>
  </section>

  <section class="container">
    <h2>What the project actually is</h2>
    <p>
      Palm Central is <strong>Nakheel's first apartment community on Palm
      Jebel Ali</strong> — three low- to mid-rise buildings positioned on the
      island's central Spine, between Fronds M and N. That's the section of
      the master plan set aside for community and retail rather than the
      private villa fronds on either side, which is why it's the one part of
      Palm Jebel Ali apartment buyers can access at all in this phase of the
      island's build-out.
    </p>
    <p>
      Every residence faces either the canal-style waterway that runs along
      the Spine or the internal courtyard, with <strong>direct beach
      access</strong> built into the ground floor rather than a separate walk
      to a shared amenity. Stepped massing on the upper floors is there for a
      practical reason: it keeps sightlines to the water open from more units
      than a flat facade would, which matters more here than the render
      suggests once you're comparing specific floors.
    </p>
  </section>

  <section class="container">
    <h2>Amenities confirmed for this phase</h2>
    <ul class="amenity-list">
      {amenities.map((a) => (
        <li><strong>{a.name}</strong> — {a.note}</li>
      ))}
    </ul>
  </section>

  <section class="container">
    <h2>Getting around from here</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th>To</th><th>Drive time</th></tr></thead>
        <tbody>
          {distances.map((d) => (
            <tr><td>{d.to}</td><td>{d.time}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="table-note">
      Palm Jebel Ali sits closer to Jebel Ali Port and the new
      <strong>Al Maktoum International Airport</strong> than to Downtown —
      worth weighing if your daily routine runs through DIFC or Business Bay
      rather than the Marina/JBR side of the city. More on this on the
      <a href="/location/" title="Palm Central location and connectivity">location page</a>.
    </p>
  </section>

  <section class="container">
    <h2>Explore further</h2>
    <div class="link-grid">
      {explore.map((item) => {
        const path = iconFor(`/${item.icon}/`);
        return (
          <a class="card link-card" href={item.href} title={item.description}>
            {path && (
              <svg class="link-card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={path} />
              </svg>
            )}
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </a>
        );
      })}
    </div>
  </section>

  <section class="container">
    <h2>Common questions</h2>
    <Faq items={faqItems.slice(0, 4)} />
    <p><a href="/faq/" title="All Palm Central frequently asked questions">See all frequently asked questions →</a></p>
  </section>

  <InterestForm currentUnits={currentUnits} />
</Layout>

<style>
  .hero { padding-bottom: var(--space-4); }
  .hero .lede { margin-top: var(--space-3); }
  .hero-actions { display: flex; gap: var(--space-2); margin-top: var(--space-3); flex-wrap: wrap; }
  .table-note { margin-top: var(--space-2); font-size: var(--step--1); color: var(--ink-muted); }
  .amenity-list { display: grid; gap: var(--space-1); padding-left: 1.2em; }
  .amenity-list li { max-width: var(--content-width); }
  .link-card-icon { width: 22px; height: 22px; margin-bottom: var(--space-2); color: var(--accent); }
</style>
