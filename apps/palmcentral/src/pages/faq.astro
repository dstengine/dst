---
import Layout from "../layouts/Layout.astro";
import Faq from "@dst/ui/Faq.astro";
import PhotoHero from "@dst/ui/district/PhotoHero.astro";
import InterestForm from "../components/InterestForm.astro";
import { siteHeaderImage, faqItems, currentUnits } from "../content";
---
<Layout
  title="Frequently Asked Questions"
  description="Palm Central FAQ: current availability, Phase 2 pricing, payment plan, Golden Visa eligibility, the developer, and exact location on Palm Jebel Ali."
>
  <section class="container hero">
    <PhotoHero
      eyebrow="FAQ"
      title="Frequently asked questions"
      image={siteHeaderImage.src}
      imageAlt={siteHeaderImage.alt}
      imageKind={siteHeaderImage.kind}
    />
    <p class="lede">
      The questions people actually ask before booking, answered plainly —
      including the one most listings skip: whether the price you're
      looking at is still available.
    </p>
    <div class="hero-actions">
      <a class="button" href="#interest" title="Register interest in Palm Central">Register interest</a>
    </div>
  </section>

  <section class="container">
    <Faq items={faqItems} />
  </section>

  <section class="container cta">
    <h2>Still have a question?</h2>
    <p>
      <a href="#interest" title="Register interest in Palm Central">Register your interest</a> and
      ask it directly — we'll answer before you're asked to commit to
      anything.
    </p>
  </section>

  <InterestForm currentUnits={currentUnits} />
</Layout>

<style>
  .cta { margin-top: var(--space-5); }
  .hero-actions { display: flex; gap: var(--space-2); margin-top: var(--space-3); flex-wrap: wrap; }
</style>
