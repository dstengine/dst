---
import Layout from "../layouts/Layout.astro";
import Callout from "@dst/ui/Callout.astro";
import PhotoHero from "@dst/ui/district/PhotoHero.astro";
import InterestForm from "../components/InterestForm.astro";
import { siteHeaderImage, currentPhase, soldOutPhase, currentUnits, phase1Units } from "../content";
---
<Layout
  title="Prices"
  description="Palm Central prices by unit type, both release phases: the current Phase 2 (from AED 2.7M) and the sold-out Phase 1 (from AED 2.5M), side by side."
>
  <section class="container hero">
    <PhotoHero
      eyebrow="Prices"
      title="Palm Central prices, both phases"
      image={siteHeaderImage.src}
      imageAlt={siteHeaderImage.alt}
    />
    <p class="lede">
      Most listings for this project quote {soldOutPhase.label} pricing without
      flagging that it's sold out. Here's both phases, so you can see what
      changed — price, timeline, and which unit types are actually on offer
      — rather than pricing a unit that no longer exists.
    </p>
  </section>

  <Callout kind="note">
    <strong>{soldOutPhase.label}</strong> ({soldOutPhase.released}) <strong>is sold out</strong> — {soldOutPhase.status} Only
    <strong>{currentPhase.label}</strong> ({currentPhase.released}) is current inventory.
  </Callout>

  <section class="container">
    <h2>{currentPhase.label} — current, {currentPhase.released}</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Unit type</th><th>Bedrooms</th><th>From (AED)</th><th>From (USD)</th></tr></thead>
        <tbody>
          {currentUnits.map((u) => (
            <tr><td>{u.type}</td><td>{u.bedrooms}</td><td>{u.priceFrom}</td><td>{u.priceFromUsd}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="table-note">
      Handover {currentPhase.handover}. No 5-bedroom apartments or penthouses
      have been confirmed for this phase — if a listing offers one at Phase 2
      pricing, ask which release it's actually from.
    </p>
  </section>

  <section class="container">
    <h2>{soldOutPhase.label} — sold out, {soldOutPhase.released}</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Unit type</th><th>Bedrooms</th><th>From (AED)</th><th>From (USD)</th></tr></thead>
        <tbody>
          {phase1Units.map((u) => (
            <tr><td>{u.type}</td><td>{u.bedrooms}</td><td>{u.priceFrom}</td><td>{u.priceFromUsd}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="table-note">
      Handover {soldOutPhase.handover}. Kept here for reference — this is what
      "Palm Central from AED 2.5M" refers to, and it's the number that
      shows up in almost every third-party listing for this project. It's
      not what you'd pay today.
    </p>
  </section>

  <section class="container">
    <h2>What actually changed between phases</h2>
    <p>
      Entry pricing moved from <strong>AED 2.5M to AED 2.7M</strong> for the
      same 1-bedroom category — roughly an 8% increase across the eight
      months between releases. Handover moved out by a full year, from
      August 2029 to <strong>September 2030</strong>. And the unit mix
      narrowed: Phase 1 included 5-bedroom apartments and penthouses that
      haven't reappeared in Phase 2's confirmed lineup, at least not yet —
      Nakheel has historically added unit types back in later releases as a
      building's design firms up, so that could still change.
    </p>
  </section>

  <section class="container cta">
    <h2>Ready to talk specifics?</h2>
    <p>
      <a href="#interest" title="Register interest in Palm Central">Register your interest</a> and
      we'll come back with current Phase 2 availability matched to what
      you're after, not a resale listing from the sold-out phase.
    </p>
  </section>

  <InterestForm currentUnits={currentUnits} />
</Layout>

<style>
  .table-note { margin-top: var(--space-2); font-size: var(--step--1); color: var(--ink-muted); }
  .cta { margin-top: var(--space-5); }
</style>
