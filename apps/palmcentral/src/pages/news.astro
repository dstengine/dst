---
import Layout from "../layouts/Layout.astro";
import SectionNav from "@dst/ui/SectionNav.astro";
import NewsList from "@dst/ui/NewsList.astro";
import { newsBySite } from "@dst/content/news";
import { eventsBySite } from "@dst/content/events";
import { sections, NAV } from "../sections";

const items = newsBySite("palmcentral");

// The subject row. Empty until a subject earns a page, and then it
// appears here without this file changing — see ../sections.ts.
const sectionLinks = sections([...eventsBySite("palmcentral"), ...newsBySite("palmcentral")]);
---
<Layout
  title="News from Palm Jebel Ali"
  description="Updates on Palm Central — pricing changes, release phases, and this site's own updates."
>
  <section class="container hero">
    <p class="eyebrow">News</p>
    <h1>What's changing at Palm Central</h1>
    <p class="lede">
      Pricing and release-phase changes at Palm Central, kept apart from
      the reference pages themselves.
    </p>
  </section>

  <section class="container">
    <SectionNav sections={sectionLinks} {...NAV} />
    <NewsList items={items} />
  </section>
</Layout>
