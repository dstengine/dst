---
import { siteId } from "../content";
import Layout from "../layouts/Layout.astro";
import PromoHero from "@dst/ui/PromoHero.astro";
import SectionNav from "@dst/ui/SectionNav.astro";
import NewsList from "@dst/ui/NewsList.astro";
import { newsBySite } from "@dst/content/news";
import { eventsBySite } from "@dst/content/events";
import { sections, NAV } from "../sections";

const items = newsBySite(siteId);

// The subject row. Empty until a subject earns a page, and then it
// appears here without this file changing — see ../sections.ts.
const sectionLinks = sections([...eventsBySite(siteId), ...newsBySite(siteId)]);
---
<Layout
  title="News from Palm Jebel Ali"
  description="Nakheel's releases and build progress on Palm Jebel Ali, and the Dubai market Palm Central is priced against: deals, mortgages, airport works, new homes."
>
  <PromoHero>
    <p class="eyebrow">News</p>
    <h1>What's changing at Palm Central</h1>
    <p class="lede">
      Nakheel's releases, how far Palm Jebel Ali is built, and the market
      Palm Central is priced against: Dubai's deals, mortgages, airport
      works and new homes.
    </p>
  </PromoHero>

  <section class="container">
    <SectionNav sections={sectionLinks} {...NAV} />
    <NewsList items={items} />
  </section>
</Layout>
