---
// Keeps "Register interest" reachable without hunting for the nav or
// scrolling to the bottom of a long page — but only once that's actually
// true. The header already has its own "Register interest" link, so this
// button stays hidden while the header is still on screen (it would just be
// a second copy of the same thing) and appears once the header scrolls past.
// It hides again near the real form so we're never showing two "Register
// interest" prompts on screen at once — the form itself is on every page
// now (InterestForm.astro), so "#interest" is a same-page anchor everywhere,
// not just a link back to the homepage.
//
// Default state is hidden via CSS, not JS, so there's no flash of the
// button before the header-visibility check runs.
---
<a class="sticky-cta button" href="#interest" title="Register interest in Palm Central" data-sticky-cta>
  Register interest
</a>
<script>
  const cta = document.querySelector<HTMLElement>("[data-sticky-cta]");
  const header = document.querySelector(".site-header");
  const interestForm = document.getElementById("interest");

  if (cta) {
    let pastHeader = false;
    let nearForm = false;
    const sync = () => cta.classList.toggle("is-visible", pastHeader && !nearForm);

    if (header) {
      new IntersectionObserver(([entry]) => {
        pastHeader = !entry.isIntersecting;
        sync();
      }).observe(header);
    }

    if (interestForm) {
      new IntersectionObserver(
        ([entry]) => {
          nearForm = entry.isIntersecting;
          sync();
        },
        { rootMargin: "0px 0px -15% 0px" },
      ).observe(interestForm);
    }
  }
</script>

<style>
  .sticky-cta {
    position: fixed;
    right: var(--space-3);
    bottom: var(--space-3);
    z-index: 40;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
    opacity: 0;
    transform: translateY(0.5em);
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .sticky-cta.is-visible {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  @media (max-width: 640px) {
    .sticky-cta {
      left: var(--space-3);
      right: var(--space-3);
      bottom: var(--space-3);
      justify-content: center;
      text-align: center;
    }
  }
</style>
