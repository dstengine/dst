---
import BaseLayout from "@dst/ui/BaseLayout.astro";
import { site } from "../site.config";
import LeadTracking from "@dst/ui/LeadTracking.astro";
import StickyCta from "../components/StickyCta.astro";
import "../styles/theme.css";

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>[];
  /** og:image for this page — see BaseLayout. */
  image?: string;
}
const { title, description, jsonLd, image } = Astro.props;

const nav = [
  { href: "/", label: "Overview", title: "Palm Central overview" },
  { href: "/prices/", label: "Prices", title: "Palm Central prices by unit type" },
  { href: "/payment-plan/", label: "Payment plan", title: "Palm Central payment plan" },
  { href: "/location/", label: "Location", title: "Palm Central location on Palm Jebel Ali" },
  { href: "/golden-visa/", label: "Golden Visa", title: "Golden Visa eligibility at Palm Central" },
  { href: "/faq/", label: "FAQ", title: "Palm Central frequently asked questions" },
  { href: "/news/", label: "News", title: "What's changing at Palm Central" },
  { href: "/events/", label: "Events", title: "Palm Central events" },
  { href: "#interest", label: "Register interest", title: "Register interest in Palm Central" },
];
---
<BaseLayout
  {...site}
  title={title}
  description={description}
  nav={nav}
  jsonLd={jsonLd}
  image={image}
>
  <LeadTracking slot="tracking" />
  <slot />
  <StickyCta />
</BaseLayout>
