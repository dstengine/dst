---
import BaseLayout from "@dst/ui/BaseLayout.astro";
import { site } from "../site.config";
import LeadTracking from "@dst/ui/LeadTracking.astro";
import StickyCta from "../components/StickyCta.astro";
import "../styles/theme.css";

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>[];
  /** og:image for this page — see BaseLayout. */
  image?: string;
  /** The page renders InterestForm, so "Register interest" stays on it. */
  hasForm?: boolean;
}
const { title, description, jsonLd, image, hasForm = false } = Astro.props;

// Where "Register interest" goes: the form on this page when it has one,
// the front page's otherwise. The news, event and subject pages carry no
// form of their own: on all of them it became the site's most repeated
// text (tests/build-output.test.js, "how much of each site is the
// template": 29% to 39%), and the reader is one tap from it anyway.
const interestHref = hasForm ? "#interest" : "/#interest";

const nav = [
  { href: "/", label: "Overview", title: "Palm Central overview" },
  { href: "/prices/", label: "Prices", title: "Palm Central prices by unit type" },
  { href: "/payment-plan/", label: "Payment plan", title: "Palm Central payment plan" },
  { href: "/location/", label: "Location", title: "Palm Central location on Palm Jebel Ali" },
  { href: "/golden-visa/", label: "Golden Visa", title: "Golden Visa eligibility at Palm Central" },
  { href: "/faq/", label: "FAQ", title: "Palm Central frequently asked questions" },
  { href: "/news/", label: "News", title: "What's changing at Palm Central" },
  { href: "/events/", label: "Events", title: "Palm Central events" },
  { href: interestHref, label: "Register interest", title: "Register interest in Palm Central" },
];
---
<BaseLayout
  {...site}
  title={title}
  description={description}
  nav={nav}
  jsonLd={jsonLd}
  image={image}
>
  <LeadTracking slot="tracking" />
  <slot />
  <StickyCta href={interestHref} />
</BaseLayout>
