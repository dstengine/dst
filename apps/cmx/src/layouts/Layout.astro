---
import BaseLayout from "@dst/ui/BaseLayout.astro";
import { site } from "../site.config";
import { promoted } from "../sections";
import "../styles/theme.css";

interface Props {
  /** Forwarded to BaseLayout: see its `prose` prop. */
  prose?: boolean;
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>[];
  image?: string;
  noindex?: boolean;
}
const { title, description, jsonLd, image, noindex, prose } = Astro.props;

const nav = [
  { href: "/", label: "Qué hacer", title: "Qué hacer hoy en la Ciudad de México", icon: "home" },
  // Second, not last: it is the one link here about what is being asked
  // for this month, and it removes itself when the last date under it has
  // gone. `title` is the section's own, so the tooltip is not the label.
  ...(promoted
    ? [{ href: `/${promoted.slug}/`, label: promoted.label, title: promoted.title, icon: "star" }]
    : []),
  { href: "/noticias/", label: "Noticias", title: "Noticias de la Ciudad de México, con la fuente a la vista", icon: "news" },
  { href: "/eventos/", label: "Eventos", title: "La agenda de eventos de la Ciudad de México", icon: "events" },
  { href: "/acerca/", label: "Acerca", title: "Quién publica este sitio y cómo se verifica cada fecha", icon: "id" },
];

---
<BaseLayout
  {...site}
  prose={prose}
  title={title}
  description={description}
  nav={nav}
  jsonLd={jsonLd}
  image={image}
  noindex={noindex}
>
  <slot />
</BaseLayout>
