---
import Layout from "../layouts/Layout.astro";
import SectionNav from "@dst/ui/SectionNav.astro";
import EventsList from "@dst/ui/EventsList.astro";
import { events, siteId, eventsBase, labels } from "../content";
import { eventsBySite } from "@dst/content/events";
import { newsBySite } from "@dst/content/news";
import { sections, NAV } from "../sections";

const items = eventsBySite(siteId);
const sectionLinks = sections([...items, ...newsBySite(siteId)]);
const thin = items.length < 3;
---
<Layout title={events.title} description={events.description} noindex={thin}>
  <section class="container hero">
    <h1>{events.h1}</h1>
    <p class="lede">{events.lede}</p>
  </section>
  <section class="container">
    <SectionNav sections={sectionLinks} allHref="/" {...NAV} />
    <EventsList locale="es-MX" items={items} eventsBase={eventsBase} labels={labels} />
  </section>
</Layout>
